		FROM (
		SELECT
		gg.bank_account_id AS accountId,
		gg.bank_account_name AS accountName,
		gg.IND_BRANCHID AS indBranchId,
		i.JGMC AS indBranchName,
		COALESCE(gg.BANK_ID, d.BANK_ID) AS bankId,
		COALESCE(gg.BANK_NAME, d.BANK_NAME) AS bankName,
		gg.ACCOUNT_TYPE_ID AS accountTypeId,
		at.ACCOUNT_TYPE_NAME AS accountTypeName,
		gg.AREA_DISTRICT AS areaDistrict,
		gg.currency AS currency,
		aa.mbtmz AS currencyName,
		gg.DEDICATED AS dedicated,
		CASE WHEN gg.DEDICATED = '0' THEN '共用' ELSE '独用' END AS dedicatedName,
		gg.EFFECTSTATUS AS effectstatus,
		ac.mbtmz AS effectstatusName,
		gg.ACCOUNT_ATTRIBUTE AS accountAttribute,
		gg.FOUREYESSTATUS AS foureyesstatus
		FROM bankAccAndUnuseAcc gg
		JOIN ACCOUNT_TYPE at ON at.ACCOUNT_TYPE_ID = gg.ACCOUNT_TYPE_ID
		LEFT JOIN IP_UNIT_STMT i ON i.ZJ = gg.IND_BRANCHID AND i.EFFECTSTATUS = '1'
		LEFT JOIN UNIT_BANK d ON gg.AREA_DISTRICT = d.DQDH || d.JGDH
		LEFT JOIN ip_codeinfo aa ON aa.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000003' AND aa.mblxbh = gg.currency
		LEFT JOIN ip_codeinfo ac ON ac.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000008' AND ac.mblxbh = gg.EFFECTSTATUS
		WHERE at.effectstatus = '1'
		
		 
			and (gg.ACCOUNT_TYPE_ID != 'CKZH' or   gg.ACCOUNT_TYPE_ID is null)
		 
		 
		 
			and gg.IND_BRANCHID in (select uib.branchid FROM user_info_branch uib WHERE uib.userid=? and uib.EFFECTSTATUS = '1')
		 
		 
		 
		 
		 
			union all
			select
			gg.bank_account_id as accountId,
			gg.bank_account_name as accountName,
			gg.IND_BRANCHID as indBranchId,
			(select i.JGMC from IP_UNIT_STMT i where i.ZJ = gg.IND_BRANCHID and i.EFFECTSTATUS='1') as indBranchName,
			NVL(gg.BANK_ID,(SELECT D.BANK_ID FROM UNIT_BANK D WHERE gg.AREA_DISTRICT = D.DQDH || D.JGDH)) as bankId,
			NVL(gg.BANK_NAME,(SELECT D.BANK_NAME FROM UNIT_BANK D WHERE gg.AREA_DISTRICT = D.DQDH || D.JGDH)) as bankName,
			gg.ACCOUNT_TYPE_ID as accountTypeId,
			at.ACCOUNT_TYPE_NAME as accountTypeName,
			gg.AR	</td><td style='mso-number-format:'@';'>2971	</td><td style='mso-number-format:'@';'>13	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>140	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>5535ccd95ee318e843ec13096818781c	</td><td style='mso-number-format:'@';'>select
		z.FAX_INSTRUCTION_ID,z.INSTRUCTION_ID,z.FAX_ID,z.PRODUCT_CODE,z.PAYMENT_DATE,z.PAYMENT_TYPE_ID,z.DIRECTION,z.AMOUNT,z.CURRENCY,z.PAYMENT_REASON,z.CREDIT_ACCOUNT,z.CREDIT_ACCOUNT_NAME,z.DEBIT_ACCOUNT,z.DEBIT_ACCOUNT_NAME,z.BANK_ID,z.BANK_NAME,z.sfqd,
		z.FILE_PATH,z.CREATED_AT,z.CREATED_BY,z.UPDATED_AT,z.UPDATED_BY,z.RESULT_STATUS,z.PUSH_STATUS,z.PUSH_AT,z.MANAGER_ID,z.MANAGER_NAME,z.RESULT_TYPE,AUDIT_COMMENT,z.TGT_QDZLBH,nvl(z.BUSINESS_TYPE,'0') BUSINESS_TYPE,
		(select a.yhmc from ip_staff a where z.CREATED_BY=a.yhbh) as createdByName,
		(select b.yhmc from ip_staff b where z.UPDATED_BY=b.yhbh) as updatedByName,
		(SELECT p.product_name FROM product p WHERE p.PRODUCT_CODE=z.PRODUCT_CODE order by p.created_at desc fetch first 1 rows only) as PRODUCT_NAME,
		NVL((SELECT psi.SYSTEM_FLAG FROM product p,prod_switch_info psi WHERE p.product_id = psi.product_id(+) and p.PRODUCT_CODE=z.PRODUCT_CODE order by p.created_at desc fetch first 1 rows only),'1') as systemFlag,
		z.ZLLY,
		(SELECT i.INSTRUC_BATCH FROM instruction i WHERE i.instruction_id = z.instruction_id) as INSTRUC_BATCH
		from FAX_INSTRUCTION z
		where 1=1
		 
		  and INSTRUCTION_ID like '%' || ? || '%' 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
 		 
		 
		order by RESULT_STATUS asc,PUSH_AT desc	</td><td style='mso-number-format:'@';'>2945	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>141	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>5d61a7a0750a6e02740a233e84f6735b	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH UnuseAccountFilter AS (
		SELECT DISTINCT P2.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP2 ON UA.BANK_ACCOUNT_ID = AP2.BANK_ACCOUNT_ID
		JOIN PRODUCT P2 ON AP2.PRODUCT_ID = P2.PRODUCT_ID
		WHERE
		UA.EFFECTSTATUS = '1'
		AND P2.SUB_GROUP_MARK = '0'
		)

		SELECT T.BALANCE_ID,
			   T.PRODUCT_ID,
			   T.PRODUCT_CODE,
			   T.MANAGER_PROD,
			   T.PRODUCT_NAME,
			   T.ACCOUNT_ID,
			   T.ACCOUNT_NAME,
			   T.ACCOUNT_TYPE_ID,
	           T.ACCOUNT_TYPE_NAME,
			   T.BALANCE_DATE,
			   T.AMOUNT,
			   T.CURRENCY,
			   T.CREATED_AT,
			   T.CREATED_BY,
			   T.CREATED_NAME,
			   T.UPDATED_AT,
			   T.UPDATED_BY,
			   T.UPDATED_NAME,
	           T.USABLE_BALANCE,
	           T.CONTROL_BALANCE,
	          T.FREEZE_BALANCE,
		T.ACCOUNT_SUB_SN
		 FROM
			(
			SELECT 
					BH.BALANCE_HISTORY_ID BALANCE_ID,
					BH.PRODUCT_ID,
	               	BH.ACCOUNT_ID,
	               	BH.ACCOUNT_TYPE_ID,
	               	BH.BALANCE_DATE,
	               	BH.AMOUNT,
	               	BH.CREATED_AT,
	               	BH.CREATED_BY,
	               	BH.UPDATED_AT,
	               	BH.UPDATED_BY,
	               	BH.USABLE_BALANCE,
	               	BH.CONTROL_BALANCE,
	               	BH.FREEZE_BALANCE,
		            AP.ACCOUNT_SUB_SN AS ACCOUNT_SUB_SN,
		            P.PRODUCT_CODE AS PRODUCT_CODE,
		            P.MANAGER_PROD AS MANAGER_PROD,
		            P.PRODUCT_NAME AS PRODUCT_NAME,
		            BA2.BANK_ACCOUNT_NAME AS ACCOUNT_NAME,
		            ACT.ACCOUNT_TYPE_NAME AS ACCOUNT_TYPE_NAME,
		            BA2.CURRENCY AS CURRENCY,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.CREATED_BY) AS CREATED_NAME,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.UPDATED_BY) AS UPDATED_NAME
	          FROM 	
	          		BALANCE_HISTORY BH
		LEFT JOIN ACCOUNT_PRODUCT AP ON AP.BANK_ACCOUNT_ID = BH.ACCOUNT_ID AND AP.PRODUCT_ID = BH.PRODUCT_ID AND AP.EFFECTSTATUS = '1'
		LEF	</td><td style='mso-number-format:'@';'>2892	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>142	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b6e7d40cf9c2c393e4e4188f402cac9c	</td><td style='mso-number-format:'@';'>SELECT BA.BANK_ACCOUNT_ID
