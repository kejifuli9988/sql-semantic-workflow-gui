		null WXFXZYXX,
		null INTE	</td><td style='mso-number-format:'@';'>27954	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>17	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>d643d0109223c69cec0d5f7734c286d8	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id AND pt.effectstatus = '1') hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CENTER_FLAG, 	</td><td style='mso-number-format:'@';'>27159	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>18	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>223129483bbf939373ae289fbed229e3	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   ) 
                AND NOT EXISTS(
                   	SELECT 1
					  FROM CheckUnuseProduct c
					 WHERE  BA.PRODUCT_ID = c.PRODUCT_ID
                   )
		) T	</td><td style='mso-number-format:'@';'>23536	</td><td style='mso-number-format:'@';'>9	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>19	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>34727f8929a14dffc68abd1d5270228f	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT T.MARKET,
		(SELECT PP.PRODUCT_NAME
		FROM PRODUCT PP
		WHERE T.PRODUCT_ID = PP.PRODUCT_ID
		AND PP.EFFECTSTATUS = '1') AS PRODUCTNAME,
		T.ZQZH,
		T.SJJS,
		T.JSRQ,
		T.SIUATIONEXPLAIN,
		OPDCONFIRMSTATUS,
		TO_CHAR(T.SIUATION_DATE, 'yyyy-MM-dd HH24:mi:ss') AS SIUATIONDATE,
		(SELECT D.YHMC
		FROM IP_STAFF_STMT D
		WHERE T.SIUATION_BY = D.YHBH) AS SIUATIONBY,
		T.PKID
		FROM (SELECT '上海' AS MARKET,
		SA.PRODUCT_ID,
		JS.ZQZH AS ZQZH,
		TO_CHAR(JS.SJSF) AS SJJS,
		JS.JSRQ AS JSRQ,
		JS.PK_ID AS PKID,
		NVL(CM.OPD_CONFIRM_STATUS, 'WQR') AS OPDCONFIRMSTATUS,
		CM.SIUATION_EXPLAIN AS SIUATIONEXPLAIN,
		CM.SIUATION_DATE,
		CM.SIUATION_BY,
		CM.OPD_BRANCH AS SIUATIONBRANCH
		FROM JSMX JS
		LEFT JOIN SECURITY_ACCOUNT SA ON (JS.ZQZH = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1')
		LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JS.PK_ID = CM.RELATION_ID
		WHERE JS.JYFS != '106'
		AND JS.JSFS = '002'
		and js.filename not like 'jsmx03%'
		AND JS.JSRQ >= TO_CHAR(cast(? as timestamp), 'yyyyMMdd')
		AND JS.JSRQ < TO_CHAR(cast(? as timestamp) + 1, 'yyyyMMdd')
		 
		 
		UNION ALL
		SELECT '深圳' AS MARKET,
		SA.PRODUCT_ID,
		JSZ.MXZQZH AS ZQZH,
		TO_CHAR(JSZ.MXSFJE) AS SJJS,
		JSZ.MXJSRQ AS JSRQ,
		JSZ.PK_ID AS PKID,
		NVL(CM.OPD_CONFIRM_STATUS, 'WQR') AS OPDCONFIRMSTATUS,
		CM.SIUATION_EXPLAIN AS SIUATIONEXPLAIN,
		CM.SIUATION_DATE,
		CM.SIUATION_BY,
		CM.OPD_BRANCH AS SIUATIONBRANCH
		FROM SJSMX JSZ
		LEFT JOIN SECURITY_ACCOUNT SA ON (TRIM(JSZ.MXZQZH) = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1')
		LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JSZ.PK_ID = CM.RELATION_ID
		WHERE JSZ.MXJSFS = 'N'
		AND JSZ.MXJSRQ >= TO_CHAR(cast(? as timestamp), 'yyyyMMdd')
		AND JSZ.MXJSRQ < TO_CHAR(cast(? as timestamp )+ 1, 'yyyyMMdd')
		and jsz.filename not like 'SJSMX2%'
		 
		  ) T
		ORDER BY decode(T.OPDCONFIRMSTATUS, 'WQR', 0, 5) ) row_ ) where rownum_ > 0 and rownum_ <= 20	</td><td style='mso-number-format:'@';'>22521	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>20	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a18849e10c326030bf534b1d17b627c0	</td><td style='mso-number-format:'@';'>delete from CSBS_SUMMARY_STATEMENT where CREATE_DATE = ?	</td><td style='mso-number-format:'@';'>19384	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>21	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>66922160801ac718a6f8d6c3fa87b157	</td><td style='mso-number-format:'@';'>with
		apba as(
		select
		ap.product_id,
		ba.bank_account_id bank_account_id,
		ba.currency bz
		from
		account_product ap,
		bank_account ba
		where
		ap.bank_account_id = ba.bank_account_id
