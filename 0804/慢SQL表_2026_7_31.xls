				update INSTRUCTION_INFOEM
				 SET INSTRUCTION_ID = ?,
					 INSTRUCTION_STATUS = ?,
		</td><td style='mso-number-format:'@';'>2771	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>150	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>ec6fae852cca8958e2b8c36d10ac13f8	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT rownum, t2.product_code, t2.product_name, t2.payment_type_name, t2.debit_account, t2.amount, t2.cashflow_at, t2.credit_account FROM (SELECT p.product_code, p.product_name, pt.payment_type_name, sc.debit_account, sc.amount, sc.cashflow_at, sc.credit_account FROM (SELECT i.debit_account, i.amount, to_char(i.payment_date, 'yyyyMMdd') cashflow_at, i.credit_account, i.payment_type_id, i.product_id FROM instruction i, product p WHERE i.debit_account IN ('051010177599010120', '051010163499000174', '051010163470100148') AND i.inter_bank = '1' AND p.product_id = i.product_id AND i.payment_status = '3' AND i.payment_date >= ? AND i.payment_date <= ? UNION ALL SELECT i.debit_account, i.amount, to_char(i.payment_date, 'yyyyMMdd') cashflow_at, i.credit_account, i.payment_type_id, i.product_id FROM instruction i, product p WHERE substr(debit_account, -8, 6) IN ('710001', '720003', '740001', '750001', '760001', '770001', '790001', '790002', '800001', '780001', '780002') AND i.inter_bank = '1' AND p.product_id = i.product_id AND i.payment_status = '3' AND i.payment_date >= ? AND i.payment_date <= ?) sc, product p, payment_type pt WHERE p.product_id = sc.product_id AND p.effectstatus = '1' AND pt.effectstatus = '1' AND pt.payment_type_id = sc.payment_type_id ORDER BY p.product_code DESC, sc.debit_account DESC) t2 ) row_ ) where rownum_ > 0 and rownum_ <= 20	</td><td style='mso-number-format:'@';'>2766	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>151	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>dbd23ab629da60702f39375ead325928	</td><td style='mso-number-format:'@';'>select
		count(accountId)
		from (
		SELECT *
		FROM (
		SELECT
		gg.bank_account_id AS accountId,
		gg.bank_account_name AS accountName,
		gg.IND_BRANCHID AS indBranchId,
		i.JGMC AS indBranchName,
		COALESCE(gg.BANK_ID, d.BANK_ID) AS bankId,
		COALESCE(gg.BANK_NAME, d.BANK_NAME) AS bankName,
		gg.ACCOUNT_TYPE_ID AS accountTypeId,
		at.ACCOUNT_TYPE_NAME AS accountTypeName,
		gg.AREA_DISTRICT AS areaDistrict,
		gg.currency AS currency,
		aa.mbtmz AS currencyName,
		gg.DEDICATED AS dedicated,
		CASE WHEN gg.DEDICATED = '0' THEN '共用' ELSE '独用' END AS dedicatedName,
		gg.EFFECTSTATUS AS effectstatus,
		ac.mbtmz AS effectstatusName,
		gg.ACCOUNT_ATTRIBUTE AS accountAttribute,
		gg.FOUREYESSTATUS AS foureyesstatus
		FROM bankAccAndUnuseAcc gg
		JOIN ACCOUNT_TYPE at ON at.ACCOUNT_TYPE_ID = gg.ACCOUNT_TYPE_ID
		LEFT JOIN IP_UNIT_STMT i ON i.ZJ = gg.IND_BRANCHID AND i.EFFECTSTATUS = '1'
		LEFT JOIN UNIT_BANK d ON gg.AREA_DISTRICT = d.DQDH || d.JGDH
		LEFT JOIN ip_codeinfo aa ON aa.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000003' AND aa.mblxbh = gg.currency
		LEFT JOIN ip_codeinfo ac ON ac.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000008' AND ac.mblxbh = gg.EFFECTSTATUS
		WHERE at.effectstatus = '1'
		 
			and (gg.ACCOUNT_TYPE_ID != 'CKZH' or   gg.ACCOUNT_TYPE_ID is null)
		 
		 
		 
			and gg.IND_BRANCHID in (select uib.branchid FROM user_info_branch uib WHERE uib.userid=? and uib.EFFECTSTATUS = '1')
		 
		 
		 
		 
		 
			union all
			select
			gg.bank_account_id as accountId,
			gg.bank_account_name as accountName,
			gg.IND_BRANCHID as indBranchId,
			(select i.JGMC from IP_UNIT_STMT i where i.ZJ = gg.IND_BRANCHID and i.EFFECTSTATUS='1') as indBranchName,
			gg.bank_id as bankId,
			gg.bank_name as bankName,
			gg.ACCOUNT_TYPE_ID as accountTypeId,
			at.ACCOUNT_TYPE_NAME as accountTypeName,
			gg.AREA_DISTRICT as areaDistrict,
