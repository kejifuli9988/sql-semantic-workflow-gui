			z.INSTRUCTION_ID
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
			 
		from
		instruction z
		left join product prot
		on z.product_id = prot.product_id
