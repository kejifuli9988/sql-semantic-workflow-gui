				  AND 	</td><td style='mso-number-format:'@';'>2229	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>194	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7e97bc1d7040ba898d25aeae3f7d8fbf	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT *
		FROM (
		SELECT
		gg.bank_account_id AS accountId,
		gg.bank_account_name AS accountName,
		gg.IND_BRANCHID AS indBranchId,
		i.JGMC AS indBranchName,
		COALESCE(gg.BANK_ID, d.BANK_ID) AS bankId,
		COALESCE(gg.BANK_NAME, d.BANK_NAME) AS bankName,
		gg.ACCOUNT_TYPE_ID AS accountTypeId,
		at.ACCOUNT_TYPE_NAME AS accountTypeName,
		gg.AREA_DISTRICT AS areaDistrict,
		gg.currency AS currency,
		aa.mbtmz AS currencyName,
		gg.DEDICATED AS dedicated,
		CASE WHEN gg.DEDICATED = '0' THEN '共用' ELSE '独用' END AS dedicatedName,
		gg.EFFECTSTATUS AS effectstatus,
		ac.mbtmz AS effectstatusName,
		gg.ACCOUNT_ATTRIBUTE AS accountAttribute,
		gg.FOUREYESSTATUS AS foureyesstatus
		FROM bankAccAndUnuseAcc gg
		JOIN ACCOUNT_TYPE at ON at.ACCOUNT_TYPE_ID = gg.ACCOUNT_TYPE_ID
		LEFT JOIN IP_UNIT_STMT i ON i.ZJ = gg.IND_BRANCHID AND i.EFFECTSTATUS = '1'
		LEFT JOIN UNIT_BANK d ON gg.AREA_DISTRICT = d.DQDH || d.JGDH
		LEFT JOIN ip_codeinfo aa ON aa.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000003' AND aa.mblxbh = gg.currency
		LEFT JOIN ip_codeinfo ac ON ac.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000008' AND ac.mblxbh = gg.EFFECTSTATUS
		WHERE at.effectstatus = '1'
		
		 
			and (gg.ACCOUNT_TYPE_ID != 'CKZH' or   gg.ACCOUNT_TYPE_ID is null)
		 
		 
		 
		 
		 
			and ((gg.IND_BRANCHID in (select uib.branchid FROM user_info_branch uib WHERE uib.userid=? and uib.EFFECTSTATUS = '1')) OR
			EXISTS (SELECT 1 FROM IP_STAFF_STMT IP, SAD_CC S WHERE S.BRANCHID = IP.SSJG AND IP.YHBH = ? AND S.RANGE IN (SUBSTR(gg.bank_account_id,0,2), SUBSTR(gg.bank_account_id,0,5))))
		 
		 
		 
		) t
		where 1=1
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		order by accountId,accountTypeId ) row_ ) where rownum_ > 0 and rownum_ <= 10	</td><td style='mso-number-format:'@';'>2226	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>195	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>3cce3a612a22a1bea3c3f2adf4f2643f	</td><td style='mso-number-format:'@';'>SELECT
			 sc.cashflow_id,
			 sc.product_id,
			 sc.account_id,
			 sc.account_type_id,
			 sc.cashflow_at,
			 sc.cashflow_time,
			 sc.counter_cashflow,
			 sc.credit_account,
			 sc.credit_account_name,
			 sc.debit_account,
			 sc.debit_account_name,
			 sc.direction,
			 sc.amount,
			 sc.balance_before,
			 sc.balance_after,
			 sc.currency,
			 sc.transaction_code,
			 sc.summary,
			 sc.message,
			 sc.remark,
			 nvl(sc.updated_at, sc.created_at) updated_at,
			 sc.use_info
		FROM SETTLEMENT_CASHFLOW SC
		INNER JOIN SHARED_ACCOUNT_WORKING_DATE SAWD
		ON SC.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID AND SC.CASHFLOW_AT = TO_DATE(SAWD.WORKING_DATE,'yyyyMMdd')
		INNER JOIN BANK_ACCOUNT BA
		ON SC.ACCOUNT_ID = BA.BANK_ACCOUNT_ID
		WHERE SC.CASHFLOW_AT BETWEEN  CAST( ? AS TIMESTAMP) AND   CAST( ? AS TIMESTAMP)
		AND SC.SUMMARY = '591'
		AND BA.DEDICATED = '0'
		  AND NOT EXISTS (SELECT 1 FROM CORE_CASHFLOW_RETURN R
	             WHERE SC.ACCOUNT_ID = R.ACCOUNT_ID
	               AND SC.CASHFLOW_AT = R.CASHFLOW_AT
	               AND SC.CASHFLOW_TIME = R.CASHFLOW_TIME
	               AND SC.DIRECTION = R.DIRECTION
	               AND SC.AMOUNT = R.AMOUNT
	               AND SC.COUNTER_CASHFLOW = R.COUNTER_CASHFLOW
	               AND (SC.CREDIT_ACCOUNT = R.CREDIT_ACCOUNT OR (SC.CREDIT_ACCOUNT IS NULL AND R.CREDIT_ACCOUNT IS NULL))
	               AND (SC.DEBIT_ACCOUNT = R.DEBIT_ACCOUNT OR (SC.DEBIT_ACCOUNT IS NULL AND R.DEBIT_ACCOUNT IS NULL)))

		UNION ALL


		SELECT
			sch.cashflow_id,
			sch.product_id,
			sch.account_id,
			sch.account_type_id,
			sch.cashflow_at,
			sch.cashflow_time,
			sch.counter_cashflow,
			sch.credit_account,
			sch.credit_account_name,
			sch.debit_account,
			sch.debit_account_name,
			sch.direction,
			sch.amount,
			sch.balance_before,
			sch.balance_after,
			sch.currency,
			sch.transaction_code,
			sch.summary,
			sch.message,
			sch.remark,
			nvl(sch.updated_at, sch.created_at) updated_at,
			sch.use_info
		FROM settlement_cashflow_his	</td><td style='mso-number-format:'@';'>2224	</td><td style='mso-number-format:'@';'>54	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>196	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>00af274d4fe5a53f06dbf0e3a5cc1933	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select * from ( SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, p.product_code cpdm, p.product_name cpmc, p.glr, p.manager_id, (SELECT ip.jgmc FROM ip_unit_stmt ip WHERE ip.zj = p.opd_branchid) cpyyjg, p.operation_mode cpyyms, p.opd_branchid opdbranchid, p.ind_branchid indBranchid, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_	</td><td style='mso-number-format:'@';'>2218	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>197	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>09ba7f2cf90d0e88f0c87397b6418801	</td><td style='mso-number-format:'@';'>SELECT
        wm_concat(isf.yhmc) AS HSLXR,
