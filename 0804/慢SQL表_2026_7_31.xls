        balance_history_id AS balanceHistoryId,
        product_id AS productId,
        account_id AS accountId,
        account_type_id AS accountTypeId,
        balance_date AS balanceDate,
        amount AS amount,
        created_at AS createdAt,
        created_by AS createdBy,
        updated_at AS updatedAt,
        updated_by AS updatedBy,
        usable_balance AS usableBalance,
        control_balance AS controlBalance,
        freeze_balance AS freezeBalance
        FROM
        BALANCE_HISTORY
        WHERE
        balance_date = trunc(cast(? as timestamp))
        ORDER BY balance_history_id ) row_ ) where rownum_ > 0 and rownum_ <= 1000	</td><td style='mso-number-format:'@';'>2542	</td><td style='mso-number-format:'@';'>54	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>163	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7632365dac6660e8649d289dd2bb14d6	</td><td style='mso-number-format:'@';'>select
