		       CRE	</td><td style='mso-number-format:'@';'>3547	</td><td style='mso-number-format:'@';'>14	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>114	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>76239a5add068a2ab845b5d15fdf8f58	</td><td style='mso-number-format:'@';'>SELECT T.BALANCE_ID,
