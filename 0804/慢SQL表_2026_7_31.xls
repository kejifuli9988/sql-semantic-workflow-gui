		USING (
		select cc.cashflow_id,
		cc.product_id,
		cc.account_id,
		cc.account_type_id,
		cc.cashflow_at,
		cc.cashflow_time,
		cc.counter_cashflow,
		cc.credit_account,
		cc.credit_account_name,
		cc.debit_account,
		cc.debit_account_name,
		cc.direction,
		cc.amount,
		cc.balance_after,
		cc.currency,
		cc.transaction_code,
		cc.summary,
		cc.use_info as message,
		cc.djsm,
		cc.remark,
		cc.bank_no,
		cc.bank_name,
		cc.pzqfrq as created_at,
		cc.cpzxh,
		cc.cpznxh,
		cc.core_cashflow_id,
		cc.transaction_org_code as trade_org_code,
		cc.postal_choose as post_route_choose,
		cc.jydqdh as trade_area_code,
		sysdate as updated_at,
		cc.xtsjc
		from core_cashflow cc
		where cc.batch_num = ?
		) b
		 
			on (sch.account_id = b.account_id and sch.cashflow_at = b.cashflow_at and sch.cpzxh = b.cpzxh
			and sch.cpznxh = b.cpznxh and sch.direction = b.direction and sch.amount = b.amount and sch.counter_cashflow = b.counter_cashflow
			and (sch.credit_account = b.credit_account or (sch.credit_account is null and b.credit_account is null))
			and (sch.debit_account = b.debit_account or (sch.debit_account is null and b.debit_account is null))
			and b.cashflow_at between ? and ?)
		 
		 
		when matched then
		update set
		sch.product_id = b.product_id,
		sch.updated_at = b.updated_at
		where sch.product_id is null
		when not matched then
		insert
		(CASHFLOW_ID,
		PRODUCT_ID,
		ACCOUNT_ID,
		ACCOUNT_TYPE_ID,
		CASHFLOW_AT,
		CASHFLOW_TIME,
		COUNTER_CASHFLOW,
		CREDIT_ACCOUNT,
		CREDIT_ACCOUNT_NAME,
		DEBIT_ACCOUNT,
		DEBIT_ACCOUNT_NAME,
		DIRECTION,
		AMOUNT,
		BALANCE_AFTER,
		CURRENCY,
		TRANSACTION_CODE,
		SUMMARY,
		MESSAGE,
		REMARK,
		USE_INFO,
		BANK_NO,
		BANK_NAME,
		CREATED_AT,
		CPZXH,
		CPZNXH,
		CORE_CASHFLOW_ID,
		TRADE_ORG_CODE,
		POST_ROUTE_CHOOSE,
		TRADE_AREA_CODE,
		UPDATED_AT)
		values
		(b.cashflow_id,
		b.product_id,
		b.account_id,
		b.account_type_id,
		b.cashflow_at,
		b.cashflow_time,
		b.counter_cashfl	</td><td style='mso-number-format:'@';'>3360	</td><td style='mso-number-format:'@';'>347	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>120	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>4af23ebc9c030a8bcee186091d370182	</td><td style='mso-number-format:'@';'>SELECT
             PK_ID
            ,BANK_ACCOUNT_ID
            ,BANK_ACCOUNT_NAME
            ,MANAGER_ID
            ,CORE_CUST_ID
            ,TRUSTEE_ID
            ,PROJECT_ID
            ,EFFECTSTATUS
            ,OP_TYPE
            ,FOUREYESSTATUS
            ,AUDIT_COMMENT
            ,CREATED_AT
            ,CREATED_BY
            ,UPDATED_AT
            ,UPDATED_BY
            ,VALIDATED_AT
            ,VALIDATED_BY
            ,PUSH_STATE  
        FROM UNUSE_ACCT_INF_CI
        WHERE BANK_ACCOUNT_ID = ?
        AND CREATED_AT = (SELECT MAX(ci.CREATED_AT) FROM UNUSE_ACCT_INF_CI ci WHERE ci.BANK_ACCOUNT_ID = ?)	</td><td style='mso-number-format:'@';'>3341	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>121	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>40879fa069ea3676f2c7ef899fef6be6	</td><td style='mso-number-format:'@';'>select PK_ID1, DEAL_ID,
		INSTR_ID, BUSINESS_ID, PRODUCT_ID, PRODUCT_NAME, MANAGER_ID,
		MANAGER_NAME, OPD_BRANCH_ID, ACCOUNT_ID, ACCOUNT_NAME, ACCOUNT_TYPE,
		COUNTER_ACCOUNT_ID, COUNTER_ACCOUNT_NAME, BUSINESS_TYPE, INSTR_STATUS,
		COUNTER_STATUS, OUR_STATUS, OP_TYPE, NOTE_FLAG, AUTOCONFIRM_FLAG,
		NOTE_ID, RECORD_STATUS, FOUREYESSTATUS, AUDIT_COMMENT,BOND_COUNT,DELIVER_DATE1,DELIVER_DATE2, CREATED_AT,
		CREATED_BY, UPDATED_AT, UPDATED_BY, VALIDATED_AT, VALIDATED_BY ,MARKET_TYPE, INIT_SETTLE_AMOUNT, DUE_SETTLE_AMOUNT
		,SUPERVISION_SIGN,SUPERVISION_OPINION,BANK_ACCOUNT_ID
		from
		CSBS_INSTRUCTION a where 
		 	((a.OUR_STATUS = 'IC02' and a.account_type = '1') or (a.counter_status = 'IC02' and a.account_type = '2')) 
		 	and a.RECORD_STATUS = '0' 
		 	and a.NOTE_FLAG = '0' 
		 	and a.AUTOCONFIRM_FLAG = '0' 
		 	and a.instr_status ='IS03'
		 	and a.market_type='0'
		 	and (a.DELIVER_DATE1 >= to_char(sysdate, 'yyyyMMdd')  or  trunc(a.CREATED_AT) >= trunc(sysdate))
		 	   
		and not exists(
		select 1 
		from csbs_instr_config
	   where (account_no=account_id or account_no=counter_account_id)
	  	 and market=market_type)	</td><td style='mso-number-format:'@';'>3315	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>122	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c854dbd01dbebdae5a50b77dc993239c	</td><td style='mso-number-format:'@';'>merge into (select * from settlement_cashflow_history where account_type_id = 'zqzh0000002') sch using(
		   
