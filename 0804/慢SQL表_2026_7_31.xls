        CI.SUPERVISION_OPINION,
        CI.BANK_ACCOUNT_ID,
        CI.ARCHIVED_STATUS,
        CI.ARCHIVED_DATE,
        CI.ARCHIVED_PACKAGE,
        (select ip.jgmc from ip_unit_stmt ip where ip.zj = (select p.opd_branchid from product p where p.product_id = CI.product_id)) cpyyjg,
        ba.BANK_ACCOUNT_NAME as bankAccountName,
        CI.TRADE_SUBCAT_ID,
