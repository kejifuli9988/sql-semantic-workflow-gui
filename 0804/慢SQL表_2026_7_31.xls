		where aa.zj = z.branch_id
		and aa.effectstatus = '1') as branch_name,
		(select aa.jgmc
		from ip_unit_stmt aa
		where aa.zj = z.ind_branch_id
		and aa.effectstatus = '1') as ind_branch_name,
		manager_id as managerIds,
		(case payment_type_id when 'FYZF03' then to_char(get_values(z.manager_id)) else manager_id end) manager_id,
		(case payment_type_id when 'FYZF03' then get_names(z.manager_id,'manager') else (select d.external_agency_name
		from external_agency d
		where d.effectstatus = '1'
		and z.manager_id = d.external_agency_id) end) as managername,
		effectstatus,
