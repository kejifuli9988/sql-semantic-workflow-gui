ated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg	</td><td style='mso-number-format:'@';'>2026	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>216	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>95d1d2b7027ec47766ee977abca48a0f	</td><td style='mso-number-format:'@';'>DELETE FROM TASK_LOG WHERE DTIME BETWEEN to_date('2026/07/21','yyyy/MM/dd') AND to_date('2026/07/28','yyyy/MM/dd') AND ROWNUM <=2000	</td><td style='mso-number-format:'@';'>2007	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr></table></body></html>