		set interface_status = ?,xxrq = ? 
		where created_at=
		(select max(created_at) from  product_ci where product_code = ? )	</td><td style='mso-number-format:'@';'>3403	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>117	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>9c345f7a69995d981e8e85999aa0c975	</td><td style='mso-number-format:'@';'>SELECT T.ACCOUNT_ID AS "accountId",
	  		 T.PRODUCT_ID AS "productId",
	  		 T.CASHFLOW_AT AS "cashflowAt"
	   FROM (
		SELECT CCA.ACCOUNT_ID,
		       CCA.PRODUCT_ID,
			   CCA.CASHFLOW_AT
		  FROM CORE_CASHFLOW_ACCOUNT CCA
		 WHERE CCA.CASHFLOW_AT BETWEEN ? AND ?
		   AND CCA.BALANCE_FLAG = '3'
		   AND EXISTS
		    (  
            	SELECT 1 FROM DUAL WHERE 1=1
                 AND CCA.PRODUCT_ID = ? 
                 AND CCA.ACCOUNT_ID = ? 
            ) ) T
      ORDER BY T.CASHFLOW_AT, T.PRODUCT_ID, T.ACCOUNT_ID	</td><td style='mso-number-format:'@';'>3399	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>118	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>065f8042bc0bcf540da8805bffce758c	</td><td style='mso-number-format:'@';'>select 
          	record_id
         from 
         faxemail_send_history  ssh,
         faxemail_config_report fcr
         where ssh.updated_at >= trunc(?) and ssh.updated_at < trunc(?)+1
         and fcr.faxemail_send_history_id = ssh.record_id
         and fcr.config_id = ?
         and fcr.file_type = ?
