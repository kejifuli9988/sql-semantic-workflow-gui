        from CSBS_INSTRUCTION CI
        left join bank_account ba on ci.BANK_ACCOUNT_ID = ba.bank_account_id
        where 1=1
         
         
         
            and (
            CI.CREATED_AT >= trunc(cast(? as timestamp)) and CI.CREATED_AT <trunc(cast(? as timestamp))+1
            or
            CI.DELIVER_DATE1 between to_char(cast(? as timestamp),'yyyymmdd') and to_char(cast(? as timestamp),'yyyymmdd')
            )
         
         
         
         
         
         
         
            and DEAL_ID like '%'||?||'%'
         
         
         
         
         
         
         
         

         

        
         
         
         
         
         
         
         
         
            
            and (
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NULL)
            OR
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NOT NULL and exists (
            SELECT IP.YHBH FROM ip_staff_stmt ip,SAD_CC S
            WHERE S.BRANCHID = ip.ssjg
            AND ip.yhbh = ?
            AND S.RANGE IN (
            SUBSTR( ci.bank_account_id,0,2),
            SUBSTR( ci.bank_account_id,0,5) )
             
        AND EXISTS (
                select 1
				from (
					select a.bank_account_id,
						pro.PRODUCT_ID,
						pro.ind_branchid as ind_branchid,
						ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN
					from auxiliary_product a
					inner join product pro on pro.product_id = a.product_id
					where a.effectstatus = '1' AND a.BANK_ACCOUNT_ID = ci.BANK_ACCOUNT_ID AND pro.IND_BRANCHID = S.BRANCHID
				) aup
				where aup.rown = 1
            )
     
            UNION ALL
            SELECT IP.YHBH FROM sad_bow sb, ip_staff_stmt ip
            WHERE ip.yhbh = ?
            AND sb.effectstatus = '1'
            AND ip.ssjg = sb.branchid
            AND sb.borwlist = '1'
            AN	</td><td style='mso-number-format:'@';'>4905	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>84	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>11a3684cb935686b714104768e49e290	</td><td style='mso-number-format:'@';'>BEGIN
        DBMS_STATS.GATHER_TABLE_STATS(?,?);
        END;	</td><td style='mso-number-format:'@';'>4800	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>85	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c7e338a5c3411b0a2c601adc94b57d92	</td><td style='mso-number-format:'@';'>select *  from (
		select pk_id pkId, security_code securityCode
			from trans_info t
			where t.TRADE_DATE = to_char(cast(? as timestamp), 'yyyyMMdd')
				 
				 
				 and t.source = '1' 
				 and exists (
					     select 1 from ip_codeinfo a, ip_codetype b 
						  where a.sjlx = b.zj
							and b.SJLXBH = 'sourceCode' 
							and a.MBLXBH||'-'||t.seq_no = ?
							and t.source_code = a.MBTMZ)
				 
				  AND T.INSTRUCTION_ID IS NULL

		union
			select pk_id pkId, security_code securityCode
			from NONSTANDARD_TRANS_INFO t
			where t.TRADE_DATE = to_char(cast(? as timestamp), 'yyyyMMdd')
			 
			 
				and exists (
				select 1 from ip_codeinfo a, ip_codetype b
				where a.sjlx = b.zj
				and b.SJLXBH = 'sourceCode'
				and a.MBLXBH||'-'||t.seq_no = ?
				and t.manager_id = a.MBTMZ)
			 
			AND T.INSTRUCTION_ID IS NULL
			)
		     where rownum = 1
			 ORDER BY pkId	</td><td style='mso-number-format:'@';'>4698	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>86	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>ca01319472a4c02207cf85f0fed3fa3b	</td><td style='mso-number-format:'@';'>select 
		    round(sum(yjamount),2) yjamount,
		    round(sum(ssamount),2) ssamount,
			round(sum(yjhnlr),2) yjhnlr,
			round(sum(yjkhlr),2) yjkhlr,
			round(sum(yjhnlc),2) yjhnlc,
			round(sum(yjkhlc),2) yjkhlc
		from 
			ipunitposition
		where
			1=1
			and yjamount!=0
			 
			 
			 
			 and sjscrq = ?	</td><td style='mso-number-format:'@';'>4693	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>87	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>d59db128b814f40d37e26eea8ede5ccd	</td><td style='mso-number-format:'@';'>select count(1) from (
			select
	      	  z.ACCOUNT_ID as accountId,
		      z.ACCOUNT_NAME as accountName,
		      z.ACCOUNT_TYPE_ID as accountTypeId,
		      a.account_type_name as accountTypeName,
		      z.SAME_CITY as sameCity,
	      	  z.INTER_BANK as interBank,
		      z.BANK_ID as bankId,
		      z.BANK_NAME as bankName
		      from COUNTERPARTY_ACCOUNT z,USER_INFO_BRANCH d,account_type a
		    where z.branchid=d.branchid
		      and z.effectstatus in 
					 (  
						?
					 ) 
		      and d.effectstatus = '1'
		      and a.effectstatus = '1'
		      and a.account_type_id = z.account_type_id
		       
				    and d.userid = ?
		         
		         
		         
		         
			  and z.ACCOUNT_ID like '%'||?||'%' 
			 
			 
	         
			union
			select 
			      ca.CSDS_ACCOUNT_ID as accountId,
			      ca.account_name as accountName,
			      ca.account_type_id as accountTypeId,
			      aty.account_type_name as accountTypeName,
			      '' as sameCity,
	      		  '' as interBank,
			      '' as bankId,
			      '' as bankName
			from csds_account ca, account_type aty
			where ca.effectstatus in 
					 (  
						?
					 ) 
			  and aty.effectstatus = '1'
			  and aty.account_type_id = ca.account_type_id
			   
			 
			  and ca.CSDS_ACCOUNT_ID like '%'||?||'%' 
			 
				and ca.CSDS_ACCOUNT_ID in (select cap.CSDS_ACCOUNT_ID from csds_account_product cap where cap.PRODUCT_ID = ?)
				 
		         
			 
			 
	         
	         
		)	</td><td style='mso-number-format:'@';'>4658	</td><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>88	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>abb2bada83af8408abababc7ed7c2974	</td><td style='mso-number-format:'@';'>SELECT  ( WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id AND pt.effectstatus = '1') hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CEN	</td><td style='mso-number-format:'@';'>4610	</td><td style='mso-number-format:'@';'>6	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>89	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>553e5d00dacde42c15f97466fd0837de	</td><td style='mso-number-format:'@';'>select
		z.FAX_INSTRUCTION_ID,z.INSTRUCTION_ID,z.FAX_ID,z.PRODUCT_CODE,z.PAYMENT_DATE,z.PAYMENT_TYPE_ID,z.DIRECTION,z.AMOUNT,z.CURRENCY,z.PAYMENT_REASON,z.CREDIT_ACCOUNT,z.CREDIT_ACCOUNT_NAME,z.DEBIT_ACCOUNT,z.DEBIT_ACCOUNT_NAME,z.BANK_ID,z.BANK_NAME,z.sfqd,
		z.FILE_PATH,z.CREATED_AT,z.CREATED_BY,z.UPDATED_AT,z.UPDATED_BY,z.RESULT_STATUS,z.PUSH_STATUS,z.PUSH_AT,z.MANAGER_ID,z.MANAGER_NAME,z.RESULT_TYPE,AUDIT_COMMENT,z.TGT_QDZLBH,nvl(z.BUSINESS_TYPE,'0') BUSINESS_TYPE,
		(select a.yhmc from ip_staff a where z.CREATED_BY=a.yhbh) as createdByName,
		(select b.yhmc from ip_staff b where z.UPDATED_BY=b.yhbh) as updatedByName,
		(SELECT p.product_name FROM product p WHERE p.PRODUCT_CODE=z.PRODUCT_CODE order by p.created_at desc fetch first 1 rows only) as PRODUCT_NAME,
		NVL((SELECT psi.SYSTEM_FLAG FROM product p,prod_switch_info psi WHERE p.product_id = psi.product_id(+) and p.PRODUCT_CODE=z.PRODUCT_CODE order by p.created_at desc fetch first 1 rows only),'1') as systemFlag,
		z.ZLLY,
