        INTO CORE_CASHFLOW_ACCOUNT
          (CASHFLOW_AT,
           ACCOUNT_ID,
           PRODUCT_ID,
           ACCOUNT_TYPE_ID,
           FLAG,
           BALANCE_FLAG,
           CHECK_NUM,
           CREATED_AT,
           UPDATED_AT,
           REMARK,
       PRIORITY)
        WITH ACCPRO AS
         (  SELECT AP.BANK_ACCOUNT_ID, AP.PRODUCT_ID, P.CSDS_SETTLEMENT
                     FROM ACCOUNT_PRODUCT AP, BANK_ACCOUNT BAI, PRODUCT P
                    WHERE AP.BANK_ACCOUNT_ID = BAI.BANK_ACCOUNT_ID
                      AND AP.PRODUCT_ID = P.PRODUCT_ID
                      AND P.EFFECTSTATUS = '1'
                      AND BAI.DEDICATED = '1'
                      AND AP.EFFECTSTATUS = '1'
                      AND NOT exists(
                        select APS.BANK_ACCOUNT_ID
                        from PRODUCT P   , ACCOUNT_PRODUCT APS
                        where P.PRODUCT_ID = APS.PRODUCT_ID
                        and APS.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
                        and P.EFFECTSTATUS = '1'
                        and APS.EFFECTSTATUS = '1'
						
                        -- and P.PRODUCT_TYPE_ID IN ('BXDLJDR', 'DK', 'JGJY', 'ABSZJGJ', 'ZJMJ', 'JGQT')
                        group by APS.bank_account_id having count(APS.bank_account_id)>1 
                     )
                    UNION ALL
                    SELECT AP.BANK_ACCOUNT_ID, AP.PRODUCT_ID, P.CSDS_SETTLEMENT
                     FROM ACCOUNT_PRODUCT AP, PRODUCT P, UNUSE_ACCT_INF UA
                    WHERE AP.PRODUCT_ID = P.PRODUCT_ID
                      AND AP.BANK_ACCOUNT_ID = UA.BANK_ACCOUNT_ID
                      AND AP.EFFECTSTATUS = '0'
                      AND UA.EFFECTSTATUS = '1'
                      AND P.EFFECTSTATUS = '0'
                      )
        SELECT TRUNC(SYSDATE - 1),
               CBA.BANK_ACCOUNT_ID,
               ACCPRO.PRODUCT_ID,
               BA.ACCOUNT_TYPE_ID,
               '1',
               '1',
               '0',
