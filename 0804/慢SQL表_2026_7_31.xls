                   u	</td><td style='mso-number-format:'@';'>6646	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>60	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7ca7d7a64f008b1ede8594aa9d981f43	</td><td style='mso-number-format:'@';'>SELECT T.ACCOUNT_ID AS "accountId",
	  		 T.PRODUCT_ID AS "productId",
	  		 T.CASHFLOW_AT AS "cashflowAt"
	   FROM (
		SELECT CCA.ACCOUNT_ID,
		       CCA.PRODUCT_ID,
			   CCA.CASHFLOW_AT
		  FROM CORE_CASHFLOW_ACCOUNT CCA
		 WHERE CCA.CASHFLOW_AT BETWEEN ? AND ?
		   AND CCA.BALANCE_FLAG = '3'
		   AND EXISTS
		    (  
            	SELECT 1 FROM DUAL WHERE 1=1
                 AND CCA.PRODUCT_ID = ? 
                 AND CCA.ACCOUNT_ID = ? 
            ) ) T
      ORDER BY T.CASHFLOW_AT, T.PRODUCT_ID, T.ACCOUNT_ID	</td><td style='mso-number-format:'@';'>6624	</td><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>61	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>966e97a27e7152d5e5338278c1eae801	</td><td style='mso-number-format:'@';'>select count(1)
        from CSBS_INSTRUCTION CI
        left join bank_account ba on ci.BANK_ACCOUNT_ID = ba.bank_account_id
        where 1=1
         
         
         
            and (
            CI.CREATED_AT >= trunc(cast(? as timestamp)) and CI.CREATED_AT <trunc(cast(? as timestamp))+1
            or
            CI.DELIVER_DATE1 between to_char(cast(? as timestamp),'yyyymmdd') and to_char(cast(? as timestamp),'yyyymmdd')
            )
         
         
         
         
            and product_id IN (SELECT pp.product_code FROM product_info_branch pib,product pp WHERE pib.product_id = pp.product_id and pib.roleid in(SELECT irs.jsbh FROM ip_role_stmt irs WHERE irs.jsmc in('核算经办','分行核算经办')) and pib.userid in
             (  
                ?
             ) 
            ) 
         
         
         
         
         
         
         
         
         
         

         

        
         
         
         
         
         
         
         
         
            
            and (
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NULL)
            OR
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NOT NULL and exists (
            SELECT IP.YHBH FROM ip_staff_stmt ip,SAD_CC S
            WHERE S.BRANCHID = ip.ssjg
            AND ip.yhbh = ?
            AND S.RANGE IN (
            SUBSTR( ci.bank_account_id,0,2),
            SUBSTR( ci.bank_account_id,0,5) )
             
        AND EXISTS (
                select 1
				from (
					select a.bank_account_id,
						pro.PRODUCT_ID,
						pro.ind_branchid as ind_branchid,
						ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN
					from auxiliary_product a
					inner join product pro on pro.product_id = a.product_id
					where a.effectstatus = '1' AND a.BANK_ACCOUNT_ID = ci.BANK_ACCOUNT_ID AND pro.IND_BRANCHID = S.BRANCHID
				) aup
				where aup.rown = 1
 	</td><td style='mso-number-format:'@';'>6533	</td><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>62	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f79dd461332193efbaf3e4002ae8ee08	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH base_instruction AS
