                 and tt.payment_at <= to_date(bcte.resale_reg_end_at, 'yyyy-MM-dd')
                     )) ) 
		and p.opd_branchid in
		 (  
			?
		 )	</td><td style='mso-number-format:'@';'>3008	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>135	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>31a759d958f4b4874275aa3f9577e645	</td><td style='mso-number-format:'@';'>INSERT INTO 
		  		BALANCE
			    (BALANCE_ID,
			     PRODUCT_ID,
			     ACCOUNT_ID,
			     ACCOUNT_TYPE_ID,
			     BALANCE_DATE,
			     AMOUNT,
			     CREATED_AT,
			     CREATED_BY,
			     UPDATED_AT,
			     UPDATED_BY,
			     REMARK)
			SELECT 'BALA99' || TO_CHAR(SYSDATE, 'yyMMdd') || LPAD(BALANCE_SEQ.NEXTVAL, 8, '0'),
		         PRODUCT_ID,
		         CSDS_ACCOUNT_ID,
		         ACCOUNT_TYPE_ID,
		         BALANCE_DATE,
		         AMOUNT,
		         CREATED_AT,
		         CREATED_BY,
		         UPDATED_AT,
		         UPDATED_BY,
		         REMARK
		    FROM (SELECT CAP.PRODUCT_ID,
		                 CAP.CSDS_ACCOUNT_ID,
		                 CAP.ACCOUNT_TYPE_ID,
						 cast(? as timestamp)+1 BALANCE_DATE,
		                 (B.AMOUNT
		                  + (SELECT NVL(SUM(decode(SC.DIRECTION, '0', -SC.AMOUNT, '1', SC.AMOUNT)), 0)
		                            FROM SETTLEMENT_CASHFLOW SC
		                           WHERE SC.PRODUCT_ID = CAP.PRODUCT_ID
		                             AND SC.ACCOUNT_ID = CAP.CSDS_ACCOUNT_ID
		                             AND SC.ACCOUNT_TYPE_ID = CAP.ACCOUNT_TYPE_ID
		                             AND SC.CASHFLOW_AT = cast(? as timestamp)+1)) AMOUNT,
		                 SYSDATE CREATED_AT,
		                 NULL CREATED_BY,
		                 SYSDATE UPDATED_AT,
		                 NULL UPDATED_BY,
		                 NULL REMARK
		            FROM CSDS_ACCOUNT_PRODUCT CAP,BALANCE B
		              WHERE B.PRODUCT_ID = CAP.PRODUCT_ID
		             AND B.ACCOUNT_ID = CAP.CSDS_ACCOUNT_ID
		             AND B.ACCOUNT_TYPE_ID = CAP.ACCOUNT_TYPE_ID
		             AND B.BALANCE_DATE = ?
		             AND CAP.ACCOUNT_TYPE_ID = ?
		             AND CAP.EFFECTSTATUS = '1'
		           UNION ALL
		           SELECT CAP.PRODUCT_ID,
		                 CAP.CSDS_ACCOUNT_ID,
		                 CAP.ACCOUNT_TYPE_ID,
						  cast(? as timestamp)+1 BALANCE_DATE,
		                 (0 + (SELECT NVL(SUM(decode(SC.DIRECTION, '0', -SC.AMOUNT, '1', SC.	</td><td style='mso-number-format:'@';'>3006	</td><td style='mso-number-format:'@';'>47	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>136	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>fca72f58c446682ad18289fe63e61d7f	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select i.*
		from(
		select
		ti.source              as source,
		(CASE
		WHEN TI.source = '0' THEN
		'SG'
		WHEN TI.source = '4' THEN
		'OCR'
		else ti.SOURCE_CODE END)      as sourceCode,
		ti.pk_id               as pkId,
		ti.manager_prod        as managerProd,
		p.PRODUCT_CODE         as productCode,
		ti.org_no              as orgNo,
		ti.seq_no              as seqNo,
		ti.trade_date          as tradeDate,
		ti.confirm_date        as confirmDate,
		ti.trade_direction     as tradeDirection,
		ti.regist_code         as registCode,
		ti.security_type       as securityType,
		ti.security_code       as securityCode,
		ti.security_name       as securityName,
		ti.appmoney            as appmoney,
		ti.appvol              as appvol,
		ti.amount              as amount,
		ti.qrfe                as qrfe,
		ti.trade_fee           as tradeFee,
		ti.interest            as interest,
		ti.volumebyinterest    as volumebyinterest,
		ti.refundamount        as refundamount,
		ti.reciprocal_code     as reciprocalCode,
		ti.reciprocal_quantity as reciprocalQuantity,
		nvl(ti.trade_status, '0000')       as tradeStatus,
		ti.fail_reason         as failReason,
		to_char(to_date( ti.create_time,'yyyy-MM-dd hh24:mi:ss') ,'yyyyMMdd')         as gxrq,
		ti.byzd1               as byzd1,
		ti.byzd2               as byzd2,
		ti.byzd3               as byzd3,
		ti.instruction_id      as byzd4,
		ti.byzd5               as byzd5,
		ti.byzd6               as byzd6,
		ti.byzd7               as byzd7,
		ti.byzd8               as byzd8,
		ti.byzd9               as byzd9,
		ti.byzd10              as byzd10
		from trans_info ti, product p
		where ti.product_id = p.product_id  and ti.product_id is not null
		 and ti.foureyesstatus = '1'
		and NOT EXISTS (SELECT 1 FROM TRANS_INFO T
		WHERE T.PK_ID = TI.PK_ID AND T.SOURCE = '1' AND T.SOURCE_CODE = 'tymh' AND T.SECURITY_TYPE IS NULL)
		and ti.create_time >= to_char(cast(? as timestamp), 'yyyy-mm-dd ')	</td><td style='mso-number-format:'@';'>3003	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>137	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>0e1286b4719172ad7414fcbb064123cf	</td><td style='mso-number-format:'@';'>select qp.*,
