        where PRODUCT_ID IN (
                      SELECT TT.PRODUCT_ID FROM TRUSTFEE_ARREARS_REPORT TT  WHERE  TT.SETTLEMENT_STATUS = '1'
                              or (TT.IS_PAYMENT_DATE_UNKNOWN = '1' AND TT.PAYMENT_FREQUENCY = '4' AND EXISTS(SELECT 1 FROM trustfee_arrears_detail_report T1 WHERE T1.REPORT_ID = TT.PK_ID AND T1.AGING = '0' ) )
                              )	</td><td style='mso-number-format:'@';'>2518	</td><td style='mso-number-format:'@';'>38	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>165	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b3f30f8b264bd0b1268e805722784400	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select * from ( SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2018 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, p.product_code cpdm, p.product_name cpmc, p.glr, p.manager_id, (SELECT ip.jgmc FROM ip_unit_stmt ip WHERE ip.zj = p.opd_branchid) cpyyjg, p.operation_mode cpyyms, p.opd_branchid opdbranchid, p.ind_branchid indBranchid, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.f	</td><td style='mso-number-format:'@';'>2516	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>166	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>ffaf8dbb0c27286e3182825be0c5f436	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select * from ( SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2020 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, p.product_code cpdm, p.product_name cpmc, p.glr, p.manager_id, (SELECT ip.jgmc FROM ip_unit_stmt ip WHERE ip.zj = p.opd_branchid) cpyyjg, p.operation_mode cpyyms, p.opd_branchid opdbranchid, p.ind_branchid indBranchid, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.f	</td><td style='mso-number-format:'@';'>2511	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>167	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>0ce1a2e5e92899459eda1b8d7b851229	</td><td style='mso-number-format:'@';'>with base_instruction as
        (
        select
        z.instruction_id,
        (CASE
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ13','TZZQ16')) THEN
        nvl((select (case when rtgs.shch_stop_status = '1' then '9' else rtgs.shch_draw_status end) ||'#@@#'|| by3 shch_draw_status from RTGS_COLLECTION_RECORD_1 rtgs where rtgs.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ12', 'TZZQ17')) THEN
        nvl((select c.ccdc_draw_status shch_draw_status from CCDC_COLLECTION_RECORD c where c.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN  (z.PAYMENT_TYPE_ID ='TZCK10') THEN
        nvl((select INSTRUCTION_PARAM_VALUE from instruction_ext where instruction_id =  z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME ='hqckWithDraw'),'')
        ELSE
        ''
        END) AS shchDrawStatus,
        z.product_id,
        z.REALTIME_STATUS,
        z.use_id,
        z.payment_date,
        z.payment_at,
        z.successful_paid_at,
        z.payment_type_id,
        (select pt.payment_type_name from payment_type pt
        where pt.payment_type_id = z.payment_type_id
        and pt.effectstatus = '1') hkmc,
        z.direction,
        z.amount,
        z.source_id,
        z.payment_reason,
        z.debit_account,
        z.debit_account_name,
        z.credit_account,
        z.credit_account_name,
        z.bank_id,
        z.bank_name,
        z.db_status,
        z.ANO_SYS_STAT,
        z.batch,
        z.IPO_SUBSCRIBE,
        z.entrust,
        z.security_code,
        z.payment_mode,
        z.inter_bank,
        decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) as finalStatusOrder,
        z.final_paymentstatus,
        z.payment_status,
        (select ip.yhmc from ip_staff_stmt ip where ip.yhbh = z.updated_by) updatedbyname,
        z.updated_at,
        z.created_at,
        (select ip.yhmc from ip_staff_stmt ip where ip.yhbh = z.instr_jbr) ins	</td><td style='mso-number-format:'@';'>2475	</td><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>168	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>5934efca7e6396defeaaa7b5da256099	</td><td style='mso-number-format:'@';'>select qp2.* from (
		select qp.*,
			   (SELECT p.PRODUCT_CODE FROM product p WHERE p.effectstatus = '1' AND p.PRODUCT_ID = ?) AS PRODUCT_CODE,
			   decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT,
			   get_ids(qp.product_id) as ids
	      from qhld_parameter qp
	     WHERE qp.effectstatus = '1'
	     	AND qp.TERMINATE_FLAG != '1'
	       AND exists (select pc2.code_id
        from (select pc.code_id,pc.para_key,pkg_pub.get_containt_items(?,pc.code_id) as con
        from para_code pc) pc2
        where pc2.para_key = qp.PRODUCT_ID
        and pc2.con is not null)
          and qp.PAYMENT_TYPE_ID = ? 
         
	    ) qp2
        where qp2.ids is not null	</td><td style='mso-number-format:'@';'>2466	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>169	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>3edc0818f2a425491dce8c981a129e0b	</td><td style='mso-number-format:'@';'>insert into TRUSTFEE_ARREARS_REPORT_HISTORY
        select TT.* from TRUSTFEE_ARREARS_REPORT TT
        WHERE  TT.SETTLEMENT_STATUS = '1'
         or (TT.IS_PAYMENT_DATE_UNKNOWN = '1' AND TT.PAYMENT_FREQUENCY = '4' AND EXISTS(SELECT 1 FROM TRUSTFEE_ARREARS_DETAIL_REPORT T1 WHERE T1.REPORT_ID = TT.PK_ID AND T1.AGING = '0' ) )	</td><td style='mso-number-format:'@';'>2442	</td><td style='mso-number-format:'@';'>38	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>170	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f89d7d1447f22784c07ad920ea31ce7a	</td><td style='mso-number-format:'@';'>SELECT COUNT(*)
       FROM (
          SELECT
                 T.PK_ID
                  ,T.PRODUCT_ID
                  ,T.FIRST_UNPAID_DATE
                  ,T.RETURNED_AMOUNT
                  ,T.SETTLEMENT_STATUS
                  ,T.PAYMENT_FREQUENCY
                  ,T.SETTLEMENT_DATE
                  ,T.SETTLEMENT_TYPE
                  ,T.SETTLEMENT_REASON
                  ,T.PAID_BILLING_END_DATE
                  ,T.TRANSFER_DATE
                  ,T.TRANSFER_LONG_TERM_DUN_TYPE
                  ,T.TRANSFER_LONG_TERM_DUN_DETAIL_REASON
                  ,T.TRANSFER_LONG_TERM_DUN_AMOUNT
                  ,TA.REPORT_ID
                  ,TA.BUSINESS_DATE
                  ,TA.AGING
                  ,TA.UNPAID_TRUSTFEE_DATE
                  ,TA.UNPAID_TRUSTFEE_DATE_AMOUNT
                  ,TA.UNPAID_TRUSTFEE_AMOUNT
                  ,TA.SETTLEMENT_HANDLER_ID
                  ,TA.SETTLEMENT_HANDLER_NAME
                  ,TA.LAST_PAY_DATE_ACC_BALANCE
                  ,TA.SPECIAL_PAY_TERMS_TYPE
                  ,TA.OPD_UNPAID_TRUSTFEE_TYPE
                  ,TA.OPD_UNPAID_TRUSTFEE_DETAIL_REASON
                  ,TA.MARKETING_UNPAID_TRUSTFEE_TYPE
                  ,TA.MARKETING_UNPAID_TRUSTFEE_DETAIL_REASON
                  ,TA.IS_OPD_BRANCH_SEND_DUNLTR
                  ,TA.OPD_BRANCH_LAST_DUNLTR_DATE
                  ,TA.OPD_BRANCH_MANAGER_FEEDBACK_TYPE
                  ,TA.OPD_BRANCH_MANAGER_FEEDBACK_DETAIL
                  ,TA.OPD_BRANCH_LAST_TRACK_DATE
                  ,TA.IS_MARKETING_BRANCH_SEND_DUNLTR
                  ,TA.MARKETING_BRANCH_LAST_DUNLTR_DATE
                  ,TA.MARKETING_BRANCH_MANAGER_FEEDBACK_TYPE
                  ,TA.MARKETING_BRANCH_MANAGER_FEEDBACK_DETAIL
                  ,TA.MARKETING_BRANCH_LAST_TRACK_DATE


            FROM trustfee_arrears_report T
            LEFT JOIN (
                        SELECT * FROM TRUSTFEE_ARREARS_DETAIL_REPORT
                        WHERE PK_ID IN (
                          SELEC	</td><td style='mso-number-format:'@';'>2438	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>171	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>2948d9d0ac20c3a16d90637fce95041b	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
    	</td><td style='mso-number-format:'@';'>2435	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>172	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>2e871037018aa99f7ddb07328efd6444	</td><td style='mso-number-format:'@';'>MERGE INTO SHCH_BOND2_TEMPORARY SBT
        USING(
           
            SELECT
                ? innerProductNo,
                ? holderAccount,
                ? bizDate,
                ? bondCode,
                ? bondName,
                ? balanceDirection,
                ? totalFlag,
                ? useBalance,
                ? freezeBalance,
                ? tobePayBalance,
                ? tobeBuyBalance,
                ? pledgeBalance,
                ? innerPledgeBalance,
                ? tobeRightBalance,
                ? totalBalance,
                ? tradeFrom
             FROM DUAL
         union all 
            SELECT
                ? innerProductNo,
                ? holderAccount,
                ? bizDate,
                ? bondCode,
                ? bondName,
                ? balanceDirection,
                ? totalFlag,
                ? useBalance,
                ? freezeBalance,
                ? tobePayBalance,
                ? tobeBuyBalance,
                ? pledgeBalance,
                ? innerPledgeBalance,
                ? tobeRightBalance,
                ? totalBalance,
                ? tradeFrom
             FROM DUAL
         union all 
            SELECT
                ? innerProductNo,
                ? holderAccount,
                ? bizDate,
                ? bondCode,
                ? bondName,
                ? balanceDirection,
                ? totalFlag,
                ? useBalance,
                ? freezeBalance,
                ? tobePayBalance,
                ? tobeBuyBalance,
                ? pledgeBalance,
                ? innerPledgeBalance,
