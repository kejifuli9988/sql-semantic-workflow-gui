		FROM (SELECT JS.PK_ID AS PKID
		FROM JSMX JS
		LEFT JOIN SECURITY_ACCOUNT SA ON (JS.ZQZH = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1')
		LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JS.PK_ID = CM.RELATION_ID
		WHERE JS.JYFS != '106'
		AND JS.JSFS = '002'
		and js.filename not like 'jsmx03%'
		AND JS.JSRQ >= TO_CHAR(cast(? as timestamp), 'yyyyMMdd')
		AND JS.JSRQ < TO_CHAR(cast(? as timestamp) + 1, 'yyyyMMdd')
		 
		 AND CM.OPD_CONFIRM_STATUS IS NULL 
		UNION ALL
		SELECT JSZ.PK_ID AS PKID
		FROM SJSMX JSZ
		LEFT JOIN SECURITY_ACCOUNT SA ON (TRIM(JSZ.MXZQZH) = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1')
		LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JSZ.PK_ID = CM.RELATION_ID
		WHERE JSZ.MXJSFS = 'N'
		AND JSZ.MXJSRQ >= TO_CHAR(cast(? as timestamp), 'yyyyMMdd')
		AND JSZ.MXJSRQ < TO_CHAR(cast(? as timestamp)+ 1, 'yyyyMMdd')
		and jsz.filename not like 'SJSMX2%'
		 
		 AND CM.OPD_CONFIRM_STATUS IS NULL  )	</td><td style='mso-number-format:'@';'>14820	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>31	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f17692f01a3361149dd91bcd3a451be9	</td><td style='mso-number-format:'@';'>WITH QX_SQL AS
		(SELECT WM_CONCAT(PRO_IND_BRANCHID) AS BRANCHID
		FROM CNZL_AUTHPAR
		WHERE INSTR(USER_BRANCHID, 'G00017713') > 0
		AND EFFECTSTATUS = '1'
		AND FOUREYESSTATUS = '1'),
		CHECK_NUM AS
		(SELECT COUNT(1) C
		FROM CNZL_AUTHPAR
		WHERE INSTR(PRO_IND_BRANCHID, '') > 0
		AND EFFECTSTATUS = '1'
		AND FOUREYESSTATUS = '1')
		SELECT Z.UNIT_ID,
		? USER_ID,
		Z.MON_MAT_TYPE,
		? REMINDER_TYPE,
		Z.DATA_AT,
		Z.INS_ID,
		NVL(Z.PRODUCT_ID, Z.UNIT_ID) AS PRODUCT_ID,
		NVL(Z.STEP_ID, '-1') AS STEP_ID,
		(SELECT IR.CDBH FROM IP_RESMENU IR
		WHERE IR.CDURL = (CASE
		WHEN Z.STEP_ID = '0' THEN '/instruction/list.do'
		WHEN Z.STEP_ID = '1' THEN '/instructionCheck/list.do'
		WHEN Z.STEP_ID = '2' THEN '/instructionAudit/list.do'
		WHEN Z.STEP_ID = '3' THEN '/stmtAudit/list.do'
		WHEN Z.STEP_ID = '4' THEN '/stmtExecuteManage/list.do'
		WHEN Z.STEP_ID = '5' THEN '/stmtExecuteCheck/list.do'
		WHEN Z.STEP_ID = '6' THEN '/stmtPayment/list.do'
		WHEN Z.STEP_ID = '7' THEN '/csbsInstruction/list.do'
		WHEN Z.STEP_ID = '8' THEN '/unRelInstruction/list.do'
		WHEN Z.STEP_ID = '9' THEN '/unRelInsHandle/list.do'
		WHEN Z.STEP_ID = '10' THEN '/unRelInsCheck/list.do'
		WHEN Z.STEP_ID = '11' THEN '/csdsInstruction/list.do'
		WHEN Z.STEP_ID = '12' THEN '/yjInstructionHandleCtrler/list.do'
		ELSE '未知' END)) AS CDBH,
		NVL((SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE Z.PAYMENT_TYPE_ID = PT.PAYMENT_TYPE_ID),
		NVL((SELECT IC.MBTMZ
		FROM IP_CODEINFO IC
		WHERE IC.SJLX IN ('CSBSCSBSCSBSCSBSCSBSCSBS00010001', 'TYLTYLTYLTYLTYLTYLTYLTYL00000348')
		AND IC.MBLXBH = Z.PAYMENT_TYPE_ID),
		'划款类型为空')) AS PAYMENT_TYPE_NAME,
		(CASE WHEN Z.STEP_ID = '0' THEN '信息经办'
		WHEN Z.STEP_ID = '1' THEN '信息审核'
		WHEN Z.STEP_ID = '2' THEN '指令审核'
		WHEN Z.STEP_ID = '3' THEN '清算审核'
		WHEN Z.STEP_ID = '4' THEN '清算执行经办'
		WHEN Z.STEP_ID = '5' THEN '清算执行复核'
		WHEN Z.STEP_ID = '6' THEN '清算支付'
		WHEN Z.STEP_ID = '7' THEN '交易指令确认'
		WHEN Z.STEP_ID = '8' THEN '未上线信息经办'
		WHEN Z.STEP_ID = '9' THEN '未上线核算经办'
		W	</td><td style='mso-number-format:'@';'>13937	</td><td style='mso-number-format:'@';'>4769	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>32	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c812967972ba9beb2470686534240cc6	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH UnuseAccountFilter AS (
		SELECT DISTINCT P2.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP2 ON UA.BANK_ACCOUNT_ID = AP2.BANK_ACCOUNT_ID
		JOIN PRODUCT P2 ON AP2.PRODUCT_ID = P2.PRODUCT_ID
		WHERE
		UA.EFFECTSTATUS = '1'
		AND P2.SUB_GROUP_MARK = '0'
		)

		SELECT T.BALANCE_ID,
			   T.PRODUCT_ID,
			   T.PRODUCT_CODE,
			   T.MANAGER_PROD,
			   T.PRODUCT_NAME,
			   T.ACCOUNT_ID,
			   T.ACCOUNT_NAME,
			   T.ACCOUNT_TYPE_ID,
	           T.ACCOUNT_TYPE_NAME,
			   T.BALANCE_DATE,
			   T.AMOUNT,
			   T.CURRENCY,
			   T.CREATED_AT,
			   T.CREATED_BY,
			   T.CREATED_NAME,
			   T.UPDATED_AT,
			   T.UPDATED_BY,
			   T.UPDATED_NAME,
	           T.USABLE_BALANCE,
	           T.CONTROL_BALANCE,
	          T.FREEZE_BALANCE,
		T.ACCOUNT_SUB_SN
		 FROM
			(
			SELECT 
					BH.BALANCE_HISTORY_ID BALANCE_ID,
					BH.PRODUCT_ID,
	               	BH.ACCOUNT_ID,
	               	BH.ACCOUNT_TYPE_ID,
	               	BH.BALANCE_DATE,
	               	BH.AMOUNT,
	               	BH.CREATED_AT,
	               	BH.CREATED_BY,
	               	BH.UPDATED_AT,
	               	BH.UPDATED_BY,
	               	BH.USABLE_BALANCE,
	               	BH.CONTROL_BALANCE,
	               	BH.FREEZE_BALANCE,
		            AP.ACCOUNT_SUB_SN AS ACCOUNT_SUB_SN,
		            P.PRODUCT_CODE AS PRODUCT_CODE,
		            P.MANAGER_PROD AS MANAGER_PROD,
		            P.PRODUCT_NAME AS PRODUCT_NAME,
		            BA2.BANK_ACCOUNT_NAME AS ACCOUNT_NAME,
		            ACT.ACCOUNT_TYPE_NAME AS ACCOUNT_TYPE_NAME,
		            BA2.CURRENCY AS CURRENCY,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.CREATED_BY) AS CREATED_NAME,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.UPDATED_BY) AS UPDATED_NAME
	          FROM 	
	          		BALANCE_HISTORY BH
		LEFT JOIN ACCOUNT_PRODUCT AP ON AP.BANK_ACCOUNT_ID = BH.ACCOUNT_ID AND AP.PRODUCT_ID = BH.PRODUCT_ID AND AP.EFFECTSTATUS = '1'
		LEF	</td><td style='mso-number-format:'@';'>13801	</td><td style='mso-number-format:'@';'>12	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>33	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>89af6569512af9fd79efb55cc5dd7b73	</td><td style='mso-number-format:'@';'>select Z.AREA_DISTRICT as Clr_Rgn_Inst_Num,
