			or  ((tt.CONTRACT_STATUS <> 'CS00' or tt.contract_sta	</td><td style='mso-number-format:'@';'>2053	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>213	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>19794e51195b167762a7c90e6568fa4f	</td><td style='mso-number-format:'@';'>WITH a AS
        (select t.product_id,
        t.bond_id,
        t.bond_short_name,
        sum(t.amountSum) as amountSum,
        sum(t.yeSum) yeSum,
        t.isBond2,
        t.bank_account_id
        from (
         
            select t.product_id,
            t.bond_id,
            t.bond_short_name,
            sum(nvl(t.usage_subject, 0) + nvl(t.forpay_subject, 0) +
            nvl(t.pledge_subject, 0) + nvl(t.repurchase_subject, 0) +
            nvl(t.block_subject, 0)) as amountSum,
            sum(nvl(t.usage_subject, 0)) AS yeSum,
            '1' as isBond2,
            t.bank_account_id
            from CSBS_SUMMARY_STATEMENT t
            where t.create_date = to_char(cast(? as timestamp) - 1, 'yyyy-MM-dd')
            group by t.product_id, t.bank_account_id, t.bond_id, t.bond_short_name
            union all
            select
            t.product_id,
            t.bond_id,
            t.bond_short_name,
            sum(nvl(t.total_amount, 0)) as amountSum,
            sum(nvl(t.usage_subject, 0)) AS yeSum,
            '1' as isBond2,
            t.bank_account_id
            from shch_summary_statement t
            where t.query_date = to_char(cast(? as timestamp) - 1, 'yyyyMMdd')
            group by t.product_id, t.bank_account_id, t.bond_id,  t.bond_short_name

         
         
            union all
         

         
            SELECT
            (select pro.product_Id from product pro where  pro.product_code = sbt.product_code and pro.effectstatus in ('1','0')) as product_id,
            sbt.BOND_CODE as BOND_ID,
            sbt.BOND_NAME as bond_short_name,
            sum(nvl(sbt.TOTAL_BALANCE, 0)) as amountSum,
            sum(nvl(sbt.USE_BALANCE, 0)) AS yeSum,
            '2' as isBond2,
            null as bank_account_id
            from SHCH_BOND2_TEMPORARY sbt
            where sbt.business_date  =  to_char(cast(? as timestamp) -1, 'yyyyMMdd')
            and sbt.product_code is not null
            group by sbt.product_code ,	</td><td style='mso-number-format:'@';'>2044	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>214	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>90e7915fc0f42f6c9d4bc33489336cf8	</td><td style='mso-number-format:'@';'>select *
