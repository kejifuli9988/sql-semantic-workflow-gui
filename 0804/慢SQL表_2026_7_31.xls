<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Sheet1</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table style="vnd.ms-excel.numberformat:@"><tr><td>序号</td><td>来源</td><td>指纹</td><td>SQL语句</td><td>平均响应时间(ms)</td><td>执行次数</td><td>服务</td><td>异常类型</td></tr><tr><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>4c5bbb92fb5eed89a963ac77e0aed3c2	</td><td style='mso-number-format:'@';'>SELECT sch.cashflow_id,
		       sch.core_cashflow_id,
		       sch.product_id,
		       sch.account_id,
		       sch.account_type_id,
		       sch.cashflow_at,
		       sch.cashflow_time,
		       sch.counter_cashflow,
		       sch.credit_account,
		       sch.credit_account_name,
		       sch.debit_account,
		       sch.debit_account_name,
		       sch.direction,
		       sch.amount,
		       sch.balance_before,
		       sch.balance_after,
		       sch.currency,
		       sch.transaction_code,
		       sch.summary,
		       sch.message,
		       sch.remark,
		       nvl(sch.updated_at, sch.created_at) updated_at,
		       sch.use_info,
		       sch.bank_no,
		       sch.bank_name,
		       sch.trade_org_code,
		       sch.post_route_choose,
		       sch.cpzxh,
		       sch.cpznxh,
		       sch.trade_area_code
		  FROM SETTLEMENT_CASHFLOW_HISTORY SCH
		 WHERE SCH.SUMMARY = '591'
		   AND SCH.CASHFLOW_AT BETWEEN  CAST( ? AS TIMESTAMP) AND   CAST( ? AS TIMESTAMP)
		   AND NOT EXISTS (SELECT 1 FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = SCH.ACCOUNT_ID AND BA.DEDICATED = '0')
		   AND NOT EXISTS (SELECT 1 FROM CORE_CASHFLOW_RETURN R
		         WHERE SCH.ACCOUNT_ID = R.ACCOUNT_ID
		           AND SCH.CASHFLOW_AT = R.CASHFLOW_AT
		           AND SCH.CASHFLOW_TIME = R.CASHFLOW_TIME
		           AND SCH.CPZXH = R.CPZXH
		           AND SCH.CPZNXH = R.CPZNXH
		           AND SCH.DIRECTION = R.DIRECTION
		           AND SCH.AMOUNT = R.AMOUNT
		           AND SCH.COUNTER_CASHFLOW = R.COUNTER_CASHFLOW
		           AND (SCH.CREDIT_ACCOUNT = R.CREDIT_ACCOUNT OR (SCH.CREDIT_ACCOUNT IS NULL AND R.CREDIT_ACCOUNT IS NULL))
		           AND (SCH.DEBIT_ACCOUNT = R.DEBIT_ACCOUNT OR (SCH.DEBIT_ACCOUNT IS NULL AND R.DEBIT_ACCOUNT IS NULL)))	</td><td style='mso-number-format:'@';'>216480	</td><td style='mso-number-format:'@';'>72	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>52306edb3ead131712e3fb9b34627e1b	</td><td style='mso-number-format:'@';'>SELECT  ( SELECT count(*) FROM instruction_2020 z LEFT JOIN (SELECT p.product_id, p.product_code, p.product_name, p.manager_id, p.ind_branchid, p.opd_branchid, p.operation_mode, (SELECT external_agency_name FROM external_agency ea WHERE ea.external_agency_id = p.manager_id AND ea.effectstatus = '1') glr FROM product p WHERE p.product_id IN (SELECT ap.product_id FROM account_product ap, bank_account ba WHERE ap.bank_account_id = ba.bank_account_id AND ba.effectstatus = '1') OR p.product_id IN (SELECT aup.product_id FROM auxiliary_product aup, bank_account ba WHERE Ba.Effectstatus = '1' AND Aup.Effectstatus = '1' AND Aup.Bank_Account_Id = Ba.Bank_Account_Id) UNION SELECT p.product_id, p.product_code, p.product_name, p.manager_id, p.ind_branchid, p.opd_branchid, p.operation_mode, (SELECT external_agency_name FROM external_agency ea WHERE ea.external_agency_id = p.manager_id AND ea.effectstatus = '1') glr FROM product p WHERE p.product_type_id = 'JWZQTG') p ON z.product_id = p.product_id WHERE 1 = 1 AND z.instruc_batch_flag IN ('0', '-1') AND z.INSTRUCTION_MODEL != '0' AND z.product_id IS NOT NULL AND (z.payment_type_id IS NULL OR z.payment_type_id != 'QSCNDB' OR (z.payment_type_id = 'QSCNDB' AND z.CSDS_BUSINESS_TYPE IS NULL AND z.source_id = '3') OR (z.payment_type_id = 'QSCNDB' AND z.source_id = '0')) AND p.product_id IN (SELECT p.product_id FROM product p, user_info_branch uib WHERE uib.userid = ? AND uib.effectstatus = '1' AND p.ind_branchid = uib.branchid UNION ALL SELECT p.product_id FROM product p, user_operating_branch opd WHERE opd.userid = ? AND opd.effectstatus = '1' AND p.opd_branchid = opd.branchid) AND z.PAYMENT_AT >= trunc(cast(? AS timestamp)) AND z.PAYMENT_AT < trunc(cast(? AS timestamp) + 1) AND z.product_id IN (?) AND (z.product_id IS NULL OR nvl((SELECT psi.system_flag FROM prod_switch_info psi WHERE psi.product_id = z.product_id), '1') = ?) )  +  ( SELECT count(*) FROM instruction_2021 z LEFT JOIN (SELECT p.product_id, p.product_code, p.product_name	</td><td style='mso-number-format:'@';'>124288	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>ee935fe3f62e9cbe04b5d4b1f62321d3	</td><td style='mso-number-format:'@';'>WITH base_instruction AS
        (SELECT z.instruction_id,
        (CASE
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ13','TZZQ16')) THEN
        nvl((select (case when rtgs.shch_stop_status = '1' then '9' else rtgs.shch_draw_status end) ||'#@@#'|| by3 shch_draw_status from RTGS_COLLECTION_RECORD_1 rtgs where rtgs.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ12', 'TZZQ17')) THEN
        nvl((select c.ccdc_draw_status shch_draw_status from CCDC_COLLECTION_RECORD c where c.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2') and z.PAYMENT_TYPE_ID in ('JWZQ01','JWZQ02')) THEN
        z.direct_status
        WHEN  (z.PAYMENT_TYPE_ID ='TZCK10') THEN
        nvl((select INSTRUCTION_PARAM_VALUE from instruction_ext where instruction_id =  z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME ='hqckWithDraw'),'')
        ELSE
        ''
        END) AS shchDrawStatus,
        z.product_id,
        z.REALTIME_STATUS REALTIME_STATUS,
        z.use_id,
        z.payment_date,
        z.payment_at,
        z.successful_paid_at,
        z.payment_type_id,
        (select pt.payment_type_name from payment_type pt where pt.payment_type_id = z.payment_type_id) hkmc,
        z.direction,
        z.amount,
        z.source_id,
        z.payment_reason,
        z.debit_account,
        z.debit_account_name,
        z.credit_account,
        z.credit_account_name,
        z.bank_id,
        z.bank_name,
        z.db_status,
        z.ANO_SYS_STAT,
        z.batch,
        z.IPO_SUBSCRIBE,
        z.entrust,
        z.security_code,
        z.payment_mode,
        z.inter_bank,
        decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) as finalStatusOrder,
        z.final_paymentstatus,
        z.payment_status,
        (select ip.yhmc from ip_staff_stmt ip where ip.yhbh = z.updated_by) updatedbyname,
        z.updated_at,
        z.created_at,
    	</td><td style='mso-number-format:'@';'>95841	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>4285465ac0d5bef68a3365dc32241310	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	 
                    	  AND BA.ACCOUNT_ID = ? 
                   ) 
                AND NOT EXISTS(
                   	SELECT 1
					  FROM CheckUnuseProduct c
					 WHERE  BA.PRODUCT_ID = c.PRODUCT_ID
                   )
		) T	</td><td style='mso-number-format:'@';'>89619	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>0c5b7e8ce2f1784af9eadfb9424f1d26	</td><td style='mso-number-format:'@';'>SELECT 
				BA.BALANCE_ID,
                BA.PRODUCT_ID,
                BA.ACCOUNT_ID,
                BA.ACCOUNT_TYPE_ID,
                BA.BALANCE_DATE,
                BA.AMOUNT
          FROM
                BALANCE BA
         WHERE 
            	BA.BALANCE_DATE = ?
            	 AND BA.ACCOUNT_TYPE_ID IN (SELECT A.ACCOUNT_TYPE_ID FROM ACCOUNT_TYPE A WHERE A.SJ_ACCOUNT_TYPE_ID='zhinitcnzh0') 
            	 
           		 AND BA.PRODUCT_ID IN
	           		 (  
	            		?
					 , 
