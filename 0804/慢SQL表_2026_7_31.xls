			</td><td style='mso-number-format:'@';'>2873	</td><td style='mso-number-format:'@';'>16	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>143	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>d5a9845f2e85b1c3fc9a8b5b99dc1929	</td><td style='mso-number-format:'@';'>select count(1)
        from CSBS_INSTRUCTION CI
        left join bank_account ba on ci.BANK_ACCOUNT_ID = ba.bank_account_id
        where 1=1
         
         
         
            and (
            CI.CREATED_AT >= trunc(cast(? as timestamp)) and CI.CREATED_AT <trunc(cast(? as timestamp))+1
            or
            CI.DELIVER_DATE1 between to_char(cast(? as timestamp),'yyyymmdd') and to_char(cast(? as timestamp),'yyyymmdd')
            )
         
         
         
         
         
         
         
         
         
         
         
         
         
         

         

        
         
         
         
         
          and ci.BANK_ACCOUNT_ID like '%'||?||'%' 
         
         
         
            
            and (
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NULL)
            OR
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NOT NULL and exists (
            SELECT IP.YHBH FROM ip_staff_stmt ip,SAD_CC S
            WHERE S.BRANCHID = ip.ssjg
            AND ip.yhbh = ?
            AND S.RANGE IN (
            SUBSTR( ci.bank_account_id,0,2),
            SUBSTR( ci.bank_account_id,0,5) )
             
        AND EXISTS (
                select 1
				from (
					select a.bank_account_id,
						pro.PRODUCT_ID,
						pro.ind_branchid as ind_branchid,
						ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN
					from auxiliary_product a
					inner join product pro on pro.product_id = a.product_id
					where a.effectstatus = '1' AND a.BANK_ACCOUNT_ID = ci.BANK_ACCOUNT_ID AND pro.IND_BRANCHID = S.BRANCHID
				) aup
				where aup.rown = 1
            )
     
            UNION ALL
            SELECT IP.YHBH FROM sad_bow sb, ip_staff_stmt ip
            WHERE ip.yhbh = ?
            AND sb.effectstatus = '1'
            AND ip.ssjg = sb.branchid
            AND sb.borwlist = '1'
            AND sb.accou	</td><td style='mso-number-format:'@';'>2845	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>144	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>5dd59311ce85b4006d4d75539a2573e5	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( with base_instruction as
        (
        select
        z.instruction_id,
        (CASE
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ13','TZZQ16')) THEN
        nvl((select (case when rtgs.shch_stop_status = '1' then '9' else rtgs.shch_draw_status end) ||'#@@#'|| by3 shch_draw_status from RTGS_COLLECTION_RECORD_1 rtgs where rtgs.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ12', 'TZZQ17')) THEN
        nvl((select c.ccdc_draw_status shch_draw_status from CCDC_COLLECTION_RECORD c where c.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2') and z.PAYMENT_TYPE_ID in ('JWZQ01','JWZQ02')) THEN
        z.direct_status
        WHEN  (z.PAYMENT_TYPE_ID ='TZCK10') THEN
        nvl((select INSTRUCTION_PARAM_VALUE from instruction_ext where instruction_id =  z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME ='hqckWithDraw'),'')
        ELSE
        ''
        END) AS shchDrawStatus,
        z.product_id,
        z.REALTIME_STATUS,
        z.use_id,
        z.payment_date,
        z.payment_at,
        z.successful_paid_at,
        z.payment_type_id,
        (select pt.payment_type_name from payment_type pt
        where pt.payment_type_id = z.payment_type_id
        ) hkmc,
        z.direction,
        z.amount,
        z.source_id,
        z.payment_reason,
        z.debit_account,
        z.debit_account_name,
        z.credit_account,
        z.credit_account_name,
        z.bank_id,
        z.bank_name,
        z.db_status,
        z.ANO_SYS_STAT,
        z.batch,
        z.IPO_SUBSCRIBE,
        z.entrust,
        z.security_code,
        z.payment_mode,
        z.inter_bank,
        decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) as finalStatusOrder,
        z.final_paymentstatus,
        z.payment_status,
        (select ip.yhmc from ip_staff_stmt ip where ip.yhbh = z.u	</td><td style='mso-number-format:'@';'>2828	</td><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>145	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>076b6fba98f33d6e64b04b4aab747fb8	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select
		accountId,
		accountName,
		accountTypeId,
		accountTypeName,
		sameCity,
		interBank,
		bankId,
		bankName
		from (select
		z.ACCOUNT_ID as accountId,
		z.ACCOUNT_NAME as accountName,
		z.ACCOUNT_TYPE_ID as accountTypeId,
		a.account_type_name as accountTypeName,
		z.SAME_CITY as sameCity,
		z.INTER_BANK as interBank,
		z.BANK_ID as bankId,
		z.BANK_NAME as bankName
		from COUNTERPARTY_ACCOUNT z,USER_INFO_BRANCH d,account_type a
		where z.branchid=d.branchid
		and z.effectstatus in
		 (  
			?
		 ) 
		and d.effectstatus = '1'
		and a.effectstatus = '1'
		and a.account_type_id = z.account_type_id
		 
			and d.userid = ?
		 
		 
		 
		 
		 
		 
		 
		 
		union
		select
		ca.CSDS_ACCOUNT_ID as accountId,
		ca.account_name as accountName,
		ca.account_type_id as accountTypeId,
		aty.account_type_name as accountTypeName,
		'' as sameCity,
		'' as interBank,
		'' as bankId,
		'' as bankName
		from csds_account ca, account_type aty
		where ca.effectstatus in
		 (  
			?
		 ) 
		and aty.effectstatus = '1'
		and aty.account_type_id = ca.account_type_id
		 
		 
		 
		 
			and ca.CSDS_ACCOUNT_ID in (select cap.CSDS_ACCOUNT_ID from csds_account_product cap where cap.PRODUCT_ID = ?)
			 
			 
		 
		 
		 
		 
		)
		order by accountId,accountTypeId ) row_ ) where rownum_ > 0 and rownum_ <= 10	</td><td style='mso-number-format:'@';'>2809	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>146	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a3d5bf4e3a56722340aa2f79af0c6176	</td><td style='mso-number-format:'@';'>WITH SC AS
 (SELECT CASHFLOW_ID,
         CREDIT_ACCOUNT,
         AMOUNT,
         DEBIT_ACCOUNT,
         CASHFLOW_AT,
         ROW_NUMBER() OVER(PARTITION BY CASHFLOW_AT, CREDIT_ACCOUNT, AMOUNT, DEBIT_ACCOUNT ORDER BY CASHFLOW_ID) ROW_NUM
    FROM SETTLEMENT_CASHFLOW_HISTORY SCH
    LEFT JOIN PRODUCT P
      ON SCH.PRODUCT_ID = P.PRODUCT_ID
   WHERE INSTRUCTION_ID IS NULL
     AND SUMMARY NOT IN ('855', '850')
     AND COUNTER_CASHFLOW NOT LIKE '9699%'
     AND DIRECTION = '0'
     AND ((SCH.PRODUCT_ID IS NOT NULL 
         AND P.PRODUCT_TYPE_ID NOT IN ('DK', 'ZJMJ', 'BXDLJDR', 'ABSZJGJ', 'JGJY', 'JGQT')
         AND P.OPD_BRANCHID IN 
		 (  
			?
		 )  ) 
       OR SCH.PRODUCT_ID IS NULL)
     AND CASHFLOW_AT BETWEEN trunc(cast(? as timestamp)) AND trunc(cast(? as timestamp))),
CC AS
 (SELECT INSTRUCTION_ID,
         CREDIT_ACCOUNT,
         AMOUNT,
         DEBIT_ACCOUNT,
         PAYMENT_AT,
         ROW_NUMBER() OVER(PARTITION BY PAYMENT_AT, CREDIT_ACCOUNT, AMOUNT, DEBIT_ACCOUNT ORDER BY INSTRUCTION_ID) ROW_NUM
    FROM INSTRUCTION I
    LEFT JOIN PRODUCT P
      ON I.PRODUCT_ID = P.PRODUCT_ID
   WHERE I.PAYMENT_MODE = '2'
     AND I.DIRECTION = '0'
     AND I.FINAL_PAYMENTSTATUS = '3'
     AND ((I.PRODUCT_ID IS NOT NULL 
         AND P.PRODUCT_TYPE_ID NOT IN ('DK', 'ZJMJ', 'BXDLJDR', 'ABSZJGJ', 'JGJY', 'JGQT')
         AND P.OPD_BRANCHID IN 
		 (  
			?
		 )  ) 
       OR I.PRODUCT_ID IS NULL)
     AND I.PAYMENT_AT BETWEEN trunc(cast(? as timestamp)) AND trunc(cast(? as timestamp)))
SELECT SC.CASHFLOW_ID
  FROM SC
 WHERE EXISTS (SELECT 1
          FROM CC
         WHERE CC.CREDIT_ACCOUNT = SC.CREDIT_ACCOUNT
           AND CC.AMOUNT = SC.AMOUNT
           AND CC.DEBIT_ACCOUNT = SC.DEBIT_ACCOUNT
           AND CASHFLOW_AT = PAYMENT_AT
           AND CC.ROW_NUM = SC.ROW_NUM)	</td><td style='mso-number-format:'@';'>2801	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>147	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b8db287f49ff1990d2283176d83266f9	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
    	</td><td style='mso-number-format:'@';'>2799	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>148	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>0611800dd773e5633fae4a7743497874	</td><td style='mso-number-format:'@';'>DELETE FROM FAXEMAIL_SEND_HISTORY  WHERE CREATED_AT BETWEEN to_date('2025-07-23','yyyy-MM-dd') AND to_date('2025-07-30','yyyy-MM-dd') AND ROWNUM <=2000	</td><td style='mso-number-format:'@';'>2771	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>149	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>62581b94b6578fac5c0802517ffeb30e	</td><td style='mso-number-format:'@';'>begin
		   
