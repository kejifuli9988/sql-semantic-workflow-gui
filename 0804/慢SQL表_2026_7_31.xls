        left join csbs_instruction_origin cio on ci.instr_id = cio.instr_id
        left join bank_account ba on ci.BANK_ACCOUNT_ID = ba	</td><td style='mso-number-format:'@';'>2595	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>158	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a3262a0b05bec5a16d2204722a146559	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( with base_chzqhs_trade_ext as(
		select
		e.trade_id,ch.resale_reg_beg_at,ch.resale_reg_end_at
		from
		chzqhs ch
		left join trade_ext e on
		ch.security_code = e.param_value
		where 1=1
		and e.param_name = 'ZQDM'
		and to_date(ch.resale_reg_end_at, 'yyyy-MM-dd') >= cast(? as timestamp)
		and to_date(ch.resale_reg_end_at, 'yyyy-MM-dd') <= cast(? as timestamp)
		)
		select tt.trade_id as id,
		p.product_name as productName,
		to_char(tt.payment_at,'yyyy-MM-dd')as paymentAt,
		tt.amount as amount,
		 tt.contract_status as proSettlementStatus,
		 tt.realtime_Status as instrStatus,
		tt.core_message as abnormalReason,
		nvl(cm.OPD_CONFIRM_STATUS,'WQR') as opdConfirmStatus,
		cm.SIUATION_EXPLAIN as siuationExplain,
		to_char(cm.siuation_date,'yyyy-MM-dd HH24:mi:ss') as siuationDate,
		cm.OPD_BRANCH as siuationBranch,
		(select d.yhmc from ip_staff_stmt d where cm.SIUATION_BY= d.yhbh) as siuationBy,
		(select d.jgmc from ip_unit_stmt d where p.ind_branchid = d.zj) as indBranch,
		p.opd_branchid as opdBranchId,
		(select g.jgmc from ip_unit_stmt g where p.opd_branchid = g.zj) as opdBranch,
		tt.instructid as instrucId
		from trade_base tt
		left join product p
		on tt.product_id = p.product_id
		left join CRITICAL_MONITOR_SIGN cm
		on tt.trade_id = cm.RELATION_ID
		where tt.action_status not in ('2','3')
		 
		 
		 and ( ((
					(tt.TRAN_TYPE in ('SQHS', 'ZZHS') and tt.final_paymentstatus <> '3'
						and (tt.CONTRACT_STATUS <> 'CS00' or tt.CONTRACT_STATUS is null)) 
			 or (tt.TRAN_TYPE  in ('ZZYQFS','ZZHQ','ZTGJYSZZZ','CDTQZQ','ZQZWQHBZJ','SQHQ','SQYQFS')
						and (tt.CONTRACT_STATUS <> 'CS00' or tt.CONTRACT_STATUS is null ))
					or(tt.TRAN_TYPE in ('ZTGZZZJYS','SQXJYY','ZZXJYY','ZZXYCKZY') and (tt.jyzt <>'3' or tt.jyzt is null) ) )
				and tt.payment_at between trunc(cast(? as timestamp)) and trunc(cast(? as timestamp)))
			or  ((tt.CONTRACT_STATUS <> 'CS00' or tt.contract_status is null)
			 and exists (select	</td><td style='mso-number-format:'@';'>2585	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>159	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>3c3b005bb97b3c9927e6a025aff53f27	</td><td style='mso-number-format:'@';'>WITH a as (
        select
        h.*
        from (
        select
        nvl(to_char(sq.REVIEW_TIME,'yyyyMMdd'),ch.PL_DATE) as PL_DATE,
        nvl(sq.bond_code,ch.SECURITY_CODE) as SECURITY_CODE,
        nvl(to_char(sq.EXERCISE_APPLY_BEGIN_DAY,'yyyyMMdd') ,ch.RESALE_REG_BEG_AT) as RESALE_REG_BEG_AT,
        nvl(to_char(sq.EXERCISE_APPLY_CLOSING_DT,'yyyyMMdd') ,ch.RESALE_REG_END_AT) as RESALE_REG_END_AT,
        nvl(to_char(sq.EXERCISE_EXEC_DAY,'yyyyMMdd'),ch.EXERCISE_AT) as EXERCISE_AT,
        nvl(ch.EVENT_TYPE,'1') as EVENT_TYPE,
        ch.SECODE,
        ch.NUM_CODE,
        ch.CHANGE_SE_CODE,
        ch.OBJ_COMP_CODE,
        ch.DATA_DATE,
        (case when sq.bond_code is null then '0' else '1'  end ) as bond_source,
        sq.bond_name
        from (
        select * from chzqhs ch
        where ch.event_type IN( '1', '13')
        and CH.EXERCISE_AT =  ?
        )ch
        full join
        (
        select * from sqzqhs sq
        where  sq.EXERCISE_EXEC_DAY = to_date(?,'yyyyMMdd')
        )sq
        on ch.security_code = sq.bond_code
        )h
         

        ),
        d as (
            select
            sum(nvl(t.amount, 0))/10000 as ydjme,
            t.product_id,
            e.param_value zqdm
            from trade_base t
            left join trade_ext e on t.trade_id = e.trade_id
            inner join a on e.param_value = a.security_code
            where
            (((t.tran_type = 'SQHS' and t.INSTRUCTION_STATUS in ('1','2','3') AND t.jyzt IS NOT NULL)
            or (t.tran_type = 'SQHS' and t.realtime_status = '清算执行复核已完成' and t.jyzt IS NULL) )
            or (t.tran_type = 'ZZHS' and t.INSTRUCTION_STATUS = 'CGSU'))
            and t.trade_date BETWEEN to_date(a.resale_reg_beg_at, 'yyyyMMdd') AND to_date(a.resale_reg_end_at, 'yyyyMMdd') +1-1/86400
             
            group by t.product_id, e.param_value
        )
        select count(*)
        from(
                select
        pro.product_code,
        pro.product_name	</td><td style='mso-number-format:'@';'>2582	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>160	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>46b04cd88940c0e9e008ab603c76c717	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
