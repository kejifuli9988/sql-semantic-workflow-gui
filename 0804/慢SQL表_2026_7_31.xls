		     	</td><td style='mso-number-format:'@';'>2658	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>154	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b677b2e513ce987951077abc005adeb4	</td><td style='mso-number-format:'@';'>WITH a AS
        (select t.product_id,
        t.bond_id,
        t.bond_short_name,
        sum(t.amountSum) as amountSum,
        sum(t.yeSum) yeSum,
        t.isBond2,
        t.bank_account_id
        from (
         
            select t.product_id,
            t.bond_id,
            t.bond_short_name,
            sum(nvl(t.usage_subject, 0) + nvl(t.forpay_subject, 0) +
            nvl(t.pledge_subject, 0) + nvl(t.repurchase_subject, 0) +
            nvl(t.block_subject, 0)) as amountSum,
            sum(nvl(t.usage_subject, 0)) AS yeSum,
            '1' as isBond2,
            t.bank_account_id
            from CSBS_SUMMARY_STATEMENT t
            where t.create_date = to_char(cast(? as timestamp) - 1, 'yyyy-MM-dd')
            group by t.product_id, t.bank_account_id, t.bond_id, t.bond_short_name
            union all
            select
            t.product_id,
            t.bond_id,
            t.bond_short_name,
            sum(nvl(t.total_amount, 0)) as amountSum,
            sum(nvl(t.usage_subject, 0)) AS yeSum,
            '1' as isBond2,
            t.bank_account_id
            from shch_summary_statement t
            where t.query_date = to_char(cast(? as timestamp) - 1, 'yyyyMMdd')
            group by t.product_id, t.bank_account_id, t.bond_id,  t.bond_short_name

         
         
            union all
         

         
            SELECT
            (select pro.product_Id from product pro where  pro.product_code = sbt.product_code and pro.effectstatus in ('1','0')) as product_id,
            sbt.BOND_CODE as BOND_ID,
            sbt.BOND_NAME as bond_short_name,
            sum(nvl(sbt.TOTAL_BALANCE, 0)) as amountSum,
            sum(nvl(sbt.USE_BALANCE, 0)) AS yeSum,
            '2' as isBond2,
            null as bank_account_id
            from SHCH_BOND2_TEMPORARY sbt
            where sbt.business_date  =  to_char(cast(? as timestamp) -1, 'yyyyMMdd')
            and sbt.product_code is not null
            group by sbt.product_code ,	</td><td style='mso-number-format:'@';'>2622	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>155	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>520c1f4355a89f285c6931a6ef1d2dbf	</td><td style='mso-number-format:'@';'>select count(1)
        from CSBS_INSTRUCTION CI
        left join bank_account ba on ci.BANK_ACCOUNT_ID = ba.bank_account_id
        where 1=1
         
         
         
            and (
            CI.CREATED_AT >= trunc(cast(? as timestamp)) and CI.CREATED_AT <trunc(cast(? as timestamp))+1
            or
            CI.DELIVER_DATE1 between to_char(cast(? as timestamp),'yyyymmdd') and to_char(cast(? as timestamp),'yyyymmdd')
            )
         
         
         
         
         
         
         
         
         
         
         
         
         
         

         

        
         
         
         
         
          and ci.BANK_ACCOUNT_ID like '%'||?||'%' 
         
         
         
            
            and (
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NULL)
            OR
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NOT NULL and exists (
            SELECT IP.YHBH FROM ip_staff_stmt ip,SAD_CC S
            WHERE S.BRANCHID = ip.ssjg
            AND ip.yhbh = ?
            AND S.RANGE IN (
            SUBSTR( ci.bank_account_id,0,2),
            SUBSTR( ci.bank_account_id,0,5) )
             
        AND EXISTS (
                select 1
				from (
					select a.bank_account_id,
						pro.PRODUCT_ID,
						pro.ind_branchid as ind_branchid,
						ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN
					from auxiliary_product a
					inner join product pro on pro.product_id = a.product_id
					where a.effectstatus = '1' AND a.BANK_ACCOUNT_ID = ci.BANK_ACCOUNT_ID AND pro.IND_BRANCHID = S.BRANCHID
				) aup
				where aup.rown = 1
            )
     
            UNION ALL
            SELECT IP.YHBH FROM sad_bow sb, ip_staff_stmt ip
            WHERE ip.yhbh = ?
            AND sb.effectstatus = '1'
            AND ip.ssjg = sb.branchid
            AND sb.borwlist = '1'
            AND sb.accou	</td><td style='mso-number-format:'@';'>2620	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>156	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>50b89191321e89021f59975a6930fd2f	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2025 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg	</td><td style='mso-number-format:'@';'>2600	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>157	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>d6b6bb8b35d346100db103f02d012723	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select
        CI.PK_ID1,
        CI.DEAL_ID,
        CI.INSTR_ID,
        CI.BUSINESS_ID,
        CI.PRODUCT_ID,
        CI.PRODUCT_NAME,
        CI.MANAGER_ID,
        CI.MANAGER_NAME,
        CI.OPD_BRANCH_ID,
        CI.ACCOUNT_TYPE,
        CI.ACCOUNT_ID,
        CI.COUNTER_ACCOUNT_ID,
        CI.ACCOUNT_NAME,
        CI.COUNTER_ACCOUNT_NAME,
        CI.BUSINESS_TYPE,
        CI.INSTR_STATUS,
        CI.COUNTER_STATUS,
        CI.OUR_STATUS,
        CI.OP_TYPE,NOTE_FLAG,
        CI.AUTOCONFIRM_FLAG,
        CI.NOTE_ID,
        decode(CI.NOTE_ID,null,'0','1') BIND_STATUS,
        CI.RECORD_STATUS,
        CI.FOUREYESSTATUS,
        CI.AUDIT_COMMENT,
        CI.BOND_COUNT,
        CI.DELIVER_DATE1,
        CI.DELIVER_DATE2,
        CI.CREATED_AT,
        CI.MARKET_TYPE,
        decode(CI.ACCOUNT_TYPE,1,CI.OUR_STATUS,CI.COUNTER_STATUS) as OUR_CODE,
        (select a.yhmc from ip_staff a where CI.CREATED_BY = a.yhbh) as CREATED_BY,
        CI.UPDATED_AT,
        (select b.yhmc from ip_staff b where  CI.UPDATED_BY = b.yhbh)  as  UPDATED_BY,
        CI.VALIDATED_AT,
        (select c.yhmc from ip_staff c where CI.VALIDATED_BY = c.yhbh)  as   VALIDATED_BY,
        CI.INIT_SETTLE_AMOUNT,
