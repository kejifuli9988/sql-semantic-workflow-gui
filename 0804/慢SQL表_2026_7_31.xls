			</td><td style='mso-number-format:'@';'>61743	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>8	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>42afe8e22bb93acfd0cfe902240aa6a3	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH instruction_data AS (
        select
        instruction_id,product_id,payment_date,payment_type_id,direction,amount,payment_reason,source_id,credit_account,credit_account_name,debit_account,debit_account_name,bank_id,bank_name,batch,entrust,ipo_subscribe,wfid,wfsid,iterationid,position,p_instruction_id,payment_status,action_status,payment_mode,payment_at,inter_bank,same_city,message,created_at,created_by,updated_at,updated_by,instruction_type,concentrate_status,validated_by,use_id,plustype,out_instruction_id,security_code,fbank_id,fbank_name,fdqh,fjgh,sdqh,sjgh,db_product_id,realtime_status,parent_instruction_id,credit_acct_type_id,debit_acct_type_id,credit_account_id,debit_account_id,currency,withdraw,voucher,business_type,cash,credit_card,post_route,payment_level,business_subject,summary,custom_type,business_category,channel,account_voucher,account_password,futher_code,futher_password,core_interface,counter_cashflow,qsxwh,wxfxzyxx,interface_code,hsbz,sub_type_id,message_v,zqzh,zqdm,return_msg,autopay,trade_type,instr_gen_source,enteraccount_flag,lock_status,role_id,core_msg,final_paymentstatus,ztczfjg,ldsjms,kh_paymentstatus,core_instruction_type,cfcs,beiyong1,zlscfsj,showcomeaccount,paymentway,faxpushtime,nextdateinstructionid,instruc_batch,instruc_batch_flag,instruc_batch_sum,instruc_batch_detail,user_subsidiary_organ,zyzxretfaxtime,zyzxretmsg,zyzxbz,activity_center_status,activity_center_flag,activity_center_message,ywlsh,zjtzzh,qhgsdm,instr_jbr,instr_fhr,batchinsno,successful_paid_at,pay_lock_status,pay_lock_user,remark,tgt_qdzlbh,auto_remark,is_emergency_payment,timestamp,discard_flag,priority,db_status,white_flge,mzbz,export_flag,proiority_sub,csds_business_type,whether_pass_auxiliary,auxiliary_account,virtual_product_name,deal_org_no,instruction_model,out_org_no,cust_prd_code,cust_cancel_status,cust_prd_name,manager_id,payflg,core_instruction_id,dfkssj,supervision_sign,supervisory_opinion,instruc	</td><td style='mso-number-format:'@';'>59048	</td><td style='mso-number-format:'@';'>105	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>9	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f53b634722f1874f866a2366dada3d5e	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT CASHFLOW_ID,
		       PRODUCT_ID,
		       (SELECT P.PRODUCT_NAME
		          FROM PRODUCT P
		         WHERE P.PRODUCT_ID = RES.PRODUCT_ID
		         ) PRODUCT_NAME,
		        (SELECT P.MANAGER_PROD
		          FROM PRODUCT P
		         WHERE P.PRODUCT_ID = RES.PRODUCT_ID
		           AND P.EFFECTSTATUS = '1') MANAGER_PROD,
		       (SELECT P.PRODUCT_CODE
		          FROM PRODUCT P
		         WHERE P.PRODUCT_ID = RES.PRODUCT_ID
		           ) PRODUCT_CODE,
		       ACCOUNT_ID,
		       (SELECT BA.BANK_ACCOUNT_NAME
		          FROM BANKACCANDUNUSEACC BA
		         WHERE BA.BANK_ACCOUNT_ID = RES.ACCOUNT_ID
		           AND BA.ACCOUNT_TYPE_ID = RES.ACCOUNT_TYPE_ID
		           
		        UNION
		        SELECT CA.ACCOUNT_NAME
		          FROM CSDS_ACCOUNT CA
		         WHERE CA.CSDS_ACCOUNT_ID = RES.ACCOUNT_ID
		           AND CA.ACCOUNT_TYPE_ID = RES.ACCOUNT_TYPE_ID
		           AND CA.EFFECTSTATUS = '1') ACCOUNT_NAME,
		       ACCOUNT_TYPE_ID,
		       (SELECT AT.ACCOUNT_TYPE_NAME
		          FROM ACCOUNT_TYPE AT
		         WHERE AT.ACCOUNT_TYPE_ID = RES.ACCOUNT_TYPE_ID) ACCOUNT_TYPE_NAME,
		       CASHFLOW_AT,
		       CASHFLOW_TIME,
		       INSTRUCTION_ID,
		       SUB_ID,
		       COUNTER_CASHFLOW,
		       CREDIT_ACCOUNT,
		       CREDIT_ACCOUNT_NAME,
		       DEBIT_ACCOUNT,
		       DEBIT_ACCOUNT_NAME,
		       DIRECTION,
		       PAYMENT_TYPE_ID,
		       (SELECT PT.PAYMENT_TYPE_NAME
		          FROM PAYMENT_TYPE PT
		         WHERE PT.PAYMENT_TYPE_ID = RES.PAYMENT_TYPE_ID) PAYMENT_TYPE_NAME,
		       AMOUNT,
		       BALANCE_BEFORE,
		       BALANCE_AFTER,
		       CURRENCY,
		       TRANSACTION_CODE,
		       (SELECT zydhb.zydh||'-'||zydhb.zymc FROM ZYDHB zydhb WHERE zydhb.effectstatus='1' AND zydhb.zydh = SUMMARY) SUMMARY,
		       MESSAGE,
		       REMARK,
		       
			   to_Date(to_char(NVL(CREATED_AT,CASHFLOW_AT), 'yyyy/MM/dd')||CASHFLOW_TIME,'yyyy/MM/ddhh24miss') CREATED_AT,   
		       CRE	</td><td style='mso-number-format:'@';'>47108	</td><td style='mso-number-format:'@';'>21	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>10	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c4c283b1ec003d93c47a5ce4ef551524	</td><td style='mso-number-format:'@';'>SELECT * FROM (
		
select pc.code_id pPRODUCT_ID,
       qp.*,
       (SELECT p.PRODUCT_CODE
          FROM product p
         WHERE p.effectstatus = '1'
           AND p.PRODUCT_ID = pc.code_id) AS PRODUCT_CODE,
       decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT
  from qhld_parameter qp, para_code pc
 WHERE qp.effectstatus = '1'
   AND qp.TERMINATE_FLAG != '1'
   and qp.IS_INS_CHECK = '1'
     and qp.PAYMENT_TYPE_ID = ? 
   AND qp.manager_id is not null
   AND qp.product_id is not null
   and qp.product_id = pc.para_key
union

select p.product_id pPRODUCT_ID,
       qp.*,
       p.product_code PRODUCT_CODE,
       decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT
  from qhld_parameter qp, product p, para_code pc
 where qp.effectstatus = '1'
   and qp.terminate_flag != '1'
   and qp.IS_INS_CHECK = '1'
   AND ((QP.BRANCH_ID IS NOT NULL AND QP.BRANCH_ID = P.OPD_BRANCHID) OR QP.BRANCH_ID IS NULL)
   AND ((QP.IND_BRANCH_ID IS NOT NULL AND QP.IND_BRANCH_ID = P.IND_BRANCHID) OR QP.IND_BRANCH_ID IS NULL)
   and pc.para_key = qp.PRODUCT_TYPE_ID
   AND qp.product_id is null
   AND qp.manager_id is not null
   AND qp.product_type_id is not null
   and p.product_type_id = pc.code_id
   and p.manager_id = qp.manager_id
   and p.effectstatus = '1'
     and qp.PAYMENT_TYPE_ID = ? 
   and not exists (select 1
          from qhld_parameter qhld, para_code pcp
         where qhld.product_id is not null
           and qhld.manager_id = qp.manager_id
           and qhld.product_id = pcp.para_key
           and pcp.code_id = p.product_id
           and qhld.terminate_flag != '1'
            and qhld.IS_INS_CHECK = '1'
           and qhld.effectstatus = '1'
             and qhld.payment_type_id = ? 
           )
u	</td><td style='mso-number-format:'@';'>38601	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>11	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7b06c102606dca94dd3711bb1e77be9f	</td><td style='mso-number-format:'@';'>BEGIN
        DBMS_STATS.GATHER_TABLE_STATS(?,?);
        END;	</td><td style='mso-number-format:'@';'>38142	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>12	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>e39578ce4eeef523c0908987f8515be5	</td><td style='mso-number-format:'@';'>SELECT COUNT(1) FROM (SELECT I.*, TRUNC(NVL(I.PAYMENT_AT, I.PAYMENT_DATE)) AS idx1, decode(I.DIRECTION, '0', I.CREDIT_ACCOUNT, '1', I.DEBIT_ACCOUNT) AS idx2 FROM INSTRUCTION I WHERE I.PAYMENT_STATUS != '3' AND ((I.SOURCE_ID = '6' AND I.ACTION_STATUS = '0') OR I.ACTION_STATUS IN ('7', '9', '10', '11', '12', '13', '14', '15', '16')) AND (I.FINAL_PAYMENTSTATUS IS NULL OR I.FINAL_PAYMENTSTATUS != '7')) I WHERE I.idx1 = TO_DATE(?, 'YYYYMMDD') AND I.idx2 = ?	</td><td style='mso-number-format:'@';'>37850	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>13	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>af06968651e66594b36cb2ac9cf80191	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select * from ( SELECT z.instruction_id, z.priority, z.payment_date, z.final_paymentstatus, z.created_at FROM instruction z INNER JOIN product p ON z.product_id = p.product_id WHERE z.product_id = ? AND z.instruc_batch_flag IN ('0', '-1') AND z.INSTRUCTION_MODEL != '0' AND (z.payment_type_id IS NULL OR z.payment_type_id != 'QSCNDB' OR (z.payment_type_id = 'QSCNDB' AND z.CSDS_BUSINESS_TYPE IS NULL AND z.source_id = '3') OR (z.payment_type_id = 'QSCNDB' AND z.source_id = '0')) AND z.PAYMENT_AT >= trunc(cast(? AS timestamp)) AND z.PAYMENT_AT < trunc(cast(? AS timestamp) + 1) AND (z.product_id IS NULL OR nvl((SELECT psi.system_flag FROM prod_switch_info psi WHERE psi.product_id = z.product_id), '1') = ?) UNION ALL SELECT z.instruction_id, z.priority, z.payment_date, z.final_paymentstatus, z.created_at FROM instruction_2026 z INNER JOIN product p ON z.product_id = p.product_id WHERE z.product_id = ? AND z.instruc_batch_flag IN ('0', '-1') AND z.INSTRUCTION_MODEL != '0' AND (z.payment_type_id IS NULL OR z.payment_type_id != 'QSCNDB' OR (z.payment_type_id = 'QSCNDB' AND z.CSDS_BUSINESS_TYPE IS NULL AND z.source_id = '3') OR (z.payment_type_id = 'QSCNDB' AND z.source_id = '0')) AND z.PAYMENT_AT >= trunc(cast(? AS timestamp)) AND z.PAYMENT_AT < trunc(cast(? AS timestamp) + 1) AND (z.product_id IS NULL OR nvl((SELECT psi.system_flag FROM prod_switch_info psi WHERE psi.product_id = z.product_id), '1') = ?) ) ORDER BY priority DESC NULLS LAST ,payment_date DESC ,decode(final_paymentstatus, '3', '-1', final_paymentstatus) DESC NULLS FIRST ,created_at ASC ) row_ ) where rownum_ > 0 and rownum_ <= 20	</td><td style='mso-number-format:'@';'>34291	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>14	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>faf576a70c51324c5f86c65111896d5f	</td><td style='mso-number-format:'@';'>SELECT I.INSTRUCTION_ID instructionId,
		I.CREDIT_ACCOUNT creditAccount,
		I.DIRECTION direction,
		I.PAYMENT_AT paymentAt
		FROM INSTRUCTION I
  		left join  EC_INSTRUCTION E on E.INSTRUCTION_ID = I.INSTRUCTION_ID
  		left join INSTRUCTION_EXT IE on I.INSTRUCTION_ID = IE.INSTRUCTION_ID
 		WHERE I.PAYMENT_TYPE_ID = 'JGXCK'
   			AND (E.GENERATE != '8' OR I.SOURCE_ID != '2')
  			AND I.ANO_SYS_STAT IN ('1', '3')
  			AND I.PAYMENT_AT BETWEEN TRUNC(SYSDATE - 15) AND TRUNC(SYSDATE)
			AND IE.INSTRUCTION_PARAM_NAME = 'CryInDt' 
			AND IE.INSTRUCTION_PARAM_VALUE  <=  to_char(sysdate,'yyyyMMdd')	</td><td style='mso-number-format:'@';'>33265	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>15	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>1093d17c4db963ce4e49d9bcc14e80be	</td><td style='mso-number-format:'@';'>merge into CSBS_CONTRACT a USING(
		   
