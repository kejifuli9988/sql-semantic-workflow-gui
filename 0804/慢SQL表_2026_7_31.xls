                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   ) 
                AND NOT EXISTS(
                   	SELECT 1
					  FROM CheckUnuseProduct c
					 WHERE  BA.PRODUCT_ID = c.PRODUCT_ID
                   )
		) T	</td><td style='mso-number-format:'@';'>3101	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>131	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>693f6f767fd95da8708beedaa30546ab	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT
