		cc.CONTRACT_PK_ID,
		PRO.PRODUCT_CODE as PRODUCT_ID,
		cc.PRODUCT_NAME,
		cc.DEAL_ID,
		cc.INSTR_ID,
		cc.GIVE_ACCOUNT_ID,
		cc.GIVE_ACCOUNT_NAME,
		cc.TAKE_ACCOUNT_ID,
		cc.TAKE_ACCOUNT_NAME,
		cc.MARKET,
		(case when cc.MARKET = '0' then (select bond_code from CSBS_BOND_INFO where instr_pkid = sio.pk_id)
		when cc.MARKET = '1' then (select bond_code from CSBS_BOND_INFO where instr_pkid = cio.pk_id) end ) bondId,
		cc.BOND_SHORT_NAME,
		cc.SETTLEMENT_AMOUNT,
		cc.SETTLEMENT_DATE,
		(case when cc.MARKET = '0' then (select sum(bond_amt) from CSBS_BOND_INFO where instr_pkid = sio.pk_id)
		when cc.MARKET = '1' then(select sum(bond_amt) from CSBS_BOND_INFO where instr_pkid = cio.pk_id) end) sttlmBd1BdAmt
		from csbs_contract cc
		left join csbs_instruction_origin  cio on cc.instr_id = cio.instr_id
		left join shch_instruction_origin  sio on cc.INSTR_ID = sio.trade_id
		left join product pro on cc.product_id = pro.product_code
		where pro.effectstatus = '1'
		 
			and cc.settlement_date = ? 
		  and pro.product_code in
			 (  
				?
			 , 
				?
			 ) 
		 
		 
			and
			(case when cc.PAYMENT_TYPE = '1' then cc.GIVE_ACCOUNT_ID
			else cc.TAKE_ACCOUNT_ID end) in
			 (  
				?
			 , 
				?
			 ) 
		 
		 
			and cc.business_type = ?
		 
		 
