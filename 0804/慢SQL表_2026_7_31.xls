                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
       	</td><td style='mso-number-format:'@';'>2563	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>161	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7e8eb361586674b0965527b9cc897d2f	</td><td style='mso-number-format:'@';'>insert into  TRUSTFEE_ARREARS_DETAIL_REPORT_HISTORY
        select * from TRUSTFEE_ARREARS_DETAIL_REPORT WHERE PRODUCT_ID IN (
           select TT.PRODUCT_ID from TRUSTFEE_ARREARS_REPORT TT
