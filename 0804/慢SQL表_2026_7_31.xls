            	</td><td style='mso-number-format:'@';'>2199	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>198	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>6c9df41659e93296cc5c8ae3633406c5	</td><td style='mso-number-format:'@';'>SELECT Z.UNIT_ID,
        ? USER_ID,
        Z.MON_MAT_TYPE,
        ? REMINDER_TYPE,
        Z.DATA_AT,
        Z.INS_ID,
        NVL(Z.PRODUCT_ID, Z.UNIT_ID) AS PRODUCT_ID,
        NVL(Z.STEP_ID, '-1') AS STEP_ID,
        (SELECT IR.CDBH FROM IP_RESMENU IR
        WHERE IR.CDURL = (CASE
        WHEN Z.STEP_ID = '2' THEN '/instructionAudit/list.do'
        ELSE '未知' END)) AS CDBH,
        NVL((SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE Z.PAYMENT_TYPE_ID = PT.PAYMENT_TYPE_ID),
        NVL((SELECT IC.MBTMZ
        FROM IP_CODEINFO IC
        WHERE IC.SJLX IN ('CSBSCSBSCSBSCSBSCSBSCSBS00010001', 'TYLTYLTYLTYLTYLTYLTYLTYL00000348')
        AND IC.MBLXBH = Z.PAYMENT_TYPE_ID),
        '划款类型为空')) AS PAYMENT_TYPE_NAME,
        (CASE
        WHEN Z.STEP_ID = '2' THEN '指令审核'
        ELSE '未知' END) AS STEP_NAME,
        NVL(Z.PAYMENT_TYPE_ID, '-1') AS PAYMENT_TYPE_ID,
        Z.DATA_TYPE,
        Z.TIME_OUT_FLAG
        FROM TIME_OUT_DATA Z
		WHERE  Z.MON_MAT_TYPE = ?
		AND  Z.DATA_AT = TRUNC(SYSDATE)
         
            AND EXISTS (
            SELECT 1 FROM DUAL
            WHERE Z.STEP_ID = '2'
            AND EXISTS (SELECT 1 FROM IP_BUTTON_LIST B, IP_RESMENU R WHERE B.CDBH = R.CDBH AND B.ACTION = 'getWhetherOperation' AND R.CDURL = '/instructionAudit/list.do'
            AND B.JSBH IN
             (  
                ?
             , 
                ?
             , 
                ?
             , 
                ?
             ) 
            AND EXISTS (SELECT 1 FROM DUAL WHERE Z.DATA_TYPE = 'INSTRUCTION'
            AND (INSTR(Z.USE_ID, ?) != 0
            OR (Z.USE_ID = '-1' AND INSTR(Z.ROLEID, B.JSBH) != 0)
            OR (Z.USE_ID = '-1' AND Z.ROLEID IS NULL) )
            AND EXISTS (
            SELECT 1 FROM PRODUCT_INFO_BRANCH P
            WHERE P.ROLEID = B.JSBH AND P.USERID = ? AND P.PRODUCT_ID = Z.PRODUCT_ID AND Z.INSTRUCTION_MODEL != '2'
            UNION ALL
            
            SELECT 1 FROM DUAL WHERE Z.INSTRUCTION_MODEL = '2'
     	</td><td style='mso-number-format:'@';'>2198	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>199	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c193e8acf71b930041100bc01feaf823	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2025 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTI	</td><td style='mso-number-format:'@';'>2179	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>200	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>8271570c3c842857d09609e33b49f3ee	</td><td style='mso-number-format:'@';'>select count(*) from (
		
		select
		CI.DEAL_ID as DEAL_ID,
		CI.INIT_SETTLE_AMOUNT as INIT_SETTLE_AMOUNT,
		NVL(CI.DELIVER_DATE1,CI.DELIVER_DATE2) as SETTLEMENT_DATE
		from CSBS_INSTRUCTION CI
		left join CRITICAL_MONITOR_SIGN cm
		on ci.instr_id = cm.RELATION_ID
		left join product pp
		on ci.product_id = pp.product_code
		where  ci.INSTR_STATUS = 'IS03'
		 
		 and  cm.OPD_CONFIRM_STATUS IS NULL 
		 
			and
			 
			(
			CI.DELIVER_DATE1 between ? and  ?
			)
			  
		 
		 
			and ci.PRODUCT_ID IN (
			select p1.PRODUCT_CODE
			FROM product p1
			WHERE p1.OPD_BRANCHID IN
			 (  
				?
			 ) 
			)
		 
		union all
		
		select
		CI.DEAL_ID as DEAL_ID,
		CI.INIT_SETTLE_AMOUNT as INIT_SETTLE_AMOUNT,
		NVL(CI.DELIVER_DATE1,CI.DELIVER_DATE2) as SETTLEMENT_DATE
		from CSBS_INSTRUCTION CI
		left join CRITICAL_MONITOR_SIGN cm
		on ci.instr_id = cm.RELATION_ID
		inner join bank_account ba on ba.bank_account_id = ci.bank_account_id
		inner join (
		select aup.ind_branchid,aup.opd_branchid,aup.bank_account_id
		from (select a.bank_account_id,
		pro.ind_branchid as ind_branchid,
		pro.opd_branchid as opd_branchid,
		ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN
		from auxiliary_product a
		inner join product pro
		on pro.product_id = a.product_id
		where a.effectstatus = '1'
		) aup
		where aup.rown = 1
		) ap
		on ap.bank_account_id = ba.bank_account_id
		where  ci.product_id is null
		and ci.INSTR_STATUS = 'IS03'
		and ba.account_attribute = '1'
		and ba.effectstatus != '2'
		 
			and ap.OPD_BRANCHID IN
			 (  
				?
			 ) 
		 
		 
		 and  cm.OPD_CONFIRM_STATUS IS NULL 
		 
			and
			 
			(
			CI.DELIVER_DATE1 between ? and  ?
			)
			  
		 
		
		union  all

		select
		cc.DEAL_ID as DEAL_ID,
		to_char(cc.SETTLEMENT_amount) as INIT_SETTLE_AMOUNT,
		cc.SETTLEMENT_DATE as SETTLEMENT_DATE
		from CSBS_CONTRACT cc
		left join CRITICAL_MONITOR_SIGN cm
		on cc.instr_id = cm.RE	</td><td style='mso-number-format:'@';'>2168	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>201	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>fce60ce69535d4ded6421f68dc9df7da	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT
         
        prod.PRODUCT_ID AS productId,
        prod.PRODUCT_NAME AS productName,
        prod.PRODUCT_CODE AS productCode,
        TO_CHAR(prod.FOUND_AT,'yyyy-MM-dd') AS foundAt,
        TO_CHAR(prod.MATURITY_AT,'yyyy-MM-dd') AS maturityAt,
        CASE
            WHEN tadr.BUSINESS_DATE > prod.MATURITY_AT THEN '0'
            ELSE '1'
        END
            AS isMaturity,
        (SELECT EA.EXTERNAL_AGENCY_NAME FROM EXTERNAL_AGENCY EA WHERE EA.EXTERNAL_AGENCY_ID = prod.MANAGER_ID) AS managerName,
        IUS1.JGMC AS opdBranchName,
        IUS2.JGMC AS marketBranchName,
        tadr.SETTLEMENT_HANDLER_NAME AS settlementHandlerName,
        tar.IS_PAYMENT_DATE_UNKNOWN AS isPaymentDateUnknown,
        tar.IS_ACCOUNT_SUFFICIENT as isAccountSufficient,
        TO_CHAR(tadr.BUSINESS_DATE,'yyyy-MM-dd') AS businessDate,
        tadr.LAST_PAY_DATE_ACC_BALANCE AS lastPayDateAccBalance,
        tadr.IS_PREPAID AS isPrepaid,
        tar.IS_FIXED_AMOUNT AS isFixedAmount,
        tadr.OPD_UNPAID_TRUSTFEE_TYPE AS opdUnpaidTrustfeeType,
        tadr.OPD_UNPAID_TRUSTFEE_DETAIL_REASON AS opdUnpaidTrustfeeDetailReason,
        tadr.MARKETING_UNPAID_TRUSTFEE_TYPE AS marketingUnpaidTrustfeeType,
        tadr.MARKETING_UNPAID_TRUSTFEE_DETAIL_REASON AS marketingUnpaidTrustfeeDetailReason,
        tadr.SPECIAL_PAY_TERMS_TYPE AS specialPayTermsType,
        tadr.IS_OPD_BRANCH_SEND_DUNLTR AS isOpdBranchSendDunltr,
        TO_CHAR(tadr.OPD_BRANCH_LAST_DUNLTR_DATE,'yyyy-MM-dd') AS opdBranchLastDunltrDate,
        tadr.OPD_BRANCH_MANAGER_FEEDBACK_TYPE AS opdBranchManagerFeedbackType,
        tadr.OPD_BRANCH_MANAGER_FEEDBACK_DETAIL AS opdBranchManagerFeedbackDetail,
        TO_CHAR(tadr.OPD_BRANCH_LAST_TRACK_DATE,'yyyy-MM-dd') AS opdBranchLastTrackDate,
        tadr.IS_MARKETING_BRANCH_SEND_DUNLTR AS isMarketingBranchSendDunltr,
        TO_CHAR(tadr.MARKETING_BRANCH_LAST_DUNLTR_DATE,'yyyy-MM-dd') AS marketingBranchLastDu	</td><td style='mso-number-format:'@';'>2159	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>202	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>676f64c9988f36675ff883f80cdd6130	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT T.BALANCE_ID,
			   T.PRODUCT_ID,
			   (SELECT P.PRODUCT_CODE FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) PRODUCT_CODE,
			   (SELECT P.MANAGER_PROD FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) MANAGER_PROD,
			   (SELECT P.PRODUCT_NAME FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) PRODUCT_NAME,
			   T.ACCOUNT_ID,
