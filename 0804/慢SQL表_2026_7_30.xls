tusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.	</td><td style='mso-number-format:'@';'>2108	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>217	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>560ab85efee8c6ad8d13355d44a9da7c	</td><td style='mso-number-format:'@';'>WITH INSTRUCTION_PARAM AS (SELECT T.INSTRUCTION_ID, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'hsgzzllx', T.INSTRUCTION_PARAM_VALUE, '')) HSGZZLLX, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'jjdm', T.INSTRUCTION_PARAM_VALUE, '')) JJDM, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'zhwhf', T.INSTRUCTION_PARAM_VALUE, '')) ZHWHF, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'cxf', T.INSTRUCTION_PARAM_VALUE, '')) CXF, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'jsf', T.INSTRUCTION_PARAM_VALUE, '')) JSF, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'qsfpbj', T.INSTRUCTION_PARAM_VALUE, '')) QSFPBJ FROM INSTRUCTION_EXT_2026 T INNER JOIN INSTRUCTION_2026 I ON T.INSTRUCTION_ID = I.INSTRUCTION_ID INNER JOIN PRODUCT P ON I.PRODUCT_ID = P.PRODUCT_ID WHERE T.INSTRUCTION_PARAM_NAME IN ('hsgzzllx', 'jjdm', 'zhwhf', 'cxf', 'jsf', 'qsfpbj') AND I.PAYMENT_TYPE_ID != 'QSCNDB' AND I.PAYMENT_STATUS = '3' AND P.EFFECTSTATUS = '1' AND P.product_code IN (?) AND i.payment_at >= to_date(?, 'yyyy/MM/dd') AND i.payment_at <= to_date(?, 'yyyy/MM/dd') GROUP BY T.INSTRUCTION_ID) SELECT * FROM (SELECT I.INSTRUCTION_ID HKDBH, I.PAYMENT_TYPE_ID HKLX, (SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE PT.PAYMENT_TYPE_ID = I.PAYMENT_TYPE_ID) HKLXMC, I.COUNTER_CASHFLOW GYLSH, IP.HSGZZLLX, IP.JJDM, IP.ZHWHF, IP.CXF, IP.JSF, IP.QSFPBJ, I.REMARK XWH, I.SOURCE_ID, NVL(NVL(NVL(NVL(NVL(NVL(I.COUNTER_CASHFLOW, IP.HSGZZLLX), IP.JJDM), IP.ZHWHF), IP.CXF), IP.JSF), IP.QSFPBJ) AS idx1 FROM INSTRUCTION_2026 I INNER JOIN PRODUCT P ON I.PRODUCT_ID = P.PRODUCT_ID LEFT JOIN INSTRUCTION_PARAM IP ON I.INSTRUCTION_ID = IP.INSTRUCTION_ID WHERE I.PAYMENT_TYPE_ID != 'QSCNDB' AND I.PAYMENT_STATUS IN ('3', '8') AND P.EFFECTSTATUS = '1' AND I.INSTRUC_BATCH_FLAG != '1' AND (I.P_INSTRUCTION_ID != '0' OR I.P_INSTRUCTION_ID IS NULL) AND p.product_code IN (?) AND i.payment_at >= to_date(?, 'yyyy/MM/dd') AND i.payment_at <= to_date(?, 'yyyy/MM/dd')) t WHERE t.idx1 IS NOT NULL OR (t.SOURCE_ID = '4' AND t.HKLX = 'FYZF03')	</td><td style='mso-number-format:'@';'>2099	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>218	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>1d98c127018f99cd91d18ce2db0ebbfd	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT
        cashflow_id AS cashflowId,
