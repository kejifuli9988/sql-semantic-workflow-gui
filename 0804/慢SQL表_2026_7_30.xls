		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   ) 
                AND NOT EXISTS(
                   	SELECT 1
					  FROM CheckUnuseProduct c
					 WHERE  BA.PRODUCT_ID = c.PRODUCT_ID
                   )
		) T	</td><td style='mso-number-format:'@';'>3167	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>129	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a31d6e6ee703c1387e1da7368df5923e	</td><td style='mso-number-format:'@';'>SELECT * FROM (SELECT ROWNUM R, T.* FROM (select serialno,count(1) from task_log group by serialno having count(1) > 1 union all select serialno,count(1) from applog group by serialno having count(1) > 1 union all select qdii_id,count(1) from foreign_position_balance group by qdii_id having count(1) > 1) T) T WHERE T.R > 0 AND T.R <= 5000	</td><td style='mso-number-format:'@';'>3160	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>130	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>9c4f733aa34d7a0a72896dc57311113c	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
