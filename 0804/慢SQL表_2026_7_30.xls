        (SELECT z.instruction_id,
        CASE
        WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND
        z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN
        NVL((SELECT CASE
        WHEN rtgs.shch_stop_status = '1' THEN
        '9'
        ELSE
        rtgs.shch_draw_status
