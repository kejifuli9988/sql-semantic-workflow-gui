        from CSBS_INSTRUCTION CI
        left join bank_account ba on ci.BANK_ACCOUNT_ID = ba.bank_account_id
        where 1=1
         
         
         
            and (
            CI.CREATED_AT >= trunc(cast(? as timestamp)) and CI.CREATED_AT <trunc(cast(? as timestamp))+1
            or
            CI.DELIVER_DATE1 between to_char(cast(? as timestamp),'yyyymmdd') and to_char(cast(? as timestamp),'yyyymmdd')
            )
         
         
         
         
         
         
         
         
         
         
         
         
         
         
            and ((ACCOUNT_TYPE =1 and OUR_STATUS = ?) or (ACCOUNT_TYPE =2 and COUNTER_STATUS = ?))
         

         

        
         
         
         
         
         
         
         
         
            
            and (
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NULL)
            OR
            (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NOT NULL and exists (
            SELECT IP.YHBH FROM ip_staff_stmt ip,SAD_CC S
            WHERE S.BRANCHID = ip.ssjg
            AND ip.yhbh = ?
            AND S.RANGE IN (
            SUBSTR( ci.bank_account_id,0,2),
            SUBSTR( ci.bank_account_id,0,5) )
             
        AND EXISTS (
                select 1
				from (
					select a.bank_account_id,
						pro.PRODUCT_ID,
						pro.ind_branchid as ind_branchid,
						ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN
					from auxiliary_product a
					inner join product pro on pro.product_id = a.product_id
					where a.effectstatus = '1' AND a.BANK_ACCOUNT_ID = ci.BANK_ACCOUNT_ID AND pro.IND_BRANCHID = S.BRANCHID
				) aup
				where aup.rown = 1
            )
     
            UNION ALL
            SELECT IP.YHBH FROM sad_bow sb, ip_staff_stmt ip
            WHERE ip.yhbh = ?
            AND sb.effectstatus = '1'
            AND ip.ssjg = sb	</td><td style='mso-number-format:'@';'>11829	</td><td style='mso-number-format:'@';'>11	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>40	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c34d8a2206ac0bf77385458c88f712e7	</td><td style='mso-number-format:'@';'>SELECT DISTINCT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN shch_stop_status = '1' THEN '9' ELSE shch_draw_status END) shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') ELSE '' END) AS shchDrawStatus, z.product_id, p.product_name cpmc, p.glr, p.manager_id, (SELECT ip.jgmc FROM ip_unit_stmt ip WHERE ip.zj = p.opd_branchid) cpyyjg, p.operation_mode cpyyms, p.opd_branchid opdbranchid, p.ind_branchid indBranchid, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id AND pt.effectstatus = '1') hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, z.final_paymentstatus, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS tempFinalStatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CENTER_FLAG, z.ACTIVITY_CENTER_MESSAGE, nvl(z.faxpushtime, z.CREATED_AT) faxpushtime, '1' is_emergency_payment, z.timestamp, z.priority, z.SHOWCOMEACCOUNT, z.PAYMENTWAY, z.message, z.WHETHER_PASS_AUXILIARY, z.trade_type, z.CORE_MSG, z.currency bz, z.export_flag, z.instruction_type, z.actio	</td><td style='mso-number-format:'@';'>11522	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>41	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f3d8e30c1e642a39887fc36e268ee06b	</td><td style='mso-number-format:'@';'>INSERT INTO BALANCE_HISTORY
			  (BALANCE_HISTORY_ID,
			   PRODUCT_ID,
			   ACCOUNT_ID,
			   ACCOUNT_TYPE_ID,
			   BALANCE_DATE,
			   AMOUNT,
			   CREATED_AT,
		       CREATED_BY,
		       UPDATED_AT,
		       UPDATED_BY)
			  SELECT B.BALANCE_ID,
			         B.PRODUCT_ID,
			         B.ACCOUNT_ID,
			         B.ACCOUNT_TYPE_ID,
			         ?,
			         B.AMOUNT,
			         B.CREATED_AT,
			         B.CREATED_BY,
			         sysdate,
			         B.UPDATED_BY
			    FROM BALANCE B
			   WHERE B.BALANCE_DATE = ?
			      
			       AND B.ACCOUNT_TYPE_ID = ?	</td><td style='mso-number-format:'@';'>11258	</td><td style='mso-number-format:'@';'>11	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>42	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>4f63c210d25ca4aacf2d43b384769225	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select pk_id,qhld_id, payment_type_id, debit_account, debit_account_name, bank_id, bank_name,
       riskfee_debit_account, riskfee_debit_account_name, riskfee_bank_id, riskfee_bank_name,
       payment_rate, date_property, payment_day, payment_time,finance_time,finance_date_property, inter_bank, branch_id,ind_branch_id,start_at,end_at,
       (select aa.jgmc
           from ip_unit_stmt aa
          where aa.zj = z.branch_id
            and aa.effectstatus = '1') as branch_name,
            (select aa.jgmc
           from ip_unit_stmt aa
          where aa.zj = z.ind_branch_id
            and aa.effectstatus = '1') as ind_branch_name,
         (case payment_type_id when 'FYZF03' then to_char(get_values(z.manager_id)) else manager_id end) manager_id,
		  (case payment_type_id when 'FYZF03' then get_names(z.manager_id,'manager') else (select d.external_agency_name
			from external_agency d
			where d.effectstatus = '1'
			and z.manager_id = d.external_agency_id) end)    as managername,

            effectstatus, op_type,
       foureyesstatus, audit_comment, created_at, created_by, updated_at, updated_by, validated_at,
       validated_by, whether_fax, riskfee_ratio, get_values(z.product_type_id,1) as product_type_id,
       get_names(z.product_type_id, 'product_type',1) as product_type_name,
       get_values(z.product_id,1) as product_id, get_names(z.product_id, 'product',1) as product_name,
       get_values(z.seat_id,1) as seat_id, get_names(z.seat_id, 'seat',1) as seat_code,
       get_values(z.broker_id,1) as broker_id, get_names(z.broker_id, 'broker',1) as broker_name,
       (select a.yhmc from ip_staff a where z.created_by = a.yhbh) as createdbyname,
       (select b.yhmc from ip_staff b where z.updated_by = b.yhbh) as updatedbyname,
       (select c.yhmc from ip_staff c where z.validated_by = c.yhbh) as validatedbyname,
       riskfee_inter_bank,created_ci,remark,is_push, TERMINATE_FLAG, TERMINATE_STAT	</td><td style='mso-number-format:'@';'>11125	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>43	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f17692f01a3361149dd91bcd3a451be9	</td><td style='mso-number-format:'@';'>WITH QX_SQL AS
		(SELECT WM_CONCAT(PRO_IND_BRANCHID) AS BRANCHID
		FROM CNZL_AUTHPAR
		WHERE INSTR(USER_BRANCHID, 'G00017713') > 0
		AND EFFECTSTATUS = '1'
		AND FOUREYESSTATUS = '1'),
		CHECK_NUM AS
		(SELECT COUNT(1) C
		FROM CNZL_AUTHPAR
		WHERE INSTR(PRO_IND_BRANCHID, '') > 0
		AND EFFECTSTATUS = '1'
		AND FOUREYESSTATUS = '1')
		SELECT Z.UNIT_ID,
		? USER_ID,
		Z.MON_MAT_TYPE,
		? REMINDER_TYPE,
		Z.DATA_AT,
		Z.INS_ID,
		NVL(Z.PRODUCT_ID, Z.UNIT_ID) AS PRODUCT_ID,
		NVL(Z.STEP_ID, '-1') AS STEP_ID,
		(SELECT IR.CDBH FROM IP_RESMENU IR
		WHERE IR.CDURL = (CASE
		WHEN Z.STEP_ID = '0' THEN '/instruction/list.do'
		WHEN Z.STEP_ID = '1' THEN '/instructionCheck/list.do'
		WHEN Z.STEP_ID = '2' THEN '/instructionAudit/list.do'
		WHEN Z.STEP_ID = '3' THEN '/stmtAudit/list.do'
		WHEN Z.STEP_ID = '4' THEN '/stmtExecuteManage/list.do'
		WHEN Z.STEP_ID = '5' THEN '/stmtExecuteCheck/list.do'
		WHEN Z.STEP_ID = '6' THEN '/stmtPayment/list.do'
		WHEN Z.STEP_ID = '7' THEN '/csbsInstruction/list.do'
