		null P_INSTRUCTION_ID,
		null PAYMENT_STATUS,
		z.ACTION_STATUS ACTION_STATUS,
		null PAYMENT_MODE,
		z.PAYMENT_AT PAYMENT_AT,
		null INTER_BANK,
		null SAME_CITY,
		null MESSAGE,
		z.CREATED_AT CREATED_AT,
		z.CREATED_BY CREATED_BY,
		z.UPDATED_AT UPDATED_AT,
		z.UPDATED_BY UPDATED_BY,
		'0' INSTRUCTION_TYPE,
