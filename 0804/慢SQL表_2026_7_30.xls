                  	  AND BH.ACCO	</td><td style='mso-number-format:'@';'>2663	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>160	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>dbd23ab629da60702f39375ead325928	</td><td style='mso-number-format:'@';'>select
		count(accountId)
		from (
		SELECT *
		FROM (
		SELECT
		gg.bank_account_id AS accountId,
		gg.bank_account_name AS accountName,
		gg.IND_BRANCHID AS indBranchId,
		i.JGMC AS indBranchName,
		COALESCE(gg.BANK_ID, d.BANK_ID) AS bankId,
		COALESCE(gg.BANK_NAME, d.BANK_NAME) AS bankName,
		gg.ACCOUNT_TYPE_ID AS accountTypeId,
		at.ACCOUNT_TYPE_NAME AS accountTypeName,
		gg.AREA_DISTRICT AS areaDistrict,
		gg.currency AS currency,
		aa.mbtmz AS currencyName,
		gg.DEDICATED AS dedicated,
		CASE WHEN gg.DEDICATED = '0' THEN '共用' ELSE '独用' END AS dedicatedName,
		gg.EFFECTSTATUS AS effectstatus,
		ac.mbtmz AS effectstatusName,
		gg.ACCOUNT_ATTRIBUTE AS accountAttribute,
		gg.FOUREYESSTATUS AS foureyesstatus
		FROM bankAccAndUnuseAcc gg
		JOIN ACCOUNT_TYPE at ON at.ACCOUNT_TYPE_ID = gg.ACCOUNT_TYPE_ID
		LEFT JOIN IP_UNIT_STMT i ON i.ZJ = gg.IND_BRANCHID AND i.EFFECTSTATUS = '1'
		LEFT JOIN UNIT_BANK d ON gg.AREA_DISTRICT = d.DQDH || d.JGDH
		LEFT JOIN ip_codeinfo aa ON aa.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000003' AND aa.mblxbh = gg.currency
		LEFT JOIN ip_codeinfo ac ON ac.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000008' AND ac.mblxbh = gg.EFFECTSTATUS
		WHERE at.effectstatus = '1'
		 
			and (gg.ACCOUNT_TYPE_ID != 'CKZH' or   gg.ACCOUNT_TYPE_ID is null)
		 
		 
		 
			and gg.IND_BRANCHID in (select uib.branchid FROM user_info_branch uib WHERE uib.userid=? and uib.EFFECTSTATUS = '1')
		 
		 
		 
		 
		 
			union all
			select
			gg.bank_account_id as accountId,
			gg.bank_account_name as accountName,
			gg.IND_BRANCHID as indBranchId,
			(select i.JGMC from IP_UNIT_STMT i where i.ZJ = gg.IND_BRANCHID and i.EFFECTSTATUS='1') as indBranchName,
			gg.bank_id as bankId,
			gg.bank_name as bankName,
			gg.ACCOUNT_TYPE_ID as accountTypeId,
			at.ACCOUNT_TYPE_NAME as accountTypeName,
			gg.AREA_DISTRICT as areaDistrict,
			gg.currency as currency,
			(select aa.mbtmz from ip_codeinfo aa where aa.sjlx='TYLTYLTYLTYLTYLTYLTYLTYL00000003' and aa.mblxbh = gg.currency) as currencyName	</td><td style='mso-number-format:'@';'>2655	</td><td style='mso-number-format:'@';'>25	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>161	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>60fea9a08c467ee250ea2a50bc011c5b	</td><td style='mso-number-format:'@';'>SELECT 
			P.PRODUCT_ID PRODUCT_ID,
			NVL(DBI.AMOUNT, 0) ALLOCATION_AMOUNT,
			NVL(I.PAID_AMOUNT, 0) PAID_AMOUNT,
			I.UNPAID_UNCOMBINED_INSTRUCTION_IDS UNPAID_UNCOMBINED_INSTRUCTION_IDS,
			NVL(I.UNPAID_AMOUNT, 0) UNPAID_AMOUNT,
			NVL(I.UNPAID_UNCOMBINED_AMOUNT, 0) UNPAID_UNCOMBINED_AMOUNT
		FROM 
			(
				SELECT 
					DISTINCT T.PRODUCT_ID
				FROM 
					INSTRUCTION T 
				WHERE 
					T.CSDS_BUSINESS_TYPE = ?
					AND PAYMENT_DATE = TO_DATE(?,'yyyyMMdd')
					AND ACTION_STATUS IS NULL
					AND PAYMENT_TYPE_ID = 'QSCNDB'
					AND SOURCE_ID = '3'
			) P
		LEFT JOIN
			(
				SELECT 
					T.PRODUCT_ID,
					(
						SELECT 
							WM_CONCAT(INS.INSTRUCTION_ID)
						FROM 
							INSTRUCTION INS 
						WHERE 
							T.PRODUCT_ID = INS.PRODUCT_ID 
							AND INS.PAYMENT_TYPE_ID = 'QSCNDB'
							AND INS.ACTION_STATUS IS NOT NULL
							AND INS.ACTION_STATUS != '3'
							AND INS.PAYMENT_DATE = TO_DATE(?,'yyyyMMdd')
							AND INS.PAYMENT_STATUS NOT IN ('2','3')
							AND INS.SOURCE_ID = '3'
							AND NOT EXISTS(select 1 from INSTRUCTION_EXT ext,product p WHERE ext.INSTRUCTION_ID = INS.INSTRUCTION_ID 
                          					AND ext.INSTRUCTION_PARAM_NAME = 'jxFlag' AND ext.INSTRUCTION_PARAM_VALUE = '0'
                          					and p.product_id = INS.product_id and p.LQFII_flag = '0')
					) AS UNPAID_UNCOMBINED_INSTRUCTION_IDS,
					SUM(CASE WHEN 
						T.PAYMENT_STATUS IN ('2','3')
					THEN 
						CASE WHEN T.DIRECTION = '0' THEN -1 * T.AMOUNT ELSE T.AMOUNT END
					ELSE 
						0
					END) PAID_AMOUNT,
					SUM(CASE WHEN
						T.PAYMENT_STATUS NOT IN ('2','3') 
					THEN 
						CASE WHEN T.DIRECTION = '0' THEN -1 * T.AMOUNT ELSE T.AMOUNT END
					ELSE 
						0
					END) UNPAID_AMOUNT,
					SUM(CASE WHEN
						T.PAYMENT_STATUS NOT IN ('2','3') AND T.ACTION_STATUS IS NOT NULL
					THEN 
						CASE WHEN T.DIRECTION = '0' THEN -1 * T.AMOUNT ELSE T.AMOUNT END
					ELSE 
						0
					END) UNPAID_UNCOMBINED_AMOUNT
				FROM 
					INSTRUCTION T
				WHERE 
						</td><td style='mso-number-format:'@';'>2652	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>162	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>ad1985b73f0fd2bc0ce2e9300af4e4b2	</td><td style='mso-number-format:'@';'>merge into  SHCH_SUMMARY_STATEMENT cs
