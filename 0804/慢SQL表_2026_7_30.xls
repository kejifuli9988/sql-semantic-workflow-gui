	       		(SELECT CA.ACCOUNT_NAME FROM CSDS_ACCOUNT CA WHERE CA.CSDS_ACCOUNT_ID = BA.ACCOUNT_ID AND CA.ACCOUNT_TYPE_ID = BA.ACCOUNT_TYPE_ID) ACCOUNT_NAME,
	       		CASE BA.ACCOUNT_TYPE_ID
	       		WHEN 'ZHLX15' THEN 'ZHLX07'
	       		WHEN 'ZHLX16' THEN 'ZHLX09'
	       		WHEN 'ZHLX17' THEN 'ZHLX13'
	       		WHEN 'ZHLX18' THEN 'ZHLX15'
	       		WHEN 'ZHLX19' THEN 'ZHLX_SHJCBZJ'
	       		WHEN 'ZHLX20' THEN 'ZHLX_SZ_JCBZJ'
	       		WHEN 'ZHLX21' THEN 'ZHLX16'
	       		WHEN 'ZHLX27' THEN 'ZHLX06'
	       		WHEN 'ZHLX28' THEN 'ZHLX08'
	       		WHEN 'ZHLX29' THEN 'ZHLX12'
	       		WHEN 'ZHLX30' THEN 'ZHLX14'
	       		WHEN 'ZHLX31' THEN 'ZHLX56'
	       		WHEN 'ZHLX33' THEN 'ZHLX10'
	       		WHEN 'ZHLX38' THEN 'ZHLX33'
	       		WHEN 'ZHLX39' THEN 'ZHLX34'
	       		WHEN 'ZHLX40' THEN 'ZHLX21'
	       		WHEN 'ZHLX41' THEN 'ZHLX22'
	       		WHEN 'ZHLX42' THEN 'ZHLX32'
	       		WHEN 'ZHLX43' THEN 'ZHLX36'
	       		WHEN 'ZHLX47' THEN 'ZHLX60'
	       		WHEN 'ZHLX48' THEN 'ZHLX61'
			    WHEN 'ZHLX22' THEN 'ZHLX_SZ_ETFSSBFJ'
	       		END AS ACCOUNT_TYPE_ID
	       		,
	       		(SELECT P.PRODUCT_CODE FROM PRODUCT P WHERE P.PRODUCT_ID = BA.PRODUCT_ID) PRODUCT_CODE,
