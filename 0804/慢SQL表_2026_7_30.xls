                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   ) 
                AND NOT EXISTS(
                   	SELECT 1
					  FROM CheckUnuseProduct c
					 WHERE  BA.PRODUCT_ID = c.PRODUCT_ID
                   )
		) T	</td><td style='mso-number-format:'@';'>3151	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>131	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>cbf57ecdb93bc9fd7f4bdb320e1fa857	</td><td style='mso-number-format:'@';'>SELECT AUTH_TRANSFER_PRODUCT_ID,AUTH_TRANSFER_ID,PROVIDER_ID,ROLE_ID,RECEIVER_ID,PRODUCT_ID,BIZ_DIM_TYP
		FROM AUTH_TRANSFER_PRODUCT
		WHERE AUTH_TRANSFER_STATUS = '2'
