		z.FAX_INSTRUCTION_ID,z.INSTRUCTION_ID,z.FAX_ID,z.PRODUCT_CODE,z.PAYMENT_DATE,z.PAYMENT_TYPE_ID,z.DIRECTION,z.AMOUNT,z.CURRENCY,z.PAYMENT_REASON,z.CREDIT_ACCOUNT,z.CREDIT_ACCOUNT_NAME,z.DEBIT_ACCOUNT,z.DEBIT_ACCOUNT_NAME,z.BANK_ID,z.BANK_NAME,z.sfqd,
