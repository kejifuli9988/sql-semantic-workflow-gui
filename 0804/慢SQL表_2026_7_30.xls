		SELECT DISTINCT P2.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP2 ON UA.BANK_ACCOUNT_ID = AP2.BANK_ACCOUNT_ID
		JOIN PRODUCT P2 ON AP2.PRODUCT_ID = P2.PRODUCT_ID
		WHERE
		UA.EFFECTSTATUS = '1'
		AND P2.SUB_GROUP_MARK = '0'
		)

		SELECT T.BALANCE_ID,
			   T.PRODUCT_ID,
			   T.PRODUCT_CODE,
			   T.MANAGER_PROD,
			   T.PRODUCT_NAME,
			   T.ACCOUNT_ID,
			   T.ACCOUNT_NAME,
			   T.ACCOUNT_TYPE_ID,
	           T.ACCOUNT_TYPE_NAME,
			   T.BALANCE_DATE,
			   T.AMOUNT,
			   T.CURRENCY,
			   T.CREATED_AT,
			   T.CREATED_BY,
			   T.CREATED_NAME,
			   T.UPDATED_AT,
			   T.UPDATED_BY,
			   T.UPDATED_NAME,
	           T.USABLE_BALANCE,
	           T.CONTROL_BALANCE,
	          T.FREEZE_BALANCE,
		T.ACCOUNT_SUB_SN
		 FROM
			(
			SELECT 
					BH.BALANCE_HISTORY_ID BALANCE_ID,
					BH.PRODUCT_ID,
	               	BH.ACCOUNT_ID,
	               	BH.ACCOUNT_TYPE_ID,
	               	BH.BALANCE_DATE,
	               	BH.AMOUNT,
	               	BH.CREATED_AT,
	               	BH.CREATED_BY,
	               	BH.UPDATED_AT,
	               	BH.UPDATED_BY,
	               	BH.USABLE_BALANCE,
	               	BH.CONTROL_BALANCE,
	               	BH.FREEZE_BALANCE,
		            AP.ACCOUNT_SUB_SN AS ACCOUNT_SUB_SN,
		            P.PRODUCT_CODE AS PRODUCT_CODE,
		            P.MANAGER_PROD AS MANAGER_PROD,
		            P.PRODUCT_NAME AS PRODUCT_NAME,
		            BA2.BANK_ACCOUNT_NAME AS ACCOUNT_NAME,
		            ACT.ACCOUNT_TYPE_NAME AS ACCOUNT_TYPE_NAME,
		            BA2.CURRENCY AS CURRENCY,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.CREATED_BY) AS CREATED_NAME,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.UPDATED_BY) AS UPDATED_NAME
	          FROM 	
	          		BALANCE_HISTORY BH
		LEFT JOIN ACCOUNT_PRODUCT AP ON AP.BANK_ACCOUNT_ID = BH.ACCOUNT_ID AND AP.PRODUCT_ID = BH.PRODUCT_ID AND AP.EFFECTSTATUS = '1'
		LEF	</td><td style='mso-number-format:'@';'>4473	</td><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>88	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>44a13d76c3a45867d543c09d0f25d479	</td><td style='mso-number-format:'@';'>with coreaccpro as
		     (select ap.bank_account_id, ap.product_id
			     from account_product ap, bank_account bai
			    where ap.bank_account_id = bai.bank_account_id
			      and bai.dedicated = '1'
			      and ap.effectstatus = '1'
			      AND NOT exists(
                        select APS.BANK_ACCOUNT_ID
                        from PRODUCT P   , ACCOUNT_PRODUCT APS
                        where P.PRODUCT_ID = APS.PRODUCT_ID
                        and APS.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
                        and P.EFFECTSTATUS = '1'
                        and APS.EFFECTSTATUS = '1'
			
			-- and P.PRODUCT_TYPE_ID IN ('BXDLJDR', 'DK', 'JGJY', 'ABSZJGJ', 'ZJMJ', 'JGQT')
                        group by APS.bank_account_id having count(APS.bank_account_id)>1 
                     )
			    union all
			    select ap.bank_account_id, ap.product_id
			     from account_product ap, product p, unuse_acct_inf ua
			    where ap.product_id = p.product_id
			      and ap.bank_account_id = ua.bank_account_id
			      and ap.effectstatus = '0'
			      and ua.effectstatus = '1'
			      and p.effectstatus = '0'
		         ),
		    accinfo as
		     (select cba.bank_account_id, ba.account_type_id, cap.product_id
		        from core_bank_account cba
		        left join bank_account ba
		          on cba.bank_account_id = ba.bank_account_id
		        left join coreaccpro cap
		          on decode(substr(cba.bank_account_id, 19, 24),
		                    '999999',
		                    substr(cba.bank_account_id, 0, 18),
		                    '999998',
		                    substr(cba.bank_account_id, 0, 18),
		                    cba.bank_account_id) = cap.bank_account_id
		       where not exists (select 1
		                from account_product ap, product p
		               where ap.product_id = p.product_id
		                 and ap.effectstatus = '1'
		                 and nvl(p.sub_group_mark, 1) = '1'
		                 and ba.dedicated = '0'
		           	</td><td style='mso-number-format:'@';'>4403	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>89	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>94c605c42dd75a45fe2967a7203e613a	</td><td style='mso-number-format:'@';'>select count(1)
		from
		(
		 
		
		select
		  PK_ID,INSTRUCTION_ID,FAX_ID,EC_ATTACH_ID,RECEIVE_DATE,DEAL_DATE,PRODUCT_NAME,PRODUCT_ID,
		  MANAGER_ID,MANAGER_NAME,DEAL_ID,RECORD_TYPE,RECORD_STATUS,AUDIT_COMMENT
		from (select
		  z.FAX_INSTRUCTION_ID PK_ID,z.INSTRUCTION_ID INSTRUCTION_ID,z.FAX_ID FAX_ID,'' EC_ATTACH_ID,z.PUSH_AT RECEIVE_DATE,z.CREATED_AT DEAL_DATE,
		  (SELECT p.product_name FROM product p WHERE p.PRODUCT_CODE=z.PRODUCT_CODE) as PRODUCT_NAME,z.PRODUCT_CODE PRODUCT_ID,
		  z.MANAGER_ID MANAGER_ID,z.MANAGER_NAME MANAGER_NAME,'' DEAL_ID,'1' RECORD_TYPE,z.RESULT_STATUS RECORD_STATUS,z.AUDIT_COMMENT
		from FAX_INSTRUCTION z
		where 1=1  
		  and trunc(PUSH_AT) >= trunc(to_date(?,'yyyy-mm-dd hh24:mi:ss')) 
