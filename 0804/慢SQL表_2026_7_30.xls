			,? as productName	</td><td style='mso-number-format:'@';'>29750	</td><td style='mso-number-format:'@';'>22	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>18	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>d643d0109223c69cec0d5f7734c286d8	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id AND pt.effectstatus = '1') hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CENTER_FLAG, 	</td><td style='mso-number-format:'@';'>28610	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>19	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>2bbd28d7eda5b23d8fafcdb3f22951b0	</td><td style='mso-number-format:'@';'>SELECT count(*) FROM instruction_2026 z INNER JOIN product p ON z.product_id = p.product_id WHERE z.product_id = ? AND z.instruc_batch_flag IN ('0', '-1') AND z.INSTRUCTION_MODEL != '0' AND (z.payment_type_id IS NULL OR z.payment_type_id != 'QSCNDB' OR (z.payment_type_id = 'QSCNDB' AND z.CSDS_BUSINESS_TYPE IS NULL AND z.source_id = '3') OR (z.payment_type_id = 'QSCNDB' AND z.source_id = '0')) AND z.PAYMENT_AT >= trunc(cast(? AS timestamp)) AND z.PAYMENT_AT < trunc(cast(? AS timestamp) + 1) AND z.product_id IN (SELECT pib.product_id FROM product_info_branch pib WHERE pib.roleid = (SELECT irs.jsbh FROM ip_role_stmt irs WHERE irs.jsmc = '核算经办') AND pib.userid IN (?)) AND (z.product_id IS NULL OR nvl((SELECT psi.system_flag FROM prod_switch_info psi WHERE psi.product_id = z.product_id), '1') = ?)	</td><td style='mso-number-format:'@';'>27500	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>20	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>e5be98f4bfd1d9427b1918fd0e31a714	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( with T as(
		select
		z.TRADE_ID INSTRUCTION_ID,
		z.PRODUCT_ID,
		z.LAST_UPDATE_AT as timestamp,
