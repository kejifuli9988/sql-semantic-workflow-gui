             WHERE Z.ACCOUNT_ID = ?	</td><td style='mso-number-format:'@';'>12364	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>36	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>417539d5d3bede59b1380dedcef26cfd	</td><td style='mso-number-format:'@';'>SELECT DISTINCT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN shch_stop_status = '1' THEN '9' ELSE shch_draw_status END) shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') ELSE '' END) AS shchDrawStatus, z.product_id, p.product_name cpmc, p.glr, p.manager_id, (SELECT ip.jgmc FROM ip_unit_stmt ip WHERE ip.zj = p.opd_branchid) cpyyjg, p.operation_mode cpyyms, p.opd_branchid opdbranchid, p.ind_branchid indBranchid, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id AND pt.effectstatus = '1') hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, z.final_paymentstatus, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS tempFinalStatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CENTER_FLAG, z.ACTIVITY_CENTER_MESSAGE, nvl(z.faxpushtime, z.CREATED_AT) faxpushtime, '1' is_emergency_payment, z.timestamp, z.priority, z.SHOWCOMEACCOUNT, z.PAYMENTWAY, z.message, z.WHETHER_PASS_AUXILIARY, z.trade_type, z.CORE_MSG, z.currency bz, z.export_flag, z.instruction_type, z.actio	</td><td style='mso-number-format:'@';'>12328	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>37	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f6d0a907c12d4643f2776eaaddea54d5	</td><td style='mso-number-format:'@';'>select Z.AREA_DISTRICT as Clr_Rgn_Inst_Num,
        (SELECT D.BANK_ID
