				(tt.TRAN_TYPE in ('SQHS', 'ZZHS') and tt.final_paymentstatus <> '3'
					and (tt.CONTRACT_STATUS <> 'CS00' or tt.CONTRACT_STATUS is null)) 
		 or (tt.TRAN_TYPE  in ('ZZYQFS','ZZHQ','ZTGJYSZZZ','CDTQZQ','ZQZWQHBZJ','SQHQ','SQYQFS')
