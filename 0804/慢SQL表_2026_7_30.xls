            FROM ip_role_stmt irs
            WHERE irs.jsmc IN ('核算经办', '分行核算经办')
            )
        and pib.userid in	</td><td style='mso-number-format:'@';'>4105	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>98	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>8ae169e51da4f07202116bd548f65b2d	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT t.* FROM (SELECT i.instruction_id AS zlbh, (SELECT p.product_code FROM product p WHERE p.product_id = i.product_id) AS cpdm, (SELECT p.product_name FROM product p WHERE p.product_id = i.product_id) AS cpmc, to_char(i.payment_date, 'yyyymmdd') AS zlrq, decode(i.direction, '0', 'F', '1', 'S') AS sffx, decode(sp.seq_no, NULL, sqq.jymh, '') AS jybh, sqq.zllx, i.amount AS zlje, i.credit_account_name AS ckzhhm, i.credit_account AS ckzhzh, i.bank_id AS ckzhkhh, i.debit_account_name AS skzhhm, i.debit_account AS skzhzh, i.fbank_id AS skzhkhh, i.payment_reason AS hksy, i.payment_status AS zfzt, '8' AS zlly, decode(i.p_instruction_id, '0', 'H', 'M') AS hbbs, i.p_instruction_id AS hbzlbm, decode(sz.seq_no, NULL, '', sz.jyrq) jyrq, decode(sz.seq_no, NULL, '', sz.jyfx) jyfx, decode(sz.seq_no, NULL, '', sz.zclx) zclx, decode(sz.seq_no, NULL, '', sz.zcdm) zcdm, decode(sz.seq_no, NULL, '', sz.zcmc) zcmc, decode(sz.seq_no, NULL, 0, sz.zcsl) zcsl, decode(sz.seq_no, NULL, NULL, sz.jsje) jsje, decode(sz.seq_no, NULL, 0, sz.bjzy) bjzy, decode(sz.seq_no, NULL, 0, sz.syzy) syzy, decode(sp.seq_no, NULL, '', sp.mjfs) mjfs, decode(sp.seq_no, NULL, '', sp.xjllx) xjllx, decode(sp.seq_no, NULL, '', sp.xsfh) xsfh, decode(sp.seq_no, NULL, '', sp.cjrq) cjrq, decode(sp.seq_no, NULL, '', sp.sjfsrq) sjfsrq, decode(sp.seq_no, NULL, '', sp.coin_code) bz, decode(sp.seq_no, NULL, 0, sp.lcbj) lcbj, decode(sp.seq_no, NULL, 0, sp.khsy) khsy, decode(sp.seq_no, NULL, 0, sp.xsglf) xsglf, decode(sp.seq_no, NULL, 0, sp.qdglf) qdglf, decode(sp.seq_no, NULL, 0, sp.rgf) rgf, decode(sp.seq_no, NULL, 0, sp.sgf) sgf, decode(sp.seq_no, NULL, 0, sp.shf) shf, decode(sp.seq_no, NULL, 0, sp.tgf) tgf, decode(sp.seq_no, NULL, 0, sp.tcglf) tcglf, decode(sp.seq_no, NULL, 0, sp.gzsy) gzsy, decode(sp.seq_no, NULL, '', sp.bz) beizhu, decode(sz.seq_no, NULL, '', sz.kjlx) kjlx, decode(sp.seq_no, NULL, '', sp.zcpdm) zcpdm FROM instruction i, sa_qszl sqq LEFT JOIN sa_zcde	</td><td style='mso-number-format:'@';'>4083	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>99	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b272ac395d9458381b5175c209167a39	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select rownum,t2.product_code,t2.product_name,t2.payment_type_name,t2.debit_account,t2.amount,t2.cashflow_at,t2.credit_account from(			
select p.product_code,
                       p.product_name,
                       pt.payment_type_name,
                       sc.debit_account,
                       sc.amount,
                       sc.cashflow_at,
                       sc.credit_account
                  from (select i.debit_account,i.amount,to_char(i.payment_date,'yyyyMMdd') cashflow_at,i.credit_account ,i.payment_type_id,i.product_id from instruction i,product p
                  where i.debit_account in ('051010177599010120', '051010163499000174','051010163470100148')
            and i.inter_bank = '1'
            and p.product_id=i.product_id           
                                  and  i.payment_status='3' 
                                     and i.payment_date >= ? 
   and i.payment_date <= ? 
            
   union all
                  select i.debit_account,i.amount,to_char(i.payment_date,'yyyyMMdd') cashflow_at,i.credit_account ,i.payment_type_id,i.product_id  from instruction i,product p
                  where substr(debit_account, -8, 6) in ('710001',
                                          '720003',
                                          '740001',
                                          '750001',
                                          '760001',
                                          '770001',
                                          '790001',
                                          '790002',
                                          '800001',
                                          '780001',
                                          '780002')
                               	and i.inter_bank = '1'
                                and p.product_id=i.product_id 
                                  and  i.payment_status='3'   
    and i.payment_date >= ? 
   and i.payment_d	</td><td style='mso-number-format:'@';'>3991	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>100	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b9e0c26dfc14b39c83ce103590e8dc77	</td><td style='mso-number-format:'@';'>SELECT 
				BA.BALANCE_ID,
                BA.PRODUCT_ID,
                BA.ACCOUNT_ID,
                BA.ACCOUNT_TYPE_ID,
                BA.BALANCE_DATE,
                BA.AMOUNT
          FROM
                BALANCE BA
         WHERE 
            	BA.BALANCE_DATE = ?
            	 AND BA.ACCOUNT_TYPE_ID IN (SELECT A.ACCOUNT_TYPE_ID FROM ACCOUNT_TYPE A WHERE A.SJ_ACCOUNT_TYPE_ID='zhinitcnzh0') 
            	 
           		 
		ORDER BY 
				BA.BALANCE_ID
        FOR UPDATE	</td><td style='mso-number-format:'@';'>3785	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>101	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>edae0148ff6f0c4d50d4241b1d1a2793	</td><td style='mso-number-format:'@';'>SELECT Z.UNIT_ID,
        ? USER_ID,
        Z.MON_MAT_TYPE,
        ? REMINDER_TYPE,
        Z.DATA_AT,
        Z.INS_ID,
        NVL(Z.PRODUCT_ID, Z.UNIT_ID) AS PRODUCT_ID,
        NVL(Z.STEP_ID, '-1') AS STEP_ID,
        (SELECT IR.CDBH FROM IP_RESMENU IR
        WHERE IR.CDURL = (CASE
        WHEN Z.STEP_ID = '2' THEN '/instructionAudit/list.do'
        ELSE '未知' END)) AS CDBH,
        NVL((SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE Z.PAYMENT_TYPE_ID = PT.PAYMENT_TYPE_ID),
        NVL((SELECT IC.MBTMZ
        FROM IP_CODEINFO IC
        WHERE IC.SJLX IN ('CSBSCSBSCSBSCSBSCSBSCSBS00010001', 'TYLTYLTYLTYLTYLTYLTYLTYL00000348')
        AND IC.MBLXBH = Z.PAYMENT_TYPE_ID),
        '划款类型为空')) AS PAYMENT_TYPE_NAME,
        (CASE
        WHEN Z.STEP_ID = '2' THEN '指令审核'
        ELSE '未知' END) AS STEP_NAME,
        NVL(Z.PAYMENT_TYPE_ID, '-1') AS PAYMENT_TYPE_ID,
        Z.DATA_TYPE,
        Z.TIME_OUT_FLAG
        FROM TIME_OUT_DATA Z
		WHERE  Z.MON_MAT_TYPE = ?
		AND  Z.DATA_AT = TRUNC(SYSDATE)
         
            AND EXISTS (
            SELECT 1 FROM DUAL
            WHERE Z.STEP_ID = '2'
            AND EXISTS (SELECT 1 FROM IP_BUTTON_LIST B, IP_RESMENU R WHERE B.CDBH = R.CDBH AND B.ACTION = 'getWhetherOperation' AND R.CDURL = '/instructionAudit/list.do'
            AND B.JSBH IN
             (  
                ?
             ) 
            AND EXISTS (SELECT 1 FROM DUAL WHERE Z.DATA_TYPE = 'INSTRUCTION'
            AND (INSTR(Z.USE_ID, ?) != 0
            OR (Z.USE_ID = '-1' AND INSTR(Z.ROLEID, B.JSBH) != 0)
            OR (Z.USE_ID = '-1' AND Z.ROLEID IS NULL) )
            AND EXISTS (
            SELECT 1 FROM PRODUCT_INFO_BRANCH P
            WHERE P.ROLEID = B.JSBH AND P.USERID = ? AND P.PRODUCT_ID = Z.PRODUCT_ID AND Z.INSTRUCTION_MODEL != '2'
            UNION ALL
            
