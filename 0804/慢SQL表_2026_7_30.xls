		t.INIT_SETTLE_AMOUNT , t.SETTLEMENT_DATE , t.PRODUCT_ID ,t.PRODUCT_NAME,
		t.opdConfirmStatus,t.siuationExplain,t.siuationDate,t.siuationBy,t.siuationBranch,
		t.OPD_BRANCH,
		t.IND_BRANCH,
		(select d.jgmc from ip_unit_stmt d where t.IND_BRANCH=d.zj) as IND_BRANCHID,
		(select g.jgmc from ip_unit_stmt g where t.OPD_BRANCH=g.zj) as OPD_BRANCHID,
		t.instrId from (
		
		select
		(select mbtmz
		from ip_codeinfo
		where sjlx =
		(select zj from ip_codetype where sjlxbh = 'marketType')
		and mblxbh = CI.MARKET_TYPE) AS MARKET_TYPE,
		'交易' as date_TYPE,
		(select mbtmz
		from ip_codeinfo
		where sjlx = (select zj
		from ip_codetype
		where sjlxbh = 'businessTypeCode')
		and mblxbh =  CI.BUSINESS_TYPE) AS BUSINESS_TYPE,
		'' as CONTRACT_STATUS,
		(select mbtmz
		from ip_codeinfo
		where sjlx =
		(select zj
		from ip_codetype
		where sjlxbh = 'instructionConfirmIndicatorCode')
		and mblxbh =  decode(CI.ACCOUNT_TYPE,1,CI.OUR_STATUS,CI.COUNTER_STATUS)) AS OUR_STATUS,
		CI.DEAL_ID as DEAL_ID,
		CI.INIT_SETTLE_AMOUNT as INIT_SETTLE_AMOUNT,
		NVL(CI.DELIVER_DATE1,CI.DELIVER_DATE2) as SETTLEMENT_DATE,
		CI.PRODUCT_ID as PRODUCT_ID,
		CI.PRODUCT_NAME as PRODUCT_NAME,
		nvl(cm.OPD_CONFIRM_STATUS,'WQR') as opdConfirmStatus,
		cm.SIUATION_EXPLAIN as siuationExplain,
		to_char(cm.siuation_date,'yyyy-MM-dd HH24:mi:ss') as siuationDate,
		(select d.yhmc from ip_staff_stmt d where cm.SIUATION_BY= d.yhbh) as siuationBy,
		cm.OPD_BRANCH as siuationBranch,
		pp.OPD_BRANCHID as OPD_BRANCH,
		pp.IND_BRANCHID as IND_BRANCH,
		ci.instr_id  as instrId
		from CSBS_INSTRUCTION CI
		left join CRITICAL_MONITOR_SIGN cm
		on ci.instr_id = cm.RELATION_ID
		left join product pp
		on ci.product_id = pp.product_code
		where  ci.INSTR_STATUS = 'IS03'
		 
		 
		 
