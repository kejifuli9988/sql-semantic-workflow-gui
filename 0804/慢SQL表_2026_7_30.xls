			or  ((tt.CONTRACT_STATUS <> 'CS00' or tt.contract_status is null)
			 and exists (select	</td><td style='mso-number-format:'@';'>2143	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>215	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a540cd32fae45ad029e73da99a060aeb	</td><td style='mso-number-format:'@';'>select
		count(bankAccountId)
		from (
        SELECT
