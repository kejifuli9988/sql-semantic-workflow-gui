			UNION ALL
                SELECT 1
                  FROM SETTLEMENT_CASHFLOW 	</td><td style='mso-number-format:'@';'>12869	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>35	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>790bf00c1fe1e5998493516d16dcb7b3	</td><td style='mso-number-format:'@';'>select Z.AREA_DISTRICT as Clr_Rgn_Inst_Num,
        (SELECT D.BANK_ID
            FROM UNIT_BANK D
            WHERE Z.AREA_DISTRICT = D.DQDH || D.JGDH) as Cur_Dpt_Acc_Opn_Bnk_No,
