							OR (z.d	</td><td style='mso-number-format:'@';'>4278	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>92	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>36f8da82fa175e8b5c4854c2fbb167b3	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
