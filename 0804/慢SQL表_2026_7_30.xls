	       AND I.TRADE_TYPE = '0'	</td><td style='mso-number-format:'@';'>17252	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>28	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a18849e10c326030bf534b1d17b627c0	</td><td style='mso-number-format:'@';'>delete from CSBS_SUMMARY_STATEMENT where CREATE_DATE = ?	</td><td style='mso-number-format:'@';'>16833	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>29	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>66922160801ac718a6f8d6c3fa87b157	</td><td style='mso-number-format:'@';'>with
		apba as(
		select
		ap.product_id,
		ba.bank_account_id bank_account_id,
		ba.currency bz
		from
		account_product ap,
		bank_account ba
		where
		ap.bank_account_id = ba.bank_account_id
		and ba.effectstatus = '1'
		and ap.effectstatus = '1'
		union
		select
		aup.Product_Id,
		ba.bank_account_id bank_account_id,
		ba.currency bz
		from
		bank_account ba,
		auxiliary_product aup
		where
		Ba.Effectstatus = '1'
		and Aup.Effectstatus = '1'
		and Aup.Bank_Account_Id = Ba.Bank_Account_Id ),
		baseinfo as (
		select
		z.INSTRUCTION_ID,
