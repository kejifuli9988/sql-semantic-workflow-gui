			accountId,
			accountName,
			accountTypeId,
			accountTypeName,
			sameCity,
			interBank,
			bankId,
			bankName
		from (select
      	  z.ACCOUNT_ID as accountId,
	      z.ACCOUNT_NAME as accountName,
	      z.ACCOUNT_TYPE_ID as accountTypeId,
	      a.account_type_name as accountTypeName,
	      z.SAME_CITY as sameCity,
	      z.INTER_BANK as interBank,
	      z.BANK_ID as bankId,
	      z.BANK_NAME as bankName
	      from COUNTERPARTY_ACCOUNT z,USER_INFO_BRANCH d,account_type a
	    where z.branchid=d.branchid
	      and z.effectstatus in 
				 (  
					?
				 ) 
	      and d.effectstatus = '1'
	      and a.effectstatus = '1'
	      and a.account_type_id = z.account_type_id
	       
			    and d.userid = ?
	         
	         
	         
	         
		  and z.ACCOUNT_ID like '%'||?||'%' 
		 
		 
         
		union
		select 
		      ca.CSDS_ACCOUNT_ID as accountId,
		      ca.account_name as accountName,
		      ca.account_type_id as accountTypeId,
		      aty.account_type_name as accountTypeName,
		      '' as sameCity,
	      	  '' as interBank,
		      '' as bankId,
		      '' as bankName
		from csds_account ca, account_type aty
		where ca.effectstatus in 
				 (  
					?
				 ) 
		  and aty.effectstatus = '1'
		  and aty.account_type_id = ca.account_type_id
		   
		 
		  and ca.CSDS_ACCOUNT_ID like '%'||?||'%' 
		 
			and ca.CSDS_ACCOUNT_ID in (select cap.CSDS_ACCOUNT_ID from csds_account_product cap where cap.PRODUCT_ID = ?)
			 
	         
		 
		 
         
         
		)
		order by accountId,accountTypeId ) row_ ) where rownum_ > 0 and rownum_ <= 10	</td><td style='mso-number-format:'@';'>3288	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>123	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a7ee7a9a1ebbc699ed9cffed6f9acabc	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT * FROM (SELECT p.product_code cpdm, i.instruction_id instructionId, i.credit_account fkfzh, i.instruction_id hkdbh, i.amount hkje, i.payment_type_id hklx, to_char(i.payment_at, 'yyyyMMdd') hkrq, to_char(i.created_at, 'yyyyMMddHH24miss') cjsj, i.direction sfkfx, i.debit_account skfzhh, i.currency bz, i.credit_account_id fkfzhid, i.credit_account_name fkfzhqc, i.bank_name fkfzhkhh, i.debit_account_id skfzhid, i.debit_account_name skfzhqc, i.fbank_name skfzhkhh, CASE WHEN i.payment_type_id IN ('TZXG01', 'TZXG02') THEN i.ipo_subscribe ELSE i.payment_reason END summary FROM instruction_2026 i INNER JOIN product p ON i.product_id = p.product_id WHERE i.payment_type_id != 'QSCNDB' AND NOT EXISTS (SELECT 1 FROM etf_paymenttype_map epm WHERE i.payment_type_id = epm.main_paymenttype_id AND epm.map_type = '1') AND i.payment_status IN ('3', '8') AND p.effectstatus = '1' AND p.product_code IN (?, ?) AND i.payment_at >= to_date(?, 'yyyy/MM/dd') AND i.payment_at <= to_date(?, 'yyyy/MM/dd') UNION ALL SELECT p.product_code cpdm, i.instruction_id instructionId, CASE WHEN (SELECT ba.account_type_id FROM bank_account ba WHERE ba.bank_account_id = isu.credit_account AND ba.effectstatus = '1') IN ('CNQSFZH', 'RQFIIQSFZH') THEN (SELECT ap.bank_account_id FROM account_product ap WHERE ap.product_id = p.product_id AND ap.main_account_mark = '0' AND ap.effectstatus = '1') ELSE isu.credit_account END fkfzh, isu.sub_id hkdbh, isu.amount hkje, isu.payment_type_id hklx, to_char(i.payment_at, 'yyyyMMdd') hkrq, to_char(i.created_at, 'yyyyMMddHH24miss') cjsj, isu.direction sfkfx, CASE WHEN (SELECT ba.account_type_id FROM bank_account ba WHERE ba.bank_account_id = isu.debit_account AND ba.effectstatus = '1') IN ('CNQSFZH', 'RQFIIQSFZH') THEN (SELECT ap.bank_account_id FROM account_product ap WHERE ap.product_id = p.product_id AND ap.main_account_mark = '0' AND ap.effectstatus = '1') ELSE isu.debit_account END skfzhh, i.currency bz, i.cre	</td><td style='mso-number-format:'@';'>3270	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>124	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>1c80594f4fd9d9542a057b20d9b6365d	</td><td style='mso-number-format:'@';'>SELECT COUNT(1) FROM (SELECT p.product_code FROM instruction_2026 i INNER JOIN product p ON i.product_id = p.product_id WHERE i.payment_type_id != 'QSCNDB' AND NOT EXISTS (SELECT 1 FROM etf_paymenttype_map epm WHERE i.payment_type_id = epm.main_paymenttype_id AND epm.map_type = '1') AND i.payment_status IN ('3', '8') AND p.effectstatus = '1' AND p.product_code IN (?) AND i.payment_at >= to_date(?, 'yyyy/MM/dd') AND i.payment_at <= to_date(?, 'yyyy/MM/dd') UNION ALL SELECT p.product_code FROM instruction_2026 i INNER JOIN instruction_sub_2026 isu ON i.instruction_id = isu.instruction_id INNER JOIN product p ON isu.product_id = p.product_id WHERE i.trade_type = '0' AND i.payment_status IN ('3', '8') AND i.payment_type_id != 'QSCNDB' AND p.effectstatus = '1' AND EXISTS (SELECT 1 FROM account_type acc, bank_account ba WHERE ba.bank_account_id = decode(isu.direction, 0, isu.credit_account, 1, isu.debit_account) AND ba.account_type_id = acc.account_type_id AND acc.sj_account_type_id = 'zhinityhzj0') AND p.product_code IN (?) AND i.payment_at >= to_date(?, 'yyyy/MM/dd') AND i.payment_at <= to_date(?, 'yyyy/MM/dd')) t	</td><td style='mso-number-format:'@';'>3246	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>125	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f9631d57591b883a1aa43ced318ff52e	</td><td style='mso-number-format:'@';'>with base_instruction as
        (
        select
        z.instruction_id,
        (CASE
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ13','TZZQ16')) THEN
        nvl((select (case when rtgs.shch_stop_status = '1' then '9' else rtgs.shch_draw_status end) ||'#@@#'|| by3 shch_draw_status from RTGS_COLLECTION_RECORD_1 rtgs where rtgs.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ12', 'TZZQ17')) THEN
        nvl((select c.ccdc_draw_status shch_draw_status from CCDC_COLLECTION_RECORD c where c.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN  (z.PAYMENT_TYPE_ID ='TZCK10') THEN
        nvl((select INSTRUCTION_PARAM_VALUE from instruction_ext where instruction_id =  z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME ='hqckWithDraw'),'')
        ELSE
        ''
        END) AS shchDrawStatus,
        z.product_id,
        z.REALTIME_STATUS,
        z.use_id,
        z.payment_date,
        z.payment_at,
        z.successful_paid_at,
        z.payment_type_id,
        (select pt.payment_type_name from payment_type pt
        where pt.payment_type_id = z.payment_type_id
        and pt.effectstatus = '1') hkmc,
        z.direction,
        z.amount,
        z.source_id,
        z.payment_reason,
        z.debit_account,
        z.debit_account_name,
        z.credit_account,
        z.credit_account_name,
        z.bank_id,
        z.bank_name,
        z.db_status,
