			 )	</td><td style='mso-number-format:'@';'>7114	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>56	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>223129483bbf939373ae289fbed229e3	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
