		 AND CM.OPD_CONFIRM_STATUS IS NULL  )	</td><td style='mso-number-format:'@';'>20442	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>23	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7960d7cedf6531d014a5b6d56a229d16	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid)	</td><td style='mso-number-format:'@';'>20213	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>24	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>e39578ce4eeef523c0908987f8515be5	</td><td style='mso-number-format:'@';'>SELECT COUNT(1) FROM (SELECT I.*, TRUNC(NVL(I.PAYMENT_AT, I.PAYMENT_DATE)) AS idx1, decode(I.DIRECTION, '0', I.CREDIT_ACCOUNT, '1', I.DEBIT_ACCOUNT) AS idx2 FROM INSTRUCTION I WHERE I.PAYMENT_STATUS != '3' AND ((I.SOURCE_ID = '6' AND I.ACTION_STATUS = '0') OR I.ACTION_STATUS IN ('7', '9', '10', '11', '12', '13', '14', '15', '16')) AND (I.FINAL_PAYMENTSTATUS IS NULL OR I.FINAL_PAYMENTSTATUS != '7')) I WHERE I.idx1 = TO_DATE(?, 'YYYYMMDD') AND I.idx2 = ?	</td><td style='mso-number-format:'@';'>19280	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>25	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b1038228fb86a89c0e1758bcb51a2a18	</td><td style='mso-number-format:'@';'>SELECT ramt.payment_date, ramt.olramt, pamt.olpamt FROM (SELECT ins.payment_date, nvl(sum(amount), 0) olramt FROM instruction ins WHERE ins.trade_type = '0' AND ins.payment_type_id != 'QSCNDB' AND ins.action_status <> '3' AND ('CNQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.DEBIT_ACCOUNT) OR 'RQFIIQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.DEBIT_ACCOUNT)) AND ins.payment_date = to_date(?, 'yyyy/MM/dd') GROUP BY ins.payment_date) ramt FULL JOIN (SELECT ins.payment_date, nvl(sum(amount), 0) olpamt FROM instruction ins WHERE ins.trade_type = '0' AND ins.payment_type_id != 'QSCNDB' AND ins.action_status <> '3' AND ('CNQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.CREDIT_ACCOUNT) OR 'RQFIIQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.CREDIT_ACCOUNT)) AND ins.payment_date = to_date(?, 'yyyy/MM/dd') GROUP BY ins.payment_date) pamt ON ramt.payment_date = pamt.payment_date	</td><td style='mso-number-format:'@';'>18186	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>26	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>536714aa4b0901adda6a3868e3166dc9	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select * from ( select * from ( WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM w	</td><td style='mso-number-format:'@';'>17454	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>27	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>2b9236c348e2ea239c585d8062d8b7f6	</td><td style='mso-number-format:'@';'>SELECT COUNT(1)
	      FROM INSTRUCTION I
	     WHERE I.PAYMENT_STATUS != '3'
