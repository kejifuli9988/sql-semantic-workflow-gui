		       sch.core_cashflow_id,
		       sch.product_id,
		       sch.account_id,
		       sch.account_type_id,
		       sch.cashflow_at,
		       sch.cashflow_time,
		       sch.counter_cashflow,
		       sch.credit_account,
		       sch.credit_account_name,
		       sch.debit_account,
		       sch.debit_account_name,
		       sch.direction,
		       sch.amount,
		       sch.balance_before,
		       sch.balance_after,
		       sch.currency,
		       sch.transaction_code,
		       sch.summary,
		       sch.message,
		       sch.remark,
		       nvl(sch.updated_at, sch.created_at) updated_at,
		       sch.use_info,
		       sch.bank_no,
		       sch.bank_name,
		       sch.trade_org_code,
		       sch.post_route_choose,
		       sch.cpzxh,
		       sch.cpznxh,
		       sch.trade_area_code
		  FROM SETTLEMENT_CASHFLOW_HISTORY SCH
		 WHERE SCH.SUMMARY = '591'
		   AND SCH.CASHFLOW_AT BETWEEN  CAST( ? AS TIMESTAMP) AND   CAST( ? AS TIMESTAMP)
		   AND NOT EXISTS (SELECT 1 FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = SCH.ACCOUNT_ID AND BA.DEDICATED = '0')
		   AND NOT EXISTS (SELECT 1 FROM CORE_CASHFLOW_RETURN R
		         WHERE SCH.ACCOUNT_ID = R.ACCOUNT_ID
		           AND SCH.CASHFLOW_AT = R.CASHFLOW_AT
		           AND SCH.CASHFLOW_TIME = R.CASHFLOW_TIME
		           AND SCH.CPZXH = R.CPZXH
		           AND SCH.CPZNXH = R.CPZNXH
		           AND SCH.DIRECTION = R.DIRECTION
		           AND SCH.AMOUNT = R.AMOUNT
		           AND SCH.COUNTER_CASHFLOW = R.COUNTER_CASHFLOW
		           AND (SCH.CREDIT_ACCOUNT = R.CREDIT_ACCOUNT OR (SCH.CREDIT_ACCOUNT IS NULL AND R.CREDIT_ACCOUNT IS NULL))
		           AND (SCH.DEBIT_ACCOUNT = R.DEBIT_ACCOUNT OR (SCH.DEBIT_ACCOUNT IS NULL AND R.DEBIT_ACCOUNT IS NULL)))	</td><td style='mso-number-format:'@';'>212396	</td><td style='mso-number-format:'@';'>72	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>0f9fd5f12b1d73354ebb9bd88f09c1d8	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2026 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w W	</td><td style='mso-number-format:'@';'>143134	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>88836164501af07aa0aec7b9617f6191	</td><td style='mso-number-format:'@';'>SELECT count(1)
		  FROM (
		  		SELECT 1
                  FROM CORE_CASHFLOW CC
                 WHERE BATCH_NUM = ?
                   
	               AND 
	                   	 (  
                       	   (1=1
                            
                        	)
                         or 
                       	   (1=1
                            
                        	)
                         ) 
                   
                 	    
			            
			            
			            
			 
			UNION ALL
                SELECT 1
                  FROM SETTLEMENT_CASHFLOW SC, SHARED_ACCOUNT_WORKING_DATE SAWD
                 WHERE SC.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
				   AND SC.CASHFLOW_AT = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
				   AND SAWD.WORKING_DATE between ? and ?
				   AND SC.ACCOUNT_TYPE_ID = 'zhinityhzj2'
                   AND 
                    (  
                     	(1=1
                     	  AND SC.PRODUCT_ID = ? 
                          AND SC.ACCOUNT_ID = ? 
                         
                        )
                    or 
                     	(1=1
                     	  AND SC.PRODUCT_ID = ? 
                          AND SC.ACCOUNT_ID = ? 
                         
                        )
                    ) 
                   AND NOT EXISTS(
	                   	SELECT 1
						  FROM UNUSE_ACCT_INF UA, ACCOUNT_PRODUCT AP, PRODUCT P
						 WHERE UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
						   AND AP.PRODUCT_ID = P.PRODUCT_ID
						   AND UA.EFFECTSTATUS = '1'
						   AND NVL(P.SUB_GROUP_MARK, '1') = '0'
						   AND SC.PRODUCT_ID = P.PRODUCT_ID)
	                
	                
	                
	                
                UNION ALL
                SELECT 1
                  FROM SETTLEMENT_CASHFLOW_HISTORY SCH
                 WHERE SCH.CASHFLOW_AT between ? and ?
                   AND SCH.ACCOUNT_TYPE_ID IN ('zhinityhzj2', 'MZH', 'ZZH' ,'QTQSFZH')
                   AND 
               	</td><td style='mso-number-format:'@';'>111266	</td><td style='mso-number-format:'@';'>7	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>ee935fe3f62e9cbe04b5d4b1f62321d3	</td><td style='mso-number-format:'@';'>WITH base_instruction AS
        (SELECT z.instruction_id,
        (CASE
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ13','TZZQ16')) THEN
        nvl((select (case when rtgs.shch_stop_status = '1' then '9' else rtgs.shch_draw_status end) ||'#@@#'|| by3 shch_draw_status from RTGS_COLLECTION_RECORD_1 rtgs where rtgs.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ12', 'TZZQ17')) THEN
        nvl((select c.ccdc_draw_status shch_draw_status from CCDC_COLLECTION_RECORD c where c.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2') and z.PAYMENT_TYPE_ID in ('JWZQ01','JWZQ02')) THEN
        z.direct_status
        WHEN  (z.PAYMENT_TYPE_ID ='TZCK10') THEN
        nvl((select INSTRUCTION_PARAM_VALUE from instruction_ext where instruction_id =  z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME ='hqckWithDraw'),'')
        ELSE
        ''
        END) AS shchDrawStatus,
        z.product_id,
        z.REALTIME_STATUS REALTIME_STATUS,
        z.use_id,
        z.payment_date,
        z.payment_at,
        z.successful_paid_at,
        z.payment_type_id,
        (select pt.payment_type_name from payment_type pt where pt.payment_type_id = z.payment_type_id) hkmc,
        z.direction,
        z.amount,
        z.source_id,
        z.payment_reason,
        z.debit_account,
        z.debit_account_name,
        z.credit_account,
        z.credit_account_name,
        z.bank_id,
        z.bank_name,
        z.db_status,
        z.ANO_SYS_STAT,
        z.batch,
        z.IPO_SUBSCRIBE,
        z.entrust,
        z.security_code,
        z.payment_mode,
        z.inter_bank,
        decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) as finalStatusOrder,
        z.final_paymentstatus,
        z.payment_status,
        (select ip.yhmc from ip_staff_stmt ip where ip.yhbh = z.updated_by) updatedbyname,
        z.updated_at,
        z.created_at,
    	</td><td style='mso-number-format:'@';'>77916	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>6	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>42afe8e22bb93acfd0cfe902240aa6a3	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH instruction_data AS (
        select
        instruction_id,product_id,payment_date,payment_type_id,direction,amount,payment_reason,source_id,credit_account,credit_account_name,debit_account,debit_account_name,bank_id,bank_name,batch,entrust,ipo_subscribe,wfid,wfsid,iterationid,position,p_instruction_id,payment_status,action_status,payment_mode,payment_at,inter_bank,same_city,message,created_at,created_by,updated_at,updated_by,instruction_type,concentrate_status,validated_by,use_id,plustype,out_instruction_id,security_code,fbank_id,fbank_name,fdqh,fjgh,sdqh,sjgh,db_product_id,realtime_status,parent_instruction_id,credit_acct_type_id,debit_acct_type_id,credit_account_id,debit_account_id,currency,withdraw,voucher,business_type,cash,credit_card,post_route,payment_level,business_subject,summary,custom_type,business_category,channel,account_voucher,account_password,futher_code,futher_password,core_interface,counter_cashflow,qsxwh,wxfxzyxx,interface_code,hsbz,sub_type_id,message_v,zqzh,zqdm,return_msg,autopay,trade_type,instr_gen_source,enteraccount_flag,lock_status,role_id,core_msg,final_paymentstatus,ztczfjg,ldsjms,kh_paymentstatus,core_instruction_type,cfcs,beiyong1,zlscfsj,showcomeaccount,paymentway,faxpushtime,nextdateinstructionid,instruc_batch,instruc_batch_flag,instruc_batch_sum,instruc_batch_detail,user_subsidiary_organ,zyzxretfaxtime,zyzxretmsg,zyzxbz,activity_center_status,activity_center_flag,activity_center_message,ywlsh,zjtzzh,qhgsdm,instr_jbr,instr_fhr,batchinsno,successful_paid_at,pay_lock_status,pay_lock_user,remark,tgt_qdzlbh,auto_remark,is_emergency_payment,timestamp,discard_flag,priority,db_status,white_flge,mzbz,export_flag,proiority_sub,csds_business_type,whether_pass_auxiliary,auxiliary_account,virtual_product_name,deal_org_no,instruction_model,out_org_no,cust_prd_code,cust_cancel_status,cust_prd_name,manager_id,payflg,core_instruction_id,dfkssj,supervision_sign,supervisory_opinion,instruc	</td><td style='mso-number-format:'@';'>70687	</td><td style='mso-number-format:'@';'>20	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>7	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>3a1860d08b7fa05f565d5b07a0de0656	</td><td style='mso-number-format:'@';'>SELECT * FROM (SELECT ROWNUM R, T.* FROM (select min(CASHFLOW_AT) from SETTLEMENT_CASHFLOW where UPDATED_AT> to_date('20260501','yyyyMMdd') or CREATED_AT>to_date('20260501','yyyyMMdd')) T) T WHERE T.R > 0 AND T.R <= 5000	</td><td style='mso-number-format:'@';'>64169	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>8	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>0c5b7e8ce2f1784af9eadfb9424f1d26	</td><td style='mso-number-format:'@';'>SELECT 
				BA.BALANCE_ID,
                BA.PRODUCT_ID,
                BA.ACCOUNT_ID,
                BA.ACCOUNT_TYPE_ID,
                BA.BALANCE_DATE,
                BA.AMOUNT
          FROM
                BALANCE BA
         WHERE 
            	BA.BALANCE_DATE = ?
            	 AND BA.ACCOUNT_TYPE_ID IN (SELECT A.ACCOUNT_TYPE_ID FROM ACCOUNT_TYPE A WHERE A.SJ_ACCOUNT_TYPE_ID='zhinitcnzh0') 
            	 
           		 AND BA.PRODUCT_ID IN
	           		 (  
	            		?
					 , 
	            		?
					 ) 
				 
		ORDER BY 
				BA.BALANCE_ID
        FOR UPDATE	</td><td style='mso-number-format:'@';'>64146	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>9	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>9ce60a2095bfabf6d3c3bec863e48580	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN NVL((SELECT CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END || '#@@#' || rtgs.shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.instruction_id), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN NVL((SELECT c.ccdc_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.instruction_id), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN NVL((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2026 WHERE instruction_id = z.instruction_id AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.	</td><td style='mso-number-format:'@';'>64126	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>10	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>35e8f099325a734c3026b6e14e918d79	</td><td style='mso-number-format:'@';'>SELECT * FROM (SELECT ROWNUM R, T.* FROM (select min(BALANCE_DATE) from BALANCE where UPDATED_AT> to_date('20260501','yyyyMMdd') or CREATED_AT>to_date('20260501','yyyyMMdd')) T) T WHERE T.R > 0 AND T.R <= 5000	</td><td style='mso-number-format:'@';'>62750	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>11	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>efd1f4604c06f7cb768693c9c6fdc40b	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select
		INFO_ID,product_id, (select a.product_name from product a where DTIC.product_id = a.product_id) as product_name ,
        (SELECT rtrim(xml_clob(xmlagg(xmlparse(content code||',') ORDER BY code)),',') from(select code_id AS code from para_code WHERE para_key = PAYMENT_TYPE_ID)) as PAYMENT_TYPE_ID,
        get_names(PAYMENT_TYPE_ID, 'payment_type') as PAYMENT_TYPE_NAME,
		(SELECT rtrim(xml_clob(xmlagg(xmlparse(content code||',') ORDER BY code)),',') from(select code_id AS code from para_code WHERE para_key = PRODUCT_TYPE_ID)) as PRODUCT_TYPE_ID,
		get_names(PRODUCT_TYPE_ID, 'product_type') as PRODUCT_TYPE_NAME,
		RFFLAG,ACCOUNT_NO,get_ids(INSTRUCT_SOURCE) as INSTRUCT_SOURCE, get_names(INSTRUCT_SOURCE, 'instruct_source') as INSTRUCT_SOURCE_NAME,EFFECTSTATUS,OP_TYPE,FOUREYESSTATUS,AUDIT_COMMENT,CREATED_AT,CREATED_BY,
		UPDATED_AT,UPDATED_BY,VALIDATED_AT,VALIDATED_BY,REMARK, NVL(APPLY_SUB, 1) APPLY_SUB,ORGANIZATION_DAYEND,PRODUCT_STMTONLINE,
		(select a.yhmc from ip_staff a where DTIC.created_by = a.yhbh) as createdByName,
        (select b.yhmc from ip_staff b where DTIC.updated_by = b.yhbh) as updatedByName,
        (select c.yhmc from ip_staff c where DTIC.validated_by = c.yhbh) as validatedByName,
		OPD_BRANCHID,(select JGMC from IP_UNIT_STMT uou where uou.ZJ = OPD_BRANCHID) as opdBranchName,
		OTHERS_SYSTEM_ID,MANAGER_ID,(select external_agency_name from EXTERNAL_AGENCY ea where ea.EXTERNAL_AGENCY_ID = MANAGER_ID) as managerName,
		get_ids(ECINS_GENTYPE) as ECINS_GENTYPE,
        decode(OTHERS_SYSTEM_ID,'1','赢时胜运营','2','服务运营','') as othersSystemName,
        replace(replace(replace(replace(get_ids(ECINS_GENTYPE),'7','托管通'),'3','深证通'),'8','同业门户'),'9','光伏贷') as ecinsGentypeName,product_onfile
		from DIRECT_TRANSFER_INFO DTIC
		where 1=1
		 
		 
		 
		 
		 
         
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		order by CREATED_AT desc, UPDATED_BY desc ) row_ ) where rownum_ > 0 and rownum_ <= 10	</td><td style='mso-number-format:'@';'>55696	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>12	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7b06c102606dca94dd3711bb1e77be9f	</td><td style='mso-number-format:'@';'>BEGIN
        DBMS_STATS.GATHER_TABLE_STATS(?,?);
        END;	</td><td style='mso-number-format:'@';'>55093	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>13	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>af06968651e66594b36cb2ac9cf80191	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select * from ( SELECT z.instruction_id, z.priority, z.payment_date, z.final_paymentstatus, z.created_at FROM instruction z INNER JOIN product p ON z.product_id = p.product_id WHERE z.product_id = ? AND z.instruc_batch_flag IN ('0', '-1') AND z.INSTRUCTION_MODEL != '0' AND (z.payment_type_id IS NULL OR z.payment_type_id != 'QSCNDB' OR (z.payment_type_id = 'QSCNDB' AND z.CSDS_BUSINESS_TYPE IS NULL AND z.source_id = '3') OR (z.payment_type_id = 'QSCNDB' AND z.source_id = '0')) AND z.PAYMENT_AT >= trunc(cast(? AS timestamp)) AND z.PAYMENT_AT < trunc(cast(? AS timestamp) + 1) AND (z.product_id IS NULL OR nvl((SELECT psi.system_flag FROM prod_switch_info psi WHERE psi.product_id = z.product_id), '1') = ?) UNION ALL SELECT z.instruction_id, z.priority, z.payment_date, z.final_paymentstatus, z.created_at FROM instruction_2026 z INNER JOIN product p ON z.product_id = p.product_id WHERE z.product_id = ? AND z.instruc_batch_flag IN ('0', '-1') AND z.INSTRUCTION_MODEL != '0' AND (z.payment_type_id IS NULL OR z.payment_type_id != 'QSCNDB' OR (z.payment_type_id = 'QSCNDB' AND z.CSDS_BUSINESS_TYPE IS NULL AND z.source_id = '3') OR (z.payment_type_id = 'QSCNDB' AND z.source_id = '0')) AND z.PAYMENT_AT >= trunc(cast(? AS timestamp)) AND z.PAYMENT_AT < trunc(cast(? AS timestamp) + 1) AND (z.product_id IS NULL OR nvl((SELECT psi.system_flag FROM prod_switch_info psi WHERE psi.product_id = z.product_id), '1') = ?) ) ORDER BY priority DESC NULLS LAST ,payment_date DESC ,decode(final_paymentstatus, '3', '-1', final_paymentstatus) DESC NULLS FIRST ,created_at ASC ) row_ ) where rownum_ > 0 and rownum_ <= 20	</td><td style='mso-number-format:'@';'>49387	</td><td style='mso-number-format:'@';'>6	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>14	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c4c283b1ec003d93c47a5ce4ef551524	</td><td style='mso-number-format:'@';'>SELECT * FROM (
		
select pc.code_id pPRODUCT_ID,
       qp.*,
       (SELECT p.PRODUCT_CODE
          FROM product p
         WHERE p.effectstatus = '1'
           AND p.PRODUCT_ID = pc.code_id) AS PRODUCT_CODE,
       decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT
  from qhld_parameter qp, para_code pc
 WHERE qp.effectstatus = '1'
   AND qp.TERMINATE_FLAG != '1'
   and qp.IS_INS_CHECK = '1'
     and qp.PAYMENT_TYPE_ID = ? 
   AND qp.manager_id is not null
   AND qp.product_id is not null
   and qp.product_id = pc.para_key
union

select p.product_id pPRODUCT_ID,
       qp.*,
       p.product_code PRODUCT_CODE,
       decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT
  from qhld_parameter qp, product p, para_code pc
 where qp.effectstatus = '1'
   and qp.terminate_flag != '1'
   and qp.IS_INS_CHECK = '1'
   AND ((QP.BRANCH_ID IS NOT NULL AND QP.BRANCH_ID = P.OPD_BRANCHID) OR QP.BRANCH_ID IS NULL)
   AND ((QP.IND_BRANCH_ID IS NOT NULL AND QP.IND_BRANCH_ID = P.IND_BRANCHID) OR QP.IND_BRANCH_ID IS NULL)
   and pc.para_key = qp.PRODUCT_TYPE_ID
   AND qp.product_id is null
   AND qp.manager_id is not null
   AND qp.product_type_id is not null
   and p.product_type_id = pc.code_id
   and p.manager_id = qp.manager_id
   and p.effectstatus = '1'
     and qp.PAYMENT_TYPE_ID = ? 
   and not exists (select 1
          from qhld_parameter qhld, para_code pcp
         where qhld.product_id is not null
           and qhld.manager_id = qp.manager_id
           and qhld.product_id = pcp.para_key
           and pcp.code_id = p.product_id
           and qhld.terminate_flag != '1'
            and qhld.IS_INS_CHECK = '1'
           and qhld.effectstatus = '1'
             and qhld.payment_type_id = ? 
           )
u	</td><td style='mso-number-format:'@';'>37993	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>15	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>bfe17968a33652895d29102ac79b1a50	</td><td style='mso-number-format:'@';'>SELECT  ( WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id AND pt.effectstatus = '1') hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CEN	</td><td style='mso-number-format:'@';'>33327	</td><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>16	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>faf576a70c51324c5f86c65111896d5f	</td><td style='mso-number-format:'@';'>SELECT I.INSTRUCTION_ID instructionId,
		I.CREDIT_ACCOUNT creditAccount,
		I.DIRECTION direction,
		I.PAYMENT_AT paymentAt
		FROM INSTRUCTION I
  		left join  EC_INSTRUCTION E on E.INSTRUCTION_ID = I.INSTRUCTION_ID
  		left join INSTRUCTION_EXT IE on I.INSTRUCTION_ID = IE.INSTRUCTION_ID
 		WHERE I.PAYMENT_TYPE_ID = 'JGXCK'
   			AND (E.GENERATE != '8' OR I.SOURCE_ID != '2')
  			AND I.ANO_SYS_STAT IN ('1', '3')
  			AND I.PAYMENT_AT BETWEEN TRUNC(SYSDATE - 15) AND TRUNC(SYSDATE)
			AND IE.INSTRUCTION_PARAM_NAME = 'CryInDt' 
			AND IE.INSTRUCTION_PARAM_VALUE  <=  to_char(sysdate,'yyyyMMdd')	</td><td style='mso-number-format:'@';'>30952	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>17	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>1093d17c4db963ce4e49d9bcc14e80be	</td><td style='mso-number-format:'@';'>merge into CSBS_CONTRACT a USING(
		   
