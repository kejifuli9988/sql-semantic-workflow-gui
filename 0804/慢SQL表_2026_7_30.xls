		z.FILE_PATH,z.CREATED_AT,z.CREATED_BY,z.UPDATED_AT,z.UPDATED_BY,z.RESULT_STATUS,z.PUSH_STATUS,z.PUSH_AT,z.MANAGER_ID,z.MANAGER_NAME,z.RESULT_TYPE,AUDIT_COMMENT,z.TGT_QDZLBH,nvl(z.BUSINESS_TYPE,'0') BUSINESS_TYPE,
