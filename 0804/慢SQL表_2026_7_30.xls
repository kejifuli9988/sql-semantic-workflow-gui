		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   ) 
                AND NOT EXISTS(
                   	SELECT 1
					  FROM CheckUnuseProduct c
					 WHERE  BA.PRODUCT_ID = c.PRODUCT_ID
                   )
		) T	</td><td style='mso-number-format:'@';'>7715	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>55	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a575017fc15c85a590234cb0656eb6eb	</td><td style='mso-number-format:'@';'>select
		cc.CONTRACT_PK_ID,
		PRO.PRODUCT_CODE as PRODUCT_ID,
		cc.PRODUCT_NAME,
		cc.DEAL_ID,
		cc.INSTR_ID,
		cc.GIVE_ACCOUNT_ID,
		cc.GIVE_ACCOUNT_NAME,
		cc.TAKE_ACCOUNT_ID,
		cc.TAKE_ACCOUNT_NAME,
		cc.MARKET,
		(case when cc.MARKET = '0' then (select bond_code from CSBS_BOND_INFO where instr_pkid = sio.pk_id)
		when cc.MARKET = '1' then (select bond_code from CSBS_BOND_INFO where instr_pkid = cio.pk_id) end ) bondId,
		cc.BOND_SHORT_NAME,
		cc.SETTLEMENT_AMOUNT,
		cc.SETTLEMENT_DATE,
		(case when cc.MARKET = '0' then (select sum(bond_amt) from CSBS_BOND_INFO where instr_pkid = sio.pk_id)
		when cc.MARKET = '1' then(select sum(bond_amt) from CSBS_BOND_INFO where instr_pkid = cio.pk_id) end) sttlmBd1BdAmt
		from csbs_contract cc
		left join csbs_instruction_origin  cio on cc.instr_id = cio.instr_id
		left join shch_instruction_origin  sio on cc.INSTR_ID = sio.trade_id
		left join product pro on cc.product_id = pro.product_code
		where pro.effectstatus = '1'
		 
			and cc.settlement_date = ? 
		 
		 
		 
			and cc.business_type = ?
		 
		 
			and cc.contract_status in
			 (  
				?
			 , 
