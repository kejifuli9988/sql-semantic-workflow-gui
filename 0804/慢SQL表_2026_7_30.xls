                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
