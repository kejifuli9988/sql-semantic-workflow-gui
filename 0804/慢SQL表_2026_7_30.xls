		z.POSITION,
		z.P_INSTRUCTION_ID,
		z.PAYMENT_STATUS,
		z.ACTION_STATUS,
		z.PAYMENT_MODE,
		z.PAYMENT_AT,
		z.INTER_BANK,
		z.SAME_CITY,
		z.MESSAGE,
		z.CREATED_AT,
		z.CREATED_BY,
		z.UPDATED_AT,
		z.UPDATED_BY,
		z.INSTRUCTION_TYPE,
		z.CONCENTRATE_STATUS,
		z.VALIDATED_BY,
		z.USE_ID,
		z.PLUSTYPE,
		z.OUT_INSTRUCTION_ID,
		z.SECURITY_CODE,
		z.FBANK_ID,
		z.FBANK_NAME,
		z.FDQH,
		z.FJGH,
		z.SDQH,
		z.SJGH,
		z.DB_PRODUCT_ID,
		z.REALTIME_STATUS,
		z.PARENT_INSTRUCTION_ID,
		z.CREDIT_ACCT_TYPE_ID,
		z.DEBIT_ACCT_TYPE_ID,
		z.CREDIT_ACCOUNT_ID,
		z.DEBIT_ACCOUNT_ID,
		z.CURRENCY,
		z.WITHDRAW,
		z.VOUCHER,
		z.BUSINESS_TYPE ywlx,
		z.CASH xzbz,
		z.CREDIT_CARD fkxykbz,
		z.POST_ROUTE ylxz,
		z.PAYMENT_LEVEL zfjb,
		z.BUSINESS_SUBJECT,
		z.SUMMARY zysm,
		(
		select
		zymc
		from
		ZYDHB
		where
		effectstatus = '1'
		and zydh = z.SUMMARY ) zysmname,
		z.CUSTOM_TYPE khlb,
		z.BUSINESS_CATEGORY ywlb,
		z.CHANNEL jyqd,
		z.ACCOUNT_VOUCHER zjzh,
		z.ACCOUNT_PASSWORD zjmm,
		z.FUTHER_CODE jhgsdm,
		z.FU	</td><td style='mso-number-format:'@';'>15997	</td><td style='mso-number-format:'@';'>6	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>30	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>98846d79c5b6c55bf6ea586f539a1fa5	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH T AS (SELECT z.TRADE_ID INSTRUCTION_ID, z.PRODUCT_ID, z.LAST_UPDATE_AT AS timestamp, z.TRADE_DATE PAYMENT_DATE, z.TRAN_TYPE PAYMENT_TYPE_ID, NULL DIRECTION, z.AMOUNT, z.REMARK PAYMENT_REASON, z.SOURCE_ID, decode(z.TRAN_TYPE, 'CNTCTZ', z.bank_account_id, 'CNTCTJ', z.BROKER_ACCOUNT_ID) CREDIT_ACCOUNT, decode(z.TRAN_TYPE, 'CNTCTZ', 'CNTCTJ', NULL) CREDIT_ACCOUNT_NAME, decode(z.TRAN_TYPE, 'CNTCTJ', z.bank_account_id, 'CNTCTZ', z.BROKER_ACCOUNT_ID) DEBIT_ACCOUNT, decode(z.TRAN_TYPE, 'CNTCTJ', 'CNTCTZ', NULL) DEBIT_ACCOUNT_NAME, NULL BANK_ID, NULL BANK_NAME, NULL BATCH, NULL ENTRUST, NULL IPO_SUBSCRIBE, z.WFID WFID, z.WFSID WFSID, z.FINAL_PAYMENTSTATUS FINAL_PAYMENTSTATUS, NULL ZTCZFJG, NULL LDSJMS, NULL KH_PAYMENTSTATUS, NULL ANO_SYS_STAT, z.CORE_MESSAGE CORE_MSG, z.ITERATIONID, z.POSITION, NULL P_INSTRUCTION_ID, NULL PAYMENT_STATUS, z.ACTION_STATUS ACTION_STATUS, NULL PAYMENT_MODE, z.PAYMENT_AT PAYMENT_AT, NULL INTER_BANK, NULL SAME_CITY, NULL MESSAGE, z.CREATED_AT CREATED_AT, z.CREATED_BY CREATED_BY, z.UPDATED_AT UPDATED_AT, z.UPDATED_BY UPDATED_BY, '0' INSTRUCTION_TYPE, NULL CONCENTRATE_STATUS, NULL VALIDATED_BY, NULL USE_ID, NULL PLUSTYPE, z.TRADE_NUM OUT_INSTRUCTION_ID, NULL SECURITY_CODE, NULL FBANK_ID, NULL FBANK_NAME, NULL FDQH, NULL FJGH, NULL SDQH, NULL SJGH, NULL DB_PRODUCT_ID, Z.REALTIME_STATUS, NULL PARENT_INSTRUCTION_ID, NULL CREDIT_ACCT_TYPE_ID, NULL DEBIT_ACCT_TYPE_ID, NULL CREDIT_ACCOUNT_ID, NULL DEBIT_ACCOUNT_ID, z.CURRENCY, NULL WITHDRAW, NULL VOUCHER, NULL ywlx, NULL xzbz, NULL fkxykbz, NULL ylxz, NULL zfjb, NULL BUSINESS_SUBJECT, NULL zysm, NULL zysmname, NULL khlb, NULL ywlb, NULL jyqd, NULL zjzh, NULL zjmm, NULL jhgsdm, NULL FUTHER_PASSWORD, NULL CORE_INTERFACE, NULL QSXWH, NULL WXFXZYXX, NULL INTERFACE_CODE, NULL HSBZ, NULL SUB_TYPE_ID, NULL fy, NULL zqzh, NULL zqdm, NULL return_msg, NULL autopay, '1' trade_type, NULL instr_gen_source, NULL lock_status, NULL role_id, z.CREATED_AT faxpush	</td><td style='mso-number-format:'@';'>15936	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>31	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>725e6766278eca96c669bcce55d4b545	</td><td style='mso-number-format:'@';'>MERGE INTO INSTRUCTION_TRANS_INFO I
		USING (
	         
	           SELECT T.INSTRUCTION_ID,
		              decode(T.INSTRUCTION_ID, NULL, '', '0') MATCH_STATUS,
		              decode(T.INSTRUCTION_ID, NULL, '', '0') SORT_ORDER,
		              decode(T.SOURCE, '2', 'GLR', '1', 'DXJG') SOURCE_ID,
		              T.PK_ID,
		              T.SEQ_NO,
		              T.PRODUCT_ID,
		              T.TRADE_DATE,
		              T.TRADE_DIRECTION,
		              T.SECURITY_TYPE,
		              NVL(AMOUNT, APPMONEY) AMOUNT,
		              T.REGIST_CODE,
		              T.SECURITY_CODE,
		              T.SECURITY_NAME,
		              T.BYZD3,
		              T.BYZD2
		         FROM TRANS_INFO T
	            where seq_no = ?
	                and nvl(org_no,'1') = nvl(?,'1')
	                and trade_date = ?
	                and nvl(trade_direction,'1') = nvl(?,'1')
	                and source = ?
	                and (source = '2' or (source = '1'
	                	and source_code = ?) )
	             union all 
	           SELECT T.INSTRUCTION_ID,
		              decode(T.INSTRUCTION_ID, NULL, '', '0') MATCH_STATUS,
		              decode(T.INSTRUCTION_ID, NULL, '', '0') SORT_ORDER,
		              decode(T.SOURCE, '2', 'GLR', '1', 'DXJG') SOURCE_ID,
		              T.PK_ID,
		              T.SEQ_NO,
		              T.PRODUCT_ID,
		              T.TRADE_DATE,
		              T.TRADE_DIRECTION,
		              T.SECURITY_TYPE,
		              NVL(AMOUNT, APPMONEY) AMOUNT,
		              T.REGIST_CODE,
		              T.SECURITY_CODE,
		              T.SECURITY_NAME,
		              T.BYZD3,
		              T.BYZD2
		         FROM TRANS_INFO T
	            where seq_no = ?
	                and nvl(org_no,'1') = nvl(?,'1')
	                and trade_date = ?
	                and nvl(trade_direction,'1') = nvl(?,'1')
	                and source = ?
	                and (source = '2' or (source = '1'
	                	and source_code = ?) )
	             union all 
