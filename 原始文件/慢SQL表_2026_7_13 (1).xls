		count(distinct t.instruction_id)
		from (
		 
			select z.instruction_id
			from instruction z
			left join  product p
			on z.product_id = p.product_id
			left join CRITICAL_MONITOR_SIGN cm
			on z.instruction_id = cm.RELATION_ID
			where z.TRADE_TYPE ='0'
			 
			 and  cm.OPD_CONFIRM_STATUS IS NULL 
			 
			 
				and ( (z.product_id is not null and p.OPD_BRANCHID in
				 (  
					?
				 ) 
				) or (z.product_id is  null
				and exists (select 1 from bankaccandunuseacc ba where   ba.bank_account_id = decode(z.direction,'0',z.credit_account,'1',z.debit_account,'3',z.credit_account)
				and ba.ind_branchid in
				 (  
					?
				 ) 
				)))
			 
			 	and z.PAYMENT_AT >= trunc(cast(? as timestamp)) and z.PAYMENT_AT < trunc(cast(?  as timestamp)+ 1) 
			and  z.action_status not in ('2', '3')
			and (z.final_paymentstatus not in ('3','7') or    z.final_paymentstatus is  null)
			union all
		 
