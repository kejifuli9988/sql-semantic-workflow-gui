        (select t.product_id,
        t.bond_id,
        t.bond_short_name,
        sum(t.amountSum) as amountSum,
        sum(t.yeSum) yeSum,
        t.isBond2,
        t.bank_account_id
        from (
         
            select t.product_id,
            t.bond_id,
            t.bond_short_name,
            sum(nvl(t.usage_subject, 0) + nvl(t.forpay_subject, 0) +
            nvl(t.pledge_subject, 0) + nvl(t.repurchase_subject, 0) +
            nvl(t.block_subject, 0)) as amountSum,
            sum(nvl(t.usage_subject, 0)) AS yeSum,
            '1' as isBond2,
            t.bank_account_id
            from CSBS_SUMMARY_STATEMENT t
            where t.create_date = to_char(cast(? as timestamp) - 1, 'yyyy-MM-dd')
            group by t.product_id, t.bank_account_id, t.bond_id, t.bond_short_name
            union all
            select
            t.product_id,
            t.bond_id,
            t.bond_short_name,
            sum(nvl(t.total_amount, 0)) as amountSum,
            sum(nvl(t.usage_subject, 0)) AS yeSum,
            '1' as isBond2,
            t.bank_account_id
            from shch_summary_statement t
            where t.query_date = to_char(cast(? as timestamp) - 1, 'yyyyMMdd')
            group by t.product_id, t.bank_account_id, t.bond_id,  t.bond_short_name

         
         
            union all
         

         
            SELECT
            (select pro.product_Id from product pro where  pro.product_code = sbt.product_code and pro.effectstatus in ('1','0')) as product_id,
            sbt.BOND_CODE as BOND_ID,
            sbt.BOND_NAME as bond_short_name,
            sum(nvl(sbt.TOTAL_BALANCE, 0)) as amountSum,
            sum(nvl(sbt.USE_BALANCE, 0)) AS yeSum,
            '2' as isBond2,
            null as bank_account_id
            from SHCH_BOND2_TEMPORARY sbt
            where sbt.business_date  =  to_char(cast(? as timestamp) -1, 'yyyyMMdd')
            and sbt.product_code is not null
            group by sbt.product_code ,	</td><td style='mso-number-format:'@';'>2251	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>193	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>387bfd46628765defc9ebeae937b917b	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT
        '应付托管费金额维护' AS todoItem,
        '产品[' || p.product_name || ']为核算系统无法准确计提托管费的产品，未按支付频率维护应付托管费金额' AS reminderText,
        (
        SELECT cdbh
        FROM ip_resmenu
        WHERE cdmc = '新托管费未支付监控'
        ) AS nodeId,
        '新托管费未支付监控' AS nodeText,
        '/trustfeeArrearsReport/list.do' AS nodeURL
        FROM
        TRUSTFEE_ARREARS_REPORT tar
        LEFT JOIN
        product p ON tar.product_id = p.product_id
        LEFT JOIN (
        SELECT *
        FROM TRUSTFEE_ARREARS_DETAIL_REPORT
        WHERE PK_ID IN (
        SELECT pk_id
        FROM (
        SELECT
        pk_id,
        report_id,
        unpaid_trustfee_amount,
        BUSINESS_DATE,
        ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn
        FROM trustfee_arrears_detail_report
        ) t
        WHERE rn = 1
        )
        ) ta ON tar.PK_ID = ta.REPORT_ID
        WHERE 1=1
          AND tar.IS_FIXED_AMOUNT <> '0'
          AND (tar.IS_PAYMENT_DATE_UNKNOWN <> 0 OR tar.IS_PAYMENT_DATE_UNKNOWN IS NULL)
          AND (ta.unpaid_trustfee_amount IS NULL OR ta.unpaid_trustfee_amount = 0)
            AND P.OPD_BRANCHID IN (
            SELECT UOB.BRANCHID
            FROM USER_OPERATING_BRANCH UOB
            WHERE UOB.USERID = ?
            )
            AND tar.product_id IN (
