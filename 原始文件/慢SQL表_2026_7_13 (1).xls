        ? USER_ID,
        Z.MON_MAT_TYPE,
        ? REMINDER_TYPE,
        Z.DATA_AT,
        Z.INS_ID,
        NVL(Z.PRODUCT_ID, Z.UNIT_ID) AS PRODUCT_ID,
        NVL(Z.STEP_ID, '-1') AS STEP_ID,
        (SELECT IR.CDBH FROM IP_RESMENU IR
        WHERE IR.CDURL = (CASE
        WHEN Z.STEP_ID = '2' THEN '/instructionAudit/list.do'
        ELSE '未知' END)) AS CDBH,
        NVL((SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE Z.PAYMENT_TYPE_ID = PT.PAYMENT_TYPE_ID),
        NVL((SELECT IC.MBTMZ
        FROM IP_CODEINFO IC
        WHERE IC.SJLX IN ('CSBSCSBSCSBSCSBSCSBSCSBS00010001', 'TYLTYLTYLTYLTYLTYLTYLTYL00000348')
        AND IC.MBLXBH = Z.PAYMENT_TYPE_ID),
        '划款类型为空')) AS PAYMENT_TYPE_NAME,
        (CASE
        WHEN Z.STEP_ID = '2' THEN '指令审核'
        ELSE '未知' END) AS STEP_NAME,
        NVL(Z.PAYMENT_TYPE_ID, '-1') AS PAYMENT_TYPE_ID,
        Z.DATA_TYPE,
        Z.TIME_OUT_FLAG
        FROM TIME_OUT_DATA Z
		WHERE  Z.MON_MAT_TYPE = ?
		AND  Z.DATA_AT = TRUNC(SYSDATE)
         
            AND EXISTS (
            SELECT 1 FROM DUAL
            WHERE Z.STEP_ID = '2'
            AND EXISTS (SELECT 1 FROM IP_BUTTON_LIST B, IP_RESMENU R WHERE B.CDBH = R.CDBH AND B.ACTION = 'getWhetherOperation' AND R.CDURL = '/instructionAudit/list.do'
            AND B.JSBH IN
             (  
                ?
             , 
                ?
             , 
                ?
             , 
                ?
             , 
                ?
             ) 
            AND EXISTS (SELECT 1 FROM DUAL WHERE Z.DATA_TYPE = 'INSTRUCTION'
            AND (INSTR(Z.USE_ID, ?) != 0
            OR (Z.USE_ID = '-1' AND INSTR(Z.ROLEID, B.JSBH) != 0)
            OR (Z.USE_ID = '-1' AND Z.ROLEID IS NULL) )
            AND EXISTS (
            SELECT 1 FROM PRODUCT_INFO_BRANCH P
            WHERE P.ROLEID = B.JSBH AND P.USERID = ? AND P.PRODUCT_ID = Z.PRODUCT_ID AND Z.INSTRUCTION_MODEL != '2'
            UNION ALL
            
            SELECT 1 FROM DUAL WHE	</td><td style='mso-number-format:'@';'>4713	</td><td style='mso-number-format:'@';'>65	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>94	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>3cce3a612a22a1bea3c3f2adf4f2643f	</td><td style='mso-number-format:'@';'>SELECT
			 sc.cashflow_id,
			 sc.product_id,
			 sc.account_id,
			 sc.account_type_id,
			 sc.cashflow_at,
			 sc.cashflow_time,
			 sc.counter_cashflow,
			 sc.credit_account,
			 sc.credit_account_name,
			 sc.debit_account,
			 sc.debit_account_name,
			 sc.direction,
			 sc.amount,
			 sc.balance_before,
			 sc.balance_after,
			 sc.currency,
			 sc.transaction_code,
			 sc.summary,
			 sc.message,
			 sc.remark,
			 nvl(sc.updated_at, sc.created_at) updated_at,
			 sc.use_info
		FROM SETTLEMENT_CASHFLOW SC
		INNER JOIN SHARED_ACCOUNT_WORKING_DATE SAWD
		ON SC.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID AND SC.CASHFLOW_AT = TO_DATE(SAWD.WORKING_DATE,'yyyyMMdd')
		INNER JOIN BANK_ACCOUNT BA
		ON SC.ACCOUNT_ID = BA.BANK_ACCOUNT_ID
		WHERE SC.CASHFLOW_AT BETWEEN  CAST( ? AS TIMESTAMP) AND   CAST( ? AS TIMESTAMP)
		AND SC.SUMMARY = '591'
		AND BA.DEDICATED = '0'
		  AND NOT EXISTS (SELECT 1 FROM CORE_CASHFLOW_RETURN R
	             WHERE SC.ACCOUNT_ID = R.ACCOUNT_ID
	               AND SC.CASHFLOW_AT = R.CASHFLOW_AT
	               AND SC.CASHFLOW_TIME = R.CASHFLOW_TIME
	               AND SC.DIRECTION = R.DIRECTION
	               AND SC.AMOUNT = R.AMOUNT
	               AND SC.COUNTER_CASHFLOW = R.COUNTER_CASHFLOW
	               AND (SC.CREDIT_ACCOUNT = R.CREDIT_ACCOUNT OR (SC.CREDIT_ACCOUNT IS NULL AND R.CREDIT_ACCOUNT IS NULL))
	               AND (SC.DEBIT_ACCOUNT = R.DEBIT_ACCOUNT OR (SC.DEBIT_ACCOUNT IS NULL AND R.DEBIT_ACCOUNT IS NULL)))

		UNION ALL


		SELECT
			sch.cashflow_id,
			sch.product_id,
			sch.account_id,
			sch.account_type_id,
			sch.cashflow_at,
			sch.cashflow_time,
			sch.counter_cashflow,
			sch.credit_account,
			sch.credit_account_name,
			sch.debit_account,
			sch.debit_account_name,
