			NVL(gg.BANK_NAME,(SELECT D.BANK_NAME FROM UNIT_BANK D WHERE gg.AREA_DISTRICT = D.DQDH || D.JGDH)) as bankName,
			gg.ACCOUNT_TYPE_ID as accountTypeId,
