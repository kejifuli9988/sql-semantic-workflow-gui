        FROM
            TRUSTFEE_ARREARS_REPORT tar
                LEFT JOIN (
                SELECT *
                FROM TRUSTFEE_ARREARS_DETAIL_REPORT
                WHERE PK_ID IN (
                    SELECT pk_id
                    FROM (
                             SELECT
