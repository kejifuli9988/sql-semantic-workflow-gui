	               s.file_address,
	               s.created_at,
	          	</td><td style='mso-number-format:'@';'>12169	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>34	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f6eeab11c3a28925f4784cd0ff852735	</td><td style='mso-number-format:'@';'>INSERT INTO BALANCE_HISTORY
			  (BALANCE_HISTORY_ID,
			   PRODUCT_ID,
			   ACCOUNT_ID,
			   ACCOUNT_TYPE_ID,
			   BALANCE_DATE,
			   AMOUNT,
			   CREATED_AT,
		       CREATED_BY,
		       UPDATED_AT,
		       UPDATED_BY)
			  SELECT B.BALANCE_ID,
			         B.PRODUCT_ID,
			         B.ACCOUNT_ID,
			         B.ACCOUNT_TYPE_ID,
			         ?,
			         B.AMOUNT,
			         B.CREATED_AT,
			         B.CREATED_BY,
			         sysdate,
			         B.UPDATED_BY
			    FROM BALANCE B
			   WHERE B.BALANCE_DATE = ?
			      
			       AND B.ACCOUNT_TYPE_ID = ?	</td><td style='mso-number-format:'@';'>12105	</td><td style='mso-number-format:'@';'>7	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>35	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7e97bc1d7040ba898d25aeae3f7d8fbf	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT *
		FROM (
		SELECT
		gg.bank_account_id AS accountId,
		gg.bank_account_name AS accountName,
		gg.IND_BRANCHID AS indBranchId,
		i.JGMC AS indBranchName,
		COALESCE(gg.BANK_ID, d.BANK_ID) AS bankId,
		COALESCE(gg.BANK_NAME, d.BANK_NAME) AS bankName,
		gg.ACCOUNT_TYPE_ID AS accountTypeId,
		at.ACCOUNT_TYPE_NAME AS accountTypeName,
		gg.AREA_DISTRICT AS areaDistrict,
		gg.currency AS currency,
		aa.mbtmz AS currencyName,
		gg.DEDICATED AS dedicated,
		CASE WHEN gg.DEDICATED = '0' THEN '共用' ELSE '独用' END AS dedicatedName,
		gg.EFFECTSTATUS AS effectstatus,
		ac.mbtmz AS effectstatusName,
		gg.ACCOUNT_ATTRIBUTE AS accountAttribute,
		gg.FOUREYESSTATUS AS foureyesstatus
		FROM bankAccAndUnuseAcc gg
		JOIN ACCOUNT_TYPE at ON at.ACCOUNT_TYPE_ID = gg.ACCOUNT_TYPE_ID
		LEFT JOIN IP_UNIT_STMT i ON i.ZJ = gg.IND_BRANCHID AND i.EFFECTSTATUS = '1'
		LEFT JOIN UNIT_BANK d ON gg.AREA_DISTRICT = d.DQDH || d.JGDH
		LEFT JOIN ip_codeinfo aa ON aa.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000003' AND aa.mblxbh = gg.currency
		LEFT JOIN ip_codeinfo ac ON ac.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000008' AND ac.mblxbh = gg.EFFECTSTATUS
		WHERE at.effectstatus = '1'
		
		 
			and (gg.ACCOUNT_TYPE_ID != 'CKZH' or   gg.ACCOUNT_TYPE_ID is null)
		 
		 
		 
		 
		 
			and ((gg.IND_BRANCHID in (select uib.branchid FROM user_info_branch uib WHERE uib.userid=? and uib.EFFECTSTATUS = '1')) OR
			EXISTS (SELECT 1 FROM IP_STAFF_STMT IP, SAD_CC S WHERE S.BRANCHID = IP.SSJG AND IP.YHBH = ? AND S.RANGE IN (SUBSTR(gg.bank_account_id,0,2), SUBSTR(gg.bank_account_id,0,5))))
		 
		 
		 
		) t
		where 1=1
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		order by accountId,accountTypeId ) row_ ) where rownum_ > 0 and rownum_ <= 10	</td><td style='mso-number-format:'@';'>11593	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>36	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7e6853df982c171b6c8a1b0b0f76b0b8	</td><td style='mso-number-format:'@';'>select
		count(accountId)
		from (
		SELECT *
		FROM (
		SELECT
		gg.bank_account_id AS accountId,
		gg.bank_account_name AS accountName,
		gg.IND_BRANCHID AS indBranchId,
		i.JGMC AS indBranchName,
		COALESCE(gg.BANK_ID, d.BANK_ID) AS bankId,
		COALESCE(gg.BANK_NAME, d.BANK_NAME) AS bankName,
		gg.ACCOUNT_TYPE_ID AS accountTypeId,
		at.ACCOUNT_TYPE_NAME AS accountTypeName,
		gg.AREA_DISTRICT AS areaDistrict,
		gg.currency AS currency,
		aa.mbtmz AS currencyName,
		gg.DEDICATED AS dedicated,
		CASE WHEN gg.DEDICATED = '0' THEN '共用' ELSE '独用' END AS dedicatedName,
		gg.EFFECTSTATUS AS effectstatus,
		ac.mbtmz AS effectstatusName,
		gg.ACCOUNT_ATTRIBUTE AS accountAttribute,
		gg.FOUREYESSTATUS AS foureyesstatus
		FROM bankAccAndUnuseAcc gg
		JOIN ACCOUNT_TYPE at ON at.ACCOUNT_TYPE_ID = gg.ACCOUNT_TYPE_ID
		LEFT JOIN IP_UNIT_STMT i ON i.ZJ = gg.IND_BRANCHID AND i.EFFECTSTATUS = '1'
		LEFT JOIN UNIT_BANK d ON gg.AREA_DISTRICT = d.DQDH || d.JGDH
		LEFT JOIN ip_codeinfo aa ON aa.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000003' AND aa.mblxbh = gg.currency
		LEFT JOIN ip_codeinfo ac ON ac.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000008' AND ac.mblxbh = gg.EFFECTSTATUS
		WHERE at.effectstatus = '1'
		 
			and (gg.ACCOUNT_TYPE_ID != 'CKZH' or   gg.ACCOUNT_TYPE_ID is null)
		 
		 
		 
		 
		 
			and ((gg.IND_BRANCHID in (select uib.branchid FROM user_info_branch uib WHERE uib.userid=? and uib.EFFECTSTATUS = '1')) OR
			EXISTS (SELECT 1 FROM IP_STAFF_STMT IP, SAD_CC S WHERE S.BRANCHID = IP.SSJG AND IP.YHBH = ? AND S.RANGE IN (SUBSTR(gg.bank_account_id,0,2), SUBSTR(gg.bank_account_id,0,5))))
		 
		 
		 
		) t
		where 1=1
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		)	</td><td style='mso-number-format:'@';'>11255	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>37	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>083966c44a48815d1bdfd4a2eaa39829	</td><td style='mso-number-format:'@';'>SELECT COUNT(1)
		FROM (SELECT JS.PK_ID AS PKID
		FROM JSMX JS
		LEFT JOIN SECURITY_ACCOUNT SA ON (JS.ZQZH = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1')
		LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JS.PK_ID = CM.RELATION_ID
		WHERE JS.JYFS != '106'
		AND JS.JSFS = '002'
		and js.filename not like 'jsmx03%'
		AND JS.JSRQ >= TO_CHAR(cast(? as timestamp), 'yyyyMMdd')
		AND JS.JSRQ < TO_CHAR(cast(? as timestamp) + 1, 'yyyyMMdd')
		 
		 AND CM.OPD_CONFIRM_STATUS IS NULL 
		UNION ALL
		SELECT JSZ.PK_ID AS PKID
		FROM SJSMX JSZ
		LEFT JOIN SECURITY_ACCOUNT SA ON (TRIM(JSZ.MXZQZH) = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1')
		LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JSZ.PK_ID = CM.RELATION_ID
		WHERE JSZ.MXJSFS = 'N'
		AND JSZ.MXJSRQ >= TO_CHAR(cast(? as timestamp), 'yyyyMMdd')
		AND JSZ.MXJSRQ < TO_CHAR(cast(? as timestamp)+ 1, 'yyyyMMdd')
		and jsz.filename not like 'SJSMX2%'
		 
		 AND CM.OPD_CONFIRM_STATUS IS NULL  )	</td><td style='mso-number-format:'@';'>11062	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>38	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>62678e01637d1b98bc5f718bff21825b	</td><td style='mso-number-format:'@';'>WITH A AS (
        SELECT
        T.PRODUCT_ID,
        T.FIRST_UNPAID_DATE,
        T.SETTLEMENT_DATE,
        (CASE WHEN T.SETTLEMENT_TYPE IS NOT NULL THEN '0' ELSE '1' END) AS RETURNED_MONEY_STATUS,
        T.SETTLEMENT_TYPE,
        T.RETURNED_AMOUNT,
        TA.UNPAID_TRUSTFEE_AMOUNT,
        TA.IS_LONG_TERM_DUN,
        TA.report_id,
        TRUNC(CAST(? AS TIMESTAMP)) AS START_DATE,
        TRUNC(CAST(? AS TIMESTAMP)) AS END_DATE,
        (CASE WHEN TA.IS_LONG_TERM_DUN = '1' THEN NULL WHEN (SELECT 0 FROM DUAL WHERE EXISTS(SELECT * FROM trustfee_arrears_detail_report WHERE T.PK_ID = REPORT_ID AND IS_LONG_TERM_DUN = '0' ) ) = 0 AND T.TRANSFER_DATE >= TRUNC(CAST(? AS TIMESTAMP)) THEN '本期转入长期催收登记簿' ELSE '以往期间转入长期催收登记簿' END ) AS longterm_Flag
        FROM trustfee_arrears_report T
        LEFT JOIN (
        SELECT * FROM TRUSTFEE_ARREARS_DETAIL_REPORT
        WHERE PK_ID IN (
        SELECT pk_id FROM (
        SELECT
        pk_id,
        report_id,
        BUSINESS_DATE,
        IS_LONG_TERM_DUN,
        UNPAID_TRUSTFEE_AMOUNT,
        ROW_NUMBER() OVER (PARTITION BY report_Id ORDER BY BUSINESS_DATE DESC) AS rn
        FROM trustfee_arrears_detail_report
        ) WHERE rn = 1
        )
        )  TA
        ON T.PK_ID = TA.REPORT_ID
        WHERE T.first_unpaid_date <= TRUNC(CAST(? AS TIMESTAMP))

        UNION ALL

        SELECT
        T.PRODUCT_ID,
        T.FIRST_UNPAID_DATE,
        T.SETTLEMENT_DATE,
        '0' AS RETURNED_MONEY_STATUS,
        T.SETTLEMENT_TYPE,
        T.RETURNED_AMOUNT,
        TA.UNPAID_TRUSTFEE_AMOUNT,
        TA.IS_LONG_TERM_DUN,
        TA.report_id,
        TRUNC(CAST(? AS TIMESTAMP)) AS START_DATE,
        TRUNC(CAST(? AS TIMESTAMP)) AS END_DATE,
        (CASE WHEN TA.IS_LONG_TERM_DUN = '1' THEN NULL WHEN (SELECT 0 FROM DUAL WHERE EXISTS(SELECT * FROM trustfee_arrears_detail_report WHERE T.PK_ID = REPORT_ID AND IS_LONG_TERM_DUN = '0' ) ) = 0 AND T.TRANSFER_DATE >= TRUNC(CAST(? AS TIMESTAMP)) THEN '本期转入长期催收登记簿' ELSE '以往期间转入长期	</td><td style='mso-number-format:'@';'>10538	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>39	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f6d0a907c12d4643f2776eaaddea54d5	</td><td style='mso-number-format:'@';'>select Z.AREA_DISTRICT as Clr_Rgn_Inst_Num,
        (SELECT D.BANK_ID
            FROM UNIT_BANK D
            WHERE Z.AREA_DISTRICT = D.DQDH || D.JGDH) as Cur_Dpt_Acc_Opn_Bnk_No,
            (SELECT D.BANK_NAME
            FROM UNIT_BANK D
            WHERE Z.AREA_DISTRICT = D.DQDH || D.JGDH) as Cur_Dpt_Acc_Opn_Bnk_Nm
              from (
                    SELECT D.ZHDH || D.ZZHXH AS ACCOUNT_ID,
                            D.KHDQDH || D.KHJGDH AS AREA_DISTRICT
                      FROM DGZZHZWJ D
                    UNION ALL
                    SELECT HQ.ZHDH AS ACCOUNT_ID, HQ.DQDH || HQ.JGDH AS AREA_DISTRICT
                      FROM HQDGZWJ HQ) Z
             WHERE Z.ACCOUNT_ID = ?	</td><td style='mso-number-format:'@';'>10404	</td><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>40	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f9631d57591b883a1aa43ced318ff52e	</td><td style='mso-number-format:'@';'>with base_instruction as
        (
        select
        z.instruction_id,
        (CASE
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ13','TZZQ16')) THEN
        nvl((select (case when rtgs.shch_stop_status = '1' then '9' else rtgs.shch_draw_status end) ||'#@@#'|| by3 shch_draw_status from RTGS_COLLECTION_RECORD_1 rtgs where rtgs.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ12', 'TZZQ17')) THEN
        nvl((select c.ccdc_draw_status shch_draw_status from CCDC_COLLECTION_RECORD c where c.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN  (z.PAYMENT_TYPE_ID ='TZCK10') THEN
        nvl((select INSTRUCTION_PARAM_VALUE from instruction_ext where instruction_id =  z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME ='hqckWithDraw'),'')
        ELSE
        ''
        END) AS shchDrawStatus,
        z.product_id,
        z.REALTIME_STATUS,
        z.use_id,
        z.payment_date,
        z.payment_at,
        z.successful_paid_at,
        z.payment_type_id,
        (select pt.payment_type_name from payment_type pt
        where pt.payment_type_id = z.payment_type_id
        and pt.effectstatus = '1') hkmc,
        z.direction,
        z.amount,
        z.source_id,
        z.payment_reason,
        z.debit_account,
        z.debit_account_name,
        z.credit_account,
        z.credit_account_name,
        z.bank_id,
