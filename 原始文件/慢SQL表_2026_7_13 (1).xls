		and instr(right_check(z.product_id, ?, 'A'), '4') > 0 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		order by z.UPDATED_AT asc, z.CREATED_AT asc ) row_ ) where rownum_ > 0 and rownum_ <= 10	</td><td style='mso-number-format:'@';'>5808	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>75	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b680f97d75291f192fdb0999ee6e17af	</td><td style='mso-number-format:'@';'>select count(*)
		from
		(select 
		  PK_ID,FAX_ID,EC_ATTACH_ID,RECEIVE_DATE,DEAL_DATE,PRODUCT_NAME,PRODUCT_ID,
		  MANAGER_ID,MANAGER_NAME,DEAL_ID,RECORD_TYPE,RECORD_STATUS,AUDIT_COMMENT
