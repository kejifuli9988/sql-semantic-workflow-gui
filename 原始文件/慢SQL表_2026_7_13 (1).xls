aff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CENTER_F	</td><td style='mso-number-format:'@';'>8033	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>56	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>832efffacc8403983c4e6e8ab2757819	</td><td style='mso-number-format:'@';'>select
	        sum(a.jgjssl) as sl,
