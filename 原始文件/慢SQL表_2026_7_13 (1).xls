		INSTR_ID, BUSINESS_ID, PRODUCT_ID, PRODUCT_NAME, MANAGER_ID,
		MANAGER_NAME, OPD_BRANCH_ID, ACCOUNT_ID, ACCOUNT_NAME, ACCOUNT_TYPE,
		COUNTER_ACCOUNT_ID, COUNTER_ACCOUNT_NAME, BUSINESS_TYPE, INSTR_STATUS,
		COUNTER_STATUS, OUR_STATUS, OP_TYPE, NOTE_FLAG, AUTOCONFIRM_FLAG,
		NOTE_ID, RECORD_STATUS, FOUREYESSTATUS, AUDIT_COMMENT,BOND_COUNT,DELIVER_DATE1,DELIVER_DATE2, CREATED_AT,
		CREATED_BY, UPDATED_AT, UPDATED_BY, VALIDATED_AT, VALIDATED_BY ,MARKET_TYPE, INIT_SETTLE_AMOUNT, DUE_SETTLE_AMOUNT
		,SUPERVISION_SIGN,SUPERVISION_OPINION,BANK_ACCOUNT_ID
		from
