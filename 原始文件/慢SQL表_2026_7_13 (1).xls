        (SELECT z.instruction_id,
        CASE
        WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND
        z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN
        NVL((SELECT CASE
        WHEN rtgs.shch_stop_status = '1' THEN
        '9'
        ELSE
        rtgs.shch_draw_status
        END || '#@@#' || rtgs.shch_draw_status
        FROM RTGS_COLLECTION_RECORD_1 rtgs
        WHERE rtgs.instruction_id = z.instruction_id),
        '6')
        WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND
        z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN
        NVL((SELECT c.ccdc_draw_status
        FROM CCDC_COLLECTION_RECORD c
        WHERE c.instruction_id = z.instruction_id),
        '6')
        WHEN (z.SOURCE_ID IN ('0', '1', '2') AND
        z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN
        z.direct_status
        WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN
        NVL((SELECT INSTRUCTION_PARAM_VALUE
