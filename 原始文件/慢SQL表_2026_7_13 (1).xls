		            P.PRODUCT_NAME AS PRODUCT_NAME,
		            BA2.BANK_ACCOUNT_NAME AS ACCOUNT_NAME,
		            ACT.ACCOUNT_TYPE_NAME AS ACCOUNT_TYPE_NAME,
		            BA2.CURRENCY AS CURRENCY,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.CREATED_BY) AS CREATED_NAME,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.UPDATED_BY) AS UPDATED_NAME
	          FROM 	
