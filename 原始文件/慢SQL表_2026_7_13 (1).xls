			  select
				  a.updated_by ,
				  (SELECT STAFF.YHMC FROM IP_STAFF_STMT STAFF WHERE a.updated_by = STAFF.YHBH) AS YHMC,
				  a.source_id,
				  a.payment_type_id,
				  (SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE PT.PAYMENT_TYPE_ID = a.PAYMENT_TYPE_ID) AS PAYMENT_TYPE_NAME,
				  a.BUSINESS_TYPE,
				  (SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE PT.PAYMENT_TYPE_ID = a.BUSINESS_TYPE) AS BUSINESS_TYPE_NAME,
				  a.OPERATION_ROLE_ID,
				  (SELECT JSMC FROM IP_ROLE WHERE JSBH = a.OPERATION_ROLE_ID) AS JSMC,
				  a.PRODUCT_TYPE_ID,
				  (SELECT PT.PRODUCT_TYPE_NAME FROM  PRODUCT_TYPE PT WHERE a.PRODUCT_TYPE_ID = PT.PRODUCT_TYPE_ID) AS PRODUCT_TYPE_NAME,
				  COUNT(DISTINCT a.INSTRUCTION_ID) AS SUM_COUNT
			  from (
				  SELECT
					  CASE
					  WHEN H.OPERATION_ROLE_ID IS NULL
					  THEN 'U00000000'
					  ELSE NVL(H.UPDATED_BY, H.CREATED_BY)
					  END AS UPDATED_BY,
					  H.SOURCE_ID,
					  H.PAYMENT_TYPE_ID,
					  H.INSTRUCTION_ID,
					  (CASE
					  WHEN ie.INSTRUCTION_PARAM_VALUE IS NOT NULL THEN ie.INSTRUCTION_PARAM_VALUE
					  ELSE PAYMENT_TYPE_ID
					  END) AS BUSINESS_TYPE,
	  				  H.OPERATION_ROLE_ID,
					  P.PRODUCT_TYPE_ID
				  FROM INSTRUCTION_HIST H LEFT JOIN INSTRUCTION_EXT ie ON H.INSTRUCTION_ID = ie.INSTRUCTION_ID AND ie.INSTRUCTION_PARAM_NAME = 'hsgzzllx'
				  LEFT JOIN PRODUCT P ON H.PRODUCT_ID = P.PRODUCT_ID
				  WHERE H.ACTION_STATUS != '0'
					  AND H.PAYMENT_TYPE_ID IS NOT NULL
					  AND H.PAYMENT_DATE >= TO_DATE(?, 'yyyy-MM-dd')
					  AND H.PAYMENT_DATE <= TO_DATE(?, 'yyyy-MM-dd')
					  AND (INSTRUC_BATCH_FLAG != '1' OR INSTRUC_BATCH_FLAG IS NULL)
					   
