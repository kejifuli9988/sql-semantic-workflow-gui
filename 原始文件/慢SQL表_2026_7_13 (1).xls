86864', '25097611', '25098151', '25098474', '24073455', '24073453', 'TUS0001058', '23103653', '23067587', '24051227', '25031822', '25064528', '25064644', '24129770', '22034008', '25064289', '25042478', '25075943', '25043101', '24129769', '21081771', '24040417', '24049968', '25032092', '24051113', '24017494', '24051107', '25032305', '25031693', '24039166', '21069297', '24040264', '21094045', '24049970', '24061819', 	</td><td style='mso-number-format:'@';'>2576	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>160	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>2fb4316e1adb6849f78cba1483529fb1	</td><td style='mso-number-format:'@';'>select
				   D.PK_ID,
