		from bank_account ba
		where ba.bank_account_id = isu.debit_account
		and ba.effectstatus = '1') in ('CNQSFZH','RQFIIQSFZH') 	</td><td style='mso-number-format:'@';'>3294	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>130	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b7ba00ab79d2b7e6d2882d869e930b0f	</td><td style='mso-number-format:'@';'>update BANK_ACCOUNT
