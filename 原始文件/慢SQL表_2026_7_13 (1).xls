	        trim(a.jgzqzh) as gddm,
			'sjsjg' as sj_tname
        from sjsjg a
       where a.datadate = ?
         and a.jgywlb in (select MBLXBH from ip_codeinfo  where sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000350')
         and a.jgsjlx = '01'
         and a.jgjsbz = 'Y'
		  and a.jgbfzh = ? 
		 
       group by a.jgzqzh, a.datadate	</td><td style='mso-number-format:'@';'>7679	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>57	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>0ba757a41b277bc8d5862da40b43bae0	</td><td style='mso-number-format:'@';'>merge into TRANS_INFO ipd
		USING (
		   
			select
			? as pk_id,
			? as product_id,
			? as product_code,
			? as manager_prod,
			? as org_no,
			? as seq_no,
			? as instruction_num,
			? as trade_date,
			? as confirm_date,
			? as trade_direction,
			? as security_type,
			? as regist_code,
			? as security_code,
			? as security_name,
			? as appmoney,
			? as appvol,
			? as amount,
			? as qrfe,
			? as quantity,
			? as trade_fee,
			? as interest,
			? as volumebyinterest,
			? as refundamount,
			? as reciprocal_code,
			? as reciprocal_quantity,
			? as trade_status,
			? as fail_reason,
			? as gxrq,
			? as instruction_id,
			? as create_time,
			? as source,
			? as source_code,
			? as foureyesstatus,
			? as debit_account,
			? as debit_account_name,
			? as validatedBy,
			? as validatedAt,
			? as byzd1,
			? as byzd2,
			? as byzd3,
