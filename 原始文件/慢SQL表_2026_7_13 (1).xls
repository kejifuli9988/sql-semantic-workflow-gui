		null WXFXZYXX,
		null INTE	</td><td style='mso-number-format:'@';'>24673	</td><td style='mso-number-format:'@';'>12	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>19	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>1093d17c4db963ce4e49d9bcc14e80be	</td><td style='mso-number-format:'@';'>merge into CSBS_CONTRACT a USING(
		   
			SELECT
			? as contractPkId
			,? as productId
