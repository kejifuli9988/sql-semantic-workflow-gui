		z.CPA_ID,z.ACCOUNT_ID,z.ACCOUNT_NAME,z.INTER_BANK,z.SAME_CITY,z.BANK_ID,z.BANK_NAME,z.YBANK_ID,z.YBANK_NAME,z.BRANCHID,z.EFFECTSTATUS,z.OP_TYPE,z.FOUREYESSTATUS,z.AUDIT_COMMENT,z.CREATED_AT,z.CREATED_BY,z.UPDATED_AT,z.UPDATED_BY,z.VALIDATED_AT,z.VALIDATED_BY,CURRENCY,
		(select a.yhmc from ip_staff a where z.CREATED_BY=a.yhbh) as createdByName,
		(select b.yhmc from ip_staff b where z.UPDATED_BY=b.yhbh) as updatedByName,
		(select c.yhmc from ip_staff c where z.VALIDATED_BY=c.yhbh) as validatedByName,
