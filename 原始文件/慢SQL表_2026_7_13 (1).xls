		? accou	</td><td style='mso-number-format:'@';'>3224	</td><td style='mso-number-format:'@';'>58	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>136	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>5535ccd95ee318e843ec13096818781c	</td><td style='mso-number-format:'@';'>select
		z.FAX_INSTRUCTION_ID,z.INSTRUCTION_ID,z.FAX_ID,z.PRODUCT_CODE,z.PAYMENT_DATE,z.PAYMENT_TYPE_ID,z.DIRECTION,z.AMOUNT,z.CURRENCY,z.PAYMENT_REASON,z.CREDIT_ACCOUNT,z.CREDIT_ACCOUNT_NAME,z.DEBIT_ACCOUNT,z.DEBIT_ACCOUNT_NAME,z.BANK_ID,z.BANK_NAME,z.sfqd,
		z.FILE_PATH,z.CREATED_AT,z.CREATED_BY,z.UPDATED_AT,z.UPDATED_BY,z.RESULT_STATUS,z.PUSH_STATUS,z.PUSH_AT,z.MANAGER_ID,z.MANAGER_NAME,z.RESULT_TYPE,AUDIT_COMMENT,z.TGT_QDZLBH,nvl(z.BUSINESS_TYPE,'0') BUSINESS_TYPE,
		(select a.yhmc from ip_staff a where z.CREATED_BY=a.yhbh) as createdByName,
		(select b.yhmc from ip_staff b where z.UPDATED_BY=b.yhbh) as updatedByName,
		(SELECT p.product_name FROM product p WHERE p.PRODUCT_CODE=z.PRODUCT_CODE order by p.created_at desc fetch first 1 rows only) as PRODUCT_NAME,
		NVL((SELECT psi.SYSTEM_FLAG FROM product p,prod_switch_info psi WHERE p.product_id = psi.product_id(+) and p.PRODUCT_CODE=z.PRODUCT_CODE order by p.created_at desc fetch first 1 rows only),'1') as systemFlag,
		z.ZLLY,
		(SELECT i.INSTRUC_BATCH FROM instruction i WHERE i.instruction_id = z.instruction_id) as INSTRUC_BATCH
		from FAX_INSTRUCTION z
		where 1=1
		 
		  and INSTRUCTION_ID like '%' || ? || '%' 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
 		 
		 
		order by RESULT_STATUS asc,PUSH_AT desc	</td><td style='mso-number-format:'@';'>3214	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>137	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>76239a5add068a2ab845b5d15fdf8f58	</td><td style='mso-number-format:'@';'>SELECT T.BALANCE_ID,
			   T.PRODUCT_ID,
			   (SELECT P.PRODUCT_CODE FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) PRODUCT_CODE,
			   (SELECT P.MANAGER_PROD FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) MANAGER_PROD,
			   (SELECT P.PRODUCT_NAME FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) PRODUCT_NAME,
			   T.ACCOUNT_ID,
			   (SELECT BA.BANK_ACCOUNT_NAME FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = T.ACCOUNT_ID AND BA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID
				   	 UNION
				   	 SELECT CA.ACCOUNT_NAME FROM CSDS_ACCOUNT CA WHERE CA.CSDS_ACCOUNT_ID = T.ACCOUNT_ID AND CA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID
				   	 UNION
				   	 SELECT SA.ACCOUNT_NAME FROM SECURITY_ACCOUNT SA where SA.ACCOUNT_CODE = T.ACCOUNT_ID AND SA.EFFECTSTATUS = '1' AND SA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) ACCOUNT_NAME,
			   T.ACCOUNT_TYPE_ID,
	           (select ACT.ACCOUNT_TYPE_NAME from ACCOUNT_TYPE ACT where ACT.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) ACCOUNT_TYPE_NAME,
			   T.BALANCE_DATE,
			   T.AMOUNT,
			   (SELECT BA.CURRENCY FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = T.ACCOUNT_ID AND BA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID
	               	 UNION
	               	 SELECT CA.CURRENCY FROM CSDS_ACCOUNT CA WHERE CA.CSDS_ACCOUNT_ID = T.ACCOUNT_ID AND CA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) CURRENCY,
			   T.CREATED_AT,
			   T.CREATED_BY,
			   (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = T.CREATED_BY) CREATED_NAME,
			   T.UPDATED_AT,
			   T.UPDATED_BY,
			   (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = T.UPDATED_BY) UPDATED_NAME,
               USABLE_BALANCE,
               CONTROL_BALANCE,
               FREEZE_BALANCE,
			   ACCOUNT_SUB_SN
		 FROM
			(SELECT 
					BH.BALANCE_HISTORY_ID BALANCE_ID,
					BH.PRODUCT_ID,
	               	BH.ACCOUNT_ID,
	               	BH.ACCOUNT_TYPE_ID,
	               	BH.BALANCE_DATE,
	               	BH.AMOUNT,
