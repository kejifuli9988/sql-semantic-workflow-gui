h = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg	</td><td style='mso-number-format:'@';'>2181	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>210	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>672c8a4a868b92a9297a8d65cf60a462	</td><td style='mso-number-format:'@';'>select count(*)
		from INSTRUC_SUPERVISION_MATCH z
		where 1=1
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		  and SUPERVISION_TYPE = ? 
		 
		  and ((z.product_id is null) or exists(
			select 1
			from  USER_OPERATING_BRANCH u
			inner join product p on u.branchid = p.opd_branchid
			inner join para_code pc on p.product_id = pc.code_id and pc.para_key = Z.PRODUCT_ID
			where u.effectstatus = '1' and u.userid = ?) or exists(
