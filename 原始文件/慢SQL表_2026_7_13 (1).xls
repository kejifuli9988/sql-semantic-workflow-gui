	   AND D.MXYWLS = ?	</td><td style='mso-number-format:'@';'>2574	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>161	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c334a9aad72384465e039d34e2745771	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2025 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTI	</td><td style='mso-number-format:'@';'>2574	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>162	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>a3d5bf4e3a56722340aa2f79af0c6176	</td><td style='mso-number-format:'@';'>WITH SC AS
 (SELECT CASHFLOW_ID,
         CREDIT_ACCOUNT,
         AMOUNT,
         DEBIT_ACCOUNT,
         CASHFLOW_AT,
         ROW_NUMBER() OVER(PARTITION BY CASHFLOW_AT, CREDIT_ACCOUNT, AMOUNT, DEBIT_ACCOUNT ORDER BY CASHFLOW_ID) ROW_NUM
    FROM SETTLEMENT_CASHFLOW_HISTORY SCH
    LEFT JOIN PRODUCT P
      ON SCH.PRODUCT_ID = P.PRODUCT_ID
   WHERE INSTRUCTION_ID IS NULL
     AND SUMMARY NOT IN ('855', '850')
     AND COUNTER_CASHFLOW NOT LIKE '9699%'
     AND DIRECTION = '0'
     AND ((SCH.PRODUCT_ID IS NOT NULL 
         AND P.PRODUCT_TYPE_ID NOT IN ('DK', 'ZJMJ', 'BXDLJDR', 'ABSZJGJ', 'JGJY', 'JGQT')
         AND P.OPD_BRANCHID IN 
		 (  
			?
		 )  ) 
       OR SCH.PRODUCT_ID IS NULL)
     AND CASHFLOW_AT BETWEEN trunc(cast(? as timestamp)) AND trunc(cast(? as timestamp))),
CC AS
 (SELECT INSTRUCTION_ID,
         CREDIT_ACCOUNT,
         AMOUNT,
         DEBIT_ACCOUNT,
         PAYMENT_AT,
         ROW_NUMBER() OVER(PARTITION BY PAYMENT_AT, CREDIT_ACCOUNT, AMOUNT, DEBIT_ACCOUNT ORDER BY INSTRUCTION_ID) ROW_NUM
    FROM INSTRUCTION I
    LEFT JOIN PRODUCT P
      ON I.PRODUCT_ID = P.PRODUCT_ID
   WHERE I.PAYMENT_MODE = '2'
     AND I.DIRECTION = '0'
     AND I.FINAL_PAYMENTSTATUS = '3'
     AND ((I.PRODUCT_ID IS NOT NULL 
         AND P.PRODUCT_TYPE_ID NOT IN ('DK', 'ZJMJ', 'BXDLJDR', 'ABSZJGJ', 'JGJY', 'JGQT')
         AND P.OPD_BRANCHID IN 
		 (  
			?
		 )  ) 
       OR I.PRODUCT_ID IS NULL)
     AND I.PAYMENT_AT BETWEEN trunc(cast(? as timestamp)) AND trunc(cast(? as timestamp)))
SELECT SC.CASHFLOW_ID
