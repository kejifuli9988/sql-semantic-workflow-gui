   	</td><td style='mso-number-format:'@';'>2271	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>191	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>3615524cf04ab130da2f62f5d6d36b35	</td><td style='mso-number-format:'@';'>WITH QX_SQL AS
		(SELECT WM_CONCAT(PRO_IND_BRANCHID) AS BRANCHID
		FROM CNZL_AUTHPAR
		WHERE INSTR(USER_BRANCHID, 'G00017713') > 0
		AND EFFECTSTATUS = '1'
		AND FOUREYESSTATUS = '1')
		SELECT Z.UNIT_ID,
		? USER_ID,
		Z.MON_MAT_TYPE,
		? REMINDER_TYPE,
		Z.DATA_AT,
		Z.INS_ID,
		NVL(Z.PRODUCT_ID, Z.UNIT_ID) AS PRODUCT_ID,
		NVL(Z.STEP_ID, '-1') AS STEP_ID,
		(SELECT IR.CDBH FROM IP_RESMENU IR
		WHERE IR.CDURL = (CASE
		WHEN Z.STEP_ID = '4' THEN '/stmtExecuteManage/list.do'
		ELSE '未知' END)) AS CDBH,
		NVL((SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE Z.PAYMENT_TYPE_ID = PT.PAYMENT_TYPE_ID),
		NVL((SELECT IC.MBTMZ
		FROM IP_CODEINFO IC
		WHERE IC.SJLX IN ('CSBSCSBSCSBSCSBSCSBSCSBS00010001', 'TYLTYLTYLTYLTYLTYLTYLTYL00000348')
		AND IC.MBLXBH = Z.PAYMENT_TYPE_ID),
		'划款类型为空')) AS PAYMENT_TYPE_NAME,
		(CASE
		WHEN Z.STEP_ID = '4' THEN '清算执行经办'
		ELSE '未知' END) AS STEP_NAME,
		NVL(Z.PAYMENT_TYPE_ID, '-1') AS PAYMENT_TYPE_ID,
		Z.DATA_TYPE,
		Z.TIME_OUT_FLAG
		FROM TIME_OUT_DATA Z
		WHERE  Z.MON_MAT_TYPE = ?
		AND  Z.DATA_AT = TRUNC(SYSDATE)
		 
			AND EXISTS (
			SELECT 1 FROM DUAL
			WHERE Z.STEP_ID = '4'
			AND EXISTS (SELECT 1 FROM IP_BUTTON_LIST B, IP_RESMENU R WHERE B.CDBH = R.CDBH AND B.ACTION = 'btAdd' AND R.CDURL = '/stmtExecuteManage/list.do'
			AND B.JSBH IN
			 (  
				?
			 , 
				?
			 , 
				?
			 , 
