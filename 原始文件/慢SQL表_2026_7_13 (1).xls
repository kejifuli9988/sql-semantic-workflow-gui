        tadr.IS_OPD_BRANCH_SEND_DUNLTR AS isOpdBranchSendDunltr,
        TO_CHAR(tadr.OPD_BRANCH_LAST_DUNLTR_DATE,'yyyy-MM-dd') AS opdBranchLastDunltrDate,
        tadr.OPD_BRANCH_MANAGER_FEEDBACK_TYPE AS opdBranchManagerFeedbackType,
        tadr.OPD_BRANCH_MANAGER_FEEDBACK_DETAIL AS opdBranchManagerFeedbackDetail,
        TO_CHAR(tadr.OPD_BRANCH_LAST_TRACK_DATE,'yyyy-MM-dd') AS opdBranchLastTrackDate,
        tadr.IS_MARKETING_BRANCH_SEND_DUNLTR AS isMarketingBranchSendDunltr,
        TO_CHAR(tadr.MARKETING_BRANCH_LAST_DUNLTR_DATE,'yyyy-MM-dd') AS marketingBranchLastDunltrDate,
        tadr.MARKETING_BRANCH_MANAGER_FEEDBACK	</td><td style='mso-number-format:'@';'>2213	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>200	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>57a3473ad5866d5561c2c211078c8d67	</td><td style='mso-number-format:'@';'>select count(*)
