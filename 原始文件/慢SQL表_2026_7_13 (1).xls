         	</td><td style='mso-number-format:'@';'>2316	</td><td style='mso-number-format:'@';'>11	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>184	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>5bde6ab84053c01052c1de0fb526219f	</td><td style='mso-number-format:'@';'>select
		count(distinct t.instruction_id)
		from (
		 
		select x.instruction_id
		from instruction x
		left join product p
		on x.product_id = p.product_id
		left join CRITICAL_MONITOR_SIGN cm
		on x.instruction_id = cm.RELATION_ID
		where 1 = 1
		 
		 and  cm.OPD_CONFIRM_STATUS IS NULL 
		and x.product_id is not null
		and x.instruc_batch_flag in ('0', '-1')
		and (x.TRADE_TYPE = '1' or x.TRADE_TYPE is null)
		and  p.OPD_BRANCHID in
		 (  
			?
		 ) 
		 	and x.PAYMENT_AT >= trunc(cast(? as timestamp)) and x.PAYMENT_AT < trunc(cast(?  as timestamp)+ 1) 
		 
			and (x.PAYMENT_TYPE_ID    in
			 ( 
				  
				?
			 
				 
					  , 
				 
				?
			 
				 
					  , 
				 
				?
			 
				 
					  , 
				 
				?
			 ) 
			  )
		 
		and  x.action_status not in ('2', '3')
		and (x.final_paymentstatus not in ('3','7') or    x.final_paymentstatus is  null)
		
		union all
		select  x.instruction_id
		from instruction x
		left join CRITICAL_MONITOR_SIGN cm
		on x.instruction_id = cm.RELATION_ID
		inner join bank_account ba on ba.bank_account_id =
				decode(x.direction, '0', x.credit_account, '1', x.debit_account, '3', x.credit_account)
		inner join (
					select aup.ind_branchid,aup.opd_branchid,aup.bank_account_id
					from (select a.bank_account_id,
							pro.ind_branchid as ind_branchid,
							pro.opd_branchid as opd_branchid,
							ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN
							from auxiliary_product a
							inner join product pro
							on pro.product_id = a.product_id
							where a.effectstatus = '1'
					) aup
					where aup.rown = 1
		) ap
		on ap.bank_account_id = ba.bank_account_id
		where 1 = 1
		 
			and ap.OPD_BRANCHID IN
			 (  
				?
			 ) 
		 
		 
		 and  cm.OPD_CONFIRM_STATUS IS NULL 
		and x.product_id is null
		and x.instruc_batch_flag in ('0', '-1')
		and (x.TRADE_TYPE = '1' or x.TRADE_TYPE is null)
		and ba.account_attribute = '1'
		and	</td><td style='mso-number-format:'@';'>2306	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>185	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>afafc6b9c3ba69390cbba17b411f540e	</td><td style='mso-number-format:'@';'>select count(*)
        FROM
            TRUSTFEE_ARREARS_REPORT tar
                LEFT JOIN (
                SELECT *
                FROM TRUSTFEE_ARREARS_DETAIL_REPORT
                WHERE PK_ID IN (
                    SELECT pk_id
                    FROM (
                             SELECT
                                 pk_id,
                                 report_id,
                                 aging,
                                 BUSINESS_DATE,
                                 ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn
                             FROM trustfee_arrears_detail_report
                         ) t
                    WHERE rn = 1
                )
            ) ta
                          ON tar.PK_ID = ta.REPORT_ID
                LEFT JOIN product p
                          ON tar.product_id = p.product_id
        WHERE
            tar.is_payment_date_unknown = '0'
          AND (ta.aging IS NULL OR ta.unpaid_trustfee_amount IS NULL )
            AND P.OPD_BRANCHID IN (
            SELECT UOB.BRANCHID
            FROM USER_OPERATING_BRANCH UOB
            WHERE UOB.USERID = ?
            )
            AND tar.product_id IN (
            SELECT pp.product_id
            FROM product_info_branch pib
            , product pp
            WHERE pib.product_id = pp.product_id
            AND pib.roleid IN (
            SELECT irs.jsbh
            FROM ip_role_stmt irs
            WHERE irs.jsmc IN ('核算经办', '分行核算经办')
            )
        and pib.userid in  (  
        ?  ) 
            )	</td><td style='mso-number-format:'@';'>2305	</td><td style='mso-number-format:'@';'>9	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>186	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>29321a137d7412e0570f175346499bb4	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT
        '应付托管费金额维护' AS todoItem,
        '产品[' || p.product_name || ']为核算系统无法准确计提托管费的产品，未按支付频率维护应付托管费金额' AS reminderText,
        (
        SELECT cdbh
        FROM ip_resmenu
        WHERE cdmc = '新托管费未支付监控'
        ) AS nodeId,
        '新托管费未支付监控' AS nodeText,
        '/trustfeeArrearsReport/list.do' AS nodeURL
        FROM
        TRUSTFEE_ARREARS_REPORT tar
        LEFT JOIN
        product p ON tar.product_id = p.product_id
        LEFT JOIN (
        SELECT *
        FROM TRUSTFEE_ARREARS_DETAIL_REPORT
        WHERE PK_ID IN (
        SELECT pk_id
        FROM (
        SELECT
        pk_id,
        report_id,
        unpaid_trustfee_amount,
        BUSINESS_DATE,
        ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn
        FROM trustfee_arrears_detail_report
        ) t
        WHERE rn = 1
        )
        ) ta ON tar.PK_ID = ta.REPORT_ID
        WHERE 1=1
          AND tar.IS_FIXED_AMOUNT <> '0'
          AND (tar.IS_PAYMENT_DATE_UNKNOWN <> 0 OR tar.IS_PAYMENT_DATE_UNKNOWN IS NULL)
          AND (ta.unpaid_trustfee_amount IS NULL OR ta.unpaid_trustfee_amount = 0)
            AND P.OPD_BRANCHID IN (
            SELECT UOB.BRANCHID
            FROM USER_OPERATING_BRANCH UOB
            WHERE UOB.USERID = ?
            )
            AND tar.product_id IN (
            SELECT pp.product_id
            FROM product_info_branch pib
            , product pp
            WHERE pib.product_id = pp.product_id
            AND pib.roleid IN (
            SELECT irs.jsbh
            FROM ip_role_stmt irs
            WHERE irs.jsmc IN ('核算经办', '分行核算经办')
            )
        and pib.userid in  (  
        ?  ) 
