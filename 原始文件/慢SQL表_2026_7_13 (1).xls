        '新托管费未支付监控' AS nodeText,
        '/trustfeeArrearsReport/list.do' AS nodeURL
        FROM
        TRUSTFEE_ARREARS_REPORT tar
        LEFT JOIN
        product p ON tar.product_id = p.product_id
        LEFT JOIN (
        SELECT *
        FROM TRUSTFEE_ARREARS_DETAIL_REPORT
        WHERE PK_ID IN (
        SELECT pk_id
        FROM (
        SELECT
        pk_id,
        report_id,
        unpaid_trustfee_amount,
        BUSINESS_DATE,
        ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn
        FROM trustfee_arrears_detail_report
        ) t
        WHERE rn = 1
        )
        ) ta ON tar.PK_ID = ta.REPORT_ID
        WHERE 1=1
          AND tar.IS_FIXED_AMOUNT <> '0'
          AND (tar.IS_PAYMENT_DATE_UNKNOWN <> 0 OR tar.IS_PAYMENT_DATE_UNKNOWN IS NULL)
          AND (ta.unpaid_trustfee_amount IS NULL OR ta.unpaid_trustfee_amount = 0)
            AND P.OPD_BRANCHID IN (
            SELECT UOB.BRANCHID
            FROM USER_OPERATING_BRANCH UOB
            WHERE UOB.USERID = ?
            )
            AND tar.product_id IN (
            SELECT pp.product_id
            FROM product_info_branch pib
            , product pp
            WHERE pib.product_id = pp.product_id
            AND pib.roleid IN (
            SELECT irs.jsbh
            FROM ip_role_stmt irs
            WHERE irs.jsmc IN ('核算经办', '分行核算经办')
            )
        and pib.userid in  (  
        ?  ) 
            ) ) row_ ) where rownum_ > 200 and rownum_ <= 300	</td><td style='mso-number-format:'@';'>2169	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>213	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>5d61a7a0750a6e02740a233e84f6735b	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH UnuseAccountFilter AS (
		SELECT DISTINCT P2.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP2 ON UA.BANK_ACCOUNT_ID = AP2.BANK_ACCOUNT_ID
		JOIN PRODUCT P2 ON AP2.PRODUCT_ID = P2.PRODUCT_ID
		WHERE
		UA.EFFECTSTATUS = '1'
		AND P2.SUB_GROUP_MARK = '0'
		)

		SELECT T.BALANCE_ID,
			   T.PRODUCT_ID,
			   T.PRODUCT_CODE,
			   T.MANAGER_PROD,
			   T.PRODUCT_NAME,
			   T.ACCOUNT_ID,
			   T.ACCOUNT_NAME,
			   T.ACCOUNT_TYPE_ID,
	           T.ACCOUNT_TYPE_NAME,
			   T.BALANCE_DATE,
			   T.AMOUNT,
			   T.CURRENCY,
			   T.CREATED_AT,
			   T.CREATED_BY,
			   T.CREATED_NAME,
			   T.UPDATED_AT,
			   T.UPDATED_BY,
			   T.UPDATED_NAME,
	           T.USABLE_BALANCE,
	           T.CONTROL_BALANCE,
	          T.FREEZE_BALANCE,
		T.ACCOUNT_SUB_SN
		 FROM
			(
			SELECT 
					BH.BALANCE_HISTORY_ID BALANCE_ID,
					BH.PRODUCT_ID,
	               	BH.ACCOUNT_ID,
	               	BH.ACCOUNT_TYPE_ID,
	               	BH.BALANCE_DATE,
	               	BH.AMOUNT,
	               	BH.CREATED_AT,
	               	BH.CREATED_BY,
	               	BH.UPDATED_AT,
	               	BH.UPDATED_BY,
	               	BH.USABLE_BALANCE,
	               	BH.CONTROL_BALANCE,
	               	BH.FREEZE_BALANCE,
		            AP.ACCOUNT_SUB_SN AS ACCOUNT_SUB_SN,
		            P.PRODUCT_CODE AS PRODUCT_CODE,
		            P.MANAGER_PROD AS MANAGER_PROD,
		            P.PRODUCT_NAME AS PRODUCT_NAME,
		            BA2.BANK_ACCOUNT_NAME AS ACCOUNT_NAME,
		            ACT.ACCOUNT_TYPE_NAME AS ACCOUNT_TYPE_NAME,
		            BA2.CURRENCY AS CURRENCY,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.CREATED_BY) AS CREATED_NAME,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.UPDATED_BY) AS UPDATED_NAME
	          FROM 	
	          		BALANCE_HISTORY BH
		LEFT JOIN ACCOUNT_PRODUCT AP ON AP.BANK_ACCOUNT_ID = BH.ACCOUNT_ID AND AP.PRODUCT_ID = BH.PRODUCT_ID AND AP.EFFECTSTATUS = '1'
		LEF	</td><td style='mso-number-format:'@';'>2124	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>214	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>e45d44bac251f21460558eab073a57f3	</td><td style='mso-number-format:'@';'>select count(*)
        FROM
            TRUSTFEE_ARREARS_REPORT tar
                LEFT JOIN (
                SELECT *
                FROM TRUSTFEE_ARREARS_DETAIL_REPORT
                WHERE PK_ID IN (
                    SELECT pk_id
                    FROM (
                             SELECT
                                 pk_id,
                                 report_id,
                                 aging,
                                 BUSINESS_DATE,
                                 ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn
                             FROM trustfee_arrears_detail_report
                         ) t
                    WHERE rn = 1
                )
            ) ta
                          ON tar.PK_ID = ta.REPORT_ID
                LEFT JOIN product p
                          ON tar.product_id = p.product_id
        WHERE
            tar.is_payment_date_unknown = '0'
          AND (ta.aging IS NULL OR ta.unpaid_trustfee_amount IS NULL )
            AND P.OPD_BRANCHID IN (
            SELECT UOB.BRANCHID
            FROM USER_OPERATING_BRANCH UOB
            WHERE UOB.USERID = ?
            )
