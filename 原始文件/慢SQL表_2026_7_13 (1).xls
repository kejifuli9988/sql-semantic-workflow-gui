				select tu.pk_id from (
					select t.pk_id,t.tran_id  from csbs_instruction_origin t
					where 1=1
					 
						union all
					select t.pk_id,t.src_trade_id tran_id  from shch_instruction_origin t
					where 1=1
					 
				) tu
		  ) 
		  and z.bond_type='1' ) row_ ) where rownum_ > 0 and rownum_ <= 20	</td><td style='mso-number-format:'@';'>3431	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>127	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c8753a27caac51841f89fc9ba8e6f126	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select * from (
		select p.product_code cpdm,
		i.instruction_id instructionId,
		i.credit_account fkfzh,
		i.instruction_id hkdbh,
		i.amount hkje,
		i.payment_type_id hklx,
		to_char(i.payment_at,'yyyyMMdd') hkrq,
		to_char(i.created_at,'yyyyMMddHH24miss') cjsj,
		i.direction sfkfx,
		i.debit_account skfzhh,
		i.currency bz,
		i.credit_account_id fkfzhid,
		i.credit_account_name fkfzhqc,
		i.bank_name fkfzhkhh,
		i.debit_account_id skfzhid,
		i.debit_account_name skfzhqc,
		i.fbank_name skfzhkhh,
		case
		when i.payment_type_id in ('TZXG01', 'TZXG02') then
		i.ipo_subscribe
		else
		i.payment_reason
		end summary
		from instruction i
		inner join product p
		on i.product_id = p.product_id
		where i.payment_type_id != 'QSCNDB'
		and not exists (select 1 from etf_paymenttype_map epm
		where i.payment_type_id = epm.main_paymenttype_id
		and epm.map_type = '1')
		and i.payment_status in( '3','8')
		and p.effectstatus = '1'
		 
			and p.product_code in
			 (  
				?
			 , 
				?
			 , 
				?
			 ) 
		 
		 
		and i.payment_at >= to_date(?,'yyyy/MM/dd')
		and i.payment_at <= to_date(?,'yyyy/MM/dd')
		union all
		select p.product_code cpdm,
		i.instruction_id instructionId,
		case
		when (select ba.account_type_id
		from bank_account ba
		where ba.bank_account_id = isu.credit_account
		and ba.effectstatus = '1') in ('CNQSFZH','RQFIIQSFZH')  then
		(select ap.bank_account_id
		from account_product ap
		where ap.product_id = p.product_id
		and ap.main_account_mark = '0'
		and ap.effectstatus = '1')
		else
		isu.credit_account
		end fkfzh,
		isu.sub_id hkdbh,
		isu.amount hkje,
		isu.payment_type_id hklx,
		to_char(i.payment_at,'yyyyMMdd') hkrq,
		to_char(i.created_at,'yyyyMMddHH24miss') cjsj,
		isu.direction sfkfx,
		case
		when (select ba.account_type_id
		from bank_account ba
		where ba.bank_account_id = isu.debit_account
		and ba.effectstatus = '1') in ('CNQSFZH','RQFIIQSFZH') then
		(select ap.bank_account_id
