			 ) 
		 
		 
		and i.payment_at >= to_date(?,'yyyy/MM/dd')
		and i.payment_at <= to_date(?,'yyyy/MM/dd')
		union all
		select p.product_code cpdm,
		i.instruction_id instructionId,
		case
		when (select ba.account_type_id
