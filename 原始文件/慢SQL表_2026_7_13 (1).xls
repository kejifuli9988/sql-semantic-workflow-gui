<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Sheet1</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table style="vnd.ms-excel.numberformat:@"><tr><td>序号</td><td>来源</td><td>指纹</td><td>SQL语句</td><td>平均响应时间(ms)</td><td>执行次数</td><td>服务</td><td>异常类型</td></tr><tr><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>4285465ac0d5bef68a3365dc32241310	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	 
                    	  AND BA.ACCOUNT_ID = ? 
                   ) 
                AND NOT EXISTS(
                   	SELECT 1
					  FROM CheckUnuseProduct c
					 WHERE  BA.PRODUCT_ID = c.PRODUCT_ID
                   )
		) T	</td><td style='mso-number-format:'@';'>328140	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>4c5bbb92fb5eed89a963ac77e0aed3c2	</td><td style='mso-number-format:'@';'>SELECT sch.cashflow_id,
		       sch.core_cashflow_id,
		       sch.product_id,
		       sch.account_id,
		       sch.account_type_id,
		       sch.cashflow_at,
		       sch.cashflow_time,
		       sch.counter_cashflow,
		       sch.credit_account,
		       sch.credit_account_name,
		       sch.debit_account,
		       sch.debit_account_name,
		       sch.direction,
		       sch.amount,
		       sch.balance_before,
		       sch.balance_after,
		       sch.currency,
		       sch.transaction_code,
		       sch.summary,
		       sch.message,
		       sch.remark,
		       nvl(sch.updated_at, sch.created_at) updated_at,
		       sch.use_info,
		       sch.bank_no,
		       sch.bank_name,
		       sch.trade_org_code,
		       sch.post_route_choose,
		       sch.cpzxh,
		       sch.cpznxh,
		       sch.trade_area_code
		  FROM SETTLEMENT_CASHFLOW_HISTORY SCH
		 WHERE SCH.SUMMARY = '591'
		   AND SCH.CASHFLOW_AT BETWEEN  CAST( ? AS TIMESTAMP) AND   CAST( ? AS TIMESTAMP)
		   AND NOT EXISTS (SELECT 1 FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = SCH.ACCOUNT_ID AND BA.DEDICATED = '0')
		   AND NOT EXISTS (SELECT 1 FROM CORE_CASHFLOW_RETURN R
		         WHERE SCH.ACCOUNT_ID = R.ACCOUNT_ID
		           AND SCH.CASHFLOW_AT = R.CASHFLOW_AT
		           AND SCH.CASHFLOW_TIME = R.CASHFLOW_TIME
		           AND SCH.CPZXH = R.CPZXH
		           AND SCH.CPZNXH = R.CPZNXH
		           AND SCH.DIRECTION = R.DIRECTION
		           AND SCH.AMOUNT = R.AMOUNT
		           AND SCH.COUNTER_CASHFLOW = R.COUNTER_CASHFLOW
		           AND (SCH.CREDIT_ACCOUNT = R.CREDIT_ACCOUNT OR (SCH.CREDIT_ACCOUNT IS NULL AND R.CREDIT_ACCOUNT IS NULL))
		           AND (SCH.DEBIT_ACCOUNT = R.DEBIT_ACCOUNT OR (SCH.DEBIT_ACCOUNT IS NULL AND R.DEBIT_ACCOUNT IS NULL)))	</td><td style='mso-number-format:'@';'>315921	</td><td style='mso-number-format:'@';'>64	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>375ad51265a35867df5805e72ffdafbb	</td><td style='mso-number-format:'@';'>WITH base_instruction AS
        (SELECT z.instruction_id,
        (CASE
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ13','TZZQ16')) THEN
        nvl((select (case when rtgs.shch_stop_status = '1' then '9' else rtgs.shch_draw_status end) ||'#@@#'|| by3 shch_draw_status from RTGS_COLLECTION_RECORD_1 rtgs where rtgs.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ12', 'TZZQ17')) THEN
        nvl((select c.ccdc_draw_status shch_draw_status from CCDC_COLLECTION_RECORD c where c.instruction_id=z.INSTRUCTION_ID),'6')
        WHEN (z.SOURCE_ID in('0','1','2') and z.PAYMENT_TYPE_ID in ('JWZQ01','JWZQ02')) THEN
        z.direct_status
        WHEN  (z.PAYMENT_TYPE_ID ='TZCK10') THEN
        nvl((select INSTRUCTION_PARAM_VALUE from instruction_ext where instruction_id =  z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME ='hqckWithDraw'),'')
        ELSE
        ''
        END) AS shchDrawStatus,
        z.product_id,
        z.REALTIME_STATUS REALTIME_STATUS,
        z.use_id,
        z.payment_date,
        z.payment_at,
        z.successful_paid_at,
        z.payment_type_id,
        (select pt.payment_type_name from payment_type pt where pt.payment_type_id = z.payment_type_id) hkmc,
        z.direction,
        z.amount,
        z.source_id,
        z.payment_reason,
        z.debit_account,
        z.debit_account_name,
        z.credit_account,
        z.credit_account_name,
        z.bank_id,
        z.bank_name,
        z.db_status,
        z.ANO_SYS_STAT,
        z.batch,
        z.IPO_SUBSCRIBE,
        z.entrust,
        z.security_code,
        z.payment_mode,
        z.inter_bank,
        decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) as finalStatusOrder,
        z.final_paymentstatus,
        z.payment_status,
        (select ip.yhmc from ip_staff_stmt ip where ip.yhbh = z.updated_by) updatedbyname,
        z.updated_at,
        z.created_at,
    	</td><td style='mso-number-format:'@';'>195461	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c812967972ba9beb2470686534240cc6	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH UnuseAccountFilter AS (
		SELECT DISTINCT P2.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP2 ON UA.BANK_ACCOUNT_ID = AP2.BANK_ACCOUNT_ID
		JOIN PRODUCT P2 ON AP2.PRODUCT_ID = P2.PRODUCT_ID
		WHERE
		UA.EFFECTSTATUS = '1'
		AND P2.SUB_GROUP_MARK = '0'
		)

		SELECT T.BALANCE_ID,
			   T.PRODUCT_ID,
			   T.PRODUCT_CODE,
			   T.MANAGER_PROD,
			   T.PRODUCT_NAME,
			   T.ACCOUNT_ID,
			   T.ACCOUNT_NAME,
			   T.ACCOUNT_TYPE_ID,
	           T.ACCOUNT_TYPE_NAME,
			   T.BALANCE_DATE,
			   T.AMOUNT,
			   T.CURRENCY,
			   T.CREATED_AT,
			   T.CREATED_BY,
			   T.CREATED_NAME,
			   T.UPDATED_AT,
			   T.UPDATED_BY,
			   T.UPDATED_NAME,
	           T.USABLE_BALANCE,
	           T.CONTROL_BALANCE,
	          T.FREEZE_BALANCE,
		T.ACCOUNT_SUB_SN
		 FROM
			(
			SELECT 
					BH.BALANCE_HISTORY_ID BALANCE_ID,
					BH.PRODUCT_ID,
	               	BH.ACCOUNT_ID,
	               	BH.ACCOUNT_TYPE_ID,
	               	BH.BALANCE_DATE,
	               	BH.AMOUNT,
	               	BH.CREATED_AT,
	               	BH.CREATED_BY,
	               	BH.UPDATED_AT,
	               	BH.UPDATED_BY,
	               	BH.USABLE_BALANCE,
	               	BH.CONTROL_BALANCE,
	               	BH.FREEZE_BALANCE,
		            AP.ACCOUNT_SUB_SN AS ACCOUNT_SUB_SN,
		            P.PRODUCT_CODE AS PRODUCT_CODE,
		            P.MANAGER_PROD AS MANAGER_PROD,
		            P.PRODUCT_NAME AS PRODUCT_NAME,
		            BA2.BANK_ACCOUNT_NAME AS ACCOUNT_NAME,
		            ACT.ACCOUNT_TYPE_NAME AS ACCOUNT_TYPE_NAME,
		            BA2.CURRENCY AS CURRENCY,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.CREATED_BY) AS CREATED_NAME,
		            (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.UPDATED_BY) AS UPDATED_NAME
	          FROM 	
	          		BALANCE_HISTORY BH
		LEFT JOIN ACCOUNT_PRODUCT AP ON AP.BANK_ACCOUNT_ID = BH.ACCOUNT_ID AND AP.PRODUCT_ID = BH.PRODUCT_ID AND AP.EFFECTSTATUS = '1'
		LEF	</td><td style='mso-number-format:'@';'>175552	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>5	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>42afe8e22bb93acfd0cfe902240aa6a3	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH instruction_data AS (
        select
        instruction_id,product_id,payment_date,payment_type_id,direction,amount,payment_reason,source_id,credit_account,credit_account_name,debit_account,debit_account_name,bank_id,bank_name,batch,entrust,ipo_subscribe,wfid,wfsid,iterationid,position,p_instruction_id,payment_status,action_status,payment_mode,payment_at,inter_bank,same_city,message,created_at,created_by,updated_at,updated_by,instruction_type,concentrate_status,validated_by,use_id,plustype,out_instruction_id,security_code,fbank_id,fbank_name,fdqh,fjgh,sdqh,sjgh,db_product_id,realtime_status,parent_instruction_id,credit_acct_type_id,debit_acct_type_id,credit_account_id,debit_account_id,currency,withdraw,voucher,business_type,cash,credit_card,post_route,payment_level,business_subject,summary,custom_type,business_category,channel,account_voucher,account_password,futher_code,futher_password,core_interface,counter_cashflow,qsxwh,wxfxzyxx,interface_code,hsbz,sub_type_id,message_v,zqzh,zqdm,return_msg,autopay,trade_type,instr_gen_source,enteraccount_flag,lock_status,role_id,core_msg,final_paymentstatus,ztczfjg,ldsjms,kh_paymentstatus,core_instruction_type,cfcs,beiyong1,zlscfsj,showcomeaccount,paymentway,faxpushtime,nextdateinstructionid,instruc_batch,instruc_batch_flag,instruc_batch_sum,instruc_batch_detail,user_subsidiary_organ,zyzxretfaxtime,zyzxretmsg,zyzxbz,activity_center_status,activity_center_flag,activity_center_message,ywlsh,zjtzzh,qhgsdm,instr_jbr,instr_fhr,batchinsno,successful_paid_at,pay_lock_status,pay_lock_user,remark,tgt_qdzlbh,auto_remark,is_emergency_payment,timestamp,discard_flag,priority,db_status,white_flge,mzbz,export_flag,proiority_sub,csds_business_type,whether_pass_auxiliary,auxiliary_account,virtual_product_name,deal_org_no,instruction_model,out_org_no,cust_prd_code,cust_cancel_status,cust_prd_name,manager_id,payflg,core_instruction_id,dfkssj,supervision_sign,supervisory_opinion,instruc	</td><td style='mso-number-format:'@';'>95335	</td><td style='mso-number-format:'@';'>22	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>6	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>d1caed4522f82d24613de8dbb4309a6d	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( WITH A AS (
        SELECT
        T.PRODUCT_ID,
        T.FIRST_UNPAID_DATE,
        T.SETTLEMENT_DATE,
        (CASE WHEN T.SETTLEMENT_TYPE IS NOT NULL THEN '0' ELSE '1' END) AS RETURNED_MONEY_STATUS,
        T.SETTLEMENT_TYPE,
        T.RETURNED_AMOUNT,
        TA.UNPAID_TRUSTFEE_AMOUNT,
        TA.IS_LONG_TERM_DUN,
        TA.report_id,
        TRUNC(CAST(? AS TIMESTAMP)) AS START_DATE,
        TRUNC(CAST(? AS TIMESTAMP)) AS END_DATE,
        (CASE WHEN TA.IS_LONG_TERM_DUN = '1' THEN NULL WHEN (SELECT 0 FROM DUAL WHERE EXISTS(SELECT * FROM trustfee_arrears_detail_report WHERE T.PK_ID = REPORT_ID AND IS_LONG_TERM_DUN = '0' ) ) = 0 AND T.TRANSFER_DATE >= TRUNC(CAST(? AS TIMESTAMP)) THEN '本期转入长期催收登记簿' ELSE '以往期间转入长期催收登记簿' END ) AS longterm_Flag
        FROM trustfee_arrears_report T
        LEFT JOIN (
        SELECT * FROM TRUSTFEE_ARREARS_DETAIL_REPORT
        WHERE PK_ID IN (
        SELECT pk_id FROM (
        SELECT
        pk_id,
        report_id,
        BUSINESS_DATE,
        IS_LONG_TERM_DUN,
        UNPAID_TRUSTFEE_AMOUNT,
        ROW_NUMBER() OVER (PARTITION BY report_Id ORDER BY BUSINESS_DATE DESC) AS rn
        FROM trustfee_arrears_detail_report
        ) WHERE rn = 1
        )
        )  TA
        ON T.PK_ID = TA.REPORT_ID
        WHERE T.first_unpaid_date <= TRUNC(CAST(? AS TIMESTAMP))

        UNION ALL

        SELECT
        T.PRODUCT_ID,
        T.FIRST_UNPAID_DATE,
        T.SETTLEMENT_DATE,
        '0' AS RETURNED_MONEY_STATUS,
        T.SETTLEMENT_TYPE,
        T.RETURNED_AMOUNT,
        TA.UNPAID_TRUSTFEE_AMOUNT,
        TA.IS_LONG_TERM_DUN,
        TA.report_id,
        TRUNC(CAST(? AS TIMESTAMP)) AS START_DATE,
        TRUNC(CAST(? AS TIMESTAMP)) AS END_DATE,
        (CASE WHEN TA.IS_LONG_TERM_DUN = '1' THEN NULL WHEN (SELECT 0 FROM DUAL WHERE EXISTS(SELECT * FROM trustfee_arrears_detail_report WHERE T.PK_ID = REPORT_ID AND IS_LONG_TERM_DUN = '0' ) ) = 0 AND T.TRANSFER_DATE >= TRUNC	</td><td style='mso-number-format:'@';'>92556	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>7	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>0c5b7e8ce2f1784af9eadfb9424f1d26	</td><td style='mso-number-format:'@';'>SELECT 
				BA.BALANCE_ID,
                BA.PRODUCT_ID,
                BA.ACCOUNT_ID,
                BA.ACCOUNT_TYPE_ID,
                BA.BALANCE_DATE,
                BA.AMOUNT
          FROM
                BALANCE BA
         WHERE 
            	BA.BALANCE_DATE = ?
            	 AND BA.ACCOUNT_TYPE_ID IN (SELECT A.ACCOUNT_TYPE_ID FROM ACCOUNT_TYPE A WHERE A.SJ_ACCOUNT_TYPE_ID='zhinitcnzh0') 
            	 
           		 AND BA.PRODUCT_ID IN
	           		 (  
	            		?
					 , 
	            		?
					 ) 
				 
		ORDER BY 
				BA.BALANCE_ID
        FOR UPDATE	</td><td style='mso-number-format:'@';'>91414	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>8	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>1f3bbed38e83d66b0062eca357a7138d	</td><td style='mso-number-format:'@';'>SELECT * FROM (SELECT ROWNUM R, T.* FROM (select count(1) from instruction i where i.VIRTUAL_PRODUCT_NAME is not null) T) T WHERE T.R > 0 AND T.R <= 5000	</td><td style='mso-number-format:'@';'>81615	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>9	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>efd1f4604c06f7cb768693c9c6fdc40b	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select
		INFO_ID,product_id, (select a.product_name from product a where DTIC.product_id = a.product_id) as product_name ,
        (SELECT rtrim(xml_clob(xmlagg(xmlparse(content code||',') ORDER BY code)),',') from(select code_id AS code from para_code WHERE para_key = PAYMENT_TYPE_ID)) as PAYMENT_TYPE_ID,
        get_names(PAYMENT_TYPE_ID, 'payment_type') as PAYMENT_TYPE_NAME,
		(SELECT rtrim(xml_clob(xmlagg(xmlparse(content code||',') ORDER BY code)),',') from(select code_id AS code from para_code WHERE para_key = PRODUCT_TYPE_ID)) as PRODUCT_TYPE_ID,
		get_names(PRODUCT_TYPE_ID, 'product_type') as PRODUCT_TYPE_NAME,
		RFFLAG,ACCOUNT_NO,get_ids(INSTRUCT_SOURCE) as INSTRUCT_SOURCE, get_names(INSTRUCT_SOURCE, 'instruct_source') as INSTRUCT_SOURCE_NAME,EFFECTSTATUS,OP_TYPE,FOUREYESSTATUS,AUDIT_COMMENT,CREATED_AT,CREATED_BY,
		UPDATED_AT,UPDATED_BY,VALIDATED_AT,VALIDATED_BY,REMARK, NVL(APPLY_SUB, 1) APPLY_SUB,ORGANIZATION_DAYEND,PRODUCT_STMTONLINE,
		(select a.yhmc from ip_staff a where DTIC.created_by = a.yhbh) as createdByName,
        (select b.yhmc from ip_staff b where DTIC.updated_by = b.yhbh) as updatedByName,
        (select c.yhmc from ip_staff c where DTIC.validated_by = c.yhbh) as validatedByName,
		OPD_BRANCHID,(select JGMC from IP_UNIT_STMT uou where uou.ZJ = OPD_BRANCHID) as opdBranchName,
		OTHERS_SYSTEM_ID,MANAGER_ID,(select external_agency_name from EXTERNAL_AGENCY ea where ea.EXTERNAL_AGENCY_ID = MANAGER_ID) as managerName,
		get_ids(ECINS_GENTYPE) as ECINS_GENTYPE,
        decode(OTHERS_SYSTEM_ID,'1','赢时胜运营','2','服务运营','') as othersSystemName,
        replace(replace(replace(replace(get_ids(ECINS_GENTYPE),'7','托管通'),'3','深证通'),'8','同业门户'),'9','光伏贷') as ecinsGentypeName,product_onfile
		from DIRECT_TRANSFER_INFO DTIC
		where 1=1
		 
		 
		 
		 
		 
         
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		order by CREATED_AT desc, UPDATED_BY desc ) row_ ) where rownum_ > 0 and rownum_ <= 10	</td><td style='mso-number-format:'@';'>55957	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>10	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>8f120c336f8d0810b1ee787dbcb1711a	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2025 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id AND pt.effectstatus = '1') hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CENTER_F	</td><td style='mso-number-format:'@';'>53466	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>11	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c23c5facd23d7886ff445115b614fe8e	</td><td style='mso-number-format:'@';'>DELETE FROM instruction_hist ii WHERE NOT EXISTS (
            SELECT 1
            FROM instruction smi
            WHERE smi.instruction_id = ii.instruction_id
        )	</td><td style='mso-number-format:'@';'>42691	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>12	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c4c283b1ec003d93c47a5ce4ef551524	</td><td style='mso-number-format:'@';'>SELECT * FROM (
		
select pc.code_id pPRODUCT_ID,
       qp.*,
       (SELECT p.PRODUCT_CODE
          FROM product p
         WHERE p.effectstatus = '1'
           AND p.PRODUCT_ID = pc.code_id) AS PRODUCT_CODE,
       decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT
  from qhld_parameter qp, para_code pc
 WHERE qp.effectstatus = '1'
   AND qp.TERMINATE_FLAG != '1'
   and qp.IS_INS_CHECK = '1'
     and qp.PAYMENT_TYPE_ID = ? 
   AND qp.manager_id is not null
   AND qp.product_id is not null
   and qp.product_id = pc.para_key
union

select p.product_id pPRODUCT_ID,
       qp.*,
       p.product_code PRODUCT_CODE,
       decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT
  from qhld_parameter qp, product p, para_code pc
 where qp.effectstatus = '1'
   and qp.terminate_flag != '1'
   and qp.IS_INS_CHECK = '1'
   AND ((QP.BRANCH_ID IS NOT NULL AND QP.BRANCH_ID = P.OPD_BRANCHID) OR QP.BRANCH_ID IS NULL)
   AND ((QP.IND_BRANCH_ID IS NOT NULL AND QP.IND_BRANCH_ID = P.IND_BRANCHID) OR QP.IND_BRANCH_ID IS NULL)
   and pc.para_key = qp.PRODUCT_TYPE_ID
   AND qp.product_id is null
   AND qp.manager_id is not null
   AND qp.product_type_id is not null
   and p.product_type_id = pc.code_id
   and p.manager_id = qp.manager_id
   and p.effectstatus = '1'
     and qp.PAYMENT_TYPE_ID = ? 
   and not exists (select 1
          from qhld_parameter qhld, para_code pcp
         where qhld.product_id is not null
           and qhld.manager_id = qp.manager_id
           and qhld.product_id = pcp.para_key
           and pcp.code_id = p.product_id
           and qhld.terminate_flag != '1'
            and qhld.IS_INS_CHECK = '1'
           and qhld.effectstatus = '1'
             and qhld.payment_type_id = ? 
           )
u	</td><td style='mso-number-format:'@';'>38992	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>13	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7b06c102606dca94dd3711bb1e77be9f	</td><td style='mso-number-format:'@';'>BEGIN
        DBMS_STATS.GATHER_TABLE_STATS(?,?);
        END;	</td><td style='mso-number-format:'@';'>38315	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>14	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>e39578ce4eeef523c0908987f8515be5	</td><td style='mso-number-format:'@';'>SELECT COUNT(1) FROM (SELECT I.*, TRUNC(NVL(I.PAYMENT_AT, I.PAYMENT_DATE)) AS idx1, decode(I.DIRECTION, '0', I.CREDIT_ACCOUNT, '1', I.DEBIT_ACCOUNT) AS idx2 FROM INSTRUCTION I WHERE I.PAYMENT_STATUS != '3' AND ((I.SOURCE_ID = '6' AND I.ACTION_STATUS = '0') OR I.ACTION_STATUS IN ('7', '9', '10', '11', '12', '13', '14', '15', '16')) AND (I.FINAL_PAYMENTSTATUS IS NULL OR I.FINAL_PAYMENTSTATUS != '7')) I WHERE I.idx1 = TO_DATE(?, 'YYYYMMDD') AND I.idx2 = ?	</td><td style='mso-number-format:'@';'>32978	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>15	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>480a01ab40864e46b353eb23aa826ad0	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN NVL((SELECT CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END || '#@@#' || rtgs.shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.instruction_id), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN NVL((SELECT c.ccdc_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.instruction_id), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN NVL((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2024 WHERE instruction_id = z.instruction_id AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.	</td><td style='mso-number-format:'@';'>32200	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>16	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>223129483bbf939373ae289fbed229e3	</td><td style='mso-number-format:'@';'>WITH
		CheckUnuseProduct AS (
		SELECT P.PRODUCT_ID
		FROM UNUSE_ACCT_INF UA
		JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID
		JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID
		WHERE UA.EFFECTSTATUS = '1'
		AND P.SUB_GROUP_MARK = '0'
		)

		SELECT COUNT(1)
		 FROM
			(
			SELECT 1
	          FROM BALANCE_HISTORY BH
	         WHERE BH.BALANCE_DATE between ? and ?
			   AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH')
                 
 		   	   AND EXISTS
                 (  
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 union all 
                  	SELECT 1 FROM DUAL WHERE 1=1
                  	  AND BH.PRODUCT_ID = ? 
                  	  AND BH.ACCOUNT_ID = ? 
                 ) 
               AND NOT EXISTS(
                   	SELECT 1
					  FROM  CheckUnuseProduct c
					 WHERE BH.PRODUCT_ID =c.PRODUCT_ID
                   )
			 UNION ALL
			 SELECT	1
	           FROM BALANCE BA
	           JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON  BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID
                WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd')
			    AND BA.BALANCE_DATE between ? and ?
			    AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2'
   		   		AND EXISTS
                   (  
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   union ALL 
                    	SELECT 1 FROM DUAL WHERE 1=1
                    	  AND BA.PRODUCT_ID = ? 
                    	  AND BA.ACCOUNT_ID = ? 
                   ) 
                AND NOT EXISTS(
                   	SELECT 1
					  FROM CheckUnuseProduct c
					 WHERE  BA.PRODUCT_ID = c.PRODUCT_ID
                   )
		) T	</td><td style='mso-number-format:'@';'>26529	</td><td style='mso-number-format:'@';'>3	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>17	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>faf576a70c51324c5f86c65111896d5f	</td><td style='mso-number-format:'@';'>SELECT I.INSTRUCTION_ID instructionId,
