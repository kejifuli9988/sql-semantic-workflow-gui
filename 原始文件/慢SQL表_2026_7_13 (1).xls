			   T.PRODUCT_ID,
			   (SELECT P.PRODUCT_CODE FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) PRODUCT_CODE,
			   (SELECT P.MANAGER_PROD FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) MANAGER_PROD,
			   (SELECT P.PRODUCT_NAME FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) PRODUCT_NAME,
			   T.ACCOUNT_ID,
			   (SELECT CA.ACCOUNT_NAME FROM CSDS_ACCOUNT CA WHERE CA.CSDS_ACCOUNT_ID = T.ACCOUNT_ID AND CA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) ACCOUNT_NAME,
			   T.ACCOUNT_TYPE_ID,
	           (select ACT.ACCOUNT_TYPE_NAME from ACCOUNT_TYPE ACT where ACT.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) ACCOUNT_TYPE_NAME,
			   T.BALANCE_DATE,
			   T.AMOUNT,
			   (SELECT CA.CURRENCY FROM CSDS_ACCOUNT CA WHERE CA.CSDS_ACCOUNT_ID = T.ACCOUNT_ID AND CA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) CURRENCY,
			   T.CREATED_AT,
