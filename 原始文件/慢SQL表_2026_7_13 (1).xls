		where ba.bank_account_id = isu.credit_account
		and ba.effectstatus = '1') in ('CNQSFZH','RQFIIQSFZH')  then
		(select ap.bank_account_id
		from account_product ap
		where ap.product_id = p.product_id
		and ap.main_account_mark = '0'
