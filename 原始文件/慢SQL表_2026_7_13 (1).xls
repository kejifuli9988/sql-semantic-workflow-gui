		i.ipo_subscribe
		else
		i.payment_reason
		end summary,
		P.PRODUCT_NAME                   productName      ,
		TO_CHAR(I.PAYMENT_DATE,'YYYYMMDD')                   paymentDate                 ,
		TO_CHAR(I.PAYMENT_AT,'YYYYMMDD')                     paymentAt                   ,
		I.PRIORITY            AS          priority                    ,
		I.PAYMENT_TYPE_ID                 paymentTypeId               ,
