		from(
		select
		ti.source              as source,
		(CASE
		WHEN TI.source = '0' THEN
		'SG'
		WHEN TI.source = '4' THEN
		'OCR'
		else ti.SOURCE_CODE END)      as sourceCode,
		ti.pk_id               as pkId,
		ti.manager_prod        as managerProd,
		p.PRODUCT_CODE         as productCode,
		ti.org_no              as orgNo,
		ti.seq_no              as seqNo,
