         where ex.effectstatus = '1'
           and ex.external_agency_id =
               (select pp.manager_id
                  from product pp
                 where pp.effectstatus = '1'
                   and pp.product_id =
       	</td><td style='mso-number-format:'@';'>12982	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>32	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>89af6569512af9fd79efb55cc5dd7b73	</td><td style='mso-number-format:'@';'>select Z.AREA_DISTRICT as Clr_Rgn_Inst_Num,
        (SELECT D.BANK_ID
            FROM UNIT_BANK D
            WHERE Z.AREA_DISTRICT = D.DQDH || D.JGDH) as Cur_Dpt_Acc_Opn_Bnk_No,
            (SELECT D.BANK_NAME
            FROM UNIT_BANK D
            WHERE Z.AREA_DISTRICT = D.DQDH || D.JGDH) as Cur_Dpt_Acc_Opn_Bnk_Nm
              from (
                    SELECT D.ZHDH || D.ZZHXH AS ACCOUNT_ID,
                            D.KHDQDH || D.KHJGDH AS AREA_DISTRICT
                      FROM DGZZHZWJ D
                    UNION ALL
                    SELECT HQ.ZHDH AS ACCOUNT_ID, HQ.DQDH || HQ.JGDH AS AREA_DISTRICT
                      FROM HQDGZWJ HQ) Z
             WHERE Z.ACCOUNT_ID = ?	</td><td style='mso-number-format:'@';'>12252	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>33	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c332be9dc10339f37aef96af539b0d44	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select sqs_id,
	       notice_id,
	       holder_id,
	       holder_name,
	       cost_type,
	       amount_pay,
	       amount_payed,
	       zl_id,
