		from
		(select 
		  PK_ID,FAX_ID,EC_ATTACH_ID,RECEIVE_DATE,DEAL_DATE,PRODUCT_NAME,PRODUCT_ID,
		  MANAGER_ID,MANAGER_NAME,DEAL_ID,RECORD_TYPE,RECORD_STATUS,AUDIT_COMMENT
		from (select
		  z.FAX_INSTRUCTION_ID PK_ID,z.FAX_ID FAX_ID,'' EC_ATTACH_ID,z.PUSH_AT RECEIVE_DATE,z.CREATED_AT DEAL_DATE,
