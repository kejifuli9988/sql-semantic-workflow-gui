			   to_Date(to_char	</td><td style='mso-number-format:'@';'>4208	</td><td style='mso-number-format:'@';'>2	</td><td style='mso-number-format:'@';'>settlement-query	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>107	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>78921d7748928846c95a5c7667f723b5	</td><td style='mso-number-format:'@';'>merge into settlement_cashflow_history sch
		 USING (
		  select cc.cashflow_id,
		         cc.product_id,
		         cc.account_id,
		         cc.account_type_id,
		         cc.cashflow_at,
		         cc.cashflow_time,
		         cc.counter_cashflow,
		         cc.credit_account,
		         cc.credit_account_name,
		         cc.debit_account,
		         cc.debit_account_name,
		         cc.direction,
		         cc.amount,
		         cc.balance_after,
		         cc.currency,
		         cc.transaction_code,
		         cc.summary,
		         cc.use_info as message,
		         cc.djsm,
		         cc.remark,
		         cc.bank_no,
		         cc.bank_name,
		         cc.pzqfrq as created_at,
		         cc.cpzxh,
		         cc.cpznxh,
		         cc.core_cashflow_id,
		         cc.transaction_org_code as trade_org_code,
		         cc.postal_choose as post_route_choose,
		         cc.jydqdh as trade_area_code,
		         sysdate as updated_at,
		         cc.xtsjc
		    from core_cashflow cc
		   where cc.batch_num = ?) b
		      
		       on (sch.account_id = b.account_id and sch.cashflow_at = b.cashflow_at and sch.cpzxh = b.cpzxh 
		        	and sch.cpznxh = b.cpznxh and sch.direction = b.direction and sch.amount = b.amount and sch.counter_cashflow = b.counter_cashflow
		        	and (sch.credit_account = b.credit_account or (sch.credit_account is null and b.credit_account is null))
		        	and (sch.debit_account = b.debit_account or (sch.debit_account is null and b.debit_account is null)))
		      
		      
		  when matched then
		  	update set
					sch.product_id = b.product_id,
					sch.updated_at = b.updated_at
			  where sch.product_id is null
		  when not matched then
		     insert
		       (CASHFLOW_ID,
		        PRODUCT_ID,
		        ACCOUNT_ID,
		        ACCOUNT_TYPE_ID,
		        CASHFLOW_AT,
		        CASHFLOW_TIME,
		        COUNTER_CASHFLOW,
		        CREDIT_ACCOUNT,
		        CREDIT_ACCOUNT_NAME,
		        DEBIT_ACCOUNT,
		        DEBIT_ACCOUNT_NAME,
		   	</td><td style='mso-number-format:'@';'>4206	</td><td style='mso-number-format:'@';'>630	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>108	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>477dad64624cbb1eb675ee99f8d6c9ea	</td><td style='mso-number-format:'@';'>select
