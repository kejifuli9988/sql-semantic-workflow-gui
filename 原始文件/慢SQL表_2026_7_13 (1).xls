		select p.product_code cpdm,
		i.instruction_id instructionId,
		i.credit_account fkfzh,
		i.instruction_id hkdbh,
		i.amount hkje,
		i.payment_type_id hklx,
		to_char(i.payment_at,'yyyyMMdd') hkrq,
		to_char(i.created_at,'yyyyMMddHH24miss') cjsj,
		i.direction sfkfx,
		i.debit_account skfzhh,
		i.currency bz,
		i.credit_account_id fkfzhid,
		i.credit_account_name fkfzhqc,
		i.bank_name fkfzhkhh,
		i.debit_account_id skfzhid,
		i.debit_account_name skfzhqc,
		i.fbank_name skfzhkhh,
		case
		when i.payment_type_id in ('TZXG01', 'TZXG02') then
		i.ipo_subscribe
		else
		i.payment_reason
		end summary
		from instruction i
		inner join product p
		on i.product_id = p.product_id
		where i.payment_type_id != 'QSCNDB'
		and not exists (select 1 from etf_paymenttype_map epm
		where i.payment_type_id = epm.main_paymenttype_id
		and epm.map_type = '1')
		and i.payment_status in( '3','8')
