                              or (TT.IS_PAYMENT_DATE_UNKNOWN = '1' AND TT.PAYMENT_FREQUENCY = '4' AND EXISTS(SELECT 1 FROM trustfee_arrears_detail_report T1 WHERE T1.REPORT_ID = TT.PK_ID AND T1.AGING = '0' ) )
                              )	</td><td style='mso-number-format:'@';'>2121	</td><td style='mso-number-format:'@';'>8	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>216	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>87975e7e444d1dbd79f5bfe4f026dbee	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT
        '应付托管费金额维护' AS todoItem,
        '产品[' || p.product_name || ']为核算系统无法准确计提托管费的产品，未按支付频率维护应付托管费金额' AS reminderText,
        (
        SELECT cdbh
        FROM ip_resmenu
        WHERE cdmc = '新托管费未支付监控'
        ) AS nodeId,
        '新托管费未支付监控' AS nodeText,
        '/trustfeeArrearsReport/list.do' AS nodeURL
        FROM
        TRUSTFEE_ARREARS_REPORT tar
        LEFT JOIN
        product p ON tar.product_id = p.product_id
        LEFT JOIN (
        SELECT *
        FROM TRUSTFEE_ARREARS_DETAIL_REPORT
        WHERE PK_ID IN (
        SELECT pk_id
        FROM (
        SELECT
        pk_id,
        report_id,
        unpaid_trustfee_amount,
        BUSINESS_DATE,
        ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn
        FROM trustfee_arrears_detail_report
        ) t
        WHERE rn = 1
        )
        ) ta ON tar.PK_ID = ta.REPORT_ID
        WHERE 1=1
          AND tar.IS_FIXED_AMOUNT <> '0'
          AND (tar.IS_PAYMENT_DATE_UNKNOWN <> 0 OR tar.IS_PAYMENT_DATE_UNKNOWN IS NULL)
          AND (ta.unpaid_trustfee_amount IS NULL OR ta.unpaid_trustfee_amount = 0)
            AND P.OPD_BRANCHID IN (
            SELECT UOB.BRANCHID
            FROM USER_OPERATING_BRANCH UOB
            WHERE UOB.USERID = ?
            )
            AND tar.product_id IN (
            SELECT pp.product_id
            FROM product_info_branch pib
            , product pp
            WHERE pib.product_id = pp.product_id
            AND pib.roleid IN (
            SELECT irs.jsbh
            FROM ip_role_stmt irs
            WHERE irs.jsmc IN ('核算经办', '分行核算经办')
            )
        and pib.userid in  (  
        ?  ) 
            ) ) row_ ) where rownum_ > 0 and rownum_ <= 100	</td><td style='mso-number-format:'@';'>2121	</td><td style='mso-number-format:'@';'>10	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>217	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>c193e8acf71b930041100bc01feaf823	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2025 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTI	</td><td style='mso-number-format:'@';'>2114	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>218	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>34727f8929a14dffc68abd1d5270228f	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( SELECT T.MARKET,
		(SELECT PP.PRODUCT_NAME
		FROM PRODUCT PP
		WHERE T.PRODUCT_ID = PP.PRODUCT_ID
		AND PP.EFFECTSTATUS = '1') AS PRODUCTNAME,
		T.ZQZH,
		T.SJJS,
		T.JSRQ,
		T.SIUATIONEXPLAIN,
		OPDCONFIRMSTATUS,
		TO_CHAR(T.SIUATION_DATE, 'yyyy-MM-dd HH24:mi:ss') AS SIUATIONDATE,
		(SELECT D.YHMC
		FROM IP_STAFF_STMT D
		WHERE T.SIUATION_BY = D.YHBH) AS SIUATIONBY,
		T.PKID
		FROM (SELECT '上海' AS MARKET,
		SA.PRODUCT_ID,
		JS.ZQZH AS ZQZH,
		TO_CHAR(JS.SJSF) AS SJJS,
		JS.JSRQ AS JSRQ,
		JS.PK_ID AS PKID,
		NVL(CM.OPD_CONFIRM_STATUS, 'WQR') AS OPDCONFIRMSTATUS,
		CM.SIUATION_EXPLAIN AS SIUATIONEXPLAIN,
		CM.SIUATION_DATE,
		CM.SIUATION_BY,
		CM.OPD_BRANCH AS SIUATIONBRANCH
		FROM JSMX JS
		LEFT JOIN SECURITY_ACCOUNT SA ON (JS.ZQZH = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1')
		LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JS.PK_ID = CM.RELATION_ID
		WHERE JS.JYFS != '106'
		AND JS.JSFS = '002'
		and js.filename not like 'jsmx03%'
		AND JS.JSRQ >= TO_CHAR(cast(? as timestamp), 'yyyyMMdd')
		AND JS.JSRQ < TO_CHAR(cast(? as timestamp) + 1, 'yyyyMMdd')
		 
		 
		UNION ALL
		SELECT '深圳' AS MARKET,
		SA.PRODUCT_ID,
		JSZ.MXZQZH AS ZQZH,
		TO_CHAR(JSZ.MXSFJE) AS SJJS,
		JSZ.MXJSRQ AS JSRQ,
		JSZ.PK_ID AS PKID,
		NVL(CM.OPD_CONFIRM_STATUS, 'WQR') AS OPDCONFIRMSTATUS,
		CM.SIUATION_EXPLAIN AS SIUATIONEXPLAIN,
		CM.SIUATION_DATE,
		CM.SIUATION_BY,
		CM.OPD_BRANCH AS SIUATIONBRANCH
		FROM SJSMX JSZ
		LEFT JOIN SECURITY_ACCOUNT SA ON (TRIM(JSZ.MXZQZH) = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1')
		LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JSZ.PK_ID = CM.RELATION_ID
		WHERE JSZ.MXJSFS = 'N'
		AND JSZ.MXJSRQ >= TO_CHAR(cast(? as timestamp), 'yyyyMMdd')
		AND JSZ.MXJSRQ < TO_CHAR(cast(? as timestamp )+ 1, 'yyyyMMdd')
		and jsz.filename not like 'SJSMX2%'
		 
		  ) T
		ORDER BY decode(T.OPDCONFIRMSTATUS, 'WQR', 0, 5) ) row_ ) where rownum_ > 0 and rownum_ <= 20	</td><td style='mso-number-format:'@';'>2107	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>219	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7e8eb361586674b0965527b9cc897d2f	</td><td style='mso-number-format:'@';'>insert into  TRUSTFEE_ARREARS_DETAIL_REPORT_HISTORY
        select * from TRUSTFEE_ARREARS_DETAIL_REPORT WHERE PRODUCT_ID IN (
           select TT.PRODUCT_ID from TRUSTFEE_ARREARS_REPORT TT
                WHERE  TT.SETTLEMENT_STATUS = '1'
                or (TT.IS_PAYMENT_DATE_UNKNOWN = '1' AND TT.PAYMENT_FREQUENCY = '4' AND EXISTS(SELECT 1 FROM trustfee_arrears_detail_report T1 WHERE T1.REPORT_ID = TT.PK_ID AND T1.AGING = '0' ) )
         )	</td><td style='mso-number-format:'@';'>2101	</td><td style='mso-number-format:'@';'>9	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>220	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>2f71cb02cea20bef8932a307a9112e3d	</td><td style='mso-number-format:'@';'>DELETE FROM IP_SCHEDULETASK_MONITOR I WHERE I.RWKSSJ BETWEEN to_timestamp('2026-01-14','yyyy-mm-dd') and to_timestamp('2026-04-11','yyyy-mm-dd') and rownum <=2000	</td><td style='mso-number-format:'@';'>2090	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-cronjob	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>221	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>44d81f2b1ca4c5e20194621057d901c7	</td><td style='mso-number-format:'@';'>WITH a as (
        select
        h.*
        from (
        select
        nvl(to_char(sq.REVIEW_TIME,'yyyyMMdd'),ch.PL_DATE) as PL_DATE,
        nvl(sq.bond_code,ch.SECURITY_CODE) as SECURITY_CODE,
        nvl(to_char(sq.EXERCISE_APPLY_BEGIN_DAY,'yyyyMMdd') ,ch.RESALE_REG_BEG_AT) as RESALE_REG_BEG_AT,
        nvl(to_char(sq.EXERCISE_APPLY_CLOSING_DT,'yyyyMMdd') ,ch.RESALE_REG_END_AT) as RESALE_REG_END_AT,
        nvl(to_char(sq.EXERCISE_EXEC_DAY,'yyyyMMdd'),ch.EXERCISE_AT) as EXERCISE_AT,
        nvl(ch.EVENT_TYPE,'1') as EVENT_TYPE,
        ch.SECODE,
        ch.NUM_CODE,
        ch.CHANGE_SE_CODE,
        ch.OBJ_COMP_CODE,
        ch.DATA_DATE,
        (case when sq.bond_code is null then '0' else '1'  end ) as bond_source,
        sq.bond_name
        from (
        select * from chzqhs ch
        where ch.event_type IN( '1', '13')
        and CH.EXERCISE_AT =  ?
        )ch
        full join
        (
        select * from sqzqhs sq
        where  sq.EXERCISE_EXEC_DAY = to_date(?,'yyyyMMdd')
        )sq
        on ch.security_code = sq.bond_code
        )h
         

        ),
        d as (
            select
            sum(nvl(t.amount, 0))/10000 as ydjme,
            t.product_id,
            e.param_value zqdm
            from trade_base t
            left join trade_ext e on t.trade_id = e.trade_id
            inner join a on e.param_value = a.security_code
            where
            (((t.tran_type = 'SQHS' and t.INSTRUCTION_STATUS in ('1','2','3') AND t.jyzt IS NOT NULL)
            or (t.tran_type = 'SQHS' and t.realtime_status = '清算执行复核已完成' and t.jyzt IS NULL) )
            or (t.tran_type = 'ZZHS' and t.INSTRUCTION_STATUS = 'CGSU'))
            and t.trade_date BETWEEN to_date(a.resale_reg_beg_at, 'yyyyMMdd') AND to_date(a.resale_reg_end_at, 'yyyyMMdd') +1-1/86400
             
                and t.product_id in
                 (  
                    ?
                 ) 
             
            group by t.product_id, e.param_value
        	</td><td style='mso-number-format:'@';'>2089	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-tran	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>222	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7f5d68ded0c8f35e4f2af1545b6a69d3	</td><td style='mso-number-format:'@';'>select count(*)
        FROM
            TRUSTFEE_ARREARS_REPORT tar
                LEFT JOIN
            product p ON tar.product_id = p.product_id
                LEFT JOIN (
                SELECT *
                FROM TRUSTFEE_ARREARS_DETAIL_REPORT
                WHERE PK_ID IN (
                    SELECT pk_id
                    FROM (
                             SELECT
                                 pk_id,
                                 report_id,
                                 unpaid_trustfee_amount,
                                 BUSINESS_DATE,
                                 ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn
                             FROM trustfee_arrears_detail_report
                         ) t
                    WHERE rn = 1
                )
            ) ta ON tar.PK_ID = ta.REPORT_ID
        WHERE 1=1
          AND tar.IS_FIXED_AMOUNT <> '0'
          AND (tar.IS_PAYMENT_DATE_UNKNOWN <> 0 OR tar.IS_PAYMENT_DATE_UNKNOWN IS NULL)
          AND (ta.unpaid_trustfee_amount IS NULL OR ta.unpaid_trustfee_amount = 0)
            AND P.OPD_BRANCHID IN (
            SELECT UOB.BRANCHID
            FROM USER_OPERATING_BRANCH UOB
            WHERE UOB.USERID = ?
            )
            AND tar.product_id IN (
            SELECT pp.product_id
            FROM product_info_branch pib
            , product pp
            WHERE pib.product_id = pp.product_id
            AND pib.roleid IN (
            SELECT irs.jsbh
            FROM ip_role_stmt irs
            WHERE irs.jsmc IN ('核算经办', '分行核算经办')
            )
        and pib.userid in  (  
        ?  ) 
            )	</td><td style='mso-number-format:'@';'>2081	</td><td style='mso-number-format:'@';'>10	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>223	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7c391de0ecd50c48a1fbaea290158e97	</td><td style='mso-number-format:'@';'>select
		count(1)
		from (
		select * from (select t.*, rownum rownum_ from (
		select
		p.product_id
		from PRODUCT p
		WHERE 1=1
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
		 
			AND (
			
			(
			(p.ind_branchid IS NOT NULL OR p.opd_branchid IS NOT NULL)
			and (p.PRODUCT_ID IN
			(
			SELECT   p1.PRODUCT_ID FROM product p1 WHERE p1.IND_BRANCHID IN (
			SELECT uib.branchid FROM user_info_branch uib WHERE uib.userid=?      and uib.EFFECTSTATUS = '1'
			)
			UNION ALL
			SELECT   p2.PRODUCT_ID FROM product p2 WHERE p2.OPD_BRANCHID IN (
			SELECT uob.branchid FROM USER_OPERATING_BRANCH uob WHERE uob.userid=? and uob.EFFECTSTATUS = '1'
			)
			)
			or exists (select 1 from bank_account ba
			inner join ip_staff_stmt iss on iss.ssjg = ba.ind_branchid
			left join account_product ap on ap.bank_account_id = ba.bank_account_id and ap.effectstatus = '1'
			where ap.main_account_mark = '0' and ba.effectstatus != '2' and iss.yhbh = ? and ap.product_id = p.product_id
			)
			)
			)
			OR
			
			(p.ind_branchid IS NULL AND p.opd_branchid IS NULL)
			)
		 
		 
		 
		
		 
		
		 
			and ? in (select ba.ind_branchid from account_product ap
			left join bank_account ba on ba.bank_account_id = ap.bank_account_id and ba.effectstatus != '2'
			where ap.product_id = p.product_id and ap.main_account_mark = '0' and ap.effectstatus != '2')
		 
		
		)t  )
	 ) a	</td><td style='mso-number-format:'@';'>2080	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>224	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>5fafb52fe590efa95e7e73c63cf4193d	</td><td style='mso-number-format:'@';'>WITH QX_SQL AS
		(SELECT WM_CONCAT(PRO_IND_BRANCHID) AS BRANCHID
