			 ) 
			  or x.PAYMENT_TYPE_ID is null   )
		 
		and  x.action_status not in ('2', '3')
		and (x.final_paymentstatus not in ('3','7') or    x.final_paymentstatus is  null)
		
		union all
		select  x.instruction_id
		from instruction x
		left join CRITICAL_MONITOR_SIGN cm
		on x.instruction_id = cm.RELATION_ID
		inner join bank_account ba on ba.bank_ac	</td><td style='mso-number-format:'@';'>18825	</td><td style='mso-number-format:'@';'>8	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>26	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>b1038228fb86a89c0e1758bcb51a2a18	</td><td style='mso-number-format:'@';'>SELECT ramt.payment_date, ramt.olramt, pamt.olpamt FROM (SELECT ins.payment_date, nvl(sum(amount), 0) olramt FROM instruction ins WHERE ins.trade_type = '0' AND ins.payment_type_id != 'QSCNDB' AND ins.action_status <> '3' AND ('CNQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.DEBIT_ACCOUNT) OR 'RQFIIQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.DEBIT_ACCOUNT)) AND ins.payment_date = to_date(?, 'yyyy/MM/dd') GROUP BY ins.payment_date) ramt FULL JOIN (SELECT ins.payment_date, nvl(sum(amount), 0) olpamt FROM instruction ins WHERE ins.trade_type = '0' AND ins.payment_type_id != 'QSCNDB' AND ins.action_status <> '3' AND ('CNQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.CREDIT_ACCOUNT) OR 'RQFIIQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.CREDIT_ACCOUNT)) AND ins.payment_date = to_date(?, 'yyyy/MM/dd') GROUP BY ins.payment_date) pamt ON ramt.payment_date = pamt.payment_date	</td><td style='mso-number-format:'@';'>18065	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>27	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>67565f931d90ebbe700e50c48f59d54c	</td><td style='mso-number-format:'@';'>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2026 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id AND pt.effectstatus = '1') hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.instruc_batch_flag, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CENTER_F	</td><td style='mso-number-format:'@';'>15205	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>settlement-web	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>28	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>f17692f01a3361149dd91bcd3a451be9	</td><td style='mso-number-format:'@';'>WITH QX_SQL AS
		(SELECT WM_CONCAT(PRO_IND_BRANCHID) AS BRANCHID
		FROM CNZL_AUTHPAR
		WHERE INSTR(USER_BRANCHID, 'G00017713') > 0
		AND EFFECTSTATUS = '1'
		AND FOUREYESSTATUS = '1'),
		CHECK_NUM AS
		(SELECT COUNT(1) C
		FROM CNZL_AUTHPAR
		WHERE INSTR(PRO_IND_BRANCHID, '') > 0
		AND EFFECTSTATUS = '1'
		AND FOUREYESSTATUS = '1')
		SELECT Z.UNIT_ID,
		? USER_ID,
		Z.MON_MAT_TYPE,
		? REMINDER_TYPE,
		Z.DATA_AT,
		Z.INS_ID,
		NVL(Z.PRODUCT_ID, Z.UNIT_ID) AS PRODUCT_ID,
		NVL(Z.STEP_ID, '-1') AS STEP_ID,
		(SELECT IR.CDBH FROM IP_RESMENU IR
		WHERE IR.CDURL = (CASE
		WHEN Z.STEP_ID = '0' THEN '/instruction/list.do'
		WHEN Z.STEP_ID = '1' THEN '/instructionCheck/list.do'
		WHEN Z.STEP_ID = '2' THEN '/instructionAudit/list.do'
		WHEN Z.STEP_ID = '3' THEN '/stmtAudit/list.do'
		WHEN Z.STEP_ID = '4' THEN '/stmtExecuteManage/list.do'
		WHEN Z.STEP_ID = '5' THEN '/stmtExecuteCheck/list.do'
		WHEN Z.STEP_ID = '6' THEN '/stmtPayment/list.do'
		WHEN Z.STEP_ID = '7' THEN '/csbsInstruction/list.do'
		WHEN Z.STEP_ID = '8' THEN '/unRelInstruction/list.do'
		WHEN Z.STEP_ID = '9' THEN '/unRelInsHandle/list.do'
		WHEN Z.STEP_ID = '10' THEN '/unRelInsCheck/list.do'
		WHEN Z.STEP_ID = '11' THEN '/csdsInstruction/list.do'
		WHEN Z.STEP_ID = '12' THEN '/yjInstructionHandleCtrler/list.do'
		ELSE '未知' END)) AS CDBH,
		NVL((SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE Z.PAYMENT_TYPE_ID = PT.PAYMENT_TYPE_ID),
		NVL((SELECT IC.MBTMZ
		FROM IP_CODEINFO IC
		WHERE IC.SJLX IN ('CSBSCSBSCSBSCSBSCSBSCSBS00010001', 'TYLTYLTYLTYLTYLTYLTYLTYL00000348')
		AND IC.MBLXBH = Z.PAYMENT_TYPE_ID),
		'划款类型为空')) AS PAYMENT_TYPE_NAME,
		(CASE WHEN Z.STEP_ID = '0' THEN '信息经办'
		WHEN Z.STEP_ID = '1' THEN '信息审核'
		WHEN Z.STEP_ID = '2' THEN '指令审核'
		WHEN Z.STEP_ID = '3' THEN '清算审核'
		WHEN Z.STEP_ID = '4' THEN '清算执行经办'
		WHEN Z.STEP_ID = '5' THEN '清算执行复核'
		WHEN Z.STEP_ID = '6' THEN '清算支付'
		WHEN Z.STEP_ID = '7' THEN '交易指令确认'
		WHEN Z.STEP_ID = '8' THEN '未上线信息经办'
		WHEN Z.STEP_ID = '9' THEN '未上线核算经办'
		W	</td><td style='mso-number-format:'@';'>14279	</td><td style='mso-number-format:'@';'>3179	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>29	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>7077c1111e98422db2a847babfb47147	</td><td style='mso-number-format:'@';'>SELECT T.ACCOUNT_ID AS "accountId",
	  		 T.PRODUCT_ID AS "productId",
	  		 T.CASHFLOW_AT AS "cashflowAt"
	   FROM (
		SELECT CCA.ACCOUNT_ID,
		       CCA.PRODUCT_ID,
			   CCA.CASHFLOW_AT
		  FROM CORE_CASHFLOW_ACCOUNT CCA
		 WHERE CCA.CASHFLOW_AT BETWEEN ? AND ?
		   AND CCA.BALANCE_FLAG = '3'
		   AND EXISTS
		    (  
            	SELECT 1 FROM DUAL WHERE 1=1
                 AND CCA.PRODUCT_ID = ? 
                 AND CCA.ACCOUNT_ID = ? 
            ) ) T
      ORDER BY T.CASHFLOW_AT, T.PRODUCT_ID, T.ACCOUNT_ID	</td><td style='mso-number-format:'@';'>13888	</td><td style='mso-number-format:'@';'>1	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>30	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>ce9fad2f16bc47bab1a787c0dfb3c6e2	</td><td style='mso-number-format:'@';'>select
		count(distinct t.instruction_id)
		from (
		 
			select z.instruction_id
			from instruction z
			left join  product p
			on z.product_id = p.product_id
			left join CRITICAL_MONITOR_SIGN cm
			on z.instruction_id = cm.RELATION_ID
			where z.TRADE_TYPE ='0'
			 
			 and  cm.OPD_CONFIRM_STATUS IS NULL 
			 
			 
				and ( (z.product_id is not null and p.OPD_BRANCHID in
				 (  
					?
				 ) 
				) or (z.product_id is  null
				and exists (select 1 from bankaccandunuseacc ba where   ba.bank_account_id = decode(z.direction,'0',z.credit_account,'1',z.debit_account,'3',z.credit_account)
				and ba.ind_branchid in
				 (  
					?
				 ) 
				)))
			 
			 	and z.PAYMENT_AT >= trunc(cast(? as timestamp)) and z.PAYMENT_AT < trunc(cast(?  as timestamp)+ 1) 
			and  z.action_status not in ('2', '3')
			and (z.final_paymentstatus not in ('3','7') or    z.final_paymentstatus is  null)
			union all
		 
		select x.instruction_id
		from instruction x
		left join product p
		on x.product_id = p.product_id
		left join CRITICAL_MONITOR_SIGN cm
		on x.instruction_id = cm.RELATION_ID
		where 1 = 1
		 
		 and  cm.OPD_CONFIRM_STATUS IS NULL 
		and x.product_id is not null
		and x.instruc_batch_flag in ('0', '-1')
		and (x.TRADE_TYPE = '1' or x.TRADE_TYPE is null)
		and  p.OPD_BRANCHID in
		 (  
			?
		 ) 
		 	and x.PAYMENT_AT >= trunc(cast(? as timestamp)) and x.PAYMENT_AT < trunc(cast(?  as timestamp)+ 1) 
		 
			and (x.PAYMENT_TYPE_ID    not   in
			 ( 
				  
				?
			 
				 
					  , 
				 
				?
			 
				 
					  , 
				 
				?
			 
				 
					  , 
				 
				?
			 
				 
					  , 
				 
				?
			 
				 
					  , 
				 
				?
			 ) 
			  or x.PAYMENT_TYPE_ID is null   )
		 
		and  x.action_status not in ('2', '3')
		and (x.final_paymentstatus not in ('3','7') or    x.final_paymentstatus is  null)
		
		union all
		select  x.instruction_id
		from instruction x
		left join CRITICAL_MONITOR_SIGN cm
		on x.instruction_id = cm.RELATION_ID
		inner join bank_account ba on ba.bank_ac	</td><td style='mso-number-format:'@';'>13136	</td><td style='mso-number-format:'@';'>4	</td><td style='mso-number-format:'@';'>tgqs	</td><td style='mso-number-format:'@';'>	</td></tr><tr><td style='mso-number-format:'@';'>31	</td><td style='mso-number-format:'@';'>全链路监控	</td><td style='mso-number-format:'@';'>29dad40b8eb36dfd648937e91ede8555	</td><td style='mso-number-format:'@';'>select * from ( select row_.*, rownum as rownum_ from ( select js.PK_ID,
