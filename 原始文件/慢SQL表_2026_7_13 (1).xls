                  ,TO_CHAR(TA.OPD_BRANCH_LAST_DUNLTR_DATE,'yyyy-MM-dd') AS OPD_BRANCH_LAST_DUNLTR_DATE
                  ,TA.OPD_BRANCH_MANAGER_FEEDBACK_TYPE
