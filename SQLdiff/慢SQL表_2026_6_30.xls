    <td class="xl66" x:str>select D.PK_ID, D.MXSXH, D.MXFFJS, D.MXFFTG, D.MXFTGM, D.MXFFJY, D.MXFJYM, D.MXFFZH, D.MXFZQM, D.MXZQDM, D.MXYWLB, D.MXZHZQ, D.MXSFJS, D.MXSFTG, D.MXSTGM, D.MXSFJY, D.MXSJYM, D.MXSFZH, D.MXSZQM, D.MXDDBH, D.MXZXBH, D.MXQTBH, D.MXSFJE, D.MXQTJE, D.MXFFFY, D.MXSFFY, D.MXJYRQ, D.MXQSRQ, D.MXFSRQ, D.MXYWLS, D.MXJSZT, D.MXBYZD1, D.MXBYZD2, D.MXBYZD3, D.FILENAME, D.CREATED_AT, D.CREATED_BY, D.DATADATE from DSFMX D where (D.MXFFJS IN ('999723','999743') OR D.MXSFJS IN ('999723','999743') ) AND D.MXYWLS = ?</td>
