    <td class="xl66" x:str>SELECT sch.cashflow_id, sch.core_cashflow_id, sch.product_id, sch.account_id, sch.account_type_id, sch.cashflow_at, sch.cashflow_time, sch.counter_cashflow, sch.credit_account, sch.credit_account_name, sch.debit_account, sch.debit_account_name, sch.direction, sch.amount, sch.balance_before, sch.balance_after, sch.currency, sch.transaction_code, sch.summary, sch.message, sch.remark, nvl(sch.updated_at, sch.created_at) updated_at, sch.use_info, sch.bank_no, sch.bank_name, sch.trade_org_code, sch.post_route_choose, sch.cpzxh, sch.cpznxh, sch.trade_area_code FROM SETTLEMENT_CASHFLOW_HISTORY SCH WHERE SCH.SUMMARY = '591' AND SCH.CASHFLOW_AT &gt;= TRUNC(SYSDATE) - ? AND NOT EXISTS (SELECT 1 FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = SCH.ACCOUNT_ID AND BA.DEDICATED = '0') AND NOT EXISTS (SELECT 1 FROM CORE_CASHFLOW_RETURN R WHERE SCH.ACCOUNT_ID = R.ACCOUNT_ID AND SCH.CASHFLOW_AT = R.CASHFLOW_AT AND SCH.CASHFLOW_TIME = R.CASHFLOW_TIME AND SCH.CPZXH = R.CPZXH AND SCH.CPZNXH = R.CPZNXH AND SCH.DIRECTION = R.DIRECTION AND SCH.AMOUNT = R.AMOUNT AND SCH.COUNTER_CASHFLOW = R.COUNTER_CASHFLOW AND (SCH.CREDIT_ACCOUNT = R.CREDIT_ACCOUNT OR (SCH.CREDIT_ACCOUNT IS NULL AND R.CREDIT_ACCOUNT IS NULL)) AND (SCH.DEBIT_ACCOUNT = R.DEBIT_ACCOUNT OR (SCH.DEBIT_ACCOUNT IS NULL AND R.DEBIT_ACCOUNT IS NULL)))</td>
