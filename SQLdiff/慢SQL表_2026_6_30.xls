   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>737</td>
    <td class="xl66" x:str>全链路监控</td>
    <td class="xl66" x:str>20ff8c20608c2d1603642817f5cb8c04</td>
    <td class="xl66" x:str>WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN nvl((SELECT (CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END) || '#@@#' || by3 shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN nvl((SELECT c.ccdc_draw_status shch_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.INSTRUCTION_ID), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN nvl((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2026 WHERE instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg</td>
    <td class="xl66" x:str>2007</td>
    <td class="xl66" x:str>1</td>
    <td class="xl66" x:str>tgqs</td>
