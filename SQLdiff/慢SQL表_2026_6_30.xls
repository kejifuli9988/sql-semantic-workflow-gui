    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select PK_ID,SUPERVISION_WARNING_ID,BRANCH_ID,PRODUCT_TYPE_ID,WARNING_WHETHER,WARNING_LINKS,EFFECTSTATUS,OP_TYPE,FOUREYESSTATUS,AUDIT_COMMENT,CREATED_AT,CREATED_BY,UPDATED_AT,UPDATED_BY,VALIDATED_AT,VALIDATED_BY,CREATED_CI, (select a.yhmc from ip_staff a where z.CREATED_BY = a.yhbh) as createdByName, (select b.yhmc from ip_staff b where z.UPDATED_BY = b.yhbh) as updatedByName, (select c.yhmc from ip_staff c where z.VALIDATED_BY = c.yhbh) as validatedByName, (select d.jgmc from ip_unit_stmt d where z.BRANCH_ID = d.zj) as branchName, (select xml_clob(xmlagg(xmlparse(content f.product_type_name||','))) from product_type f where pkg_pub.get_containt_items(z.product_type_id, f.product_type_id) is not null) as productTypeName, SUPERVISION_TYPE, SOURCE_ID, PAYMENT_TYPE_ID, (SELECT xml_clob(xmlagg(xmlparse(content pt.payment_type_name||','))) FROM para_code pc, payment_type pt WHERE pc.para_key = z.payment_type_id AND pt.payment_type_id = pc.code_id) as paymentTypeName, TRAN_TYPE_ID, (SELECT xml_clob(xmlagg(xmlparse(content ic.mbtmz ||','))) FROM para_code pc, IP_CODEINFO ic WHERE pc.para_key = z.tran_type_id AND ic.MBLXBH = pc.code_id and ic.SJLX = 'TYLTYLTYLTYLTYLTYLTYLTYL00000348') as tranTypeName from INSTRUC_SUPERVISION_WARN_CI z where 1=1 and z.CREATED_CI = (SELECT max(zz.CREATED_CI) FROM INSTRUC_SUPERVISION_WARN_CI zz where zz.SUPERVISION_WARNING_ID = z.SUPERVISION_WARNING_ID) order by CREATED_AT desc ) row_ ) where rownum_ &gt; 0 and rownum_ &lt;= 10</td>
