    <td class="xl66" x:str>SELECT * FROM (SELECT ROWNUM R, T.* FROM (SELECT T.TABLE_NAME FROM USER_TABLES T WHERE T.TEMPORARY = 'N' AND NOT EXISTS ( SELECT 1 FROM USER_CONSTRAINTS C WHERE C.TABLE_NAME = T.TABLE_NAME AND C.CONSTRAINT_TYPE = 'P' ) ORDER BY T.TABLE_NAME) T) T WHERE T.R &gt; 0 AND T.R &lt;= 5000</td>
