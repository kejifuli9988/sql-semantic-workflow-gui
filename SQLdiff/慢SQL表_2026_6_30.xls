    <td class="xl66" x:str>merge into (select * from settlement_cashflow_history where account_type_id = 'zqzh0000002') sch using( select ? coreCashflowId, ? productId, ? accountId, ? accountTypeId, ? cashflowAt, ? cashflowTime, ? instructionId, ? subId, ? counterCashflow, ? creditAccount, ? creditAccountName, ? debitAccount, ? debitAccountName, ? direction, ? amount, ? balanceBefore, ? balanceAfter, ? currency, ? transactionCode, ? summary, ? message, ? remark, ? createdAt, ? createdBy, ? updatedAt, ? updatedBy, ? userInfo, ? bankNo, ? bankName, ? bankAccountId from dual union all select ? coreCashflowId, ? productId, ? accountId, ? accountTypeId, ? cashflowAt, ? cashflowTime, ? instructionId, ? subId, ? counterCashflow, ? creditAccount, ? creditAccountName, ? debitAccount, ? debitAccountName, ? direction, ? amount, ? balanceBefore, ? balanceAfter, ? currency, ? transactionCode, ? summary, ? message, ? remark, ? createdAt, ? createdBy, ? updatedAt, ? updatedBy, ? userInfo, ? bankNo, ? bankName, ? bankAccountId from dual union all select ? coreCashflowId, ? productId, ? accountId, ? accountTypeId, ? cas</td>
