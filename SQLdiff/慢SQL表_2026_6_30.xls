    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( with baseinfo as ( select z.INSTRUCTION_ID, z.PRODUCT_ID, z.timestamp, z.PAYMENT_DATE, z.PAYMENT_TYPE_ID, z.DIRECTION, z.AMOUNT, z.PAYMENT_REASON, z.SOURCE_ID, z.CREDIT_ACCOUNT, z.CREDIT_ACCOUNT_NAME, z.DEBIT_ACCOUNT, z.DEBIT_ACCOUNT_NAME, z.BANK_ID, z.BANK_NAME, z.BATCH, z.ENTRUST, z.IPO_SUBSCRIBE, z.WFID, z.WFSID, z.ITERATIONID, z.POSITION, z.P_INSTRUCTION_ID, z.PAYMENT_STATUS, z.ACTION_STATUS, z.PAYMENT_MODE, z.PAYMENT_AT, z.INTER_BANK, z.SAME_CITY, z.MESSAGE, z.CREATED_AT, z.CREATED_BY, z.UPDATED_AT, z.UPDATED_BY, z.INSTRUCTION_TYPE, z.CONCENTRATE_STATUS, z.VALIDATED_BY, z.USE_ID, z.PLUSTYPE, z.OUT_INSTRUCTION_ID, z.SECURITY_CODE, z.FBANK_ID, z.FBANK_NAME, z.FDQH, z.FJGH, z.SDQH, z.SJGH, z.DB_PRODUCT_ID, z.REALTIME_STATUS, z.PARENT_INSTRUCTION_ID, z.CREDIT_ACCT_TYPE_ID, z.DEBIT_ACCT_TYPE_ID, z.CREDIT_ACCOUNT_ID, z.DEBIT_ACCOUNT_ID, z.CURRENCY, z.WITHDRAW, z.VOUCHER, z.BUSINESS_TYPE ywlx, z.CASH xzbz, z.CREDIT_CARD fkxykbz, z.POST_ROUTE ylxz, z.PAYMENT_LEVEL zfjb, z.BUSINESS_SUBJECT, z.SUMMARY zysm, (select zymc from ZYDHB where effectstatus = '1' and zydh = z.SUMMARY ) zysmname, z.CUSTOM_TYPE khlb, z.BUSINESS_CATEGORY ywlb, z.CHANNEL jyqd, z.ACCOUNT_VOUCHER zjzh, z.ACCOUNT_PASSWORD zjmm, z.FUTHER_CODE jhgsdm, z.FUTHER_PASSWORD, z.CORE_INTERFACE, z.COUNTER_CASHFLOW, z.QSXWH, z.WXFXZYXX, z.INTERFACE_CODE, z.HSBZ, z.SUB_TYPE_ID, z.message_v fy, z.zqzh, z.zqdm, z.return_msg, z.autopay, z.trade_type, z.instr_gen_source, z.lock_status, z.role_id, nvl(z.faxpushtime, z.CREATED_AT) faxpushtime, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.zyzxBz, z.ACTIVITY_CENTER_STATUS, z.ACTIVITY_CENTER_FLAG, z.ACTIVITY_CENTER_MESSAGE, z.TGT_QDZLBH, z.p</td>
