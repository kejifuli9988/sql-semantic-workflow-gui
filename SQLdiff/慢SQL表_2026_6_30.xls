    <td class="xl66" x:str>34727f8929a14dffc68abd1d5270228f</td>
    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( SELECT T.MARKET, (SELECT PP.PRODUCT_NAME FROM PRODUCT PP WHERE T.PRODUCT_ID = PP.PRODUCT_ID AND PP.EFFECTSTATUS = '1') AS PRODUCTNAME, T.ZQZH, T.SJJS, T.JSRQ, T.SIUATIONEXPLAIN, OPDCONFIRMSTATUS, TO_CHAR(T.SIUATION_DATE, 'yyyy-MM-dd HH24:mi:ss') AS SIUATIONDATE, (SELECT D.YHMC FROM IP_STAFF_STMT D WHERE T.SIUATION_BY = D.YHBH) AS SIUATIONBY, T.PKID FROM (SELECT '上海' AS MARKET, SA.PRODUCT_ID, JS.ZQZH AS ZQZH, TO_CHAR(JS.SJSF) AS SJJS, JS.JSRQ AS JSRQ, JS.PK_ID AS PKID, NVL(CM.OPD_CONFIRM_STATUS, 'WQR') AS OPDCONFIRMSTATUS, CM.SIUATION_EXPLAIN AS SIUATIONEXPLAIN, CM.SIUATION_DATE, CM.SIUATION_BY, CM.OPD_BRANCH AS SIUATIONBRANCH FROM JSMX JS LEFT JOIN SECURITY_ACCOUNT SA ON (JS.ZQZH = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1') LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JS.PK_ID = CM.RELATION_ID WHERE JS.JYFS != '106' AND JS.JSFS = '002' and js.filename not like 'jsmx03%' AND JS.JSRQ &gt;= TO_CHAR(cast(? as timestamp), 'yyyyMMdd') AND JS.JSRQ &lt; TO_CHAR(cast(? as timestamp) + 1, 'yyyyMMdd') UNION ALL SELECT '深圳' AS MARKET, SA.PRODUCT_ID, JSZ.MXZQZH AS ZQZH, TO_CHAR(JSZ.MXSFJE) AS SJJS, JSZ.MXJSRQ AS JSRQ, JSZ.PK_ID AS PKID, NVL(CM.OPD_CONFIRM_STATUS, 'WQR') AS OPDCONFIRMSTATUS, CM.SIUATION_EXPLAIN AS SIUATIONEXPLAIN, CM.SIUATION_DATE, CM.SIUATION_BY, CM.OPD_BRANCH AS SIUATIONBRANCH FROM SJSMX JSZ LEFT JOIN SECURITY_ACCOUNT SA ON (TRIM(JSZ.MXZQZH) = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1') LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JSZ.PK_ID = CM.RELATION_ID WHERE JSZ.MXJSFS = 'N' AND JSZ.MXJSRQ &gt;= TO_CHAR(cast(? as timestamp), 'yyyyMMdd') AND JSZ.MXJSRQ &lt; TO_CHAR(cast(? as timestamp )+ 1, 'yyyyMMdd') and jsz.filename not like 'SJSMX2%' ) T ORDER BY decode(T.OPDCONFIRMSTATUS, 'WQR', 0, 5) ) row_ ) where rownum_ &gt; 0 and rownum_ &lt;= 20</td>
