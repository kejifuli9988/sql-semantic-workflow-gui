    <td class="xl66" x:str>select count (*) from ( select pk_id,qhld_id, payment_type_id, debit_account, debit_account_name, bank_id, bank_name, riskfee_debit_account, riskfee_debit_account_name, riskfee_bank_id, riskfee_bank_name, payment_rate, date_property, payment_day,payment_time,finance_time,finance_date_property, inter_bank, branch_id, (select aa.jgmc from ip_unit_stmt aa where aa.zj = z.branch_id and aa.effectstatus = '1') as branch_name, (select aa.jgmc from ip_unit_stmt aa where aa.zj = z.ind_branch_id and aa.effectstatus = '1') as ind_branch_name, (case payment_type_id when 'FYZF03' then to_char(get_values(z.manager_id)) else manager_id end) manager_id, (case payment_type_id when 'FYZF03' then get_names(z.manager_id,'manager') else (select d.external_agency_name from external_agency d where d.effectstatus = '1' and z.manager_id = d.external_agency_id) end) as managername, effectstatus, op_type, foureyesstatus, audit_comment, created_at, created_by, updated_at, updated_by, validated_at, validated_by, whether_fax, riskfee_ratio, get_values(z.product_type_id,1) as product_type_id, get_names(z.product_type_id, 'product_type',1) as product_type_name, get_values(z.product_id,1) as product_id, get_names(z.product_id, 'product',1) as product_name, get_values(z.seat_id,1) as seat_id, get_names(z.seat_id, 'seat',1) as seat_code, get_values(z.broker_id,1) as broker_id, get_names(z.broker_id, 'broker',1) as broker_name, (select a.yhmc from ip_staff a where z.created_by = a.yhbh) as createdbyname, (select b.yhmc from ip_staff b where z.updated_by = b.yhbh) as updatedbyname, (select c.yhmc from ip_staff c where z.validated_by = c.yhbh) as validatedbyname, riskfee_inter_bank,created_ci,remark, is_push, TERMINATE_FLAG, TERMINATE_STATUS from qhld_parameter_ci z, ( SEL</td>
