    <td class="xl66" x:str>WITH E_INSTRUCTION_EXT AS ( SELECT EX.GENERATE, EX.manager_id, EX.product_code, EX.INSTRUCTION_NUM, EX.INSTRUCTION_MODEL, EX.manager_id || EX.instruction_num || EX.GENERATE AS BUSINESS_ID1, NULL AS BUSINESS_ID2 FROM INSTRUCTION I JOIN INSTRUCTION_DISTINCT D ON D.instruction_id = I.instruction_id JOIN PRODUCT P ON I.PRODUCT_ID = P.PRODUCT_ID JOIN EC_INSTRUCTION EX ON D.source_id='2' AND (I.MANAGER_ID = EX.MANAGER_ID or EX.GENERATE = '10') AND D.BUSINESS_ID = EX.manager_id || EX.instruction_num || EX.GENERATE AND (EX.INSTRUCTION_MODEL= '0' or EX.GENERATE = '10') WHERE ((I.UPDATED_AT is null and I.CREATED_AT &gt;= to_date(?, 'yyyy/MM/dd')) or (I.UPDATED_AT &gt;= to_date(?, 'yyyy/MM/dd'))) AND I.ACTION_STATUS IS NOT NULL AND NOT EXISTS (SELECT 1 FROM instruction_infoem ii WHERE ii.INSTRUCTION_ID = I.INSTRUCTION_ID and ii.INSTRUCTION_STATUS = i.ACTION_STATUS and (ii.REALTIME_STATUS = i.final_paymentstatus or i.final_paymentstatus is null) and (ii.PAYMENT_STATUS = i.PAYMENT_STATUS or i.PAYMENT_STATUS is null) and (ii.PUSH_ZLPT = '0' OR ii.PUSH_ZLPT IS NULL or (ii.PUSH_ZLPT = '1' and ii.ZLPT_FAIL_NUM &gt; ?)) and (ii.PUSH_TYMH = '0' OR ii.PUSH_TYMH IS NULL or (ii.PUSH_TYMH = '1' and ii.TYMH_FAIL_NUM &gt; ?)) and (ii.PUSH_TGT = '0' OR ii.PUSH_TGT IS NULL or (ii.PUSH_TGT = '1' and ii.TGT_FAIL_NUM &gt; ?)) and (ii.PUSH_KSH = '0' OR ii.PUSH_KSH IS NULL or (ii.PUSH_KSH = '1' and ii.KSH_FAIL_NUM &gt; ?)) ) UNION ALL SELECT EX.GENERATE, EX.manager_id, EX.product_code, EX.INSTRUCTION_NUM, EX.INSTRUCTION_MODEL, NULL AS BUSINESS_ID1, EX.product_code || EX.instruction_num || EX.GENERATE AS BUSINESS_ID2 FROM INSTRUCTION I JOIN INSTRUCTION_DISTINCT D ON D.instruction_id = I.instruction_id JOIN PRODUCT P ON I.PRODUCT_ID = P.PRODUCT_ID JOIN EC_INSTRUCTION EX ON D.source_id='2' AND p.product_code = EX.product_code AND D.BUSINESS_ID = EX.product_code || EX.instruction_num || EX.GENERATE AND</td>
