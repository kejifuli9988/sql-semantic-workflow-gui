    <td class="xl66" x:str>select qp2.* from ( select qp.*, (SELECT p.PRODUCT_CODE FROM product p WHERE p.effectstatus = '1' AND p.PRODUCT_ID = ?) AS PRODUCT_CODE, decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT, get_ids(qp.product_id) as ids from qhld_parameter qp WHERE qp.effectstatus = '1' AND qp.TERMINATE_FLAG != '1' AND exists (select pc2.code_id from (select pc.code_id,pc.para_key,pkg_pub.get_containt_items(?,pc.code_id) as con from para_code pc) pc2 where pc2.para_key = qp.PRODUCT_ID and pc2.con is not null) and qp.PAYMENT_TYPE_ID = ? ) qp2 where qp2.ids is not null</td>
