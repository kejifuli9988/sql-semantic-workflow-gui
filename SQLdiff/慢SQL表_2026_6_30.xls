    <td class="xl66" x:str>da990bccd3a5555924f9ebf4f719c481</td>
    <td class="xl66" x:str>SELECT wm_concat(isf.yhmc) AS HSLXR, wm_concat(isf.yhbh) AS YHBH, (SELECT PRODUCT_ID FROM PRODUCT P WHERE P.PRODUCT_ID = HSYHS.PRODUCT_ID AND ROWNUM = 1) PRODUCT_ID FROM IP_STAFF_STMT ISF,IP_UNIT_STMT IUS, (SELECT PIB.USERID,PIB.PRODUCT_ID FROM PRODUCT_INFO_BRANCH PIB,ip_role_staff rs WHERE pib.userid = rs.yhbh AND pib.roleid = rs.jsbh AND rs.jlzt = '1' AND PIB.ROLEID in (SELECT JSBH FROM IP_ROLE WHERE JSMC in ('核算经办','分行核算经办')) AND PIB.PRODUCT_ID in (SELECT PRODUCT_ID FROM PRODUCT P WHERE P.product_id in ( ? ) and P.EFFECTSTATUS = '1' ) AND ((EXISTS (SELECT 1 FROM sysparam WHERE param_name = 'AUTH_TRANSFER_PRODUCT_SWITCH_V4.13.0' AND param_value = '0') AND NOT exists (SELECT 1 FROM auth_transfer_product WHERE role_id = PIB.roleid AND auth_transfer_status = '2' AND product_id = PIB.product_id AND PIB.userid=provider_id ) ) OR (EXISTS (SELECT 1 FROM sysparam WHERE param_name = 'AUTH_TRANSFER_PRODUCT_SWITCH_V4.13.0' AND param_value = '1') AND NOT exists (SELECT 1 FROM auth_transfer_product atp left join AUTH_TRANSFER_PRODUCT_RECORD atpr on atpr.auth_transfer_product_id = atp.auth_transfer_product_id WHERE atp.role_id = PIB.roleid AND atp.auth_transfer_status = '2' AND PIB.userid=atp.provider_id AND atpr.product_id = PIB.product_id ) ) )) HSYHS WHERE ISF.YHBH = HSYHS.USERID AND ISF.SSJG=IUS.ZJ AND ISF.effectstatus='1' group by HSYHS.PRODUCT_ID</td>
    <td class="xl66" x:str>2034</td>
