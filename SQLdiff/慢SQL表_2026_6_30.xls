    <td class="xl66" x:str>94abd7f07607336173dbbd8715b30826</td>
    <td class="xl66" x:str>WITH SC AS (SELECT CASHFLOW_ID, CREDIT_ACCOUNT, AMOUNT, DEBIT_ACCOUNT, CASHFLOW_AT, ROW_NUMBER() OVER (PARTITION BY CASHFLOW_AT, CREDIT_ACCOUNT, AMOUNT, DEBIT_ACCOUNT ORDER BY CASHFLOW_ID) ROW_NUM FROM SETTLEMENT_CASHFLOW_HISTORY SCH LEFT JOIN PRODUCT P ON SCH.PRODUCT_ID = P.PRODUCT_ID WHERE INSTRUCTION_ID IS NULL AND SUMMARY NOT IN ('855', '850') AND COUNTER_CASHFLOW NOT LIKE '9699%' AND DIRECTION = '0' AND ((SCH.PRODUCT_ID IS NOT NULL AND P.PRODUCT_TYPE_ID NOT IN ('DK', 'ZJMJ', 'BXDLJDR', 'ABSZJGJ', 'JGJY', 'JGQT') AND P.OPD_BRANCHID IN (?)) OR SCH.PRODUCT_ID IS NULL) AND CASHFLOW_AT BETWEEN trunc(cast(? AS timestamp)) AND trunc(cast(? AS timestamp))), CC AS (SELECT INSTRUCTION_ID, CREDIT_ACCOUNT, AMOUNT, DEBIT_ACCOUNT, PAYMENT_AT, ROW_NUMBER() OVER (PARTITION BY PAYMENT_AT, CREDIT_ACCOUNT, AMOUNT, DEBIT_ACCOUNT ORDER BY INSTRUCTION_ID) ROW_NUM FROM INSTRUCTION_2026 I LEFT JOIN PRODUCT P ON I.PRODUCT_ID = P.PRODUCT_ID WHERE I.PAYMENT_MODE = '2' AND I.DIRECTION = '0' AND I.FINAL_PAYMENTSTATUS = '3' AND ((I.PRODUCT_ID IS NOT NULL AND P.PRODUCT_TYPE_ID NOT IN ('DK', 'ZJMJ', 'BXDLJDR', 'ABSZJGJ', 'JGJY', 'JGQT') AND P.OPD_BRANCHID IN (?)) OR I.PRODUCT_ID IS NULL) AND I.PAYMENT_AT BETWEEN trunc(cast(? AS timestamp)) AND trunc(cast(? AS timestamp))) SELECT SC.CASHFLOW_ID FROM SC WHERE EXISTS (SELECT 1 FROM CC WHERE CC.CREDIT_ACCOUNT = SC.CREDIT_ACCOUNT AND CC.AMOUNT = SC.AMOUNT AND CC.DEBIT_ACCOUNT = SC.DEBIT_ACCOUNT AND CASHFLOW_AT = PAYMENT_AT AND CC.ROW_NUM = SC.ROW_NUM)</td>
