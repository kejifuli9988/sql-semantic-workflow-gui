    <td class="xl66" x:str>select count(1) from account_product aps where EXISTS (select 1 from account_product ap, product t where ap.product_id = t.product_id and ap.effectstatus = '1' and t.effectstatus = '1' AND ap.bank_account_id = aps.bank_account_id and t.product_name LIKE '%'||?||'%' ) and exists ( select 1 from product_info_branch a where a.userid = ? and a.roleid = ? and a.product_id = aps.product_id)</td>
