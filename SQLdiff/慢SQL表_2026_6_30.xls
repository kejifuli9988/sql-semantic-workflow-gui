    <td class="xl66" x:str>select Z.AREA_DISTRICT as Clr_Rgn_Inst_Num, (SELECT D.BANK_ID FROM UNIT_BANK D WHERE Z.AREA_DISTRICT = D.DQDH || D.JGDH) as Cur_Dpt_Acc_Opn_Bnk_No, (SELECT D.BANK_NAME FROM UNIT_BANK D WHERE Z.AREA_DISTRICT = D.DQDH || D.JGDH) as Cur_Dpt_Acc_Opn_Bnk_Nm from ( SELECT D.ZHDH || D.ZZHXH AS ACCOUNT_ID, D.KHDQDH || D.KHJGDH AS AREA_DISTRICT FROM DGZZHZWJ D UNION ALL SELECT HQ.ZHDH AS ACCOUNT_ID, HQ.DQDH || HQ.JGDH AS AREA_DISTRICT FROM HQDGZWJ HQ) Z WHERE Z.ACCOUNT_ID = ?</td>
