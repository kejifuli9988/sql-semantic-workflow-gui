    <td class="xl66" x:str>73a3e510b84b0cd6b8b9c57cd2307f43</td>
    <td class="xl66" x:str>WITH apba AS (SELECT ap.product_id, ba.bank_account_id bank_account_id, ba.currency bz FROM account_product ap, bank_account ba WHERE ap.bank_account_id = ba.bank_account_id AND ba.effectstatus = '1' AND ap.effectstatus = '1' UNION SELECT aup.Product_Id, ba.bank_account_id bank_account_id, ba.currency bz FROM bank_account ba, auxiliary_product aup WHERE Ba.Effectstatus = '1' AND Aup.Effectstatus = '1' AND Aup.Bank_Account_Id = Ba.Bank_Account_Id), baseinfo AS (SELECT z.INSTRUCTION_ID, z.PRODUCT_ID, z.timestamp, z.PAYMENT_DATE, z.PAYMENT_TYPE_ID, z.DIRECTION, z.AMOUNT, z.PAYMENT_REASON, z.SOURCE_ID, z.CREDIT_ACCOUNT, z.CREDIT_ACCOUNT_NAME, z.DEBIT_ACCOUNT, z.DEBIT_ACCOUNT_NAME, z.BANK_ID, z.BANK_NAME, z.BATCH, z.ENTRUST, z.IPO_SUBSCRIBE, z.WFID, z.WFSID, z.FINAL_PAYMENTSTATUS, z.ZTCZFJG, z.LDSJMS, z.KH_PAYMENTSTATUS, z.ANO_SYS_STAT, z.CORE_MSG, z.ITERATIONID, z.POSITION, z.P_INSTRUCTION_ID, z.PAYMENT_STATUS, z.ACTION_STATUS, z.PAYMENT_MODE, z.PAYMENT_AT, z.INTER_BANK, z.SAME_CITY, z.MESSAGE, z.CREATED_AT, z.CREATED_BY, z.UPDATED_AT, z.UPDATED_BY, z.INSTRUCTION_TYPE, z.CONCENTRATE_STATUS, z.VALIDATED_BY, z.USE_ID, z.PLUSTYPE, z.OUT_INSTRUCTION_ID, z.SECURITY_CODE, z.FBANK_ID, z.FBANK_NAME, z.FDQH, z.FJGH, z.SDQH, z.SJGH, z.DB_PRODUCT_ID, z.REALTIME_STATUS, z.PARENT_INSTRUCTION_ID, z.CREDIT_ACCT_TYPE_ID, z.DEBIT_ACCT_TYPE_ID, z.CREDIT_ACCOUNT_ID, z.DEBIT_ACCOUNT_ID, z.CURRENCY, z.WITHDRAW, z.VOUCHER, z.BUSINESS_TYPE ywlx, z.CASH xzbz, z.CREDIT_CARD fkxykbz, z.POST_ROUTE ylxz, z.PAYMENT_LEVEL zfjb, z.BUSINESS_SUBJECT, z.SUMMARY zysm, (SELECT zymc FROM ZYDHB WHERE effectstatus = '1' AND zydh = z.SUMMARY) zysmname, z.CUSTOM_TYPE khlb, z.BUSINESS_CATEGORY ywlb, z.CHANNEL jyqd, z.ACCOUNT_VOUCHER zjzh, z.ACCOUNT_PASSWORD zjmm, z.FUTHER_CODE jhgsdm, z.FUTHER_PASSWORD, z.CORE_INTERFACE, z.QSXWH, z.WXFXZYXX, z.INTERFACE_CODE, z.HSBZ, z.SUB_TYPE_ID, z.message_v fy, z.zqzh, z.zqdm, z.return_msg, z.autopay, z.trade_type, z.instr_gen_source, z.lock_status, z.role_id, nvl(z.faxpusht</td>
