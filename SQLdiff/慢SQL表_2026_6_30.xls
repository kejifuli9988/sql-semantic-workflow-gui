    <td class="xl66" x:str>select count(*) FROM TRUSTFEE_ARREARS_REPORT tar LEFT JOIN ( SELECT * FROM TRUSTFEE_ARREARS_DETAIL_REPORT WHERE PK_ID IN ( SELECT pk_id FROM ( SELECT pk_id, report_id, aging, BUSINESS_DATE, ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn FROM trustfee_arrears_detail_report ) t WHERE rn = 1 ) ) ta ON tar.PK_ID = ta.REPORT_ID LEFT JOIN product p ON tar.product_id = p.product_id WHERE tar.is_payment_date_unknown = '0' AND (ta.aging IS NULL OR ta.unpaid_trustfee_amount IS NULL ) AND P.OPD_BRANCHID IN ( SELECT UOB.BRANCHID FROM USER_OPERATING_BRANCH UOB WHERE UOB.USERID = ? ) AND tar.product_id IN ( SELECT pp.product_id FROM product_info_branch pib , product pp WHERE pib.product_id = pp.product_id AND pib.roleid IN ( SELECT irs.jsbh FROM ip_role_stmt irs WHERE irs.jsmc IN ('核算经办', '分行核算经办') ) and pib.userid in ( ? ) )</td>
