    <td class="xl66" x:str>select count(1) from ( select * from (select t.*, rownum rownum_ from ( select p.product_id from PRODUCT p WHERE 1=1 AND ( ( (p.ind_branchid IS NOT NULL OR p.opd_branchid IS NOT NULL) and (p.PRODUCT_ID IN ( SELECT p1.PRODUCT_ID FROM product p1 WHERE p1.IND_BRANCHID IN ( SELECT uib.branchid FROM user_info_branch uib WHERE uib.userid=? and uib.EFFECTSTATUS = '1' ) UNION ALL SELECT p2.PRODUCT_ID FROM product p2 WHERE p2.OPD_BRANCHID IN ( SELECT uob.branchid FROM USER_OPERATING_BRANCH uob WHERE uob.userid=? and uob.EFFECTSTATUS = '1' ) ) or exists (select 1 from bank_account ba inner join ip_staff_stmt iss on iss.ssjg = ba.ind_branchid left join account_product ap on ap.bank_account_id = ba.bank_account_id and ap.effectstatus = '1' where ap.main_account_mark = '0' and ba.effectstatus != '2' and iss.yhbh = ? and ap.product_id = p.product_id ) ) ) OR (p.ind_branchid IS NULL AND p.opd_branchid IS NULL) ) )t ) ) a</td>
