    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select PK_ID,FAX_ID,EC_ATTACH_ID,RECEIVE_DATE,DEAL_DATE,PRODUCT_NAME,PRODUCT_ID, MANAGER_ID,MANAGER_NAME,DEAL_ID,RECORD_TYPE,RECORD_STATUS,AUDIT_COMMENT from (select z.FAX_INSTRUCTION_ID PK_ID,z.FAX_ID FAX_ID,'' EC_ATTACH_ID,z.PUSH_AT RECEIVE_DATE,z.CREATED_AT DEAL_DATE, (SELECT p.product_name FROM product p WHERE p.PRODUCT_CODE=z.PRODUCT_CODE) as PRODUCT_NAME,z.PRODUCT_CODE PRODUCT_ID, z.MANAGER_ID MANAGER_ID, (SELECT ex.external_agency_name FROM external_agency ex, product pr WHERE ex.external_agency_id=pr.manager_id and pr.PRODUCT_CODE=z.PRODUCT_CODE) as MANAGER_NAME, (SELECT c.DEAL_ID FROM csbs_Instruction c WHERE c.note_id=z.fax_instruction_id) as DEAL_ID, '1' RECORD_TYPE,z.RESULT_STATUS RECORD_STATUS,z.AUDIT_COMMENT from FAX_INSTRUCTION z where 1=1 and (PRODUCT_CODE in ( ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ?</td>
