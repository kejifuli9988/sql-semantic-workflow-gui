    <td class="xl66" x:str>ce9fad2f16bc47bab1a787c0dfb3c6e2</td>
    <td class="xl66" x:str>select count(distinct t.instruction_id) from ( select z.instruction_id from instruction z left join product p on z.product_id = p.product_id left join CRITICAL_MONITOR_SIGN cm on z.instruction_id = cm.RELATION_ID where z.TRADE_TYPE ='0' and cm.OPD_CONFIRM_STATUS IS NULL and ( (z.product_id is not null and p.OPD_BRANCHID in ( ? ) ) or (z.product_id is null and exists (select 1 from bankaccandunuseacc ba where ba.bank_account_id = decode(z.direction,'0',z.credit_account,'1',z.debit_account,'3',z.credit_account) and ba.ind_branchid in ( ? ) ))) and z.PAYMENT_AT &gt;= trunc(cast(? as timestamp)) and z.PAYMENT_AT &lt; trunc(cast(? as timestamp)+ 1) and z.action_status not in ('2', '3') and (z.final_paymentstatus not in ('3','7') or z.final_paymentstatus is null) union all select x.instruction_id from instruction x left join product p on x.product_id = p.product_id left join CRITICAL_MONITOR_SIGN cm on x.instruction_id = cm.RELATION_ID where 1 = 1 and cm.OPD_CONFIRM_STATUS IS NULL and x.product_id is not null and x.instruc_batch_flag in ('0', '-1') and (x.TRADE_TYPE = '1' or x.TRADE_TYPE is null) and p.OPD_BRANCHID in ( ? ) and x.PAYMENT_AT &gt;= trunc(cast(? as timestamp)) and x.PAYMENT_AT &lt; trunc(cast(? as timestamp)+ 1) and (x.PAYMENT_TYPE_ID not in ( ? , ? , ? , ? , ? , ? ) or x.PAYMENT_TYPE_ID is null ) and x.action_status not in ('2', '3') and (x.final_paymentstatus not in ('3','7') or x.final_paymentstatus is null) union all select x.instruction_id from instruction x left join CRITICAL_MONITOR_SIGN cm on x.instruction_id = cm.RELATION_ID inner join bank_account ba on ba.bank_ac</td>
    <td class="xl66" x:str>2638</td>
    <td class="xl66" x:str>1</td>
    <td class="xl66" x:str>tgqs</td>
