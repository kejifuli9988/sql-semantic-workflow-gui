    <td class="xl66" x:str>INSERT INTO BALANCE (BALANCE_ID, PRODUCT_ID, ACCOUNT_ID, ACCOUNT_TYPE_ID, BALANCE_DATE, AMOUNT, CREATED_AT, CREATED_BY, UPDATED_AT, UPDATED_BY, REMARK) SELECT 'BALA99' || TO_CHAR(SYSDATE, 'yyMMdd') || LPAD(BALANCE_SEQ.NEXTVAL, 8, '0'), PRODUCT_ID, CSDS_ACCOUNT_ID, ACCOUNT_TYPE_ID, BALANCE_DATE, AMOUNT, CREATED_AT, CREATED_BY, UPDATED_AT, UPDATED_BY, REMARK FROM (SELECT CAP.PRODUCT_ID, CAP.CSDS_ACCOUNT_ID, CAP.ACCOUNT_TYPE_ID, cast(? as timestamp)+1 BALANCE_DATE, (B.AMOUNT + (SELECT NVL(SUM(decode(SC.DIRECTION, '0', -SC.AMOUNT, '1', SC.AMOUNT)), 0) FROM SETTLEMENT_CASHFLOW SC WHERE SC.PRODUCT_ID = CAP.PRODUCT_ID AND SC.ACCOUNT_ID = CAP.CSDS_ACCOUNT_ID AND SC.ACCOUNT_TYPE_ID = CAP.ACCOUNT_TYPE_ID AND SC.CASHFLOW_AT = cast(? as timestamp)+1)) AMOUNT, SYSDATE CREATED_AT, NULL CREATED_BY, SYSDATE UPDATED_AT, NULL UPDATED_BY, NULL REMARK FROM CSDS_ACCOUNT_PRODUCT CAP,BALANCE B WHERE B.PRODUCT_ID = CAP.PRODUCT_ID AND B.ACCOUNT_ID = CAP.CSDS_ACCOUNT_ID AND B.ACCOUNT_TYPE_ID = CAP.ACCOUNT_TYPE_ID AND B.BALANCE_DATE = ? AND CAP.ACCOUNT_TYPE_ID = ? AND CAP.EFFECTSTATUS = '1' UNION ALL SELECT CAP.PRODUCT_ID, CAP.CSDS_ACCOUNT_ID, CAP.ACCOUNT_TYPE_ID, cast(? as timestamp)+1 BALANCE_DATE, (0 + (SELECT NVL(SUM(decode(SC.DIRECTION, '0', -SC.AMOUNT, '1', SC.</td>
