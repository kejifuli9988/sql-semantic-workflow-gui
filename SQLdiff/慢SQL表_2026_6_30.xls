    <td class="xl66" x:str>7e6853df982c171b6c8a1b0b0f76b0b8</td>
    <td class="xl66" x:str>select count(accountId) from ( SELECT * FROM ( SELECT gg.bank_account_id AS accountId, gg.bank_account_name AS accountName, gg.IND_BRANCHID AS indBranchId, i.JGMC AS indBranchName, COALESCE(gg.BANK_ID, d.BANK_ID) AS bankId, COALESCE(gg.BANK_NAME, d.BANK_NAME) AS bankName, gg.ACCOUNT_TYPE_ID AS accountTypeId, at.ACCOUNT_TYPE_NAME AS accountTypeName, gg.AREA_DISTRICT AS areaDistrict, gg.currency AS currency, aa.mbtmz AS currencyName, gg.DEDICATED AS dedicated, CASE WHEN gg.DEDICATED = '0' THEN '共用' ELSE '独用' END AS dedicatedName, gg.EFFECTSTATUS AS effectstatus, ac.mbtmz AS effectstatusName, gg.ACCOUNT_ATTRIBUTE AS accountAttribute, gg.FOUREYESSTATUS AS foureyesstatus FROM bankAccAndUnuseAcc gg JOIN ACCOUNT_TYPE at ON at.ACCOUNT_TYPE_ID = gg.ACCOUNT_TYPE_ID LEFT JOIN IP_UNIT_STMT i ON i.ZJ = gg.IND_BRANCHID AND i.EFFECTSTATUS = '1' LEFT JOIN UNIT_BANK d ON gg.AREA_DISTRICT = d.DQDH || d.JGDH LEFT JOIN ip_codeinfo aa ON aa.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000003' AND aa.mblxbh = gg.currency LEFT JOIN ip_codeinfo ac ON ac.sjlx = 'TYLTYLTYLTYLTYLTYLTYLTYL00000008' AND ac.mblxbh = gg.EFFECTSTATUS WHERE at.effectstatus = '1' and (gg.ACCOUNT_TYPE_ID != 'CKZH' or gg.ACCOUNT_TYPE_ID is null) and ((gg.IND_BRANCHID in (select uib.branchid FROM user_info_branch uib WHERE uib.userid=? and uib.EFFECTSTATUS = '1')) OR EXISTS (SELECT 1 FROM IP_STAFF_STMT IP, SAD_CC S WHERE S.BRANCHID = IP.SSJG AND IP.YHBH = ? AND S.RANGE IN (SUBSTR(gg.bank_account_id,0,2), SUBSTR(gg.bank_account_id,0,5)))) ) t where 1=1 )</td>
    <td class="xl66" x:str>11456</td>
    <td class="xl66" x:str>1</td>
