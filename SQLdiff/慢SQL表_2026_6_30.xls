    <td class="xl66" x:str>3cdc4447678971215b49a2485c1f45dc</td>
    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( SELECT '催收函发送' AS todoItem, ('产品[' || p.product_name || ']应付未付托管费账龄达到20个自然日但运营机构未发函') AS reminderText, (SELECT cdbh FROM ip_resmenu WHERE cdmc = '新托管费未支付监控') AS nodeId, '新托管费未支付监控' AS nodeText, '/trustfeeArrearsReport/list.do' AS nodeURL FROM TRUSTFEE_ARREARS_REPORT tar LEFT JOIN ( SELECT * FROM TRUSTFEE_ARREARS_DETAIL_REPORT WHERE PK_ID IN ( SELECT pk_id FROM ( SELECT pk_id, report_id, aging, IS_OPD_BRANCH_SEND_DUNLTR, BUSINESS_DATE, ROW_NUMBER() OVER (PARTITION BY report_id ORDER BY BUSINESS_DATE DESC) AS rn FROM trustfee_arrears_detail_report ) t WHERE rn = 1 ) ) ta ON tar.PK_ID = ta.REPORT_ID LEFT JOIN product p ON tar.product_id = p.product_id WHERE manager_id != '005622' AND ta.aging &gt; 20 and (ta.IS_OPD_BRANCH_SEND_DUNLTR = '1' or ta.IS_OPD_BRANCH_SEND_DUNLTR is null) AND P.OPD_BRANCHID IN ( SELECT UOB.BRANCHID FROM USER_OPERATING_BRANCH UOB WHERE UOB.USERID = ? ) AND tar.product_id IN ( SELECT pp.product_id FROM product_info_branch pib , product pp WHERE pib.product_id = pp.product_id AND pib.roleid IN ( SELECT irs.jsbh FROM ip_role_stmt irs WHERE irs.jsmc IN ('核算经办', '分行核算经办') ) and pib.userid in</td>
