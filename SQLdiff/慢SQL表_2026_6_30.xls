   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>733</td>
    <td class="xl66" x:str>全链路监控</td>
    <td class="xl66" x:str>4e928ecfaa0d3822add832a52d5abb14</td>
    <td class="xl66" x:str>SELECT CBA.BANK_ACCOUNT_ID AS &quot;accountId&quot;, PRO.PRODUCT_ID || '|' || BA.ACCOUNT_TYPE_ID AS &quot;proAndType&quot; FROM CORE_BANK_ACCOUNT CBA LEFT JOIN BANK_ACCOUNT BA ON CBA.BANK_ACCOUNT_ID = BA.BANK_ACCOUNT_ID LEFT JOIN (SELECT AP.BANK_ACCOUNT_ID, AP.PRODUCT_ID FROM ACCOUNT_PRODUCT AP, BANK_ACCOUNT BAI WHERE AP.BANK_ACCOUNT_ID = BAI.BANK_ACCOUNT_ID AND BAI.DEDICATED = '1' AND AP.EFFECTSTATUS = '1' AND NOT exists( select APS.BANK_ACCOUNT_ID from PRODUCT P , ACCOUNT_PRODUCT APS where P.PRODUCT_ID = APS.PRODUCT_ID and APS.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID and P.EFFECTSTATUS = '1' and APS.EFFECTSTATUS = '1' -- and P.PRODUCT_TYPE_ID IN ('BXDLJDR', 'DK', 'JGJY', 'ABSZJGJ', 'ZJMJ', 'JGQT') group by APS.bank_account_id having count(APS.bank_account_id)&gt;1 ) UNION ALL SELECT AP.BANK_ACCOUNT_ID, AP.PRODUCT_ID FROM ACCOUNT_PRODUCT AP, PRODUCT P, UNUSE_ACCT_INF UA WHERE AP.PRODUCT_ID = P.PRODUCT_ID AND AP.BANK_ACCOUNT_ID = UA.BANK_ACCOUNT_ID AND AP.EFFECTSTATUS = '0' AND UA.EFFECTSTATUS = '1' AND P.EFFECTSTATUS = '0' ) PRO ON CBA.BANK_ACCOUNT_ID = PRO.BANK_ACCOUNT_ID WHERE LENGTH(CBA.BANK_ACCOUNT_ID) = 18 AND NOT EXISTS (SELECT 1 FROM ACCOUNT_PRODUCT AP, PRODUCT P, BANK_ACCOUNT BAT WHERE AP.PRODUCT_ID = P.PRODUCT_ID AND AP.EFFECTSTATUS = '1' AND AP.BANK_ACCOUNT_ID = BAT.BANK_ACCOUNT_ID</td>
    <td class="xl66" x:str>2011</td>
    <td class="xl66" x:str>1</td>
