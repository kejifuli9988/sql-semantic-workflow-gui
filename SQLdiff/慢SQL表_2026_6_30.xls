    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( WITH base_instruction AS (SELECT z.instruction_id, (CASE WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ13','TZZQ16')) THEN nvl((select (case when rtgs.shch_stop_status = '1' then '9' else rtgs.shch_draw_status end) ||'#@@#'|| by3 shch_draw_status from RTGS_COLLECTION_RECORD_1 rtgs where rtgs.instruction_id=z.INSTRUCTION_ID),'6') WHEN (z.SOURCE_ID in('0','1','2','6','8') and z.PAYMENT_TYPE_ID in ('TZZQ12', 'TZZQ17')) THEN nvl((select c.ccdc_draw_status shch_draw_status from CCDC_COLLECTION_RECORD c where c.instruction_id=z.INSTRUCTION_ID),'6') WHEN (z.SOURCE_ID in('0','1','2') and z.PAYMENT_TYPE_ID in ('JWZQ01','JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID ='TZCK10') THEN nvl((select INSTRUCTION_PARAM_VALUE from instruction_ext where instruction_id = z.INSTRUCTION_ID AND INSTRUCTION_PARAM_NAME ='hqckWithDraw'),'') ELSE '' END) AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (select pt.payment_type_name from payment_type pt where pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) as finalStatusOrder, z.final_paymentstatus, z.payment_status, (select ip.yhmc from ip_staff_stmt ip where ip.yhbh = z.updated_by) updated</td>
