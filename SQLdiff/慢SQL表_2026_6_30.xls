    <td class="xl66" x:str>WITH QX_SQL AS (SELECT WM_CONCAT(PRO_IND_BRANCHID) AS BRANCHID FROM CNZL_AUTHPAR WHERE INSTR(USER_BRANCHID, 'G00017713') &gt; 0 AND EFFECTSTATUS = '1' AND FOUREYESSTATUS = '1'), CHECK_NUM AS (SELECT COUNT(1) C FROM CNZL_AUTHPAR WHERE INSTR(PRO_IND_BRANCHID, '') &gt; 0 AND EFFECTSTATUS = '1' AND FOUREYESSTATUS = '1') SELECT Z.UNIT_ID, ? USER_ID, Z.MON_MAT_TYPE, ? REMINDER_TYPE, Z.DATA_AT, Z.INS_ID, NVL(Z.PRODUCT_ID, Z.UNIT_ID) AS PRODUCT_ID, NVL(Z.STEP_ID, '-1') AS STEP_ID, (SELECT IR.CDBH FROM IP_RESMENU IR WHERE IR.CDURL = (CASE WHEN Z.STEP_ID = '0' THEN '/instruction/list.do' WHEN Z.STEP_ID = '1' THEN '/instructionCheck/list.do' WHEN Z.STEP_ID = '2' THEN '/instructionAudit/list.do' WHEN Z.STEP_ID = '3' THEN '/stmtAudit/list.do' WHEN Z.STEP_ID = '4' THEN '/stmtExecuteManage/list.do' WHEN Z.STEP_ID = '5' THEN '/stmtExecuteCheck/list.do' WHEN Z.STEP_ID = '6' THEN '/stmtPayment/list.do' WHEN Z.STEP_ID = '7' THEN '/csbsInstruction/list.do' WHEN Z.STEP_ID = '8' THEN '/unRelInstruction/list.do' WHEN Z.STEP_ID = '9' THEN '/unRelInsHandle/list.do' WHEN Z.STEP_ID = '10' THEN '/unRelInsCheck/list.do' WHEN Z.STEP_ID = '11' THEN '/csdsInstruction/list.do' WHEN Z.STEP_ID = '12' THEN '/yjInstructionHandleCtrler/list.do' ELSE '未知' END)) AS CDBH, NVL((SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE Z.PAYMENT_TYPE_ID = PT.PAYMENT_TYPE_ID), NVL((SELECT IC.MBTMZ FROM IP_CODEINFO IC WHERE IC.SJLX IN ('CSBSCSBSCSBSCSBSCSBSCSBS00010001', 'TYLTYLTYLTYLTYLTYLTYLTYL00000348') AND IC.MBLXBH = Z.PAYMENT_TYPE_ID), '划款类型为空')) AS PAYMENT_TYPE_NAME, (CASE WHEN Z.STEP_ID = '0' THEN '信息经办' WHEN Z.STEP_ID = '1' THEN '信息审核' WHEN Z.STEP_ID = '2' THEN '指令审核' WHEN Z.STEP_ID = '3' THEN '清算审核' WHEN Z.STEP_ID = '4' THEN '清算执行经办' WHEN Z.STEP_ID = '5' THEN '清算执行复核' WHEN Z.STEP_ID = '6' THEN '清算支付' WHEN Z.STEP_ID = '7' THEN '交易指令确认' WHEN Z.STEP_ID = '8' THEN '未上线信息经办' WHEN Z.STEP_ID = '9' THEN '未上线核算经办' W</td>
