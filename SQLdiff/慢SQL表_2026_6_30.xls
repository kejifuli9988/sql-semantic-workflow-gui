    <td class="xl66" x:str>with coreaccpro as (select ap.bank_account_id, ap.product_id from account_product ap, bank_account bai where ap.bank_account_id = bai.bank_account_id and bai.dedicated = '1' and ap.effectstatus = '1' AND NOT exists( select APS.BANK_ACCOUNT_ID from PRODUCT P , ACCOUNT_PRODUCT APS where P.PRODUCT_ID = APS.PRODUCT_ID and APS.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID and P.EFFECTSTATUS = '1' and APS.EFFECTSTATUS = '1' -- and P.PRODUCT_TYPE_ID IN ('BXDLJDR', 'DK', 'JGJY', 'ABSZJGJ', 'ZJMJ', 'JGQT') group by APS.bank_account_id having count(APS.bank_account_id)&gt;1 ) union all select ap.bank_account_id, ap.product_id from account_product ap, product p, unuse_acct_inf ua where ap.product_id = p.product_id and ap.bank_account_id = ua.bank_account_id and ap.effectstatus = '0' and ua.effectstatus = '1' and p.effectstatus = '0' ), accinfo as (select cba.bank_account_id, ba.account_type_id, cap.product_id from core_bank_account cba left join bank_account ba on cba.bank_account_id = ba.bank_account_id left join coreaccpro cap on decode(substr(cba.bank_account_id, 19, 24), '999999', substr(cba.bank_account_id, 0, 18), '999998', substr(cba.bank_account_id, 0, 18), cba.bank_account_id) = cap.bank_account_id where not exists (select 1 from account_product ap, product p where ap.product_id = p.product_id and ap.effectstatus = '1' and nvl(p.sub_group_mark, 1) = '1' and ba.dedicated = '0'</td>
