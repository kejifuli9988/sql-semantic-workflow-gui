    <td class="xl66" x:str>WITH INSTRUCTION_PARAM AS (SELECT T.INSTRUCTION_ID, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'hsgzzllx', T.INSTRUCTION_PARAM_VALUE, '')) HSGZZLLX, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'jjdm', T.INSTRUCTION_PARAM_VALUE, '')) JJDM, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'zhwhf', T.INSTRUCTION_PARAM_VALUE, '')) ZHWHF, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'cxf', T.INSTRUCTION_PARAM_VALUE, '')) CXF, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'jsf', T.INSTRUCTION_PARAM_VALUE, '')) JSF, MAX(decode(T.INSTRUCTION_PARAM_NAME, 'qsfpbj', T.INSTRUCTION_PARAM_VALUE, '')) QSFPBJ FROM INSTRUCTION_EXT_2025 T INNER JOIN INSTRUCTION_2025 I ON T.INSTRUCTION_ID = I.INSTRUCTION_ID INNER JOIN PRODUCT P ON I.PRODUCT_ID = P.PRODUCT_ID WHERE T.INSTRUCTION_PARAM_NAME IN ('hsgzzllx', 'jjdm', 'zhwhf', 'cxf', 'jsf', 'qsfpbj') AND I.PAYMENT_TYPE_ID != 'QSCNDB' AND I.PAYMENT_STATUS = '3' AND P.EFFECTSTATUS = '1' AND P.product_code IN (?) AND i.payment_at &gt;= to_date(?, 'yyyy/MM/dd') AND i.payment_at &lt;= to_date(?, 'yyyy/MM/dd') GROUP BY T.INSTRUCTION_ID) SELECT * FROM (SELECT I.INSTRUCTION_ID HKDBH, I.PAYMENT_TYPE_ID HKLX, (SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE PT.PAYMENT_TYPE_ID = I.PAYMENT_TYPE_ID) HKLXMC, I.COUNTER_CASHFLOW GYLSH, IP.HSGZZLLX, IP.JJDM, IP.ZHWHF, IP.CXF, IP.JSF, IP.QSFPBJ, I.REMARK XWH, I.SOURCE_ID, NVL(NVL(NVL(NVL(NVL(NVL(I.COUNTER_CASHFLOW, IP.HSGZZLLX), IP.JJDM), IP.ZHWHF), IP.CXF), IP.JSF), IP.QSFPBJ) AS idx1 FROM INSTRUCTION_2025 I INNER JOIN PRODUCT P ON I.PRODUCT_ID = P.PRODUCT_ID LEFT JOIN INSTRUCTION_PARAM IP ON I.INSTRUCTION_ID = IP.INSTRUCTION_ID WHERE I.PAYMENT_TYPE_ID != 'QSCNDB' AND I.PAYMENT_STATUS IN ('3', '8') AND P.EFFECTSTATUS = '1' AND I.INSTRUC_BATCH_FLAG != '1' AND (I.P_INSTRUCTION_ID != '0' OR I.P_INSTRUCTION_ID IS NULL) AND p.product_code IN (?) AND i.payment_at &gt;= to_date(?, 'yyyy/MM/dd') AND i.payment_at &lt;= to_date(?, 'yyyy/MM/dd')) t WHERE t.idx1 IS NOT NULL OR (t.SOURCE_ID = '4' AND t.HKLX = 'FYZF03')</td>
