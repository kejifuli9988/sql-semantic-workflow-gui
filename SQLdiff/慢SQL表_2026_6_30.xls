    <td class="xl66" x:str>d6b6bb8b35d346100db103f02d012723</td>
    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select CI.PK_ID1, CI.DEAL_ID, CI.INSTR_ID, CI.BUSINESS_ID, CI.PRODUCT_ID, CI.PRODUCT_NAME, CI.MANAGER_ID, CI.MANAGER_NAME, CI.OPD_BRANCH_ID, CI.ACCOUNT_TYPE, CI.ACCOUNT_ID, CI.COUNTER_ACCOUNT_ID, CI.ACCOUNT_NAME, CI.COUNTER_ACCOUNT_NAME, CI.BUSINESS_TYPE, CI.INSTR_STATUS, CI.COUNTER_STATUS, CI.OUR_STATUS, CI.OP_TYPE,NOTE_FLAG, CI.AUTOCONFIRM_FLAG, CI.NOTE_ID, decode(CI.NOTE_ID,null,'0','1') BIND_STATUS, CI.RECORD_STATUS, CI.FOUREYESSTATUS, CI.AUDIT_COMMENT, CI.BOND_COUNT, CI.DELIVER_DATE1, CI.DELIVER_DATE2, CI.CREATED_AT, CI.MARKET_TYPE, decode(CI.ACCOUNT_TYPE,1,CI.OUR_STATUS,CI.COUNTER_STATUS) as OUR_CODE, (select a.yhmc from ip_staff a where CI.CREATED_BY = a.yhbh) as CREATED_BY, CI.UPDATED_AT, (select b.yhmc from ip_staff b where CI.UPDATED_BY = b.yhbh) as UPDATED_BY, CI.VALIDATED_AT, (select c.yhmc from ip_staff c where CI.VALIDATED_BY = c.yhbh) as VALIDATED_BY, CI.INIT_SETTLE_AMOUNT, CI.DUE_SETTLE_AMOUNT, cio.PLEDGEBOND_CODE, cio.PLEDGEBOND_FACEAMT, cio.PLEDGEBOND_RATE, cio.PLEDGEBOND_NUMBER, CI.SUPERVISION_SIGN, CI.SUPERVISION_OPINION, CI.BANK_ACCOUNT_ID, CI.ARCHIVED_STATUS, CI.ARCHIVED_DATE, CI.ARCHIVED_PACKAGE, (select ip.jgmc from ip_unit_stmt ip where ip.zj = (select p.opd_branchid from product p where p.product_id = CI.product_id)) cpyyjg, ba.BANK_ACCOUNT_NAME as bankAccountName, CI.TRADE_SUBCAT_ID, CI.TRADE_SUBCAT_NAME from CSBS_INSTRUCTION CI left join csbs_instruction_origin cio on ci.instr_id = cio.instr_id left join bank_account ba on ci.BANK_ACCOUNT_ID = ba</td>
    <td class="xl66" x:str>2769</td>
