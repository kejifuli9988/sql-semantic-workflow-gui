    <td class="xl66" x:str>merge into settlement_cashflow_history sh using ( select ? as cashflowId, ? as productId, ? as accountId, ? as accountTypeId, ? as cashflowAt, ? as cashflowTime, ? as creditAccount, ? as creditAccountName, ? as debitAccount, ? as debitAccountName, ? as direction, ? as amount, ? as balanceBefore, ? as balanceAfter, ? as currency, ? as message, ? as remark, ? as dfkhhh, ? as dfkhmc, ? as bankAccountId from dual union all select ? as cashflowId, ? as productId, ? as accountId, ? as accountTypeId, ? as cashflowAt, ? as cashflowTime, ? as creditAccount, ? as creditAccountName, ? as debitAccount, ? as debitAccountName, ? as direction, ? as amount, ? as balanceBefore, ? as balanceAfter, ? as currency, ? as message, ? as remark, ? as dfkhhh, ? as dfkhmc, ? as bankAccountId from dual union all select ? as cashflowId, ? as productId, ? as accountId, ? as accountTypeId, ? as cashflowAt, ? as cashflowTime, ? as creditAccount, ? as creditAccountName, ? as debitAccount, ? as debitAccountName, ? as direction, ? as amount, ? as balanceBefore, ? as balanceAfter, ? as currency, ? as message, ? as remark, ? as dfkhhh, ? as dfkhmc, ? as bankAccountId from dual ) b on (sh.ACCOUNT_TYPE_ID='zqzh0000003' and substr(sh.CASHFLOW_ID,1,length(sh.CASHFLOW_ID)-length(sh.account_id)) = substr(b.cashflowId,1,length(b.cashflowId)-length(b.accountId)) and sh.ACCOUNT_ID = b.accountId and sh.direction = b.direction) when not matched then insert (cashflow_id,product_id,account_id,account_type_id,cashflow_at,cashflow_time,credit_account,credit_account_name,debit_account,debit_account_name, direction,amount,balance_before,balance_after,currency,message,remark,created_at,created_by,bank_no,bank_name,bank_account_id) values (b.cashflowId, b.product</td>
