    <td class="xl66" x:str>fe5e7893b643113b6640589d4e18a38e</td>
    <td class="xl66" x:str>SELECT I.INSTRUCTION_ID as &quot;instructionId&quot;, I.PAYMENT_TYPE_ID as &quot;paymentTypeId&quot;, E.GENERATE as &quot;sourceId&quot;, I.DIRECTION as &quot;direction&quot;, null as &quot;creditAcctTypeId&quot;, null as &quot;beiyong1&quot;, I.PAYMENT_AT as &quot;paymentAt&quot; FROM INSTRUCTION I, EC_INSTRUCTION E, INSTRUCTION_EXT IE WHERE E.INSTRUCTION_ID = I.INSTRUCTION_ID AND I.INSTRUCTION_ID = IE.INSTRUCTION_ID AND I.PAYMENT_TYPE_ID = 'JGXCK' AND E.GENERATE = '8' AND I.ACTION_STATUS = '50' AND ((IE.INSTRUCTION_PARAM_NAME = 'controlStatus' AND IE.INSTRUCTION_PARAM_VALUE != '3') OR i.payment_status = '7') AND I.PAYMENT_AT &gt;= trunc(cast(? as timestamp)) union all SELECT I.INSTRUCTION_ID as &quot;instructionId&quot;, I.PAYMENT_TYPE_ID as &quot;paymentTypeId&quot;, E.GENERATE as &quot;sourceId&quot;, I.DIRECTION as &quot;direction&quot;, null as &quot;creditAcctTypeId&quot;, BA.EBNK_CUST_CD as &quot;beiyong1&quot;, I.PAYMENT_AT AS &quot;paymentAt&quot; FROM INSTRUCTION I LEFT JOIN CURDPT_ACCOUNT_PRODUCT BA ON I.CREDIT_ACCOUNT = BA.CUR_DPT_ACC_NO AND I.PRODUCT_ID = BA.CLR_PRD_ID LEFT JOIN EC_INSTRUCTION E ON E.INSTRUCTION_ID = I.INSTRUCTION_ID LEFT JOIN INSTRUCTION_EXT IE ON I.INSTRUCTION_ID = IE.INSTRUCTION_ID WHERE IE.INSTRUCTION_PARAM_NAME ='hqckWithDraw' AND IE.INSTRUCTION_PARAM_VALUE ='3' AND I.PAYMENT_TYPE_ID = 'TZCK10' AND I.PAYMENT_AT &gt;= trunc(cast(? as timestamp)) AND ROWNUM &lt;=200</td>
