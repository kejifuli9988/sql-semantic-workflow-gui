    <td class="xl66" x:str>WITH base_instruction AS (SELECT z.instruction_id, CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN NVL((SELECT CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END || '#@@#' || rtgs.shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.instruction_id), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN NVL((SELECT c.ccdc_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.instruction_id), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN NVL((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext WHERE instruction_id = z.instruction_id AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (select pt.payment_type_name from payment_type pt where pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) as finalStatusOrder, z.final_paymentstatus,</td>
