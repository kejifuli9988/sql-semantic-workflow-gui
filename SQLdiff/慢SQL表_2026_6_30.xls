    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select INFO_ID,product_id, (select a.product_name from product a where DTIC.product_id = a.product_id) as product_name , (SELECT rtrim(xml_clob(xmlagg(xmlparse(content code||',') ORDER BY code)),',') from(select code_id AS code from para_code WHERE para_key = PAYMENT_TYPE_ID)) as PAYMENT_TYPE_ID, get_names(PAYMENT_TYPE_ID, 'payment_type') as PAYMENT_TYPE_NAME, (SELECT rtrim(xml_clob(xmlagg(xmlparse(content code||',') ORDER BY code)),',') from(select code_id AS code from para_code WHERE para_key = PRODUCT_TYPE_ID)) as PRODUCT_TYPE_ID, get_names(PRODUCT_TYPE_ID, 'product_type') as PRODUCT_TYPE_NAME, RFFLAG,ACCOUNT_NO,get_ids(INSTRUCT_SOURCE) as INSTRUCT_SOURCE, get_names(INSTRUCT_SOURCE, 'instruct_source') as INSTRUCT_SOURCE_NAME,EFFECTSTATUS,OP_TYPE,FOUREYESSTATUS,AUDIT_COMMENT,CREATED_AT,CREATED_BY, UPDATED_AT,UPDATED_BY,VALIDATED_AT,VALIDATED_BY,REMARK, NVL(APPLY_SUB, 1) APPLY_SUB,ORGANIZATION_DAYEND,PRODUCT_STMTONLINE, (select a.yhmc from ip_staff a where DTIC.created_by = a.yhbh) as createdByName, (select b.yhmc from ip_staff b where DTIC.updated_by = b.yhbh) as updatedByName, (select c.yhmc from ip_staff c where DTIC.validated_by = c.yhbh) as validatedByName, OPD_BRANCHID,(select JGMC from IP_UNIT_STMT uou where uou.ZJ = OPD_BRANCHID) as opdBranchName, OTHERS_SYSTEM_ID,MANAGER_ID,(select external_agency_name from EXTERNAL_AGENCY ea where ea.EXTERNAL_AGENCY_ID = MANAGER_ID) as managerName, get_ids(ECINS_GENTYPE) as ECINS_GENTYPE, decode(OTHERS_SYSTEM_ID,'1','赢时胜运营','2','服务运营','') as othersSystemName, replace(replace(replace(replace(get_ids(ECINS_GENTYPE),'7','托管通'),'3','深证通'),'8','同业门户'),'9','光伏贷') as ecinsGentypeName,product_onfile from DIRECT_TRANSFER_INFO DTIC where 1=1 order by CREATED_AT desc, UPDATED_BY desc ) row_ ) where rownum_ &gt; 0 and rownum_ &lt;= 10</td>
