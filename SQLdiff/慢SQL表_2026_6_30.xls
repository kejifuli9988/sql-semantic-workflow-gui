    <td class="xl66" x:str>SELECT * FROM (SELECT ROWNUM R, T.* FROM (WITH TEMP1 AS (SELECT 'SETTLEMENT_AMOUNT_SH' MXLX, '051010100100000144' BFZH, 'ZHLX15' DFZHLX FROM DUAL UNION ALL SELECT 'SETTLEMENT_AMOUNT_SZ' MXLX, '051010100100000144' BFZH, 'ZHLX17' DFZHLX FROM DUAL UNION ALL SELECT 'SETTLEMENT_AMOUNT_BJ' MXLX, '051010100100000144' BFZH, 'ZHLX38' DFZHLX FROM DUAL UNION ALL SELECT 'SETTLEMENT_AMOUNT_SHHK' MXLX, '051010100100000144' BFZH, 'ZHLX40' DFZHLX FROM DUAL UNION ALL SELECT 'SETTLEMENT_AMOUNT_SZHK' MXLX, '051010100100000144' BFZH, 'ZHLX47' DFZHLX FROM DUAL UNION ALL SELECT 'UNSECURED_AMOUNT_SH' MXLX, '051010100100000144' BFZH, 'ZHLX16' DFZHLX FROM DUAL), TEMP2 AS (SELECT 'RISK_AMOUNT_SHHK' MXLX, 'ZHLX40' BFZHLX, 'ZHLX41' DFZHLX FROM DUAL UNION ALL SELECT 'RISK_AMOUNT_SZHK' MXLX, 'ZHLX47' BFZHLX, 'ZHLX48' DFZHLX FROM DUAL UNION ALL SELECT 'PROVISION_AMOUNT_SH' MXLX, 'ZHLX15' BFZHLX, 'ZHLX28' DFZHLX FROM DUAL UNION ALL SELECT 'PROVISION_AMOUNT_SZ' MXLX, 'ZHLX17' BFZHLX, 'ZHLX30' DFZHLX FROM DUAL UNION ALL SELECT 'PROVISION_AMOUNT_BJ' MXLX, 'ZHLX38' BFZHLX, 'ZHLX39' DFZHLX FROM DUAL UNION ALL SELECT 'MARGIN_AMOUNT_SH' MXLX, 'ZHLX15' BFZHLX, 'ZHLX33' DFZHLX FROM DUAL UNION ALL SELECT 'MARGIN_AMOUNT_SZ' MXLX, 'ZHLX17' BFZHLX, 'ZHLX21' DFZHLX FROM DUAL UNION ALL SELECT 'MARGIN_AMOUNT_BJ' MXLX, 'ZHLX38' BFZHLX, 'ZHLX43' DFZHLX FROM DUAL), TEMP3 AS (SELECT PRODUCT_ID, MXLX, SUM(AMOUNT) MONEY FROM (SELECT I.PRODUCT_ID, TEMP1.MXLX, decode(I.DIRECTION, '0', -I.AMOUNT, '1', I.AMOUNT) AMOUNT FROM INSTRUCTION I, TEMP1 WHERE decode(I.DIRECTION, '0', I.CREDIT_ACCOUNT, '1', I.DEBIT_ACCOUNT) = TEMP1.BFZH AND decode(I.DIRECTION, '0', I.DEBIT_ACCT_TYPE_ID, '1', I.CREDIT_ACCT_TYPE_ID) = TEMP1.DFZHLX AND trunc(I.PAYMENT_AT) = trunc(sysdate) AND I.PRODUCT_ID IN ('PROD9922030800060486') AND (I.ACTION_STATUS != '3' OR I.ACTION_STATUS IS NULL) AND NOT EXISTS (SELECT 1 FROM product p, INSTRUCTION II WHERE II.instruction_id = I.instruction_id AND p.product_id = I.product_id AND p.LQFII_flag = '0' AND II.csds_b</td>
