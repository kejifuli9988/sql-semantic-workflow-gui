    <td class="xl66" x:str>select count(*) from ( select CI.DEAL_ID as DEAL_ID, CI.INIT_SETTLE_AMOUNT as INIT_SETTLE_AMOUNT, NVL(CI.DELIVER_DATE1,CI.DELIVER_DATE2) as SETTLEMENT_DATE from CSBS_INSTRUCTION CI left join CRITICAL_MONITOR_SIGN cm on ci.instr_id = cm.RELATION_ID left join product pp on ci.product_id = pp.product_code where ci.INSTR_STATUS = 'IS03' and cm.OPD_CONFIRM_STATUS IS NULL and ( CI.DELIVER_DATE1 between ? and ? ) and ci.PRODUCT_ID IN ( select p1.PRODUCT_CODE FROM product p1 WHERE p1.OPD_BRANCHID IN ( ? ) ) union all select CI.DEAL_ID as DEAL_ID, CI.INIT_SETTLE_AMOUNT as INIT_SETTLE_AMOUNT, NVL(CI.DELIVER_DATE1,CI.DELIVER_DATE2) as SETTLEMENT_DATE from CSBS_INSTRUCTION CI left join CRITICAL_MONITOR_SIGN cm on ci.instr_id = cm.RELATION_ID inner join bank_account ba on ba.bank_account_id = ci.bank_account_id inner join ( select aup.ind_branchid,aup.opd_branchid,aup.bank_account_id from (select a.bank_account_id, pro.ind_branchid as ind_branchid, pro.opd_branchid as opd_branchid, ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN from auxiliary_product a inner join product pro on pro.product_id = a.product_id where a.effectstatus = '1' ) aup where aup.rown = 1 ) ap on ap.bank_account_id = ba.bank_account_id where ci.product_id is null and ci.INSTR_STATUS = 'IS03' and ba.account_attribute = '1' and ba.effectstatus != '2' and ap.OPD_BRANCHID IN ( ? ) and cm.OPD_CONFIRM_STATUS IS NULL and ( CI.DELIVER_DATE1 between ? and ? ) union all select cc.DEAL_ID as DEAL_ID, to_char(cc.SETTLEMENT_amount) as INIT_SETTLE_AMOUNT, cc.SETTLEMENT_DATE as SETTLEMENT_DATE from CSBS_CONTRACT cc left join CRITICAL_MONITOR_SIGN cm on cc.instr_id = cm.RE</td>
