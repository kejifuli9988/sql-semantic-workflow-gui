    <td class="xl66" x:str>select t.info_id , t.product_id , (select xml_clob(xmlagg(xmlparse(content p.payment_type_name||',')order by t1.payid)) from PAYMENTTYPES_LIST t1, payment_type p where t1.payid = t.payment_type_id and t1.ipaymenttypeid = p.payment_type_id and p.effectstatus = '1' ) payMentTypeName, (select xml_clob(xmlagg(xmlparse(content t1.ipaymenttypeid||',')order by t1.payid)) from PAYMENTTYPES_LIST t1, payment_type p where t1.payid = t.payment_type_id and t1.ipaymenttypeid = p.payment_type_id and p.effectstatus = '1' ) payMentTypeId, t.payment_type_id payMentTypeIdq, t.pay_flag , t.account_no , t.effectstatus effectstatus, t.op_type , t.foureyesstatus foureyesstatus, t.audit_comment , t.created_at , t.created_by , t.updated_at , t.updated_by , t.validated_at , t.validated_by , a.yhmc createdByName, b.yhmc updatedByName, c.yhmc validatedByName from SUBSI_ACCOUNT_PARA t left join ip_staff a on t.CREATED_BY = a.yhbh left join ip_staff b on t.UPDATED_BY = b.yhbh left join ip_staff c on t.VALIDATED_BY = c.yhbh where t.info_id IN ( ? , ? , ? , ? , ? , ? , ? ) order by CREATED_AT desc</td>
