    <td class="xl66" x:str>MERGE INTO INSTRUCTION_TRANS_INFO I USING ( SELECT T.INSTRUCTION_ID, decode(T.INSTRUCTION_ID, NULL, '', '0') MATCH_STATUS, decode(T.INSTRUCTION_ID, NULL, '', '0') SORT_ORDER, decode(T.SOURCE, '2', 'GLR', '1', 'DXJG') SOURCE_ID, T.PK_ID, T.SEQ_NO, T.PRODUCT_ID, T.TRADE_DATE, T.TRADE_DIRECTION, T.SECURITY_TYPE, NVL(AMOUNT, APPMONEY) AMOUNT, T.REGIST_CODE, T.SECURITY_CODE, T.SECURITY_NAME, T.BYZD3, T.BYZD2 FROM TRANS_INFO T where seq_no = ? and nvl(org_no,'1') = nvl(?,'1') and trade_date = ? and nvl(trade_direction,'1') = nvl(?,'1') and source = ? and (source = '2' or (source = '1' and source_code = ?) ) union all SELECT T.INSTRUCTION_ID, decode(T.INSTRUCTION_ID, NULL, '', '0') MATCH_STATUS, decode(T.INSTRUCTION_ID, NULL, '', '0') SORT_ORDER, decode(T.SOURCE, '2', 'GLR', '1', 'DXJG') SOURCE_ID, T.PK_ID, T.SEQ_NO, T.PRODUCT_ID, T.TRADE_DATE, T.TRADE_DIRECTION, T.SECURITY_TYPE, NVL(AMOUNT, APPMONEY) AMOUNT, T.REGIST_CODE, T.SECURITY_CODE, T.SECURITY_NAME, T.BYZD3, T.BYZD2 FROM TRANS_INFO T where seq_no = ? and nvl(org_no,'1') = nvl(?,'1') and trade_date = ? and nvl(trade_direction,'1') = nvl(?,'1') and source = ? and (source = '2' or (source = '1' and source_code = ?) ) union all</td>
