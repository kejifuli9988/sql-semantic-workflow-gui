    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select TSR.PRODUCT_ID, PRO.MANAGER_ID, PRO.PRODUCT_NAME, PRO.PRODUCT_CODE, (SELECT EA.EXTERNAL_AGENCY_NAME FROM EXTERNAL_AGENCY EA WHERE EA.EXTERNAL_AGENCY_ID = PRO.MANAGER_ID) AS MANAGER_NAME, (SELECT IUS.JGMC FROM IP_UNIT_STMT IUS WHERE IUS.ZJ = PRO.OPD_BRANCHID ) AS OPD_BRANCHNAME, TSR.PAY_FREQUENCY, to_char(TSR.REGISTER_DATE,'yyyy-MM-dd hh24:mi:ss') as REGISTER_DATE, TSR.INITIAL_TGF_AMOUNT, TSR.REGISTER_CAUSE, TSR.GZJGQR, TSR.TRACING_CONFIRM_CAUSE, to_char(TSR.LAST_TRACING_DATE,'yyyy-MM-dd hh24:mi:ss') as LAST_TRACING_DATE, TSR.NOT_PAY_TGF_AMOUNT, TSR.EFFECTSTATUS, to_char(NVL(TP.SC_TGF_DATE,TP.TGF_INITIALIZE_DATE),'yyyyMMdd') as SC_TGF_DATE, TP.IF_WROKDAY_FLAG, tp.TGF_CHECK_DAY, TP.ANOMALY_GATHER_DATE, TP.WHETHER_STAY_BE_OFFLINE, TP.WHETHER_PREPAYMENT, TP.MANY_YEARS, TP.INITIAL_PAY_YEAR, (case when TP.pay_frequency = '0' then '30' when TP.pay_frequency = '1' then '90' when TP.pay_frequency = '2' then '180' when TP.pay_frequency = '3' then '360' else '0' end ) as DAY_NUMBER, TP.DAY_RULE, TP.MONTH_RULE, TP.MONTH_END_FLAG, TP.IF_DAYRULE_FLAG, to_char(TP.TGF_INITIALIZE_DATE,'yyyy-MM-dd') as TGF_INITIALIZE_DATE, (select sum(tih.amount) from TGF_INSTR_HISTORY tih where ( tih.created_At &gt;= trunc(tsr.register_date) and tih.created_At &lt;= nvl(tsr.tgf_deadline_date,sysdate)) and tih.product_id = tsr.product_id) as COLLECT_AMOUNT_COUNT, ( select max(to_char(tt.payment_date,'yyyy-MM-dd')) from TGF_INSTR_HISTORY tt where tt.product_id = tsr.product_id and tt.created_at = ( select max(tih.created_at)from TGF_INSTR_HISTORY tih where ( tih.created_At &gt;= trunc(tsr.r</td>
