    <td class="xl66" x:str>c85e10c59d5a79a7f72d79faf7bafdf1</td>
    <td class="xl66" x:str>select count(*) from ( select cc.CONTRACT_PK_ID as pkid from csbs_contract cc left join csbs_instruction_origin cio on cc.instr_id = cio.instr_id left join shch_instruction_origin sio on cc.INSTR_ID = sio.trade_id left join product pro on cc.product_id = pro.product_code where (pro.effectstatus != '2' or cc.product_id is null) and( ( 1=1 and pro.product_code = ? and cc.bank_account_id = ? and cc.market = ? ) ) AND (CC.SETTLEMENT_DATE &gt;=? AND CC.SETTLEMENT_DATE &lt;=?) UNION select cc.CONTRACT_PK_ID as pkid from csbs_contract cc left join csbs_instruction_origin cio on cc.instr_id = cio.instr_id left join shch_instruction_origin sio on cc.INSTR_ID = sio.trade_id left join product pro on cc.product_id = pro.product_code where (pro.effectstatus != '2' or cc.product_id is null) and( ( 1=1 and pro.product_code = ? and cc.bank_account_id = ? and cc.market = ? ) ) AND (CC.FINISHDATE &gt;=? AND CC.FINISHDATE &lt;=?) )t</td>
