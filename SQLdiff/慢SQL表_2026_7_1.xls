    <td class="xl66" x:str>fb5170d06e9408a1aa64d6b2d2643a79</td>
    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select * from ( select p.product_code cpdm, i.instruction_id instructionId, i.credit_account fkfzh, i.instruction_id hkdbh, i.amount hkje, i.payment_type_id hklx, to_char(i.payment_at,'yyyyMMdd') hkrq, to_char(i.created_at,'yyyyMMddHH24miss') cjsj, i.direction sfkfx, i.debit_account skfzhh, i.currency bz, i.credit_account_id fkfzhid, i.credit_account_name fkfzhqc, i.bank_name fkfzhkhh, i.debit_account_id skfzhid, i.debit_account_name skfzhqc, i.fbank_name skfzhkhh, case when i.payment_type_id in ('TZXG01', 'TZXG02') then i.ipo_subscribe else i.payment_reason end summary from instruction i inner join product p on i.product_id = p.product_id where i.payment_type_id != 'QSCNDB' and not exists (select 1 from etf_paymenttype_map epm where i.payment_type_id = epm.main_paymenttype_id and epm.map_type = '1') and i.payment_status in( '3','8') and p.effectstatus = '1' and p.product_code in ( ? , ? , ? , ? , ? , ? ) and i.payment_at &gt;= to_date(?,'yyyy/MM/dd') and i.payment_at &lt;= to_date(?,'yyyy/MM/dd') union all select p.product_code cpdm, i.instruction_id instructionId, case when (select ba.account_type_id from bank_account ba where ba.bank_account_id = isu.credit_account and ba.effectstatus = '1') in ('CNQSFZH','RQFIIQSFZH') then (select ap.bank_account_id from account_product ap where ap.product_id = p.product_id and ap.main_account_mark = '0' and ap.effectstatus = '1') else isu.credit_account end fkfzh, isu.sub_id hkdbh, isu.amount hkje, isu.payment_type_id hklx, to_char(i.payment_at,'yyyyMMdd') hkrq, to_char(i.created_at,'yyyyMMddHH24miss') cjsj, isu.direction sfkfx, case when (select ba.account_type_id from bank_account ba where ba.bank_account_id = isu.debit_account and ba.effectstatus = '1') in ('CNQSFZH','RQFIIQSFZH')</td>
