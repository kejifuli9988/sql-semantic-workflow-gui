    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select z.qhld_id, debit_account, debit_account_name, bank_id, bank_name, riskfee_debit_account, riskfee_debit_account_name, riskfee_bank_id, riskfee_bank_name, payment_rate, date_property, payment_day, payment_time,finance_time,finance_date_property, inter_bank, branch_id,ind_branch_id,start_at,end_at, (select aa.jgmc from ip_unit_stmt aa where aa.zj = z.branch_id and aa.effectstatus = '1') as branch_name, (select aa.jgmc from ip_unit_stmt aa where aa.zj = z.ind_branch_id and aa.effectstatus = '1') as ind_branch_name, (case payment_type_id when 'FYZF03' then to_char(get_values(z.manager_id)) else manager_id end) manager_id, (case payment_type_id when 'FYZF03' then get_names(z.manager_id,'manager') else (select d.external_agency_name from external_agency d where d.effectstatus = '1' and z.manager_id = d.external_agency_id) end) as manager_name, effectstatus, op_type, foureyesstatus, audit_comment, created_at, created_by, updated_at, updated_by, validated_at, validated_by, whether_fax, riskfee_ratio, get_values(z.product_type_id) as product_type_id, get_names(z.product_type_id, 'product_type') as product_type_name, get_values(z.product_id) as product_id, get_names(z.product_id, 'product') as product_name, get_values(z.seat_id) as seat_id, get_names(z.seat_id, 'seat') as seat_code, get_values(z.broker_id) as broker_id, get_names(z.broker_id, 'broker') as broker_name, z.payment_type_id,(case when z.terminate_flag ='0' then ( select p.payment_type_name from payment_type p where z.payment_type_id = p.payment_type_id and p.effectstatus='1') else z.payment_type_id end) as paymentTypeName, (select a.yhmc from ip_staff a where z.created_by = a.yhbh) as createdByName, (select b.yhmc from ip_staff b where z.updated_b</td>
