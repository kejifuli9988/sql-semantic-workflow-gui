    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select * from ( select cc.CONTRACT_PK_ID, PRO.PRODUCT_CODE as PRODUCT_ID, cc.PRODUCT_NAME, cc.DWFHK, cc.MANAGER_ID, cc.MANAGER_NAME, cc.CONTRACT_NO, cc.DEAL_ID, cc.INSTR_ID, cc.BUSINESS_TYPE, cc.STARTVALUE_INFO, cc.ENDVALUE_INFO, cc.CONTRACT_STATUS, cc.GIVE_ACCOUNT_ID, cc.GIVE_ACCOUNT_NAME, cc.TAKE_ACCOUNT_ID, cc.TAKE_ACCOUNT_NAME, cc.CONTRACT_DATE, cc.ORDER_SEQ, cc.OWNER_STATUS, cc.PAYMENT_TYPE, cc.FAILREASON, cc.FINISHDATE, cc.CONTRACTFORZEN_STATUS, cc.BUSINESSNO, cc.MARKET, cc.BOND_SUM, cc.SETTLEMENT_AMOUNT, cc.GROSS_ORDER_STATUS, cc.FUND_SETT_STATUS, cc.PRODUCT_STATUS, cc.SETTLEMENT_DATE, (case when cc.MARKET = '0' then cc.full_order_type when cc.market = '1' and (cc.BUSINESS_TYPE = 'BT02' or cc.BUSINESS_TYPE = 'BT03' or cc.BUSINESS_TYPE = 'BT05') then '0' when cc.market = '1' and (cc.BUSINESS_TYPE = 'BT23' or cc.BUSINESS_TYPE = 'BT24' or cc.BUSINESS_TYPE = 'BT25') then '1' else '' end) as full_order_type, cc.ZQDM, cc.ZQJC, cc.CREATE_DATE, cc.CREATE_TIME, cc.TRADE_TYPE, (case when MARKET='0' then cc.INSTR_ID else cc.SRC_TRADE_ID end ) SRC_TRADE_ID, cc.FIRST_CREATE_DATE, cc.SETTLEMENT_MODEL, cc.BOND_FACE_PRICE, cc.TRANSFER_OUT_APPLICANT, pro.MANAGER_PROD, cc.BANK_ACCOUNT_ID, cio.GIVEBOND_AMOUNT, cio.TAKEBOND_AMOUNT, cio.SETTLEMENT_CURRENCY, (case when cc.market = '0' then sio.pk_id else cio.pk_id end ) as sqzjpkid from csbs_contract cc left join csbs_instruction_origin cio on cc.instr_id = cio.instr_id left join shch_instruction_origin sio on cc.INSTR_ID = sio.trade_id left join product pro on cc.product_id = pro.product_code where (pro.effectstatus != '2' or cc.product_id is null) and ( ( 1=1 and pro.product_code = ? and cc.bank_account_id = ? and cc.market = ? )</td>
