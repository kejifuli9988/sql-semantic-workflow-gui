    <td class="xl66" x:str>UPDATE CSDS_DAYEND_DETAIL I SET I.CHECK_RESULT = '1' WHERE I.DAYEND_DATE = trunc(cast(? as timestamp)) AND I.CLEAR_TYPE = ? AND EXISTS ( SELECT 1 FROM (SELECT TEMP.*, NVL(TEMP.CREDIT_ACCOUNT,'NULL') AS IDX1, NVL(TEMP.DEBIT_ACCOUNT,'NULL') AS IDX2 FROM CSDS_DAYEND_DETAIL TEMP ) A, (SELECT TEMP.*, NVL(TEMP.CREDIT_ACCOUNT,'NULL') AS IDX3, NVL(TEMP.DEBIT_ACCOUNT,'NULL') AS IDX4 FROM CSDS_DAYEND_DETAIL TEMP ) B WHERE A.DETAIL_ID = I.DETAIL_ID AND A.DATA_SOURCE != B.DATA_SOURCE AND A.INSTRUCTION_ID = B.INSTRUCTION_ID AND A.PAYMENT_DATE = B.PAYMENT_DATE AND A.PAYMENT_TYPE_ID = B.PAYMENT_TYPE_ID AND A.PRODUCT_ID = B.PRODUCT_ID AND A.DIRECTION = B.DIRECTION AND A.AMOUNT = B.AMOUNT AND A.CLEAR_TYPE = B.CLEAR_TYPE AND A.IDX1 = B.IDX3 AND A.IDX2 = B.IDX4 )</td>
