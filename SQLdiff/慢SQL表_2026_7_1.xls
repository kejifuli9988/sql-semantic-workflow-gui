    <td class="xl66" x:str>select count(1) from( select zzd_id, zjzh, listagg(product_id, ',') within group(order by null) product_id, listagg(product_code, ',') within group(order by null) product_code, listagg(product_name, ',') within group(order by null) product_name, listagg(zqzhBankAccountId, ',') within group(order by null) ZQZH_BANK_ACCOUNT_ID, listagg(zqzhBankAccountName, ',') within group(order by null) ZQZH_BANK_ACCOUNT_NAME, decode(count(OPERATION_MODE), 1, listagg(OPERATION_MODE, ',') within group(order by null), '') OPERATION_MODE, decode(count(OPD_BRANCHID), 1, listagg(OPD_BRANCHID, ',') within group(order by null), '') OPD_BRANCHID, decode(count(IND_BRANCHID), 1, listagg(IND_BRANCHID, ',') within group(order by null), '') IND_BRANCHID, decode(count(manager_id), 1, listagg(manager_id, ',') within group(order by null), '') manager_id, decode(count(manager_name), 1, listagg(manager_name, ',') within group(order by null), '') manager_name, CHARGE_CYCLE, AMOUNT_PAY, AMOUNT_PAYED, BANK_SUN, AMOUNT_NOT_PAY, PAY_INFO, FEE_PAY_STATUS, ZL_CREATE_STATE, ZL_CREATE_DATE, ZL_CREATE_WAY, CREATED_AT, UPDATED_AT, REMARKS, instruction_id, ZL_WITHHOLD_STATE, CREATED_BY, UPDATED_BY from ( select a.ZZD_ID,a.ZJZH,c.product_id,c.product_code,c.product_name,c.OPERATION_MODE,c.OPD_BRANCHID,c.IND_BRANCHID,ea_mg.external_agency_id manager_id ,ea_mg.EXTERNAL_AGENCY_NAME manager_name, a.CHARGE_CYCLE, a.AMOUNT_PAY,a.AMOUNT_PAYED,a.BANK_SUN,a.AMOUNT_NOT_PAY,a.PAY_INFO,a.FEE_PAY_STATUS, a.ZL_CREATE_STATE,a.ZL_CREATE_DATE,a.ZL_CREA</td>
