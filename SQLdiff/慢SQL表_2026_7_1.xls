    <td class="xl66" x:str>select count(1) from (select sqs_id, notice_id, holder_id, holder_name, cost_type, amount_pay, amount_payed, zl_id, zl_create_state, zl_create_date, zl_create_way, sqs_pay_state, sqs_create_date, calculate_cycle, bizcategory, procategory, biz_type, biz_zdtm, receivablesid, remark, poolnumber, currency, file_address, created_at, created_by, fee_project, updated_at, updated_by, yc_type, amount_unpaid, listagg(product_id, ',') within group(order by null) product_id, listagg(product_name, ',') within group(order by null) product_name, listagg(product_code, ',') within group(order by null) product_code, listagg(bankAccountId, ',') within group(order by null) BANK_ACCOUNT_ID, listagg(bankAccountName, ',') within group(order by null) BANK_ACCOUNT_NAME, decode(count(manager_name), 1, listagg(manager_name, ',') within group(order by null), '') manager_name from (select s.sqs_id, s.notice_id, s.holder_id, s.holder_name, s.cost_type, s.amount_pay, s.amount_payed, s.zl_id, s.zl_create_state, s.zl_create_date, s.zl_create_way, s.sqs_pay_state, s.sqs_create_date, s.calculate_cycle, s.bizcategory, s.procategory, s.biz_type, s.biz_zdtm, s.receivablesid, s.remark, s.poolnumber, s.currency, s.file_address, s.created_at, (i2.yhmc) created_by, s.fee_project,</td>
