    <td class="xl66" x:str>select sch.CASHFLOW_ID cashflowId, (SELECT P.MANAGER_PROD FROM PRODUCT P WHERE P.PRODUCT_ID = sch.PRODUCT_ID AND P.EFFECTSTATUS = '1') managerProd, (SELECT P.PRODUCT_CODE FROM PRODUCT P WHERE P.PRODUCT_ID = sch.PRODUCT_ID AND P.EFFECTSTATUS = '1') productCode, sch.ACCOUNT_TYPE_ID accountTypeId, (SELECT AT.ACCOUNT_TYPE_NAME FROM ACCOUNT_TYPE AT WHERE AT.ACCOUNT_TYPE_ID = sch.ACCOUNT_TYPE_ID) accountTypeName, sch.CASHFLOW_AT cashflowAt, sch.CASHFLOW_TIME cashflowTime, decode(sch.direction,'0',nvl(ba.bank_account_id, sch.credit_account),sch.credit_account) creditAccount, decode(sch.direction,'0',nvl(ba.bank_account_name, sch.credit_account_name),sch.credit_account_name) creditAccountName, decode(sch.direction,'1',nvl(ba.bank_account_id, sch.debit_account),sch.debit_account) debitAccount, decode(sch.direction,'1',nvl(ba.bank_account_name, sch.debit_account_name),sch.debit_account_name) debitAccountName, sch.DIRECTION direction, sch.AMOUNT amount, sch.BALANCE_AFTER balanceAfter, sch.CURRENCY currency, (SELECT zydhb.zydh||'-'||zydhb.zymc FROM ZYDHB zydhb WHERE zydhb.effectstatus='1' AND zydhb.zydh = SUMMARY) summary, sch.MESSAGE message, sch.USE_INFO userInfo, sch.BANK_NO bankNo, sch.BANK_NAME bankName, (SELECT P.MANAGER_ID FROM PRODUCT P WHERE P.PRODUCT_ID = sch.PRODUCT_ID) managerId, sch.COUNTER_CASHFLOW counterCashflow, sch.REMARK xtsjc from settlement_cashflow_history sch left join bank_account ba on ba.account_type_id = 'MZH' and decode(sch.direction,'0',substr(sch.credit_account, 19),substr(sch.debit_account, 19)) = '999999' and decode(sch.direction,'0',substr(sch.credit_account, 0, 18),substr(sch.debit_account, 0, 18)) = ba.bank_account_id where</td>
