    <td class="xl66" x:str>SELECT CBA.BANK_ACCOUNT_ID AS &quot;accountId&quot; FROM CORE_BANK_ACCOUNT CBA INNER JOIN BANK_ACCOUNT BA ON CBA.BANK_ACCOUNT_ID = BA.BANK_ACCOUNT_ID WHERE LENGTH(CBA.BANK_ACCOUNT_ID) = 18 AND NOT EXISTS (SELECT 1 FROM ACCOUNT_PRODUCT AP, PRODUCT P, BANK_ACCOUNT BAT WHERE AP.PRODUCT_ID = P.PRODUCT_ID AND AP.EFFECTSTATUS = '1' AND AP.BANK_ACCOUNT_ID = BAT.BANK_ACCOUNT_ID AND NVL(P.SUB_GROUP_MARK, 1) = '1' AND BAT.DEDICATED = '0' AND AP.BANK_ACCOUNT_ID = CBA.BANK_ACCOUNT_ID) AND (BA.CREATED_AT BETWEEN trunc(SYSDATE) and trunc(SYSDATE + 1) - 1 / 86400 OR BA.VALIDATED_AT BETWEEN trunc(SYSDATE) and trunc(SYSDATE + 1) - 1 / 86400) AND NOT EXISTS (SELECT 1 FROM SUPPLY_LX_ACCOUNT SLA WHERE SLA.ACCOUNT_ID = CBA.BANK_ACCOUNT_ID AND SLA.PRODUCT_ID IS NULL) UNION SELECT CBA.BANK_ACCOUNT_ID AS &quot;accountId&quot; FROM CORE_BANK_ACCOUNT CBA INNER JOIN UNUSE_ACCT_INF BA ON CBA.BANK_ACCOUNT_ID = BA.BANK_ACCOUNT_ID WHERE LENGTH(CBA.BANK_ACCOUNT_ID) = 18 AND NOT EXISTS (SELECT 1 FROM ACCOUNT_PRODUCT AP, PRODUCT P, BANK_ACCOUNT BAT WHERE AP.PRODUCT_ID = P.PRODUCT_ID AND AP.EFFECTSTATUS = '1' AND AP.BANK_ACCOUNT_ID = BAT.BANK_ACCOUNT_ID AND NVL(P.SUB_GROUP_MARK, 1) = '1' AND BAT.DEDICATED = '0' AND AP.BANK_ACCOUNT_ID = CBA.BANK_ACCOUNT_ID) AND (BA.CREATED_AT BETWEEN trunc(SYSDATE) and trunc(SYSDATE + 1) - 1 / 86400) AND NOT EXISTS (SELECT 1 FROM SUPPLY_LX_ACCOUNT SLA WHERE SLA.ACCOUNT_ID = CBA.BANK_ACCOUNT_ID AND SLA.PRODUCT_ID IS NULL)</td>
