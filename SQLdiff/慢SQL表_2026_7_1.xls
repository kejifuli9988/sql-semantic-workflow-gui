   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>3</td>
    <td class="xl66" x:str>全链路监控</td>
    <td class="xl66" x:str>45b82da29c20f70c2a7f1480292c137c</td>
    <td class="xl66" x:str>insert into instruction_monitor (instruction_id,product_id,payment_type_id,action_status,payment_status,updated_at,payment_at,final_paymentstatus,data_type,direction,currency,credit_account,debit_account,is_emergency_payment, instruction_model,instruction_type,trade_type,use_id,role_id,user_subsidiary_organ,deal_org_no,out_org_no,amount,inter_bank,created_at) (select i.instruction_id, i.product_id, NVL((select instruction_param_value from instruction_ext where instruction_id = i.instruction_id and instruction_param_name = 'hsgzzllx'),i.payment_type_id) paymentTypeId, i.action_status, i.payment_status, NVL(i.updated_at,i.created_at), i.payment_at, i.final_paymentstatus, 'INSTRUCTION' DATA_TYPE, I.DIRECTION, I.CURRENCY, I.CREDIT_ACCOUNT, I.DEBIT_ACCOUNT, I.IS_EMERGENCY_PAYMENT, I.INSTRUCTION_MODEL, I.INSTRUCTION_TYPE, I.TRADE_TYPE, I.USE_ID, I.ROLE_ID, I.USER_SUBSIDIARY_ORGAN, I.DEAL_ORG_NO, I.OUT_ORG_NO, I.AMOUNT, I.INTER_BANK, I.CREATED_AT from instruction i where i.created_at between trunc(sysdate) and trunc(sysdate)+1-1/86400 and i.direction = '0' and i.trade_type = '1' and ((i.paymentway != '1'and i.action_status != '99') or (i.paymentway = '1' and i.p_instruction_id = '1')) and i.created_at &lt; (sysdate-15/60/60/24) )</td>
    <td class="xl66" x:str>242950</td>
    <td class="xl66" x:str>1</td>
    <td class="xl66" x:str>settlement-cronjob</td>
    <td class="xl67" x:str></td>
   </tr>
   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>4</td>
    <td class="xl66" x:str>全链路监控</td>
    <td class="xl66" x:str>56bb66cbe15369f4be69f2729263b0de</td>
    <td class="xl66" x:str>select count(*) from( WITH schistory as ( select sch.cashflow_id as CASHFLOW_ID, TO_CHAR(sch.cashflow_at, 'yyyy-MM-dd') as CASHFLOW_AT, sch.amount as amount, (select zydhb.zydh || '-' || zydhb.zymc from ZYDHB zydhb where zydhb.effectstatus = '1' and zydhb.zydh = sch.SUMMARY) as summary, sch.message as message, SCH.ACCOUNT_ID, ( select ba.BANK_ACCOUNT_NAME from bank_account ba where ba.bank_account_id = sch.account_id) as BANK_ACCOUNT_NAME, sch.product_id, sch.instruction_id, sch.COUNTER_CASHFLOW, sch.DIRECTION from settlement_cashflow_history sch where sch.cashflow_at between trunc(cast(? as timestamp)) and trunc(cast(? as timestamp)) and sch.instruction_id is null and sch.SUMMARY not in ('855', '850') and sch.COUNTER_CASHFLOW not like '9699%' and sch.DIRECTION = '0' ), bka as( select * from bankaccandunuseacc where ind_branchid IN ( ? ) ), CTE1 AS ( SELECT sch.cashflow_id AS CASHFLOW_ID, p.product_name AS PRODUCT_NAME, sch.cashflow_at AS CASHFLOW_AT, sch.amount AS amount, NVL(cm.OPD_CONFIRM_STATUS, 'WQR') AS opdConfirmStatus, cm.SIUATION_EXPLAIN AS SIUATION_EXPLAIN, TO_CHAR(cm.siuation_date, 'yyyy-MM-dd HH24:mi:ss') AS SIUATION_DATE, cm.OPD_BRANCH AS siuationBranch, (SELECT d.yhmc FROM ip_staff_stmt d WHERE cm.SIUATION_BY = d.yhbh) AS SIUATION_BY, NULL AS INTER_BANK, P.Ind_Branchid AS indBranchId, P.OPD_BRANCHID AS opdBranchId, (SELECT zydhb.zydh || '-' || zydhb.zymc FROM ZYDHB zydhb WHERE zydhb.effectstatus = '1' AND zydhb.zydh = sch.SUMMARY) AS summary, sch.message AS message, p.product_Id, SCH.ACCOUNT_ID, (SELECT ba.BANK_ACCOUNT_NAME FROM bank_account ba WHERE ba.bank_account_id = sch.account_id) AS BANK_ACCOUNT_NAME, DECODE(P.OPERATION_STATUS, '', '0', P.OPERATION_STATUS) AS OPERATION_STATUS FROM schistory sch LEFT JOIN product p ON sch.product_id = p.product_id LEFT JOIN CRITICAL_MONITOR_SIGN cm ON sch.CASHFLOW_ID = cm.RELATION_ID WHERE</td>
    <td class="xl66" x:str>194233</td>
    <td class="xl66" x:str>4</td>
    <td class="xl66" x:str>tgqs</td>
    <td class="xl67" x:str></td>
   </tr>
   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>5</td>
    <td class="xl66" x:str>全链路监控</td>
    <td class="xl66" x:str>d2c9988420b391a1741b4ec08c84b933</td>
    <td class="xl66" x:str>WITH base_instruction AS (SELECT z.instruction_id, CASE WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ13', 'TZZQ16')) THEN NVL((SELECT CASE WHEN rtgs.shch_stop_status = '1' THEN '9' ELSE rtgs.shch_draw_status END || '#@@#' || rtgs.shch_draw_status FROM RTGS_COLLECTION_RECORD_1 rtgs WHERE rtgs.instruction_id = z.instruction_id), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2', '6', '8') AND z.PAYMENT_TYPE_ID IN ('TZZQ12', 'TZZQ17')) THEN NVL((SELECT c.ccdc_draw_status FROM CCDC_COLLECTION_RECORD c WHERE c.instruction_id = z.instruction_id), '6') WHEN (z.SOURCE_ID IN ('0', '1', '2') AND z.PAYMENT_TYPE_ID IN ('JWZQ01', 'JWZQ02')) THEN z.direct_status WHEN (z.PAYMENT_TYPE_ID = 'TZCK10') THEN NVL((SELECT INSTRUCTION_PARAM_VALUE FROM instruction_ext_2022 WHERE instruction_id = z.instruction_id AND INSTRUCTION_PARAM_NAME = 'hqckWithDraw'), '') ELSE '' END AS shchDrawStatus, z.product_id, z.REALTIME_STATUS REALTIME_STATUS, z.use_id, z.payment_date, z.payment_at, z.successful_paid_at, z.payment_type_id, (SELECT pt.payment_type_name FROM payment_type pt WHERE pt.payment_type_id = z.payment_type_id) hkmc, z.direction, z.amount, z.source_id, z.payment_reason, z.debit_account, z.debit_account_name, z.credit_account, z.credit_account_name, z.bank_id, z.bank_name, z.db_status, z.ANO_SYS_STAT, z.batch, z.IPO_SUBSCRIBE, z.entrust, z.security_code, z.payment_mode, z.inter_bank, decode(z.final_paymentstatus, '3', '-1', z.final_paymentstatus) AS finalStatusOrder, z.final_paymentstatus, z.payment_status, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.updated_by) updatedbyname, z.updated_at, z.created_at, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_jbr) instr_jbr, (SELECT ip.yhmc FROM ip_staff_stmt ip WHERE ip.yhbh = z.instr_fhr) instr_fhr, z.fbank_id, z.fbank_name, z.fdqh, z.fjgh, z.sdqh, z.sjgh, z.post_route, z.INSTRUC_BATCH, (SELECT w.wfname FROM workflow w WHERE w.wfid = z.wfid) gzlmc, z.same_city, z.ZYZXRETFAXTIME, z.zyzxRetMsg, z.</td>
    <td class="xl66" x:str>182334</td>
    <td class="xl66" x:str>1</td>
    <td class="xl66" x:str>tgqs</td>
    <td class="xl67" x:str></td>
   </tr>
   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>6</td>
