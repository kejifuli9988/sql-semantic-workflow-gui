    <td class="xl66" x:str>select r.product_id, sum(r.rem_fee) REM_FEE, r.credit_account, xml_clob(xmlagg(xmlparse(content remfee_info_id||','))) as ids from remfee_info r where r.remfee_info_id in(SELECT para_value FROM TMP_PARAS WHERE para_name = ?) group by r.product_id,r.credit_account</td>
