    <td class="xl66" x:str>select count(distinct t.instruction_id) from ( select x.instruction_id from instruction x left join product p on x.product_id = p.product_id left join CRITICAL_MONITOR_SIGN cm on x.instruction_id = cm.RELATION_ID where 1 = 1 and cm.OPD_CONFIRM_STATUS IS NULL and x.product_id is not null and x.instruc_batch_flag in ('0', '-1') and (x.TRADE_TYPE = '1' or x.TRADE_TYPE is null) and p.OPD_BRANCHID in ( ? ) and x.PAYMENT_AT &gt;= trunc(cast(? as timestamp)) and x.PAYMENT_AT &lt; trunc(cast(? as timestamp)+ 1) and (x.PAYMENT_TYPE_ID in ( ? , ? ) ) and x.action_status not in ('2', '3') and (x.final_paymentstatus not in ('3','7') or x.final_paymentstatus is null) union all select x.instruction_id from instruction x left join CRITICAL_MONITOR_SIGN cm on x.instruction_id = cm.RELATION_ID inner join bank_account ba on ba.bank_account_id = decode(x.direction, '0', x.credit_account, '1', x.debit_account, '3', x.credit_account) inner join ( select aup.ind_branchid,aup.opd_branchid,aup.bank_account_id from (select a.bank_account_id, pro.ind_branchid as ind_branchid, pro.opd_branchid as opd_branchid, ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN from auxiliary_product a inner join product pro on pro.product_id = a.product_id where a.effectstatus = '1' ) aup where aup.rown = 1 ) ap on ap.bank_account_id = ba.bank_account_id where 1 = 1 and ap.OPD_BRANCHID IN ( ? ) and cm.OPD_CONFIRM_STATUS IS NULL and x.product_id is null and x.instruc_batch_flag in ('0', '-1') and (x.TRADE_TYPE = '1' or x.TRADE_TYPE is null) and ba.account_attribute = '1' and ba.effectstatus != '2' and (x.instruction_model='1' or x.instru</td>
