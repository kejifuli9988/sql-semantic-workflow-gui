    <td class="xl66" x:str>select count(bond_code) from ( select z.bond_code from csbs_bond_info z where z.instr_pkid in( select tu.pk_id from ( select t.pk_id,t.tran_id from csbs_instruction_origin t where 1=1 union all select t.pk_id,t.src_trade_id tran_id from shch_instruction_origin t where 1=1 ) tu ) and z.bond_type='1' )</td>
