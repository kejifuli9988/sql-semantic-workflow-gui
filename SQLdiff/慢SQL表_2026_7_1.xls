    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( WITH UnuseAccountFilter AS ( SELECT DISTINCT P2.PRODUCT_ID FROM UNUSE_ACCT_INF UA JOIN ACCOUNT_PRODUCT AP2 ON UA.BANK_ACCOUNT_ID = AP2.BANK_ACCOUNT_ID JOIN PRODUCT P2 ON AP2.PRODUCT_ID = P2.PRODUCT_ID WHERE UA.EFFECTSTATUS = '1' AND P2.SUB_GROUP_MARK = '0' ) SELECT T.BALANCE_ID, T.PRODUCT_ID, T.PRODUCT_CODE, T.MANAGER_PROD, T.PRODUCT_NAME, T.ACCOUNT_ID, T.ACCOUNT_NAME, T.ACCOUNT_TYPE_ID, T.ACCOUNT_TYPE_NAME, T.BALANCE_DATE, T.AMOUNT, T.CURRENCY, T.CREATED_AT, T.CREATED_BY, T.CREATED_NAME, T.UPDATED_AT, T.UPDATED_BY, T.UPDATED_NAME, T.USABLE_BALANCE, T.CONTROL_BALANCE, T.FREEZE_BALANCE, T.ACCOUNT_SUB_SN FROM ( SELECT BH.BALANCE_HISTORY_ID BALANCE_ID, BH.PRODUCT_ID, BH.ACCOUNT_ID, BH.ACCOUNT_TYPE_ID, BH.BALANCE_DATE, BH.AMOUNT, BH.CREATED_AT, BH.CREATED_BY, BH.UPDATED_AT, BH.UPDATED_BY, BH.USABLE_BALANCE, BH.CONTROL_BALANCE, BH.FREEZE_BALANCE, AP.ACCOUNT_SUB_SN AS ACCOUNT_SUB_SN, P.PRODUCT_CODE AS PRODUCT_CODE, P.MANAGER_PROD AS MANAGER_PROD, P.PRODUCT_NAME AS PRODUCT_NAME, BA2.BANK_ACCOUNT_NAME AS ACCOUNT_NAME, ACT.ACCOUNT_TYPE_NAME AS ACCOUNT_TYPE_NAME, BA2.CURRENCY AS CURRENCY, (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.CREATED_BY) AS CREATED_NAME, (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = BH.UPDATED_BY) AS UPDATED_NAME FROM BALANCE_HISTORY BH LEFT JOIN ACCOUNT_PRODUCT AP ON AP.BANK_ACCOUNT_ID = BH.ACCOUNT_ID AND AP.PRODUCT_ID = BH.PRODUCT_ID AND AP.EFFECTSTATUS = '1' LEF</td>
