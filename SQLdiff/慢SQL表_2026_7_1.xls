    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( with base_chzqhs_trade_ext as( select e.trade_id,ch.resale_reg_beg_at,ch.resale_reg_end_at from chzqhs ch left join trade_ext e on ch.security_code = e.param_value where 1=1 and e.param_name = 'ZQDM' and to_date(ch.resale_reg_end_at, 'yyyy-MM-dd') &gt;= cast(? as timestamp) and to_date(ch.resale_reg_end_at, 'yyyy-MM-dd') &lt;= cast(? as timestamp) ) select tt.trade_id as id, p.product_name as productName, to_char(tt.payment_at,'yyyy-MM-dd')as paymentAt, tt.amount as amount, tt.contract_status as proSettlementStatus, tt.realtime_Status as instrStatus, tt.core_message as abnormalReason, nvl(cm.OPD_CONFIRM_STATUS,'WQR') as opdConfirmStatus, cm.SIUATION_EXPLAIN as siuationExplain, to_char(cm.siuation_date,'yyyy-MM-dd HH24:mi:ss') as siuationDate, cm.OPD_BRANCH as siuationBranch, (select d.yhmc from ip_staff_stmt d where cm.SIUATION_BY= d.yhbh) as siuationBy, (select d.jgmc from ip_unit_stmt d where p.ind_branchid = d.zj) as indBranch, p.opd_branchid as opdBranchId, (select g.jgmc from ip_unit_stmt g where p.opd_branchid = g.zj) as opdBranch, tt.instructid as instrucId from trade_base tt left join product p on tt.product_id = p.product_id left join CRITICAL_MONITOR_SIGN cm on tt.trade_id = cm.RELATION_ID where tt.action_status not in ('2','3') and ( (( (tt.TRAN_TYPE in ('SQHS', 'ZZHS') and tt.final_paymentstatus &lt;&gt; '3' and (tt.CONTRACT_STATUS &lt;&gt; 'CS00' or tt.CONTRACT_STATUS is null)) or (tt.TRAN_TYPE in ('ZZYQFS','ZZHQ','ZTGJYSZZZ','CDTQZQ','ZQZWQHBZJ','SQHQ','SQYQFS') and (tt.CONTRACT_STATUS &lt;&gt; 'CS00' or tt.CONTRACT_STATUS is null )) or(tt.TRAN_TYPE in ('ZTGZZZJYS','SQXJYY','ZZXJYY','ZZXYCKZY') and (tt.jyzt &lt;&gt;'3' or tt.jyzt is null) ) ) and tt.payment_at between trunc(cast(? as timestamp)) and trunc(cast(? as timestamp))) or ((tt.CONTRACT_STATUS &lt;&gt; 'CS00' or tt.contract_status is null) and exists (select</td>
