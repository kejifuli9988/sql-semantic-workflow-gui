    <td class="xl66" x:str>select z.FAX_INSTRUCTION_ID,z.INSTRUCTION_ID,z.FAX_ID,z.PRODUCT_CODE,z.PAYMENT_DATE,z.PAYMENT_TYPE_ID,z.DIRECTION,z.AMOUNT,z.CURRENCY,z.PAYMENT_REASON,z.CREDIT_ACCOUNT,z.CREDIT_ACCOUNT_NAME,z.DEBIT_ACCOUNT,z.DEBIT_ACCOUNT_NAME,z.BANK_ID,z.BANK_NAME,z.sfqd, z.FILE_PATH,z.CREATED_AT,z.CREATED_BY,z.UPDATED_AT,z.UPDATED_BY,z.RESULT_STATUS,z.PUSH_STATUS,z.PUSH_AT,z.MANAGER_ID,z.MANAGER_NAME,z.RESULT_TYPE,AUDIT_COMMENT,z.TGT_QDZLBH,nvl(z.BUSINESS_TYPE,'0') BUSINESS_TYPE, (select a.yhmc from ip_staff a where z.CREATED_BY=a.yhbh) as createdByName, (select b.yhmc from ip_staff b where z.UPDATED_BY=b.yhbh) as updatedByName, (SELECT p.product_name FROM product p WHERE p.PRODUCT_CODE=z.PRODUCT_CODE order by p.created_at desc fetch first 1 rows only) as PRODUCT_NAME, NVL((SELECT psi.SYSTEM_FLAG FROM product p,prod_switch_info psi WHERE p.product_id = psi.product_id(+) and p.PRODUCT_CODE=z.PRODUCT_CODE order by p.created_at desc fetch first 1 rows only),'1') as systemFlag, z.ZLLY, (SELECT i.INSTRUC_BATCH FROM instruction i WHERE i.instruction_id = z.instruction_id) as INSTRUC_BATCH from FAX_INSTRUCTION z where 1=1 and INSTRUCTION_ID like '%' || ? || '%' order by RESULT_STATUS asc,PUSH_AT desc</td>
