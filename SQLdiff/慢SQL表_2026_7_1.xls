    <td class="xl66" x:str>SELECT T.ACCOUNT_ID AS &quot;accountId&quot;, T.PRODUCT_ID AS &quot;productId&quot;, T.CASHFLOW_AT AS &quot;cashflowAt&quot; FROM ( SELECT CCA.ACCOUNT_ID, CCA.PRODUCT_ID, CCA.CASHFLOW_AT FROM CORE_CASHFLOW_ACCOUNT CCA WHERE CCA.CASHFLOW_AT BETWEEN ? AND ? AND CCA.BALANCE_FLAG = '3' AND EXISTS ( SELECT 1 FROM DUAL WHERE 1=1 AND CCA.PRODUCT_ID = ? AND CCA.ACCOUNT_ID = ? ) ) T ORDER BY T.CASHFLOW_AT, T.PRODUCT_ID, T.ACCOUNT_ID</td>
