    <td class="xl66" x:str>WITH remfeeInfoAll AS ( select p.product_id productId, ri.CREDIT_ACCOUNT bankAccountId, SUM(ri.REM_FEE) amount, COUNT(1) remfeeInfoAllNum from remfee_info ri,product p where p.product_id = ri.product_Id and p.MANAGER_ID = ? and ri.SOURCE_PAY_STATUS = '3' AND ri.SOURCE_INSTRUCT_DATE &gt;= TO_DATE(?,'yyyyMMdd') AND ri.SOURCE_INSTRUCT_DATE &lt; TO_DATE(?,'yyyyMMdd')+1 AND EXISTS ( SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND p.PRODUCT_CODE = ?</td>
