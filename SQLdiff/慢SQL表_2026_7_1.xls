    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select PK_ID,PRODUCT_MATURITY_ID,PRODUCT_ID, (select p.product_name from product p where p.product_id=z.product_id ) PRODUCT_NAME, PRODUCT_STATUS,SEAT_STATUS,BANK_ACCOUNT_STATUS,SECURITY_ACCOUNT_STATUS,CSDS_ACCOUNT_STATUS,OTHER_ACCOUNT_STATUS,EFFECTSTATUS,OP_TYPE,FOUREYESSTATUS,AUDIT_COMMENT,CREATED_AT,CREATED_BY,UPDATED_AT,UPDATED_BY,VALIDATED_AT,VALIDATED_BY,CREATED_CI,BANK_ACCOUNT_CANCEL, (select a.yhmc from ip_staff a where z.CREATED_BY=a.yhbh) as createdByName, (select b.yhmc from ip_staff b where z.UPDATED_BY=b.yhbh) as updatedByName, (select c.yhmc from ip_staff c where z.VALIDATED_BY=c.yhbh) as validatedByName, z.RECEIPT_FLAG from PRODUCT_MATURITY_CI z where z.created_CI = (SELECT max(zz.created_Ci) FROM PRODUCT_MATURITY_CI zz where zz.PRODUCT_MATURITY_ID = z.PRODUCT_MATURITY_ID) and instr(right_check(z.product_id, ?, 'A'), '4') &gt; 0 and exists (select 1 from product p where p.product_id = z.PRODUCT_ID and p.PRODUCT_NAME like '%'||?||'%') order by CREATED_CI desc ) row_ ) where rownum_ &gt; 0 and rownum_ &lt;= 10</td>
