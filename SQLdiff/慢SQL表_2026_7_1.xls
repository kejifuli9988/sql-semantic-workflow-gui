    <td class="xl66" x:str>SELECT COUNT(1) FROM (SELECT JS.PK_ID AS PKID FROM JSMX JS LEFT JOIN SECURITY_ACCOUNT SA ON (JS.ZQZH = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1') LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JS.PK_ID = CM.RELATION_ID WHERE JS.JYFS != '106' AND JS.JSFS = '002' and js.filename not like 'jsmx03%' AND JS.JSRQ &gt;= TO_CHAR(cast(? as timestamp), 'yyyyMMdd') AND JS.JSRQ &lt; TO_CHAR(cast(? as timestamp) + 1, 'yyyyMMdd') AND CM.OPD_CONFIRM_STATUS IS NULL UNION ALL SELECT JSZ.PK_ID AS PKID FROM SJSMX JSZ LEFT JOIN SECURITY_ACCOUNT SA ON (TRIM(JSZ.MXZQZH) = SA.ACCOUNT_CODE AND SA.EFFECTSTATUS = '1') LEFT JOIN CRITICAL_MONITOR_SIGN CM ON JSZ.PK_ID = CM.RELATION_ID WHERE JSZ.MXJSFS = 'N' AND JSZ.MXJSRQ &gt;= TO_CHAR(cast(? as timestamp), 'yyyyMMdd') AND JSZ.MXJSRQ &lt; TO_CHAR(cast(? as timestamp)+ 1, 'yyyyMMdd') and jsz.filename not like 'SJSMX2%' AND CM.OPD_CONFIRM_STATUS IS NULL )</td>
