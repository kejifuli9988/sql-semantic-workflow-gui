    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select accountId, accountName, accountTypeId, accountTypeName, sameCity, interBank, bankId, bankName from (select z.ACCOUNT_ID as accountId, z.ACCOUNT_NAME as accountName, z.ACCOUNT_TYPE_ID as accountTypeId, a.account_type_name as accountTypeName, z.SAME_CITY as sameCity, z.INTER_BANK as interBank, z.BANK_ID as bankId, z.BANK_NAME as bankName from COUNTERPARTY_ACCOUNT z,USER_INFO_BRANCH d,account_type a where z.branchid=d.branchid and z.effectstatus in ( ? ) and d.effectstatus = '1' and a.effectstatus = '1' and a.account_type_id = z.account_type_id and d.userid = ? union select ca.CSDS_ACCOUNT_ID as accountId, ca.account_name as accountName, ca.account_type_id as accountTypeId, aty.account_type_name as accountTypeName, '' as sameCity, '' as interBank, '' as bankId, '' as bankName from csds_account ca, account_type aty where ca.effectstatus in ( ? ) and aty.effectstatus = '1' and aty.account_type_id = ca.account_type_id and ca.CSDS_ACCOUNT_ID in (select cap.CSDS_ACCOUNT_ID from csds_account_product cap where cap.PRODUCT_ID = ?) ) order by accountId,accountTypeId ) row_ ) where rownum_ &gt; 0 and rownum_ &lt;= 10</td>
