    <td class="xl66" x:str>select PK_ID1, DEAL_ID, INSTR_ID, BUSINESS_ID, PRODUCT_ID, PRODUCT_NAME, MANAGER_ID, MANAGER_NAME, OPD_BRANCH_ID, ACCOUNT_ID, ACCOUNT_NAME, ACCOUNT_TYPE, COUNTER_ACCOUNT_ID, COUNTER_ACCOUNT_NAME, BUSINESS_TYPE, INSTR_STATUS, COUNTER_STATUS, OUR_STATUS, OP_TYPE, NOTE_FLAG, AUTOCONFIRM_FLAG, NOTE_ID, RECORD_STATUS, FOUREYESSTATUS, AUDIT_COMMENT,BOND_COUNT,DELIVER_DATE1,DELIVER_DATE2, CREATED_AT, CREATED_BY, UPDATED_AT, UPDATED_BY, VALIDATED_AT, VALIDATED_BY ,MARKET_TYPE, INIT_SETTLE_AMOUNT, DUE_SETTLE_AMOUNT ,SUPERVISION_SIGN,SUPERVISION_OPINION,BANK_ACCOUNT_ID from CSBS_INSTRUCTION a where ((a.OUR_STATUS = 'IC02' and a.account_type = '1') or (a.counter_status = 'IC02' and a.account_type = '2')) and a.RECORD_STATUS = '0' and a.NOTE_FLAG = '0' and a.AUTOCONFIRM_FLAG = '0' and a.instr_status ='IS03' and a.market_type='0' and (a.DELIVER_DATE1 &gt;= to_char(sysdate, 'yyyyMMdd') or trunc(a.CREATED_AT) &gt;= trunc(sysdate)) and not exists( select 1 from csbs_instr_config where (account_no=account_id or account_no=counter_account_id) and market=market_type)</td>
