    <td class="xl66" x:str>SELECT T.BALANCE_ID, T.PRODUCT_ID, (SELECT P.PRODUCT_CODE FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) PRODUCT_CODE, (SELECT P.MANAGER_PROD FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) MANAGER_PROD, (SELECT P.PRODUCT_NAME FROM PRODUCT P WHERE P.PRODUCT_ID = T.PRODUCT_ID) PRODUCT_NAME, T.ACCOUNT_ID, (SELECT BA.BANK_ACCOUNT_NAME FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = T.ACCOUNT_ID AND BA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID UNION SELECT CA.ACCOUNT_NAME FROM CSDS_ACCOUNT CA WHERE CA.CSDS_ACCOUNT_ID = T.ACCOUNT_ID AND CA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID UNION SELECT SA.ACCOUNT_NAME FROM SECURITY_ACCOUNT SA where SA.ACCOUNT_CODE = T.ACCOUNT_ID AND SA.EFFECTSTATUS = '1' AND SA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) ACCOUNT_NAME, T.ACCOUNT_TYPE_ID, (select ACT.ACCOUNT_TYPE_NAME from ACCOUNT_TYPE ACT where ACT.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) ACCOUNT_TYPE_NAME, T.BALANCE_DATE, T.AMOUNT, (SELECT BA.CURRENCY FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = T.ACCOUNT_ID AND BA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID UNION SELECT CA.CURRENCY FROM CSDS_ACCOUNT CA WHERE CA.CSDS_ACCOUNT_ID = T.ACCOUNT_ID AND CA.ACCOUNT_TYPE_ID = T.ACCOUNT_TYPE_ID) CURRENCY, T.CREATED_AT, T.CREATED_BY, (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = T.CREATED_BY) CREATED_NAME, T.UPDATED_AT, T.UPDATED_BY, (SELECT IPS.YHMC FROM IP_STAFF IPS WHERE IPS.YHBH = T.UPDATED_BY) UPDATED_NAME, USABLE_BALANCE, CONTROL_BALANCE, FREEZE_BALANCE, ACCOUNT_SUB_SN FROM (SELECT BH.BALANCE_HISTORY_ID BALANCE_ID, BH.PRODUCT_ID, BH.ACCOUNT_ID, BH.ACCOUNT_TYPE_ID, BH.BALANCE_DATE, BH.AMOUNT, BH.CREATED_AT, BH.CREATED_BY, BH.UPDATED_AT,</td>
