    <td class="xl66" x:str>84e6d7936b542d98cd489e86198e56ec</td>
    <td class="xl66" x:str>select distinct i.instruction_id, i.payment_type_id from instruction i,instruction_ext ie where trunc(i.payment_at) = trunc(sysdate) and i.payment_type_id = 'QSCNDB' and i.payment_status = '3' and ((ie.instruction_param_name = 'informBroker' and ie.instruction_param_value = '4') or (ie.instruction_param_name = 'informManager' and ie.instruction_param_value = '4')) and exists(select 1 from instruction a,instruction_ext b where b.instruction_param_name = 'jxFlag' and b.instruction_param_value = '1' and a.instruction_id = b.instruction_id and i.instruction_id = a.instruction_id) and not exists(select 1 from instruction a,instruction_ext b where b.instruction_param_name = 'informWay' and b.instruction_param_value = '1' and a.instruction_id = b.instruction_id and i.instruction_id = a.instruction_id) and i.payment_mode = '1' and (discard_flag != '1' or discard_flag is null) and i.instruction_id = ie.instruction_id union all select t.trade_id instruction_id, t.tran_type payment_type_id from trade_base t where t.tran_type in ('CNTCTJ','CNTCTZ') and trade_date = trunc(sysdate) and inform_broker_status = '4' and (discard_flag != '1' or discard_flag is null) and t.inform_way = '0' union all select t.trade_id instruction_id, t.tran_type payment_type_id from trade_base t where t.tran_type in ('CNTCTJ','CNTCTZ') and trade_date = trunc(sysdate) and inform_manager_status = '4' and t.inform_way = '0'</td>
