    <td class="xl66" x:str>INSERT INTO BALANCE_HISTORY (BALANCE_HISTORY_ID, PRODUCT_ID, ACCOUNT_ID, ACCOUNT_TYPE_ID, BALANCE_DATE, AMOUNT, CREATED_AT, CREATED_BY, UPDATED_AT, UPDATED_BY) SELECT B.BALANCE_ID, B.PRODUCT_ID, B.ACCOUNT_ID, B.ACCOUNT_TYPE_ID, ?, B.AMOUNT, B.CREATED_AT, B.CREATED_BY, sysdate, B.UPDATED_BY FROM BALANCE B WHERE B.BALANCE_DATE = ? AND B.ACCOUNT_TYPE_ID = ?</td>
