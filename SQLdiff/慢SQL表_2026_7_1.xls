    <td class="xl66" x:str>SELECT ramt.payment_date, ramt.olramt, pamt.olpamt FROM (SELECT ins.payment_date, nvl(sum(amount), 0) olramt FROM instruction ins WHERE ins.trade_type = '0' AND ins.payment_type_id != 'QSCNDB' AND ins.action_status &lt;&gt; '3' AND ('CNQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.DEBIT_ACCOUNT) OR 'RQFIIQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.DEBIT_ACCOUNT)) AND ins.payment_date = to_date(?, 'yyyy/MM/dd') GROUP BY ins.payment_date) ramt FULL JOIN (SELECT ins.payment_date, nvl(sum(amount), 0) olpamt FROM instruction ins WHERE ins.trade_type = '0' AND ins.payment_type_id != 'QSCNDB' AND ins.action_status &lt;&gt; '3' AND ('CNQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.CREDIT_ACCOUNT) OR 'RQFIIQSFZH' IN (SELECT ACCOUNT_TYPE_ID FROM BANK_ACCOUNT WHERE bank_account_id = ins.CREDIT_ACCOUNT)) AND ins.payment_date = to_date(?, 'yyyy/MM/dd') GROUP BY ins.payment_date) pamt ON ramt.payment_date = pamt.payment_date</td>
