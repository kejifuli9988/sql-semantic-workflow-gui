    <td class="xl66" x:str>begin update INSTRUCTION_INFOEM SET INSTRUCTION_ID = ?, INSTRUCTION_STATUS = ?, REALTIME_STATUS = ?, SEND_PLAT = trunc(?), INFORM_AT = ?, PUSH_ZLPT = ?, PUSH_TYMH = ?, PUSH_TGT = ?, PAYMENT_STATUS = ? where INSTRUCTION_ID = ? ; update INSTRUCTION_INFOEM SET INSTRUCTION_ID = ?, INSTRUCTION_STATUS = ?, REALTIME_STATUS = ?, SEND_PLAT = trunc(?), MANAGER_ID = ?, INFORM_AT = ?, PUSH_ZLPT = ?, PUSH_TYMH = ?, PUSH_TGT = ?, PAYMENT_STATUS = ? where INSTRUCTION_ID = ? ; update INSTRUCTION_INFOEM SET INSTRUCTION_ID = ?, INSTRUCTION_STATUS = ?, REALTIME_STATUS = ?, SEND_PLAT = trunc(?), MANAGER_ID = ?, INFORM_AT = ?, PUSH_ZLPT = ?, PUSH_TYMH = ?, PUSH_TGT = ?, PAYMENT_STATUS = ? where INSTRUCTION_ID = ? ; update INSTRUCTION_INFOEM SET INSTRUCTION_ID = ?, INSTRUCTION_STATUS = ?, REALTIME_STATUS = ?, SEND_PLAT = trunc(?), MANAGER_ID = ?, INFORM_AT = ?, PUSH_ZLPT = ?, PUSH_TYMH = ?, PUSH_TGT = ?, PAYMENT_STATUS = ? where INSTRUCTION_ID = ? ; update INSTRUCTION_INFOEM SET INSTRUCTION_ID = ?, INSTRUCTION_STATUS = ?, REALTIME_STATUS = ?, SEND_PLAT = trunc(?), MANAGER_ID = ?, INFORM_AT = ?, PUSH_ZLPT = ?, PUSH_TYMH = ?, PUSH_TGT = ?, PAYMENT_STATUS = ? where INSTRUCTION_ID = ? ; update INSTRUCTION_INFOEM SET INSTRUCTION_ID = ?, INSTRUCTION_STATUS = ?, REALTIME_STATUS = ?, SEND_PLAT = trunc(?), MANAGER_ID = ?, INFORM_AT = ?, PUSH_ZLPT = ?, PUSH_TYMH = ?, PUSH_TGT = ?, PAYMENT_STATUS = ? where INSTRUCTION_ID = ? ; update INSTRUCTION_INFOEM SET INSTRUCTION_ID = ?, INSTRUCTION_STATUS = ?,</td>
