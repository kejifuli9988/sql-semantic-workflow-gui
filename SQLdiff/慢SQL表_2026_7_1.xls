    <td class="xl66" x:str>merge into SHCH_SUMMARY_STATEMENT cs using ( select ? pkId, ? createDate, ? productId, ? productName, ? bondId, ? bondShortName, ? productCategory, ? productType, ? accountNo, ? accountName, ? opdBranchId, ? subjectCode, ? totalAmount, ? usageSubject, ? forpaySubject, ? pledgeSubject, ? fullToRepurchaseAmount, ? netToRepurchaseAmount, ? blockSubject, ? issueAmount, ? toPerformAmount, ? corpusPayAmount, ? interestPayAmount, ? memberId, ? positionStr, ? holdAccount, ? updateDate, ? createdAt, ? createdBy, ? updateAt, ? updateBy, ? bankAccountId from dual union all select ? pkId, ? createDate, ? productId, ? productName, ? bondId, ? bondShortName, ? productCategory, ? productType, ? accountNo, ? accountName, ? opdBranchId, ? subjectCode, ? totalAmount, ? usageSubject, ? forpaySubject, ? pledgeSubject, ? fullToRepurchaseAmount, ? netToRepurchaseAmount, ? blockSubject, ? issueAmount, ? toPerformAmount, ? corpusPayAmount, ? interestPayAmount, ? memberId, ? positionStr, ? holdAccount, ? updateDate, ? createdAt, ? createdBy, ? updateAt, ? updateBy, ? bankAccountId from dual union all select ? pkId, ? createDate, ? productId, ? productName, ? bondId, ? bondShortName, ? productCategory, ? productType, ? accountNo, ? accountName, ? opdBranchId, ? subjectCode, ? totalAmount, ? usageSubject, ? forpaySubject, ? pledgeSubject, ? fullToRepurchaseAmount, ? netToRepurchaseAmount, ? blockSubject, ? issueAmount, ? toPerformAmount, ? corpusPayAmount, ? interestPayAmount, ? memberId, ? positionStr, ? holdAccount, ? updateDate, ? createdAt, ? createdBy, ? updateAt, ? updateBy, ? bankAccountId from dual union all select ? pkId, ? createDate, ? productId, ? productName, ? bondId, ? bondShortName, ? productCategory, ? productType, ? accountNo, ? accou</td>
