    <td class="xl66" x:str>INSERT INTO CSDS_DAYEND_DETAIL (DETAIL_ID, DAYEND_DATE, DATA_SOURCE, INSTRUCTION_SOURCE, INSTRUCTION_ID, PAYMENT_DATE, PAYMENT_TYPE_ID, PRODUCT_ID, DIRECTION, AMOUNT, CREDIT_ACCOUNT, DEBIT_ACCOUNT, CHECK_RESULT, REMARK, CLEAR_TYPE) SELECT 'PUBK' || to_char(SYSDATE, 'yyyyMMdd') || LPAD(PUBK_SEQ.NEXTVAL, 8, '0'), trunc(cast(? AS timestamp)), '1', '3', TEMP.INSTRUCTION_ID, TEMP.PAYMENT_DATE, TEMP.PAYMENT_TYPE_ID, TEMP.PRODUCT_ID, TEMP.DIRECTION, TEMP.AMOUNT, TEMP.CREDIT_ACCOUNT, TEMP.DEBIT_ACCOUNT, '0', TEMP.REMARK, ? FROM ((SELECT SUB.SUB_ID INSTRUCTION_ID, SUB.INSTRUCTION_AT PAYMENT_DATE, SUB.PAYMENT_TYPE_ID PAYMENT_TYPE_ID, SUB.PRODUCT_ID PRODUCT_ID, SUB.DIRECTION DIRECTION, SUB.AMOUNT AMOUNT, SUB.CREDIT_ACCOUNT CREDIT_ACCOUNT, SUB.DEBIT_ACCOUNT DEBIT_ACCOUNT, '担保一级明细' REMARK FROM INSTRUCTION_SUB SUB, INSTRUCTION INS WHERE SUB.INSTRUCTION_ID = INS.INSTRUCTION_ID AND INS.PAYMENT_DATE = trunc(cast(? AS timestamp)) AND INS.TRADE_TYPE = '0' AND (INS.PRODUCT_ID IS NULL OR EXISTS (SELECT 1 FROM ETF_PAYMENTTYPE_MAP EPM WHERE INS.PAYMENT_TYPE_ID = EPM.MAIN_PAYMENTTYPE_ID AND EPM.MAP_TYPE = '1')) AND INS.SOURCE_ID = '3' AND NOT EXISTS (SELECT 1 FROM DUAL WHERE SUB.DEBIT_ACCT_TYPE_ID IN ('CNQSFZH', 'RQFIIQSFZH') AND SUB.PAYMENT_TYPE_ID = 'QSCN_T1_FDB_SZ_ETFSK_T1') AND NOT EXISTS (SELECT 1 FROM GGT_INSTRUCTION_SUB isb WHERE isb.SUB_ID = SUB.SUB_ID) AND INS.PAYMENT_TYPE_ID NOT IN ('SHZJTK', 'SZZJTK') AND INS.CSDS_BUSINESS_TYPE IN ('qsk', 'jx', 'ggt', 'zrt') UNION ALL SELECT SUB.SUB_ID INSTRUCTION_ID, SUB.INSTRUCTION_AT PAYMENT_DATE, SUB.PAYMENT_TYPE_ID PAYMENT_TYPE_ID, SUB.PRODUCT_ID PRODUCT_ID, SUB.DIRECTION DIRECTION, SUB.AMOUNT AMOUNT, SUB.CREDIT_ACCOUNT CREDIT_ACCOUNT, SUB.DEBIT_ACCOUNT DEBIT_ACCOUNT, '担保一级明细' REMARK FROM GGT_INSTRUCTION_SUB SUB, INSTRUCTION INS WHERE SUB.INSTRUCTION_ID = INS.INSTRUCTION_ID AND INS.PAYMENT_DATE = trunc(cast(? AS timestamp)) AND INS.TRADE_TYPE = '0' AND INS.CSDS_BUSINESS_TYPE IN ('qsk', 'jx', 'ggt', 'zrt') AND INS.PRODUCT_ID IS NULL AND INS.</td>
