    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( WITH A AS ( SELECT T.PRODUCT_ID, T.FIRST_UNPAID_DATE, T.SETTLEMENT_DATE, (CASE WHEN T.SETTLEMENT_TYPE IS NOT NULL THEN '0' ELSE '1' END) AS RETURNED_MONEY_STATUS, T.SETTLEMENT_TYPE, T.RETURNED_AMOUNT, TA.UNPAID_TRUSTFEE_AMOUNT, TA.IS_LONG_TERM_DUN, TA.report_id, TRUNC(CAST(? AS TIMESTAMP)) AS START_DATE, TRUNC(CAST(? AS TIMESTAMP)) AS END_DATE, (CASE WHEN TA.IS_LONG_TERM_DUN = '1' THEN NULL WHEN (SELECT 0 FROM DUAL WHERE EXISTS(SELECT * FROM trustfee_arrears_detail_report WHERE T.PK_ID = REPORT_ID AND IS_LONG_TERM_DUN = '0' ) ) = 0 AND T.TRANSFER_DATE &gt;= TRUNC(CAST(? AS TIMESTAMP)) THEN '本期转入长期催收登记簿' ELSE '以往期间转入长期催收登记簿' END ) AS longterm_Flag FROM trustfee_arrears_report T LEFT JOIN ( SELECT * FROM TRUSTFEE_ARREARS_DETAIL_REPORT WHERE PK_ID IN ( SELECT pk_id FROM ( SELECT pk_id, report_id, BUSINESS_DATE, IS_LONG_TERM_DUN, UNPAID_TRUSTFEE_AMOUNT, ROW_NUMBER() OVER (PARTITION BY report_Id ORDER BY BUSINESS_DATE DESC) AS rn FROM trustfee_arrears_detail_report ) WHERE rn = 1 ) ) TA ON T.PK_ID = TA.REPORT_ID WHERE T.first_unpaid_date &lt;= TRUNC(CAST(? AS TIMESTAMP)) UNION ALL SELECT T.PRODUCT_ID, T.FIRST_UNPAID_DATE, T.SETTLEMENT_DATE, '0' AS RETURNED_MONEY_STATUS, T.SETTLEMENT_TYPE, T.RETURNED_AMOUNT, TA.UNPAID_TRUSTFEE_AMOUNT, TA.IS_LONG_TERM_DUN, TA.report_id, TRUNC(CAST(? AS TIMESTAMP)) AS START_DATE, TRUNC(CAST(? AS TIMESTAMP)) AS END_DATE, (CASE WHEN TA.IS_LONG_TERM_DUN = '1' THEN NULL WHEN (SELECT 0 FROM DUAL WHERE EXISTS(SELECT * FROM trustfee_arrears_detail_report WHERE T.PK_ID = REPORT_ID AND IS_LONG_TERM_DUN = '0' ) ) = 0 AND T.TRANSFER_DATE &gt;= TRUNC</td>
