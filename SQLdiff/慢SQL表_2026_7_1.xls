    <td class="xl66" x:str>SELECT sc.cashflow_id, sc.product_id, sc.account_id, sc.account_type_id, sc.cashflow_at, sc.cashflow_time, sc.counter_cashflow, sc.credit_account, sc.credit_account_name, sc.debit_account, sc.debit_account_name, sc.direction, sc.amount, sc.balance_before, sc.balance_after, sc.currency, sc.transaction_code, sc.summary, sc.message, sc.remark, nvl(sc.updated_at, sc.created_at) updated_at, sc.use_info FROM SETTLEMENT_CASHFLOW SC INNER JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON SC.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID AND SC.CASHFLOW_AT = TO_DATE(SAWD.WORKING_DATE,'yyyyMMdd') INNER JOIN BANK_ACCOUNT BA ON SC.ACCOUNT_ID = BA.BANK_ACCOUNT_ID WHERE SC.CASHFLOW_AT BETWEEN CAST( ? AS TIMESTAMP) AND CAST( ? AS TIMESTAMP) AND SC.SUMMARY = '591' AND BA.DEDICATED = '0' AND NOT EXISTS (SELECT 1 FROM CORE_CASHFLOW_RETURN R WHERE SC.ACCOUNT_ID = R.ACCOUNT_ID AND SC.CASHFLOW_AT = R.CASHFLOW_AT AND SC.CASHFLOW_TIME = R.CASHFLOW_TIME AND SC.DIRECTION = R.DIRECTION AND SC.AMOUNT = R.AMOUNT AND SC.COUNTER_CASHFLOW = R.COUNTER_CASHFLOW AND (SC.CREDIT_ACCOUNT = R.CREDIT_ACCOUNT OR (SC.CREDIT_ACCOUNT IS NULL AND R.CREDIT_ACCOUNT IS NULL)) AND (SC.DEBIT_ACCOUNT = R.DEBIT_ACCOUNT OR (SC.DEBIT_ACCOUNT IS NULL AND R.DEBIT_ACCOUNT IS NULL))) UNION ALL SELECT sch.cashflow_id, sch.product_id, sch.account_id, sch.account_type_id, sch.cashflow_at, sch.cashflow_time, sch.counter_cashflow, sch.credit_account, sch.credit_account_name, sch.debit_account, sch.debit_account_name, sch.direction, sch.amount, sch.balance_before, sch.balance_after, sch.currency, sch.transaction_code, sch.summary, sch.message, sch.remark, nvl(sch.updated_at, sch.created_at) updated_at, sch.use_info FROM settlement_cashflow_his</td>
