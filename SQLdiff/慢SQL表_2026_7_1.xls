    <td class="xl66" x:str>WITH CheckUnuseProduct AS ( SELECT P.PRODUCT_ID FROM UNUSE_ACCT_INF UA JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID WHERE UA.EFFECTSTATUS = '1' AND P.SUB_GROUP_MARK = '0' ) SELECT COUNT(1) FROM ( SELECT 1 FROM BALANCE_HISTORY BH WHERE BH.BALANCE_DATE between ? and ? AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH') AND EXISTS ( SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? ) AND NOT EXISTS( SELECT 1 FROM CheckUnuseProduct c WHERE BH.PRODUCT_ID =c.PRODUCT_ID ) UNION ALL SELECT 1 FROM BALANCE BA JOIN SHARED_ACCOUNT_WORKING_DATE SAWD ON BA.ACCOUNT_ID = SAWD.BANK_ACCOUNT_ID WHERE BA.BALANCE_DATE = to_date(SAWD.WORKING_DATE,'yyyyMMdd') AND BA.BALANCE_DATE between ? and ? AND BA.ACCOUNT_TYPE_ID = 'zhinityhzj2' AND EXISTS ( SELECT 1 FROM DUAL WHERE 1=1 AND BA.PRODUCT_ID = ? AND BA.ACCOUNT_ID = ? union ALL SELECT 1 FROM DUAL WHERE 1=1 AND BA.PRODUCT_ID = ? AND BA.ACCOUNT_ID = ? ) AND NOT EXISTS( SELECT 1 FROM CheckUnuseProduct c WHERE BA.PRODUCT_ID = c.PRODUCT_ID ) ) T</td>
