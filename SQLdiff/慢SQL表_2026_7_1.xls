    <td class="xl66" x:str>select iti.instruction_id as instructionId, iti.match_status as matchStatus, iti.sort_order as sortOrder, iti.source_id as sourceId, iti.pk_id as pkId, iti.seq_no as seqNo, iti.product_id as productId, iti.trade_date as tradeDate, iti.trade_direction as tradeDirection, iti.security_type as securityType, iti.amount as amount, iti.regist_code as registCode, iti.security_code as securityCode, iti.security_name as securityName, iti.debit_account as debitAccount, iti.debit_account_name as debitAccountName, iti.bank_name as bankName, iti.interest_rate_type as interestRateType, iti.interest_freq as interestFreq, iti.withdraw_type as withdrawType from INSTRUCTION_TRANS_INFO iti where iti.SEQ_NO in ( ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? , ? )</td>
