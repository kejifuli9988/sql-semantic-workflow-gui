    <td class="xl66" x:str>249d768e0cec8ba6b19e74da17dd02f8</td>
    <td class="xl66" x:str>select count(*) from( WITH schistory as ( select sch.cashflow_id as CASHFLOW_ID, TO_CHAR(sch.cashflow_at, 'yyyy-MM-dd') as CASHFLOW_AT, sch.amount as amount, (select zydhb.zydh || '-' || zydhb.zymc from ZYDHB zydhb where zydhb.effectstatus = '1' and zydhb.zydh = sch.SUMMARY) as summary, sch.message as message, SCH.ACCOUNT_ID, ( select ba.BANK_ACCOUNT_NAME from bank_account ba where ba.bank_account_id = sch.account_id) as BANK_ACCOUNT_NAME, sch.product_id, sch.instruction_id, sch.COUNTER_CASHFLOW, sch.DIRECTION from settlement_cashflow_history sch where sch.cashflow_at between trunc(cast(? as timestamp)) and trunc(cast(? as timestamp)) and sch.instruction_id is null and sch.SUMMARY not in ('855', '850') and sch.COUNTER_CASHFLOW not like '9699%' and sch.DIRECTION = '0' ), bka as( select * from bankaccandunuseacc where ind_branchid IN ( ? ) ), CTE1 AS ( SELECT sch.cashflow_id AS CASHFLOW_ID, p.product_name AS PRODUCT_NAME, sch.cashflow_at AS CASHFLOW_AT, sch.amount AS amount, NVL(cm.OPD_CONFIRM_STATUS, 'WQR') AS opdConfirmStatus, cm.SIUATION_EXPLAIN AS SIUATION_EXPLAIN, TO_CHAR(cm.siuation_date, 'yyyy-MM-dd HH24:mi:ss') AS SIUATION_DATE, cm.OPD_BRANCH AS siuationBranch, (SELECT d.yhmc FROM ip_staff_stmt d WHERE cm.SIUATION_BY = d.yhbh) AS SIUATION_BY, NULL AS INTER_BANK, P.Ind_Branchid AS indBranchId, P.OPD_BRANCHID AS opdBranchId, (SELECT zydhb.zydh || '-' || zydhb.zymc FROM ZYDHB zydhb WHERE zydhb.effectstatus = '1' AND zydhb.zydh = sch.SUMMARY) AS summary, sch.message AS message, p.product_Id, SCH.ACCOUNT_ID, (SELECT ba.BANK_ACCOUNT_NAME FROM bank_account ba WHERE ba.bank_account_id = sch.account_id) AS BANK_ACCOUNT_NAME, DECODE(P.OPERATION_STATUS, '', '0', P.OPERATION_STATUS) AS OPERATION_STATUS FROM schistory sch LEFT JOIN product p ON sch.product_id = p.product_id LEFT JOIN CRITICAL_MONITOR_SIGN cm ON sch.CASHFLOW_ID = cm.RELATION_ID WHERE</td>
    <td class="xl66" x:str>2674</td>
