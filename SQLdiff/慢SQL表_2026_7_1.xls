   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>661</td>
    <td class="xl66" x:str>全链路监控</td>
    <td class="xl66" x:str>db8a0019323d8c4e856555df536b31ad</td>
    <td class="xl66" x:str>WITH warn AS ( SELECT wm_concat(warning_links) warning_links,wm_concat(SUPERVISION_TYPE) supervisionType,wm_concat(branch_id) branch_id FROM ( SELECT w.warning_links warning_links,w.SUPERVISION_TYPE,w.branch_id FROM instruc_supervision_warn w WHERE w.effectstatus = '1' and w.warning_whether = ? and INSTR(',' || w.SOURCE_ID || ',',',' || ? || ',' ) &gt; 0 AND ((w.product_type_id is null) or EXISTS (select 1 from product p where p.product_id = ? and INSTR(',' || w.product_type_id || ',', ',' || p.product_type_id || ',') &gt; 0)) and EXISTS (SELECT 1 FROM para_code pc WHERE pc.para_key = w.payment_type_id AND pc.code_id = ?) and exists (select 1 from product p where p.product_id = ? and w.branch_id = p.opd_branchId ) ) group by SUPERVISION_TYPE ) SELECT m.supervision_id, m.title, w.warning_links, m.SUPERVISION_TYPE, m.DEPOSIT_ACCOUNT, INSTR(w.supervisionType, m.SUPERVISION_TYPE) isFlag FROM product p,payment_type pt,instruc_supervision_match m left join warn w on ( INSTR(',' || w.supervisionType || ',', ',' || m.supervision_type || ',') &gt; 0 ) WHERE m.effectstatus = '1' AND (m.manager_id = p.manager_id or m.manager_id is null) and (m.branch_id is null or m.branch_id = p.opd_branchId) AND (m.direction is null or ','||m.direction||',' LIKE '%'||?||'%') AND p.product_id = ? AND ((m.product_id IS NULL ) OR (EXISTS(SELECT 1 FROM para_code pc WHERE pc.para_key = m.product_id AND pc.code_id = ?))) AND ((m.product_type_id IS NULL ) OR (EXISTS(SELECT 1 FROM para_code pc WHERE pc.para_key = m.product_type_id AND pc.code_id = p.product_type_id) )) AND ((m.payment_type_id IS NULL) or (EXISTS(SELECT 1 FROM para_code pc WHERE pc.para_key = m.payment_type_id AND pc.code_id =?) or (m.payment_type_id = 'EKP' and pt.inv_supervision_flag = '1' ))) and pt.payment_type_id =?</td>
    <td class="xl66" x:str>2049</td>
    <td class="xl66" x:str>1</td>
