   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>1</td>
    <td class="xl66" x:str>全链路监控</td>
    <td class="xl66" x:str>4c5bbb92fb5eed89a963ac77e0aed3c2</td>
    <td class="xl66" x:str>SELECT sch.cashflow_id, sch.core_cashflow_id, sch.product_id, sch.account_id, sch.account_type_id, sch.cashflow_at, sch.cashflow_time, sch.counter_cashflow, sch.credit_account, sch.credit_account_name, sch.debit_account, sch.debit_account_name, sch.direction, sch.amount, sch.balance_before, sch.balance_after, sch.currency, sch.transaction_code, sch.summary, sch.message, sch.remark, nvl(sch.updated_at, sch.created_at) updated_at, sch.use_info, sch.bank_no, sch.bank_name, sch.trade_org_code, sch.post_route_choose, sch.cpzxh, sch.cpznxh, sch.trade_area_code FROM SETTLEMENT_CASHFLOW_HISTORY SCH WHERE SCH.SUMMARY = '591' AND SCH.CASHFLOW_AT BETWEEN CAST( ? AS TIMESTAMP) AND CAST( ? AS TIMESTAMP) AND NOT EXISTS (SELECT 1 FROM BANK_ACCOUNT BA WHERE BA.BANK_ACCOUNT_ID = SCH.ACCOUNT_ID AND BA.DEDICATED = '0') AND NOT EXISTS (SELECT 1 FROM CORE_CASHFLOW_RETURN R WHERE SCH.ACCOUNT_ID = R.ACCOUNT_ID AND SCH.CASHFLOW_AT = R.CASHFLOW_AT AND SCH.CASHFLOW_TIME = R.CASHFLOW_TIME AND SCH.CPZXH = R.CPZXH AND SCH.CPZNXH = R.CPZNXH AND SCH.DIRECTION = R.DIRECTION AND SCH.AMOUNT = R.AMOUNT AND SCH.COUNTER_CASHFLOW = R.COUNTER_CASHFLOW AND (SCH.CREDIT_ACCOUNT = R.CREDIT_ACCOUNT OR (SCH.CREDIT_ACCOUNT IS NULL AND R.CREDIT_ACCOUNT IS NULL)) AND (SCH.DEBIT_ACCOUNT = R.DEBIT_ACCOUNT OR (SCH.DEBIT_ACCOUNT IS NULL AND R.DEBIT_ACCOUNT IS NULL)))</td>
    <td class="xl66" x:str>413862</td>
    <td class="xl66" x:str>9</td>
    <td class="xl66" x:str>settlement-cronjob</td>
    <td class="xl67" x:str></td>
   </tr>
   <tr height="546" class="xl65" style='height:409.50pt;'>
    <td class="xl66" height="546" style='height:409.50pt;' x:str>2</td>
    <td class="xl66" x:str>全链路监控</td>
    <td class="xl66" x:str>0b340613845327af23ff5041756a60a7</td>
    <td class="xl66" x:str>select count(*) from ( select z.qhld_id, debit_account, debit_account_name, bank_id, bank_name, riskfee_debit_account, riskfee_debit_account_name, riskfee_bank_id, riskfee_bank_name, payment_rate, date_property, payment_day, payment_time,finance_time,finance_date_property, inter_bank, branch_id, (select aa.jgmc from ip_unit_stmt aa where aa.zj = z.branch_id and aa.effectstatus = '1') as branch_name, (case payment_type_id when 'FYZF03' then to_char(get_values(z.manager_id)) else manager_id end) manager_id, (case payment_type_id when 'FYZF03' then get_names(z.manager_id,'manager') else (select d.external_agency_name from external_agency d where d.effectstatus = '1' and z.manager_id = d.external_agency_id) end) as manager_name, effectstatus, op_type, foureyesstatus, audit_comment, created_at, created_by, updated_at, updated_by, validated_at, validated_by, whether_fax, riskfee_ratio, get_values(z.product_type_id) as product_type_id, get_names(z.product_type_id, 'product_type') as product_type_name, get_values(z.product_id) as product_id, get_names(z.product_id, 'product') as product_name, get_values(z.seat_id) as seat_id, get_names(z.seat_id, 'seat') as seat_code, get_values(z.broker_id) as broker_id, get_names(z.broker_id, 'broker') as broker_name, z.payment_type_id,(case when z.terminate_flag ='0' then ( select p.payment_type_name from payment_type p where z.payment_type_id = p.payment_type_id and p.effectstatus='1') else z.payment_type_id end) as paymentTypeName, (select a.yhmc from ip_staff a where z.created_by = a.yhbh) as createdByName, (select b.yhmc from ip_staff b where z.updated_by = b.yhbh) as updatedByName, (select c.yhmc from ip_staff c where z.validated_by = c.yhbh) as validatedByName, riskfee_inter_bank, remark, is_push, TERMINATE_FLAG, TERMINATE_STATUS from qhld_parameter z</td>
    <td class="xl66" x:str>292021</td>
    <td class="xl66" x:str>5</td>
    <td class="xl66" x:str>settlement-web</td>
    <td class="xl67" x:str></td>
