    <td class="xl66" x:str>973ade66f771bb1213e532b5c28714eb</td>
    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select * from ( select p.product_code cpdm, i.instruction_id instructionId, i.credit_account fkfzh, i.instruction_id hkdbh, i.amount hkje, i.payment_type_id hklx, to_char(i.payment_at,'yyyyMMdd') hkrq, to_char(i.created_at,'yyyyMMddHH24miss') cjsj, i.direction sfkfx, i.debit_account skfzhh, i.currency bz, i.credit_account_id fkfzhid, i.credit_account_name fkfzhqc, i.bank_name fkfzhkhh, i.debit_account_id skfzhid, i.debit_account_name skfzhqc, i.fbank_name skfzhkhh, case when i.payment_type_id in ('TZXG01', 'TZXG02') then i.ipo_subscribe else i.payment_reason end summary, P.PRODUCT_NAME productName , TO_CHAR(I.PAYMENT_DATE,'YYYYMMDD') paymentDate , TO_CHAR(I.PAYMENT_AT,'YYYYMMDD') paymentAt , I.PRIORITY priority , I.PAYMENT_TYPE_ID paymentTypeId , I.WHETHER_PASS_AUXILIARY whetherPassAuxiliary , I.REALTIME_STATUS realtimeStatus , I.FINAL_PAYMENTSTATUS finalPaymentStatus , replace(I.PAYMENT_REASON,chr(10),'') paymentReason , I.ACTIVITY_CENTER_FLAG activityCenterFlag , I.SOURCE_ID sourceId , TO_CHAR(I.UPDATED_AT,'YYYYMMDDHH24MISS') updatedAt , I.UPDATED_BY updatedBy , (select ea.external_agency_name from external_agency ea where p.manager_id = ea.external_agency_id and ea.effectstatus = '1') manageName , (select ip.jgmc from ip_unit_stmt ip where ip.zj = p.opd_branchid) cpyyjg, P.OPERATION_MODE cpyyms , I.ACTIVITY_CENTER_STATUS activityCenterStatus , I</td>
