    <td class="xl66" x:str>INSERT INTO SETTLEMENT_CASHFLOW_HISTORY (CASHFLOW_ID, PRODUCT_ID, ACCOUNT_ID, ACCOUNT_TYPE_ID, CASHFLOW_AT, CASHFLOW_TIME, INSTRUCTION_ID, SUB_ID, COUNTER_CASHFLOW, CREDIT_ACCOUNT, CREDIT_ACCOUNT_NAME, DEBIT_ACCOUNT, DEBIT_ACCOUNT_NAME, DIRECTION, PAYMENT_TYPE_ID, AMOUNT, BALANCE_BEFORE, BALANCE_AFTER, CURRENCY, TRANSACTION_CODE, SUMMARY, MESSAGE, REMARK, CREATED_AT, CREATED_BY, UPDATED_AT, UPDATED_BY, USE_INFO, BANK_NO, BANK_NAME) SELECT CASHFLOW_ID, PRODUCT_ID, ACCOUNT_ID, ACCOUNT_TYPE_ID, CASHFLOW_AT, CASHFLOW_TIME, INSTRUCTION_ID, SUB_ID, COUNTER_CASHFLOW, CREDIT_ACCOUNT, CREDIT_ACCOUNT_NAME, DEBIT_ACCOUNT, DEBIT_ACCOUNT_NAME, DIRECTION, PAYMENT_TYPE_ID, AMOUNT, BALANCE_BEFORE, BALANCE_AFTER, CURRENCY, TRANSACTION_CODE, SUMMARY, MESSAGE, REMARK, CREATED_AT, CREATED_BY, sysdate, UPDATED_BY, USE_INFO, null, null FROM SETTLEMENT_CASHFLOW SC WHERE SC.CASHFLOW_AT = ? AND SC.ACCOUNT_TYPE_ID = ?</td>
