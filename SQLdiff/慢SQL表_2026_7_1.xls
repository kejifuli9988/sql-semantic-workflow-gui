    <td class="xl66" x:str>select count(1) from CSBS_INSTRUCTION CI left join bank_account ba on ci.BANK_ACCOUNT_ID = ba.bank_account_id where 1=1 and ( CI.CREATED_AT &gt;= trunc(cast(? as timestamp)) and CI.CREATED_AT &lt;trunc(cast(? as timestamp))+1 or CI.DELIVER_DATE1 between to_char(cast(? as timestamp),'yyyymmdd') and to_char(cast(? as timestamp),'yyyymmdd') ) and product_id IN (SELECT pp.product_code FROM product_info_branch pib,product pp WHERE pib.product_id = pp.product_id and pib.roleid in(SELECT irs.jsbh FROM ip_role_stmt irs WHERE irs.jsmc in('核算经办','分行核算经办')) and pib.userid in ( ? ) ) and ( (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NULL) OR (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NOT NULL and exists ( SELECT IP.YHBH FROM ip_staff_stmt ip,SAD_CC S WHERE S.BRANCHID = ip.ssjg AND ip.yhbh = ? AND S.RANGE IN ( SUBSTR( ci.bank_account_id,0,2), SUBSTR( ci.bank_account_id,0,5) ) AND EXISTS ( select 1 from ( select a.bank_account_id, pro.PRODUCT_ID, pro.ind_branchid as ind_branchid, ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN from auxiliary_product a inner join product pro on pro.product_id = a.product_id where a.effectstatus = '1' AND a.BANK_ACCOUNT_ID = ci.BANK_ACCOUNT_ID AND pro.IND_BRANCHID = S.BRANCHID ) aup where aup.rown = 1</td>
