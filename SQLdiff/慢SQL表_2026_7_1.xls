    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( SELECT z.FAX_INSTRUCTION_ID, z.INSTRUCTION_ID, z.FAX_ID, z.PRODUCT_CODE, z.PAYMENT_DATE, z.PAYMENT_TYPE_ID, z.DIRECTION, z.AMOUNT, z.CURRENCY, z.PAYMENT_REASON, z.CREDIT_ACCOUNT, z.CREDIT_ACCOUNT_NAME, z.DEBIT_ACCOUNT, z.DEBIT_ACCOUNT_NAME, z.BANK_ID, z.BANK_NAME, z.sfqd, z.FILE_PATH, z.CREATED_AT, z.CREATED_BY, z.UPDATED_AT, z.UPDATED_BY, z.RESULT_STATUS, z.PUSH_STATUS, z.PUSH_AT, z.MANAGER_ID, z.MANAGER_NAME, z.RESULT_TYPE, AUDIT_COMMENT, z.TGT_QDZLBH, nvl(z.BUSINESS_TYPE, '0') BUSINESS_TYPE, (SELECT a.yhmc FROM ip_staff a WHERE z.CREATED_BY = a.yhbh) AS createdByName, (SELECT b.yhmc FROM ip_staff b WHERE z.UPDATED_BY = b.yhbh) AS updatedByName, (SELECT p.product_name FROM product p WHERE p.PRODUCT_CODE = z.PRODUCT_CODE ORDER BY p.created_at DESC FETCH FIRST 1 ROWS ONLY) AS PRODUCT_NAME, NVL((SELECT psi.SYSTEM_FLAG FROM product p, prod_switch_info psi WHERE p.product_id = psi.product_id(+) AND p.PRODUCT_CODE = z.PRODUCT_CODE ORDER BY p.created_at DESC FETCH FIRST 1 ROWS ONLY), '1') AS systemFlag, z.ZLLY, (SELECT i.INSTRUC_BATCH FROM instruction i WHERE i.instruction_id = z.instruction_id) AS INSTRUC_BATCH FROM FAX_INSTRUCTION z WHERE 1 = 1 AND trunc(PUSH_AT) = trunc(cast(? AS timestamp)) AND RESULT_TYPE = ? AND PRODUCT_CODE IN (SELECT PRODUCT_CODE FROM PRODUCT WHERE PRODUCT_NAME LIKE '%' || ? || '%' AND PRODUCT_CODE IS NOT NULL) AND EXISTS (SELECT 1 FROM PRODUCT p, prod_switch_info psi WHERE p.product_id = psi.product_id AND psi.system_flag = '2' AND z.PRODUCT_CODE = P.PRODUCT_CODE) ORDER BY RESULT_STATUS ASC, PUSH_AT DESC ) row_ ) where rownum_ &gt; 0 and rownum_ &lt;= 10</td>
