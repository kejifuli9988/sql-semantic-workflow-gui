    <td class="xl66" x:str>merge into CSBS_CONTRACT a USING( SELECT ? as contractPkId ,? as productId ,? as productName ,? as managerId ,? as managerName ,? as dealId ,? as instrId ,? as giveAccountId ,? as giveAccountName ,? as takeAccountId ,? as takeAccountName ,? as zqdm ,? as zqjc ,? as tradeType ,? as fullOrderType ,? as settlementAmount ,? as grossOrderStatus ,? as fundSettStatus ,? as productStatus ,? as createDate ,? as createTime ,? as paymentType ,? as createdAt ,? as createdBy ,? as updatedAt ,? as updatedBy ,? as srcTradeId ,? as market ,? as firstCreateDate ,? as businessType ,? as settlementDate ,? as ownerStatus ,? as dwfhk ,? as contractStatus ,? as buyerSettleConfirmStatus ,? as sellerSettleConfirmStatus ,? as recvConfirmStatus ,? as payConfirmStatus ,? as contractNo ,? as bankAccountId ,? as isBond2 ,? as bondFacePrice from dual union all SELECT ? as contractPkId ,? as productId ,? as productName ,? as managerId ,? as managerName ,? as dealId ,? as instrId ,? as giveAccountId ,? as giveAccountName ,? as takeAccountId ,? as takeAccountName ,? as zqdm ,? as zqjc ,? as tradeType ,? as fullOrderType ,? as settlementAmount ,? as grossOrderStatus ,? as fundSettStatus ,? as productStatus ,? as createDate ,? as createTime ,? as paymentType ,? as createdAt ,? as createdBy ,? as updatedAt ,? as updatedBy ,? as srcTradeId ,? as market ,? as firstCreateDate ,? as businessType ,? as settlementDate ,? as ownerStatus ,? as dwfhk ,? as contractStatus ,? as buyerSettleConfirmStatus ,? as sellerSettleConfirmStatus ,? as recvConfirmStatus ,? as payConfirmStatus ,? as contractNo ,? as bankAccountId ,? as isBond2 ,? as bondFacePrice from dual union all SELECT ? as contractPkId ,? as productId ,? as productName</td>
