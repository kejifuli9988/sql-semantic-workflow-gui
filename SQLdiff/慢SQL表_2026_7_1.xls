    <td class="xl66" x:str>WITH CheckUnuseProduct AS ( SELECT P.PRODUCT_ID FROM UNUSE_ACCT_INF UA JOIN ACCOUNT_PRODUCT AP ON UA.BANK_ACCOUNT_ID = AP.BANK_ACCOUNT_ID JOIN PRODUCT P ON AP.PRODUCT_ID = P.PRODUCT_ID WHERE UA.EFFECTSTATUS = '1' AND P.SUB_GROUP_MARK = '0' ) SELECT COUNT(1) FROM ( SELECT 1 FROM BALANCE_HISTORY BH WHERE BH.BALANCE_DATE between ? and ? AND BH.ACCOUNT_TYPE_ID in ('zhinityhzj2','MZH','ZZH','QTQSFZH') AND EXISTS ( SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM DUAL WHERE 1=1 AND BH.PRODUCT_ID = ? AND BH.ACCOUNT_ID = ? union all SELECT 1 FROM</td>
