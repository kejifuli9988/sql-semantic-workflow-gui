    <td class="xl66" x:str>SELECT * FROM ( select pc.code_id pPRODUCT_ID, qp.*, (SELECT p.PRODUCT_CODE FROM product p WHERE p.effectstatus = '1' AND p.PRODUCT_ID = pc.code_id) AS PRODUCT_CODE, decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT from qhld_parameter qp, para_code pc WHERE qp.effectstatus = '1' AND qp.TERMINATE_FLAG != '1' and qp.IS_INS_CHECK = '1' and qp.PAYMENT_TYPE_ID = ? AND qp.manager_id is not null AND qp.product_id is not null and qp.product_id = pc.para_key union select p.product_id pPRODUCT_ID, qp.*, p.product_code PRODUCT_CODE, decode(qp.payment_rate,'0',trunc(cast(? as timestamp)),PKG_PUB.get_date_after(decode(qp.payment_rate,'1','0','2','1',qp.payment_rate),qp.date_property,qp.payment_day,'1')) AS PAYMENT_AT from qhld_parameter qp, product p, para_code pc where qp.effectstatus = '1' and qp.terminate_flag != '1' and qp.IS_INS_CHECK = '1' AND ((QP.BRANCH_ID IS NOT NULL AND QP.BRANCH_ID = P.OPD_BRANCHID) OR QP.BRANCH_ID IS NULL) AND ((QP.IND_BRANCH_ID IS NOT NULL AND QP.IND_BRANCH_ID = P.IND_BRANCHID) OR QP.IND_BRANCH_ID IS NULL) and pc.para_key = qp.PRODUCT_TYPE_ID AND qp.product_id is null AND qp.manager_id is not null AND qp.product_type_id is not null and p.product_type_id = pc.code_id and p.manager_id = qp.manager_id and p.effectstatus = '1' and qp.PAYMENT_TYPE_ID = ? and not exists (select 1 from qhld_parameter qhld, para_code pcp where qhld.product_id is not null and qhld.manager_id = qp.manager_id and qhld.product_id = pcp.para_key and pcp.code_id = p.product_id and qhld.terminate_flag != '1' and qhld.IS_INS_CHECK = '1' and qhld.effectstatus = '1' and qhld.payment_type_id = ? ) u</td>
