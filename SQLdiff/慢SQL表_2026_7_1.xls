    <td class="xl66" x:str>merge into TRANS_INFO ipd USING ( select ? as pk_id, ? as product_id, ? as product_code, ? as manager_prod, ? as org_no, ? as seq_no, ? as instruction_num, ? as trade_date, ? as confirm_date, ? as trade_direction, ? as security_type, ? as regist_code, ? as security_code, ? as security_name, ? as appmoney, ? as appvol, ? as amount, ? as qrfe, ? as quantity, ? as trade_fee, ? as interest, ? as volumebyinterest, ? as refundamount, ? as reciprocal_code, ? as reciprocal_quantity, ? as trade_status, ? as fail_reason, ? as gxrq, ? as instruction_id, ? as create_time, ? as source, ? as source_code, ? as foureyesstatus, ? as validatedBy, ? as validatedAt, ? as byzd1, ? as byzd2, ? as byzd3, ? as byzd4, ? as byzd5, ? as byzd6, ? as byzd7, ? as byzd8, ? as byzd9, ? as byzd10 from dual union all select ? as pk_id, ? as product_id, ? as product_code, ? as manager_prod, ? as org_no, ? as seq_no, ? as instruction_num, ? as trade_date, ? as confirm_date, ? as trade_direction, ? as security_type, ? as regist_code, ? as security_code, ? as security_name, ? as appmoney, ? as appvol, ? as amount, ? as qrfe, ? as quantity, ? as trade_fee, ? as interest, ? as volumebyinterest, ? as refundamount, ? as reciprocal_code, ? as reciprocal_quantity, ? as trade_status, ? as fail_reason, ? as gxrq, ? as instruction_id, ? as create_time, ? as source, ? as source_code, ? as foureyesstatus, ? as validatedBy, ? as validatedAt, ? as byzd1, ? as byzd2, ? as byzd3, ? as byzd4, ? as byzd5, ? as byzd6, ? as byzd7, ? as byzd8, ? as byzd9, ? as byzd10 from dual union all select ? as pk_id, ? as product_id, ? as product_code, ? as manager_prod, ? as org_no, ? as seq_no, ? as instruction_num,</td>
