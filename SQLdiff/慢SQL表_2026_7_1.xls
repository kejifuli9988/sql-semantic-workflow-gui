    <td class="xl66" x:str>4a8dfe157467fa32c791bad3bc47c5f0</td>
    <td class="xl66" x:str>select count(1) from CSBS_INSTRUCTION CI left join bank_account ba on ci.BANK_ACCOUNT_ID = ba.bank_account_id where 1=1 and ( CI.CREATED_AT &gt;= trunc(cast(? as timestamp)) and CI.CREATED_AT &lt;trunc(cast(? as timestamp))+1 or CI.DELIVER_DATE1 between to_char(cast(? as timestamp),'yyyymmdd') and to_char(cast(? as timestamp),'yyyymmdd') ) and ba.BANK_ACCOUNT_NAME like '%'||?||'%' and ( (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NULL) OR (ci.PRODUCT_ID IS NULL and ci.BANK_ACCOUNT_ID IS NOT NULL and exists ( SELECT IP.YHBH FROM ip_staff_stmt ip,SAD_CC S WHERE S.BRANCHID = ip.ssjg AND ip.yhbh = ? AND S.RANGE IN ( SUBSTR( ci.bank_account_id,0,2), SUBSTR( ci.bank_account_id,0,5) ) AND EXISTS ( select 1 from ( select a.bank_account_id, pro.PRODUCT_ID, pro.ind_branchid as ind_branchid, ROW_NUMBER() OVER(PARTITION BY a.bank_account_id order by decode(pro.operation_status,'1','-1','','0',pro.operation_status) asc,pro.updated_at desc) AS ROWN from auxiliary_product a inner join product pro on pro.product_id = a.product_id where a.effectstatus = '1' AND a.BANK_ACCOUNT_ID = ci.BANK_ACCOUNT_ID AND pro.IND_BRANCHID = S.BRANCHID ) aup where aup.rown = 1 ) UNION ALL SELECT IP.YHBH FROM sad_bow sb, ip_staff_stmt ip WHERE ip.yhbh = ? AND sb.effectstatus = '1' AND ip.ssjg = sb.branchid AND sb.borwlist = '1' AND sb.acc</td>
    <td class="xl66" x:str>2747</td>
