    <td class="xl66" x:str>select a.PRODUCT_ID, a.PRODUCT_NAME, a.product_code, a.TRUSTEE_ID, a.MANAGER_ID, a.CSDS_SETTLEMENT, a.PRODUCT_TYPE_ID, a.OPD_BRANCHID, a.IND_BRANCHID, a.MARKET_BRANCHID, a.ACCOUNTING_GROUPID, a.SUPERVISION_GROUPID, a.OPERATION_MODE, a.FOUND_AT, a.MATURITY_AT, a.OPERATION_STATUS, a.AUDIT_COMMENT, a.FOUREYESSTATUS, a.CREATED_AT, a.CREATED_BY, a.UPDATED_AT, a.UPDATED_BY, a.queryUpdateAt, a.VALIDATED_AT, a.VALIDATED_BY, a.OP_TYPE, a.EFFECTSTATUS, a.INTERFACE_STATUS, a.PUSH_NAS, a.PUSH_XJ, a.IS_XJJG, a.PUSH_YSS, a.MANAGER_PROD, a.OTHERS_SYSTEM_ID, a.SEND_STATUS, a.FAX_SEND_STATUS, a.SYNCHR_FAIL_REASON, a.SEND_DATE, a.MARK, a.PROD_SOURCE, a.SUB_GROUP_MARK, a.SFERJITG, a.ERJITGKH, a.FOREIGN_EX_TRADING_CENTER, a.pushZj, a.PUSH_EITP, a.FILLING_STATUS, a.ONFILE, (select is_cr.yhmc from ip_staff is_cr where a.created_by = is_cr.yhbh) as CREATED_BY_NAME, (select is_up.yhmc from ip_staff is_up where a.updated_by = is_up.yhbh) as UPDATED_BY_NAME, (select is_va.yhmc from ip_staff is_va where a.validated_by = is_va.yhbh) as VALIDATED_BY_NAME, (select ea_tr.external_agency_name from EXTERNAL_AGENCY ea_tr where a.trustee_id = ea_tr.external_agency_id) as TRUSTEE_NAME, (select ea_mg.external_agency_name from EXTERNAL_AGENCY ea_mg where a.manager_id = ea_mg.external_agency_id) as MANAGER_NAME, (select ga.groupname from tgroup ga where a.accounting_groupid = ga.groupid) as ACCOUNTING_GROUP_NAME, (select gs.groupname from tgroup gs where a.supervision_groupid = gs.groupid) as SUPERVISION_GROUP_NAME, (select pt.product_type_name from product_type pt where a.product_type_id = pt.product_type_id) as PRODUCT_TYPE_NAME, (select uiu.jgmc from ip_unit_stmt uiu where a.ind_branchid = uiu.zj) as BRANCH_NAME, (select uou.jgmc from ip_unit_stmt uou where a.opd_branchid = uou.zj) as OPDBRANCH_NAME, (select uou.jgmc from ip_unit_stmt uou where a.market_branchid = uou.zj) as MA</td>
