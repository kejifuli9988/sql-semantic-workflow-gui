    <td class="xl66" x:str>select * from ( select pk_id pkId, security_code securityCode from trans_info t where t.TRADE_DATE = to_char(cast(? as timestamp), 'yyyyMMdd') and t.source = '1' and exists ( select 1 from ip_codeinfo a, ip_codetype b where a.sjlx = b.zj and b.SJLXBH = 'sourceCode' and a.MBLXBH||'-'||t.seq_no = ? and t.source_code = a.MBTMZ) AND T.INSTRUCTION_ID IS NULL union select pk_id pkId, security_code securityCode from NONSTANDARD_TRANS_INFO t where t.TRADE_DATE = to_char(cast(? as timestamp), 'yyyyMMdd') and exists ( select 1 from ip_codeinfo a, ip_codetype b where a.sjlx = b.zj and b.SJLXBH = 'sourceCode' and a.MBLXBH||'-'||t.seq_no = ? and t.manager_id = a.MBTMZ) AND T.INSTRUCTION_ID IS NULL ) where rownum = 1 ORDER BY pkId</td>
