    <td class="xl66" x:str>c2f82b1c818cbc3e2c6ec2e2086f52b3</td>
    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select ri.remfee_info_id, ri.product_id, ri.source_id, ri.credit_account, ri.credit_account_name, ri.debit_account, ri.debit_account_name, ri.bank_id, ri.bank_name, ri.postal_fee, ri.poundage, ri.rem_fee, ri.summary, ri.target_id, ri.generate_status, ri.payment_status, ri.consolidate_id, ri.consolidate_status, ri.pay_freq, p.product_code, p.product_name, p.operation_status, ri.source_amount,ri.merge_amount,ri.source_instruct_date, ri.source_pay_date , ri.source_pay_status, ri.generated_at,(select a.yhmc from ip_staff a where a.yhbh = ri.generated_by) generated_by from remfee_info ri, (select distinct product_id, product_code, product_name, operation_status from (select info_branch.branchid info_branch_id, null oper_branch_id, t.product_id, t.product_code, t.product_name, t.operation_status from product t, (select uib.branchid from user_info_branch uib where uib.effectstatus = '1' and uib.userid = ?) info_branch where t.ind_branchid = info_branch.branchid union all select null info_branch_id, oper_branch.branchid oper_branch_id, t.product_id, t.product_code, t.product_name, t.operation_status from product t, (select uob.branchid from user_operating_branch uob where uob.effectstatus = '1' and uob.userid = ?) oper_branch where t.opd_branchid = oper_branch.branchid)) p where ri.product_id = p.product_id and ri.SOURCE_PAY_STATUS = '3' and ri.PAYMENT_STATUS = ? and trunc(ri.SOURCE_PAY_DATE) &gt;= ? and trunc(ri.SOURCE_PAY_DA</td>
