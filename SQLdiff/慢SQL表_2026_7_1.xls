    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select Z.SUPERVISION_ID from INSTRUC_SUPERVISION_MATCH Z where 1=1 AND EXISTS (SELECT 1 FROM para_code pc WHERE pc.para_key = Z.PRODUCT_ID AND pc.code_id = ?) and SUPERVISION_TYPE = ? and ((z.product_id is null) or exists( select 1 from USER_OPERATING_BRANCH u inner join product p on u.branchid = p.opd_branchid inner join para_code pc on p.product_id = pc.code_id and pc.para_key = Z.PRODUCT_ID where u.effectstatus = '1' and u.userid = ?) or exists( select 1 from USER_INFO_BRANCH ui inner join product pr on ui.branchid = pr.ind_branchid inner join para_code pcc on pr.product_id = pcc.code_id and pcc.para_key = Z.PRODUCT_ID where ui.effectstatus = '1' and ui.userid = ? )) ) row_ ) where rownum_ &gt; 0 and rownum_ &lt;= 10</td>
