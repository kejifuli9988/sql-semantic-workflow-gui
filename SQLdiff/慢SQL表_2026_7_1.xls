    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( SELECT CASHFLOW_ID, PRODUCT_ID, (SELECT P.PRODUCT_CODE FROM PRODUCT P WHERE P.PRODUCT_ID = RES.PRODUCT_ID AND P.EFFECTSTATUS = '1') PRODUCT_CODE, (SELECT P.MANAGER_PROD FROM PRODUCT P WHERE P.PRODUCT_ID = RES.PRODUCT_ID AND P.EFFECTSTATUS = '1') MANAGER_PROD, (SELECT P.PRODUCT_NAME FROM PRODUCT P WHERE P.PRODUCT_ID = RES.PRODUCT_ID ) PRODUCT_NAME, ACCOUNT_ID, (SELECT CA.ACCOUNT_NAME FROM CSDS_ACCOUNT CA WHERE CA.CSDS_ACCOUNT_ID = RES.ACCOUNT_ID AND CA.ACCOUNT_TYPE_ID = RES.ACCOUNT_TYPE_ID AND CA.EFFECTSTATUS = '1') ACCOUNT_NAME, ACCOUNT_TYPE_ID, (SELECT AT.ACCOUNT_TYPE_NAME FROM ACCOUNT_TYPE AT WHERE AT.ACCOUNT_TYPE_ID = RES.ACCOUNT_TYPE_ID) ACCOUNT_TYPE_NAME, CASHFLOW_AT, CASHFLOW_TIME, INSTRUCTION_ID, SUB_ID, COUNTER_CASHFLOW, CREDIT_ACCOUNT, CREDIT_ACCOUNT_NAME, DEBIT_ACCOUNT, DEBIT_ACCOUNT_NAME, DIRECTION, PAYMENT_TYPE_ID, (SELECT PT.PAYMENT_TYPE_NAME FROM PAYMENT_TYPE PT WHERE PT.PAYMENT_TYPE_ID = RES.PAYMENT_TYPE_ID) PAYMENT_TYPE_NAME, AMOUNT, BALANCE_BEFORE, BALANCE_AFTER, CURRENCY, TRANSACTION_CODE, (SELECT zydhb.zydh||'-'||zydhb.zymc FROM ZYDHB zydhb WHERE zydhb.effectstatus='1' AND zydhb.zydh = SUMMARY) SUMMARY, MESSAGE, USE_INFO, REMARK, to_Date(to_char</td>
