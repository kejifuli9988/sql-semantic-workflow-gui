    <td class="xl66" x:str>SELECT WM_CONCAT(ISF.YHMC || decode(IUS.JGMC,NULL,'', '+') || IUS.JGMC || decode(ISF.DHHM || ISF.KZZD1,NULL,'', '+') || ISF.DHHM || decode(ISF.DHHM,NULL,'', '/') || ISF.KZZD1 ) AS HSLXR ,(SELECT PRODUCT_CODE FROM PRODUCT P WHERE P.PRODUCT_ID = HSYHS.PRODUCT_ID AND ROWNUM = 1) PRODUCT_ID FROM IP_STAFF_STMT ISF,IP_UNIT_STMT IUS, (SELECT PIB.USERID,PIB.PRODUCT_ID FROM PRODUCT_INFO_BRANCH PIB,ip_role_staff rs WHERE pib.userid = rs.yhbh AND pib.roleid = rs.jsbh AND rs.jlzt = '1' AND PIB.ROLEID = (SELECT JSBH FROM IP_ROLE WHERE JSMC = '核算经办') AND PIB.PRODUCT_ID in (SELECT PRODUCT_ID FROM PRODUCT P WHERE P.PRODUCT_CODE in ( ? ) and P.EFFECTSTATUS = '1' ) AND ((EXISTS (SELECT 1 FROM sysparam WHERE param_name = 'AUTH_TRANSFER_PRODUCT_SWITCH_V4.13.0' AND param_value = '0') AND NOT exists (SELECT 1 FROM auth_transfer_product WHERE role_id = PIB.roleid AND auth_transfer_status = '2' AND product_id = PIB.product_id AND PIB.userid=provider_id ) ) OR (EXISTS (SELECT 1 FROM sysparam WHERE param_name = 'AUTH_TRANSFER_PRODUCT_SWITCH_V4.13.0' AND param_value = '1') AND NOT exists (SELECT 1 FROM auth_transfer_product atp left join AUTH_TRANSFER_PRODUCT_RECORD atpr on atpr.auth_transfer_product_id = atp.auth_transfer_product_id WHERE atp.role_id = PIB.roleid AND atp.auth_transfer_status = '2' AND PIB.userid=atp.provider_id</td>
