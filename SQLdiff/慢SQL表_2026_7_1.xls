    <td class="xl66" x:str>select * from ( select row_.*, rownum as rownum_ from ( select i.* from( select ti.source as source, (CASE WHEN TI.source = '0' THEN 'SG' WHEN TI.source = '4' THEN 'OCR' else ti.SOURCE_CODE END) as sourceCode, ti.pk_id as pkId, ti.manager_prod as managerProd, p.PRODUCT_CODE as productCode, ti.org_no as orgNo, ti.seq_no as seqNo, ti.trade_date as tradeDate, ti.confirm_date as confirmDate, ti.trade_direction as tradeDirection, ti.regist_code as registCode, ti.security_type as securityType, ti.security_code as securityCode, ti.security_name as securityName, ti.appmoney as appmoney, ti.appvol as appvol, ti.amount as amount, ti.qrfe as qrfe, ti.trade_fee as tradeFee, ti.interest as interest, ti.volumebyinterest as volumebyinterest, ti.refundamount as refundamount, ti.reciprocal_code as reciprocalCode, ti.reciprocal_quantity as reciprocalQuantity, nvl(ti.trade_status, '0000') as tradeStatus, ti.fail_reason as failReason, to_char(to_date( ti.create_time,'yyyy-MM-dd hh24:mi:ss') ,'yyyyMMdd') as gxrq, ti.byzd1 as byzd1, ti.byzd2 as byzd2, ti.byzd3 as byzd3, ti.instruction_id as byzd4, ti.byzd5 as byzd5, ti.byzd6 as byzd6, ti.byzd7 as byzd7, ti.byzd8 as byzd8, ti.byzd9 as byzd9, ti.byzd10 as byzd10 from trans_info ti, product p where ti.product_id = p.product_id and ti.product_id is not null and ti.foureyesstatus = '1' and NOT EXISTS (SELECT 1 FROM TRANS_INFO T WHERE T.PK_ID = TI.PK_ID AND T.SOURCE = '1' AND T.SOURCE_CODE = 'tymh' AND T.SECURITY_TYPE IS NULL) and ti.create_time &gt;= to_char(cast(? as timestamp), 'yyyy-mm-dd ')</td>
