    <td class="xl66" x:str>SELECT II.INSTRUCTION_ID as &quot;instructionId&quot;, RIC.CASHFLOW_ID as &quot;cashflowId&quot;, II.ACTION_STATUS as &quot;actionStatus&quot;, II.PAYMENT_STATUS AS &quot;paymentStatus&quot; FROM INSTRUCTION II, RECORD_INSTRUCTION_CASHFLOW RIC WHERE II.INSTRUC_BATCH_FLAG != '0' AND (II.P_INSTRUCTION_ID = '0' OR II.P_INSTRUCTION_ID IS NULL) AND II.DIRECTION = '1' AND II.CREDIT_ACCOUNT = RIC.CREDIT_ACCOUNT AND II.DEBIT_ACCOUNT = RIC.DEBIT_ACCOUNT AND II.PAYMENT_AT = RIC.CASHFLOW_AT AND II.AMOUNT = RIC.AMOUNT AND NOT EXISTS(SELECT 1 FROM RECORD_INSTRUCTION_CASHFLOW RI WHERE RI.INSTRUCTION_ID = II.INSTRUCTION_ID) AND (RIC.CASHFLOW_ID IN ( ? , ? , ? , ? , ? , ? , ? , ? , ? , ? ) ) AND II.ACTION_STATUS != '3' ORDER BY II.PAYMENT_STATUS DESC</td>
